-- ============================================================

local function referenceCursorNumber(value, fallback, minimum, maximum)
    value = tonumber(value)
    if value == nil then value = fallback end
    if minimum ~= nil then value = math.max(minimum, value) end
    if maximum ~= nil then value = math.min(maximum, value) end
    return value
end

local function referenceCursorColor(value, fallback)
    if typeof(value) == "Color3" then return value end
    if typeof(fallback) == "Color3" then return fallback end
    return Color3.new(1, 1, 1)
end

