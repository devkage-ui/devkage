end

local function referenceApplyGlow(
    settings,
    line,
    color,
    isHorizontalOrVerticalReference
)
    local glow =
        line.Glow

    if settings.LineGlow ~= true
        or not line.Frame.Visible then

        glow.Visible = false
        return
    end

    local glowThickness =
        referenceCursorNumber(
            settings.GlowThickness,
            30,
            0,
            50
        )

    local glowExtraLength =
        referenceCursorNumber(
            settings.GlowExtraLength,
            15,
            0,
            50
        )

    local glowTransparency =
        referenceCursorNumber(
            settings.GlowTransparency,
            0.43,
            0,
            1
        )

    referenceCopyFrameGeometry(
        line.Frame,
        glow
    )

    local sourceSize =
        line.Frame.AbsoluteSize

    if sourceSize.X >= sourceSize.Y then
        glow.Size =
            UDim2.fromOffset(
                math.max(
                    1,
                    sourceSize.X
                    + glowExtraLength
                ),
                math.max(
                    1,
                    sourceSize.Y
                    + glowThickness
                )
            )
    else
        glow.Size =
            UDim2.fromOffset(
                math.max(
                    1,
                    sourceSize.X
                    + glowThickness
                ),
                math.max(
                    1,
                    sourceSize.Y
                    + glowExtraLength
                )
            )
    end

    glow.BackgroundColor3 = color

    glow.BackgroundTransparency =
        glowTransparency

    glow.Visible = true
end





