local function applyESPProfile(name)
local profile=espProfileData[name]
if not profile then VisualsState.esp_profile="Custom"; return false end
VisualsState.esp_profile=name
for key,value in pairs(profile) do
VisualsState[key]=value
local control=VisualControls[key]
if control and control.Set then
if control.Options then control:Set(optionIndex(control.Options,value),true)
elseif control.GetAlpha then control:Set(value,control:GetAlpha(),true)
else control:Set(value,true) end
end
end
