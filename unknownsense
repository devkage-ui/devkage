local function combatTextCreditsLocal(value)
local lower=tostring(value or ""):lower():gsub("%s+"," ")
if lower=="" then return false end
if lower:find("killed you",1,true)
or lower:find("you were killed",1,true)
or lower:find("you died",1,true)
or lower:find("defeated by",1,true)
or lower:find("eliminated by",1,true) then return false end
if lower:find("you eliminated",1,true)
or lower:find("you killed",1,true)
or lower:find("you defeated",1,true)
or lower:find("elimination confirmed",1,true) then return true end
local names={tostring(LocalPlayer.Name or ""):lower(),tostring(LocalPlayer.DisplayName or ""):lower()}
for _,name in ipairs(names) do
if name~="" then
local np=lower:find(name,1,true)
if np then
