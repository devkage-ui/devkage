-- ============================================================
-- DEVKAGE INTEGRATED CURSOR RENDERER
--
-- This renderer is based on the exact visual/animation model from the
-- supplied DevKage cursor:
--
--   * 25x25 default rotating aim container
--   * four rectangular cardinal lines
--   * one-pixel black line outlines
--   * Arcade cursor text
--   * TextScaled labels
--   * squared sine pulse
--   * per-rotation slowdown near the end of the cycle
--   * original DevKage sine-wave rainbow
--   * cursor text offset below the mouse
--
-- The existing Crosshair page remains the settings source. No controls,
-- labels, profile tables, config names or callbacks are replaced here.
--
-- The only additions around the reference look are optional behaviors
-- already exposed by the existing Cursor tab (profiles, extra arm counts,
-- glow, secondary text, position mode, etc.). With the default DevKage
-- cursor settings, the renderer follows the supplied cursor geometry and
-- animation values exactly.
-- ============================================================

local ReferenceCursorRuntime = {
    Protocol = "DevKage.MaskShard.Cursor/1",
    InstanceId = game:GetService("HttpService"):GenerateGUID(false):gsub("%-", ""),
    Running = true,

    ScreenGui = nil,
    AimContainer = nil,

    Lines = {},
    MainText = nil,
    MainTextStroke = nil,
    SecondText = nil,
    SecondTextStroke = nil,

    Settings = {},
    Revision = -1,

    -- These are the same animation-state variables used by the supplied
    -- cursor code.
    time = 0,
    rotationProgress = 0,
    currentRotationSpeed = 0.8,
    smoothedRotation = 5,

    LastGuiCheck = 0,
    PreviousMouseIconEnabled = uis.MouseIconEnabled,
    OwnsMouseIcon = false,

    Host = nil,
}

do
    local previous = cursorBridgeEnv.__DevKageIntegratedCursorRuntime
    if type(previous) == "table"
        and previous ~= ReferenceCursorRuntime
        and type(previous.Stop) == "function" then

        pcall(function()
            previous:Stop()
        end)
    end

    local oldStandalone = cursorBridgeEnv.__DevKageCursorRuntimeV1
    if type(oldStandalone) == "table"
        and type(oldStandalone.Stop) == "function" then

        pcall(function()
            oldStandalone:Stop()
        end)
    end

    cursorBridgeEnv.__DevKageIntegratedCursorRuntime =
        ReferenceCursorRuntime
end

-- ============================================================
