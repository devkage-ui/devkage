local function applyAntiAimPreset(name)
local profile=antiAimPresetProfiles[name]
if not profile then AntiAimState.preset="Custom"; return end
AntiAimState.preset=name
for key,value in pairs(profile) do
AntiAimState[key]=value
local control=AntiAimControls[key]
if control and control.Set then
if control.Options then control:Set(optionIndex(control.Options,value),true) else control:Set(value,true) end
end
end
AntiAimState.nextRandomUpdate=0
AntiAimState.lastJitterStep=-1
AntiAimState.targetPlayer=nil
AntiAimState.lastTargetUpdate=0
AntiAimState.smoothedYaw=nil
AntiAimState.smoothedPitch=nil
AntiAimState.smoothedRoll=nil
if AntiAimState.enabled then aa_apply(true) end
end

