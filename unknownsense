local function aa_makeGhost(player, rootCF, color, previousPos)
local char = player and player.Character
if not char then return end
local folder = aa_ensureBacktrackFolder()
local model = Instance.new("Model")
model.Name = "BacktrackGhost"
model.Parent = folder
local root = char:FindFirstChild("HumanoidRootPart")
if not root then model:Destroy(); return end
local offset = rootCF * root.CFrame:Inverse()
local quality=tostring(AntiAimState.backtrack_quality or "High")
local materialOptions={
ForceField=Enum.Material.ForceField,
Neon=Enum.Material.Neon,
Glass=Enum.Material.Glass,
SmoothPlastic=Enum.Material.SmoothPlastic,
}
local ghostMaterial=materialOptions[tostring(AntiAimState.backtrack_material)] or Enum.Material.ForceField
local baseTransparency=math.clamp(tonumber(AntiAimState.backtrack_transparency) or 0.58,0.05,0.95)
local partTransparency=math.clamp(baseTransparency+(quality=="Performance" and 0.10 or (quality=="Ultra" and -0.08 or 0)),0.05,0.95)
local performanceParts={Head=true,UpperTorso=true,Torso=true,LowerTorso=true}
for _, obj in ipairs(char:GetDescendants()) do
if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" and (quality~="Performance" or performanceParts[obj.Name]) then
local cloneOk,ghost=pcall(function() return obj:Clone() end)
if not cloneOk or not ghost then
ghost=Instance.new("Part")
ghost.Size=obj.Size
if obj:IsA("Part") then ghost.Shape=obj.Shape end
else
for _,descendant in ipairs(ghost:GetDescendants()) do
if descendant:IsA("JointInstance") or descendant:IsA("Constraint") or descendant:IsA("Attachment") or descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") or descendant:IsA("Sound") or descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") or descendant:IsA("Beam") then
pcall(function() descendant:Destroy() end)
end
end
end
ghost.Name = obj.Name
ghost.Anchored = true
ghost.CanCollide = false
ghost.CanTouch = false
ghost.CanQuery = false
ghost.CastShadow = false
ghost.Material = ghostMaterial
ghost.Color = color
ghost.Transparency = partTransparency
ghost.Size = obj.Size
ghost.CFrame = offset * obj.CFrame
pcall(function() ghost.LocalTransparencyModifier=0 end)
ghost.Parent = model
end
end
if quality=="Ultra" then
local highlight=Instance.new("Highlight")
highlight.Name="DevKage_BacktrackGlow"
highlight.Adornee=model
highlight.FillColor=color
highlight.FillTransparency=math.clamp(partTransparency+0.30,0,1)
highlight.OutlineColor=color:Lerp(Color3.new(1,1,1),0.25)
highlight.OutlineTransparency=0.42
highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
highlight.Parent=model
end
local pos = rootCF.Position
local line = previousPos and aa_makeLine(previousPos, pos, color) or nil
table.insert(AntiAimVisualRuntime.backtrackEntries, {model=model, line=line, born=os.clock(), position=pos, transparency=partTransparency})
end

local function aa_updateReferenceFeatures(dt)
local now = os.clock()

if AntiAimState.target_indicator_enabled then
 aa_ensureIndicator()
 AntiAimVisualRuntime.gui.Enabled = true
 local scanDelay = math.max(0.05, math.clamp(tonumber(AntiAimState.scan_interval) or 0.18, 0.01, 2))
 if now - AntiAimVisualRuntime.lastScan >= scanDelay then
  AntiAimVisualRuntime.lastScan = now
  AntiAimVisualRuntime.target = aa_pickTarget(math.clamp(tonumber(AntiAimState.target_radius) or 367, 1, 2000), nil)
 end
 local target = AntiAimVisualRuntime.target
 local frame = AntiAimVisualRuntime.frame
 local camera = workspace.CurrentCamera
 local targetPos = nil
 if target and target.Character then
  local root = target.Character:FindFirstChild("HumanoidRootPart")
  if root and camera then
   local screen, visible = camera:WorldToViewportPoint(root.Position)
   if visible and screen.Z > 0 then targetPos = Vector2.new(screen.X, screen.Y) end
  end
 end
 local width = math.clamp(tonumber(AntiAimState.window_width) or 220, 120, 600)
 local height = math.clamp(tonumber(AntiAimState.window_height) or 74, 68, 300)
 frame.Size = UDim2.fromOffset(width, height)
 local viewport = camera and camera.ViewportSize or Vector2.new(1280,720)
 local positionMode = tostring(AntiAimState.indicator_position_mode or "Follow Target")
 local baseX,baseY = viewport.X*0.5,viewport.Y*0.5
 if positionMode == "Top Center" then
  baseY = height*0.5+18
 elseif positionMode == "Bottom Center" then
  baseY = viewport.Y-height*0.5-18
 elseif positionMode == "Follow Target" and targetPos then
  baseX,baseY = targetPos.X,targetPos.Y
 end
 frame.Position = UDim2.fromOffset(baseX + AntiAimState.offset_x, baseY + AntiAimState.offset_y)
 frame.BackgroundTransparency = math.clamp(tonumber(AntiAimState.indicator_background_transparency) or 0.08,0,1)
 local color = aa_indicatorColor(now)
 AntiAimVisualRuntime.accentBar.BackgroundColor3 = color
 AntiAimVisualRuntime.barFill.BackgroundColor3 = color
 AntiAimVisualRuntime.stroke.Color = aa_indicatorGlowColor(color)
 AntiAimVisualRuntime.stroke.Enabled = AntiAimState.indicator_glow == true
 AntiAimVisualRuntime.stroke.Transparency = math.clamp(tonumber(AntiAimState.indicator_glow_transparency) or 0.3, 0, 1)
 AntiAimVisualRuntime.stroke.Thickness = math.clamp(tonumber(AntiAimState.indicator_border_thickness) or 1.5,0,6)
 AntiAimVisualRuntime.title.Text = tostring(AntiAimState.indicator_title or "TARGET INDICATOR")
 local textDelay = math.clamp(tonumber(AntiAimState.text_interval) or 0.1, 0.01, 2)
 local hum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
 local targetHealth = hum and math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1) or 0
 local smooth = math.clamp(tonumber(AntiAimState.bar_smoothness) or 18, 0.1, 60)
 AntiAimVisualRuntime.healthDisplay = AntiAimVisualRuntime.healthDisplay + (targetHealth - AntiAimVisualRuntime.healthDisplay) * (1 - math.exp(-smooth * math.max(dt, 0)))
 AntiAimVisualRuntime.barFill.Size = UDim2.new(math.clamp(AntiAimVisualRuntime.healthDisplay,0,1),0,1,0)
 if now - AntiAimVisualRuntime.lastText >= textDelay then
  AntiAimVisualRuntime.lastText = now
  AntiAimVisualRuntime.name.Text = target and (AntiAimState.indicator_compact and target.DisplayName or (target.DisplayName.."  @"..target.Name)) or "NO TARGET"
