local function aa_randomRange(minimum, maximum)
minimum = math.floor(tonumber(minimum) or 0)
maximum = math.floor(tonumber(maximum) or 0)
if minimum > maximum then minimum, maximum = maximum, minimum end
return math.random(minimum, maximum)
end

local function aa_refreshRandoms(now)
local delay = math.clamp(tonumber(AntiAimState.update_delay) or 0.12, 0.01, 1.00)
if now < AntiAimState.nextRandomUpdate then return end
local minimum = math.clamp(tonumber(AntiAimState.random_min) or -180, -180, 180)
local maximum = math.clamp(tonumber(AntiAimState.random_max) or 180, -180, 180)
AntiAimState.randomYaw = aa_randomRange(minimum, maximum)
if AntiAimState.pitch_mode == "Extended Random" then
AntiAimState.randomPitch = aa_randomRange(-180, 180)
else
AntiAimState.randomPitch = aa_randomRange(-89, 89)
end
AntiAimState.nextRandomUpdate = now + delay
end

local function aa_mode_angles(now)
now = now or os.clock()
aa_refreshRandoms(now)

local yawMode = AntiAimState.yaw_mode
local yaw = 0
if yawMode == "Offset" then
yaw = math.clamp(tonumber(AntiAimState.yaw_offset) or 0, -180, 180)
elseif yawMode == "Backwards" then
yaw = 180
elseif yawMode == "Random" then
yaw = AntiAimState.randomYaw
elseif yawMode == "Custom" then
yaw = math.clamp(tonumber(AntiAimState.custom_yaw) or 0, -180, 180)
else
yaw = 0
end

local spinSpeed = math.clamp(tonumber(AntiAimState.spin_speed) or 0, -720, 720)
yaw = yaw + ((now * spinSpeed) % 360)

local jitterAngle = math.clamp(math.abs(tonumber(AntiAimState.jitter_angle) or 0), 0, 180)
if jitterAngle > 0 then
local step = math.max(0.01, math.clamp(tonumber(AntiAimState.update_delay) or 0.12, 0.01, 1.00))
yaw = yaw + ((math.floor(now / step) % 2 == 0) and jitterAngle or -jitterAngle)
end

local pitchMode = AntiAimState.pitch_mode
local pitch = 0
if pitchMode == "Random" then
pitch = math.clamp(AntiAimState.randomPitch, -89, 89)
elseif pitchMode == "Look Up" then
pitch = -70
elseif pitchMode == "Look Down" then
pitch = 70
elseif pitchMode == "Custom" then
pitch = math.clamp(tonumber(AntiAimState.pitch_angle) or 0, -89, 89)
elseif pitchMode == "Extended Custom" then
pitch = math.clamp(tonumber(AntiAimState.pitch_angle) or 0, -180, 180)
elseif pitchMode == "Extended Random" then
pitch = math.clamp(AntiAimState.randomPitch, -180, 180)
end

return yaw, pitch
end

local function aa_apply(enabled)
aa_restore()
AntiAimState.enabled = enabled == true
if not AntiAimState.enabled then return end

local function setupCharacter(char)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
    if not hum then return end
    if AntiAimState.savedHumanoids[hum] == nil then
        AntiAimState.savedHumanoids[hum] = hum.AutoRotate
    end
    hum.AutoRotate = false
end

if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
AntiAimState.characterConnection = LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    if AntiAimState.enabled then setupCharacter(char) end
end)

AntiAimState.connection = RunService.RenderStepped:Connect(function()
    if not AntiAimState.enabled then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp or not hum or hum.Health <= 0 then return end

    local yaw, pitch = aa_mode_angles(os.clock())
    local position = hrp.Position
    local camera = workspace.CurrentCamera
    local currentLook = camera and camera.CFrame.LookVector or hrp.CFrame.LookVector
    local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
    if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(0, 0, -1) end
    flatLook = flatLook.Unit
    local baseYaw = math.atan2(-flatLook.X, -flatLook.Z)
    local desiredYaw = baseYaw + math.rad(yaw)
    local safeCFrame = CFrame.new(position) * CFrame.Angles(0, desiredYaw, 0)
    pcall(function() hrp.CFrame = safeCFrame end)

    local neck = aa_findNeck(char)
    if neck then
        if AntiAimState.savedNecks[neck] == nil then
            AntiAimState.savedNecks[neck] = neck.C0
        end
        pcall(function()
            neck.C0 = AntiAimState.savedNecks[neck] * CFrame.Angles(math.rad(pitch), 0, 0)
        end)
    end

    AntiAimState.lastYaw = yaw
    AntiAimState.lastPitch = pitch
end)
end

