        if not ua_isActiveInstance() or not UA.ready or not UA.DataController or not UA.DataController.CurrentData then
            table.clear(UA.replicatePending)
            return
        end
        local pending = UA.replicatePending
        UA.replicatePending = {}
        for replicateKey in pairs(pending) do
            pcall(function() UA.DataController.CurrentData:Replicate(replicateKey) end)
        end
    end)
end

local function ua_config()
    local environment = ua_environment()
    local config = type(environment) == "table" and environment.__DevKageConfig or nil
    return type(config) == "ta]==================],
    [==================[ble" and config or nil
end

local function ua_emotesEnabled()
    local config = ua_config()
    return config and config.unlockEmotes == true or false
end

local function ua_weaponsEnabled()
    local config = ua_config()
    return config and config.unlockWeapons == true or false
end

local function ua_isNotFinisher(name)
    if not name then return false end
    local lower = tostring(name):lower()
    return not (lower:find("finisher") or lower:find("finish") or lower:find("execution"))
end

local function ua_isEmote(cosmeticType, cosmeticName)
    local typeName = tostring(cosmeticType or ""):lower()
    if typeName:find("emote", 1, true) or typeName:find("dance", 1, true) then return true end
    local library = UA.CosmeticLibrary
    local cosmetic = library and library.Cosmetics and library.Cosmetics[cosmeticName]
    local libraryType = tostring(cosmetic and cosmetic.Type or ""):lower()
    local name = tostring(cosmeticName or ""):lower()
    return libraryType:find("emote", 1, true) ~= nil
        or libraryType:find("dance", 1, true) ~= nil
        or name:find("emote", 1, true) ~= nil
        or name:find("dance", 1, true) ~= nil
end

local function ua_shouldSpoofCosmetic(name)
    if not UA.CosmeticLibrary or not UA.CosmeticLibrary.Cosmetics or not name or not ua_isNotFinisher(name) then return false end
    local cosmetic = UA.CosmeticLibrary.Cosmetics[name]
    if not cosmetic then return false end
    if ua_isEmote(cosmetic.Type, name) then
        -- Emotes intentionally do not use the shared cosmetic ownership
        -- spoof. Another Unlock-All script may already own that hook.
        return false
    end
    return ua_weaponsEnabled()
end

local function ua_cloneTable(source)
    local out = {}
    if type(source) ~= "table" then return out end
    for key, value in pairs(source) do
        if type(value) == "table" then
            local nested = {}
            for nestedKey, nestedValue in pairs(value) do nested[nestedKey] = nestedValue end
            out[key] = nested
        else
            out[key] = value
        end
    end
    return out
end

local function ua_cloneCosmetic(name, cosmeticType, options)
    local base = UA.CosmeticLibrary and UA.CosmeticLibrary.Cosmetics and UA.CosmeticLibrary.Cosmetics[name]
    if not base then return nil end
    local data = {}
    for key, value in pairs(base) do data[key] = value end
    data.Name = name
    data.Type = data.Type or cosmeticType
    data.Seed = data.Seed or math.random(1, 1000000)
    if UA.EnumLibrary then
        local success, enumId = pcall(UA.EnumLibrary.ToEnum, UA.EnumLibrary, name)
        if success and enumId then data.Enum, data.ObjectID = enumId, data.ObjectID or enumId end
    end
    if options then
        if options.inverted ~= nil then data.Inverted = options.inverted end
        if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
    end
    return data
end

local function ua_rawData(key)
    if not UA.DataController or type(UA.originalDataGet) ~= "function" then return nil end
    local ok, value = pcall(UA.originalDataGet, UA.DataController, key)
    return ok and value or nil
end

local function ua_inventoryContains(inventory, name)
    if type(inventory) ~= "table" or type(name) ~= "string" or name == "" then return false end
    local direct = rawget(inventory, name)
    if direct ~= nil and direct ~= false and direct ~= 0 then return true end
    for key, value in pairs(inventory) do
        if tostring(key) == name and value ~= false and value ~= 0 then return true end
        if type(value) == "string" and value == name then return true end
        if type(value) == "table" and tostring(value.Name or value.name or "") == name then return true end
    end
    return false
end

local function ua_copyWeaponLoadout(source)
    local out = {}
    if type(source) ~= "table" then return out end
    for weapon, cosmetics in pairs(source) do
        if type(cosmetics) == "table" then
            local weaponOut = {}
            for cosmeticType, cosmeticData in pairs(cosmetics) do
                if type(cosmeticData) == "table" then
                    local name = tostring(cosmeticData.name or cosmeticData.Name or "")
                    if name ~= "" and ua_isNotFinisher(name) then
                        weaponOut[tostring(cosmeticType)] = {
                            name = name,
                            seed = tonumber(cosmeticData.seed or cosmeticData.Seed),
                            inverted = cosmeticData.inverted == true or cosmeticData.Inverted == true,
                            favoritesOnly = cosmeticData.favoritesOnly == true or cosmeticData.OnlyUseFavorites == true,
                        }
                    end
                end
            end
            if next(weaponOut) then out[tostring(weapon)] = weaponOut end
        end
    end
    return out
end

local function ua_copyEmoteLoadout(source)
    local out = {}
    if type(source) ~= "table" then return out end
    for slot, entry in pairs(source) do
        if type(entry) == "table" then
            local cosmeticName = tostring(entry.cosmeticName or entry.name or "")
            local cosmeticType = tostring(entry.cosmeticType or entry.type or "")
            if cosmeticName ~= "" and cosmeticType ~= "" and ua_isNotFinisher(cosmeticName) then
                out[tostring(slot)] = {
                    weaponName = tostring(entry.weaponName or entry.slot or ""),
                    cosmeticType = cosmeticType,
                    cosmeticName = cosmeticName,
                    isInverted = entry.isInverted == true,
                    onlyUseFavorites = entry.onlyUseFavorites == true,
                }
            end
        end
    end
    return out
end

local function ua_materializeWeaponLoadout()
    if not UA.CosmeticLibrary then return false end
    UA.weaponEquipped = {}
    for weapon, cosmetics in pairs(UA.weaponLoadout) do
        local runtime = {}
        for cosmeticType, cosmeticData in pairs(cosmetics) do
            local cloned = ua_cloneCosmetic(cosmeticData.name, cosmeticType, {
                inverted = cosmeticData.inverted,
                favoritesOnly = cosmeticData.favoritesOnly,
            })
            if cloned then
                if cosmeticData.seed then cloned.Seed = cosmeticData.seed end
                runtime[cosmeticType] = cloned
            end
        end
        if next(runtime) then UA.weaponEquipped[weapon] = runtime end
    end
    return true
end

local function ua_materializeEmoteLoadout()
    if not UA.CosmeticLibrary then return false end
    UA.emoteEquipped = {}
    for _, entry in pairs(UA.emoteLoadout) do
        if type(entry) == "table" then
            local weaponName = tostring(entry.weaponName or "")
            local cosmeticType = tostring(entry.cosmeticType or "")
            local cosmeticName = tostring(entry.cosmeticName or "")
            if weaponName ~= ""
                and cosmeticType ~= ""
                and cosmeticName ~= ""
                and ua_isNotFinisher(cosmeticName)
                and ua_isEmote(cosmeticType, cosmeticName) then
                local cloned = ua_cloneCosmetic(cosmeticName, cosmeticType, {
                    inverted = entry.isInverted == true,
                    favoritesOnly = entry.onlyUseFavorites == true,
                })
                if cloned then
                    UA.emoteEquipped[weaponName] = UA.emoteEquipped[weaponName] or {}
                    UA.emoteEquipped[weaponName][cosmeticType] = cloned
                end
            end
        end
    end
    ua_environment().__DevKageEmoteEquipped = UA.emoteEquipped
    return true
end

function UA.ExportWeaponLoadout()
