            if type(gray) ~= "number" then
                local color = object.BackgroundColor3
                local maxv = math.max(color.R, color.G, color.B)
                local minv = math.min(color.R, color.G, color.B)
                if (maxv - minv) <= 0.012 and maxv <= 0.42 then
                    gray = (color.R + color.G + color.B) / 3
                    pcall(function() object:SetAttribute("DevKageThemeBaseGray", gray) end)
                end
            end
            if type(gray) == "number" then
                pcall(function() object.BackgroundColor3 = self:ThemeColorFromGray(gray) end)
            end
        end
    end
end

function library:ObserveThemeRoot(root)
    if not root or root.Parent == nil or self.ThemeObservedRoots[root] then return end
    self.ThemeObservedRoots[root] = true
    if utility.CreateConnection then
        utility:CreateConnection(root.DescendantAdded, function(object)
            task.defer(function()
                if object and object.Parent then self:ApplyThemeObject(object) end
            end)
        end)
    end
end

function library:ApplyTheme()
    for index = #self.ThemeUIObjects, 1, -1 do
        local entry = self.ThemeUIObjects[index]
        local object = entry and entry.Object
        if not object or object.Parent == nil then
            table.remove(self.ThemeUIObjects, index)
        else
            pcall(function()
                object.BackgroundColor3 = self:ThemeColorFromGray(entry.Gray)
            end)
        end
    end

    for index = #self.ThemeToggleControls, 1, -1 do
        local control = self.ThemeToggleControls[index]
        local frame = control and control.ThemeToggleFrame
        if not frame or frame.Parent == nil then
            table.remove(self.ThemeToggleControls, index)
        else
            pcall(function()
                frame.BackgroundColor3 = control.State and self.Theme.Toggle or Color3.fromRGB(77, 77, 77)
            end)
        end
    end

    for index = #self.ThemeSliderFrames, 1, -1 do
        local frame = self.ThemeSliderFrames[index]
        if not frame or frame.Parent == nil then
            table.remove(self.ThemeSliderFrames, index)
        else
            pcall(function() frame.BackgroundColor3 = self.Theme.Slider end)
        end
    end

    for index = #self.ThemeTopBars, 1, -1 do
        local bar = self.ThemeTopBars[index]
        if not bar or bar.Parent == nil then
            table.remove(self.ThemeTopBars, index)
        else
            pcall(function()
                bar.ImageColor3 = self.Theme.TopBar
                bar.ImageTransparency = math.clamp(tonumber(self.Theme.TopBarTransparency) or 0, 0, 1)
            end)
        end
    end

    local function applyRoot(root)
        if not root or root.Parent == nil then return end
        self:ObserveThemeRoot(root)
        self:ApplyThemeObject(root)
        for _, object in ipairs(root:GetDescendants()) do
            self:ApplyThemeObject(object)
        end
    end

    applyRoot(self.ThemeRoot)
    if self.KeybindManager then applyRoot(self.KeybindManager.Overlay) end
end

function library:SetThemeColor(kind, color)
    if typeof(color) ~= "Color3" then return false end
    if kind ~= "UI" and kind ~= "Toggle" and kind ~= "Slider" and kind ~= "Text" and kind ~= "TopBar" then return false end
    self.Theme[kind] = color
    self:ApplyTheme()
    return true
end


function utility:RenderObject(RenderType, RenderProperties, RenderHidden)
    if (__devkageStartupRenderBudget or 0) > 0 then
        __devkageStartupRenderCount = __devkageStartupRenderCount + 1
        if (__devkageStartupRenderCount % __devkageStartupRenderBudget) == 0 then
            task.wait()
        end
    end
    local Render = Instance.new(RenderType)
    if RenderProperties and typeof(RenderProperties) == "table" then
        for Property, Value in pairs(RenderProperties) do
            if Property ~= "RenderTime" and Property ~= "ThemeRole" and Property ~= "ThemeIgnore" then
                Render[Property] = Value
            end
        end
    end
    library.Renders[#library.Renders + 1] = {
        Render,
        RenderProperties,
        RenderHidden,
        RenderProperties["RenderTime"] or nil
    }
    if utility.RegisterThemeObject then
        utility:RegisterThemeObject(Render, RenderProperties)
    end
    return Render
end

function utility:CreateConnection(ConnectionType, ConnectionCallback)
    local Connection = ConnectionType:Connect(ConnectionCallback)
    library.Connections[#library.Connections + 1] = Connection
    return Connection
end

function utility:GetProperty(Properties, Names, Fallback)
    for _, Name in ipairs(Names) do
        if Properties[Name] ~= nil then
            return Properties[Name]
        end
    end
    return Fallback
end

function utility:SafeCallback(Callback, ...)
    local Args = table.pack(...)
    local Success, Result = xpcall(function()
        return Callback(table.unpack(Args, 1, Args.n))
    end, function(Error)
        return debug and debug.traceback and debug.traceback(tostring(Error), 2) or tostring(Error)
    end)
    if not Success then
        warn("[DevKage UI] Control callback failed:\n" .. tostring(Result))
    end
    return Success, Result
end

function utility:RegisterControl(Content, Properties)
    local Flag = utility:GetProperty(Properties, {"flag", "Flag", "id", "Id", "idx", "Idx"}, nil)
    Content.Flag = Flag
    if Flag ~= nil and tostring(Flag) ~= "" then
        library.Controls[tostring(Flag)] = Content
    end
    return Content
end

function utility:MouseLocation()
    return uis:GetMouseLocation()
end

function utility:Serialise(Table)
    local Serialised = ""
    for Index, Value in pairs(Table) do
        Serialised = Serialised .. Value .. ", "
    end
    return Serialised:sub(0, #Serialised - 2)
end

function utility:Sort(Table1, Table2)
    local Table3 = {}
    for Index, Value in pairs(Table2) do
        if table.find(Table1, Index) then
            Table3[#Table3 + 1] = Value
        end
    end
    return Table3
end


