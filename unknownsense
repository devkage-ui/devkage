        end)

        Content:Set(Content.State, true)
        if library.KeybindManager then library.KeybindManager:Register(Content, Properties) end
    end
    return utility:RegisterControl(Content, Properties)
end

function sections:CreateSlider(Properties)
    Properties = Properties or {}
    local Minimum = tonumber(utility:GetProperty(Properties, {"min", "Min", "minimum", "Minimum"}, 0)) or 0
    local Maximum = tonumber(utility:GetProperty(Properties, {"max", "Max", "maximum", "Maximum"}, 100)) or 100
    if Maximum < Minimum then Minimum, Maximum = Maximum, Minimum end
    local DecimalPlaces = math.max(0, math.floor(tonumber(utility:GetProperty(Properties, {"decimals", "Decimals"}, 0)) or 0))
    local ExplicitStep = tonumber(utility:GetProperty(Properties, {"step", "Step", "tick", "Tick"}, nil))
    local Step = ExplicitStep and math.abs(ExplicitStep) or (10 ^ -DecimalPlaces)
    if Step == 0 or Step ~= Step or Step == math.huge then Step = 1 end
    local Content = {
        Name     = (Properties.name or Properties.Name or Properties.title or Properties.Title or nil),
        State    = tonumber(utility:GetProperty(Properties, {"state", "State", "def", "Def", "default", "Default"}, Minimum)) or Minimum,
        Min      = Minimum,
        Max      = Maximum,
        Ending   = (Properties.ending or Properties.Ending or Properties.suffix or Properties.Suffix or ""),
        Decimals = DecimalPlaces,
        Step     = Step,
