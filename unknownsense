    local function findFirstBasePart(object)
        if not object then return nil end
        if object:IsA("BasePart") then return object end
        if object:IsA("Accessory") then
            local handle = object:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then return handle end
        end
        return object:FindFirstChildWhichIsA("BasePart",true)
    end

    local function catalogHandle(assetIds)
        for _,assetId in ipairs(assetIds) do
            local cached = state.assetCache[assetId]
            if cached and cached.Parent == nil then
                return cached:Clone(),assetId
            end

            local objects
            local ok,result = pcall(function()
                return game:GetObjects("rbxassetid://" .. tostring(assetId))
            end)
            if ok and type(result)=="table" then objects=result end

            if (not objects or #objects==0) and type(GetObjects)=="function" then
                local okGlobal,resultGlobal = pcall(GetObjects,"rbxassetid://" .. tostring(assetId))
                if okGlobal and type(resultGlobal)=="table" then objects=resultGlobal end
            end

            if objects and #objects>0 then
                for _,object in ipairs(objects) do
                    local handle = findFirstBasePart(object)
                    if handle then
                        local template = handle:Clone()
                        template.Parent = nil
                        state.assetCache[assetId] = template
                        for _,loaded in ipairs(objects) do safeDestroy(loaded) end
                        return template:Clone(),assetId
                    end
                end
                for _,loaded in ipairs(objects) do safeDestroy(loaded) end
            end
        end
        return nil,nil
    end

    local function stripVisualTextures(part)
        if not part then return end
        pcall(function()
            if part:IsA("MeshPart") then part.TextureID="" end
        end)
        for _,desc in ipairs(part:GetDescendants()) do
            if desc:IsA("SurfaceAppearance") or desc:IsA("Texture") or desc:IsA("Decal") then
                safeDestroy(desc)
            elseif desc:IsA("SpecialMesh") then
                pcall(function() desc.TextureId="" end)
            end
        end
    end

    local function scaleCatalogPart(part,scale)
        if not part or not part:IsA("BasePart") then return end
        local factor = math.max(0.2,tonumber(scale) or 1)
        pcall(function() part.Size=part.Size*factor]==================],
    [==================[ end)
        for _,desc in ipairs(part:GetDescendants()) do
            if desc:IsA("Attachment") then
                desc.Position=desc.Position*factor
            elseif desc:IsA("SpecialMesh") then
                desc.Scale=desc.Scale*factor
            end
        end
    end

    local function prepareCatalogPart(part,name,color,scale,preserveTexture)
        part.Name=name
        part.Anchored=false
        part.CanCollide=false
        part.CanTouch=false
        part.CanQuery=false
        part.CastShadow=false
        part.Massless=true
        if preserveTexture ~= true then
            stripVisualTextures(part)
        end
        scaleCatalogPart(part,scale)
        part.Color=color
        part.Material=featherMaterial()
        part.Transparency=transparency()
        part.Parent=state.model
        remember(part)
        return part
    end

    local function attachmentByNames(part,names)
        for _,name in ipairs(names) do
            local attachment=part:FindFirstChild(name,true)
            if attachment and attachment:IsA("Attachment") then return attachment end
        end
        return part:FindFirstChildWhichIsA("Attachment",true)
    end

    local function fallbackWingSide(torso,side,profile,scale)
        local sideName=side<0 and "L" or "R"
        local rootBone=makeInvisibleBone("WingRoot_"..sideName,state.model)
        local rootMotor=makeMotor(
            "WingRootMotor_"..sideName,
            torso,
            rootBone,
            CFrame.new(side*0.42*scale,0.38*scale,0.72*scale)
        )
        state.wingRigs[#state.wingRigs+1]={
            Side=side,RootMotor=rootMotor,OuterMotor=nil,Fallback=true
        }

        local total=profile.primary+profile.secondary+profile.covert
        local index=0
        local function featherLayer(count,startX,endX,startY,endY,startZ,endZ,width,lengthMin,lengthMax,layer)
            for i=1,count do
                index=index+1
                local t=(i-1)/math.max(count-1,1)
                local base=Vector3.new(side*0.12*scale,(0.28-t*0.22)*scale,0)
                local tip=Vector3.new(
                    side*(startX+(endX-startX)*t)*scale,
                    (startY+(endY-startY)*t)*scale,
                    (startZ+(endZ-startZ)*t)*scale
                )
                local delta=tip-base
                local length=math.max(delta.Magnitude,(lengthMin+(lengthMax-lengthMin)*t)*scale)
                local middle=(base+tip)*0.5
                local cf=CFrame.lookAt(middle,tip)
                makeFeather(
                    rootBone,cf,
                    width*scale,length,0.095*scale,
                    layer,i,layer=="Primary" and i>=count-1
                )
            end
        end

        featherLayer(profile.primary,1.5,4.2,1.15,-1.8,0.9,2.4,0.48,2.5,4.7,"Primary")
        featherLayer(profile.secondary,0.9,3.15,1.25,-0.65,0.72,1.75,0.58,1.8,3.25,"Secondary")
        featherLayer(profile.covert,0.45,2.2,1.05,0.15,0.58,1.2,0.66,1.1,2.0,"Covert")

        addLight(rootBone,primaryColor(),side<0 and 1 or 2,0.72)
        addEmitter(rootBone,side<0 and 1 or 2,0.65)
    end

    local function createWings(character,torso)
        local scale=modSize()
        -- Classic White Angel Wings is a real back-accessory mesh. Additional
        -- IDs are fallbacks if Roblox asset delivery changes.
        local handle=select(1,catalogHandle({4461505493,7241300525,15504166811}))
        if handle then
            prepareCatalogPart(handle,"HighQualityAngelWings",primaryColor(),scale,true)

            local handleAttachment=attachmentByNames(handle,{
                "BodyBackAttachment","WaistBackAttachment","BackAttachment"
            })
            local torsoAttachment=attachmentByNames(torso,{
                "BodyBackAttachment","WaistBackAttachment","BackAttachment"
            })

            local motor=makeMotor(
                "HighQualityWingMotor",
                torso,
                handle,
                torsoAttachment and torsoAttachment.CFrame
                    or CFrame.new(0,0.28*scale,0.72*scale)
            )
            motor.C1=handleAttachment and handleAttachment.CFrame or CFrame.new()

            state.wingRigs[#state.wingRigs+1]={
                Pair=true,Side=0,RootMotor=motor,OuterMotor=nil
            }
            state.feathers[#state.feathers+1]={
                Part=handle,Layer="CatalogWing",Index=1,Tip=false
            }

            local highlight=Instance.new("Highlight")
            highlight.Name="DevKage_WingSoftGlow"
            highlight.Adornee=handle
            highlight.DepthMode=Enum.HighlightDepthMode.Occluded
            highlight.FillColor=primaryColor()
            highlight.FillTransparency=0.84
            highlight.OutlineTransparency=1
            highlight.Parent=state.model
            remember(highlight)
            state.wingHighlights[#state.wingHighlights+1]=highlight

            addLight(handle,primaryColor(),1,0.82)
            addEmitter(handle,1,0.72)
            return
        end

        -- Offline/asset-delivery fallback: correctly back-facing symmetric fan.
        local profile=qualityProfile()
        fallbackWingSide(torso,-1,profile,scale)
        fallbackWingSide(torso,1,profile,scale)
    end

    local function footOffset(root,humanoid)
        local hip=humanoid and tonumber(humanoid.HipHeight) or nil
        if hip and hip>0 then return -(hip+root.Size.Y*0.5+0.12) end
        return -2.72
    end

    local function makeHaloSurface(plate,face,ringIndex)
        local gui=Instance.new("SurfaceGui")
        gui.Name="DevKage_HaloSurface_"..face.Name
        gui.Face=face
        gui.AlwaysOnTop=true
        gui.LightInfluence=0
        gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud=180
        gui.ClipsDescendants=false
        gui.Parent=plate
        remember(gui)

        local glowFrame=Instance.new("Frame")
        glowFrame.Name="GlowRing"
        glowFrame.AnchorPoint=Vector2.new(0.5,0.5)
        glowFrame.Position=UDim2.fromScale(0.5,0.5)
        glowFrame.Size=UDim2.fromScale(0.80,0.80)
        glowFrame.BackgroundTransparency=1
        glowFrame.ZIndex=1
        glowFrame.Parent=gui
        remember(glowFrame)

        local glowCorner=Instance.new("UICorner")
        glowCorner.CornerRadius=UDim.new(1,0)
        glowCorner.Parent=glowFrame
        remember(glowCorner)

        local glowStroke=Instance.new("UIStroke")
        glowStroke.Name="HaloGlow"
        glowStroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
        glowStroke.LineJoinMode=Enum.LineJoinMode.Round
        glowStroke.Color=ringIndex==2 and secondaryColor() or primaryColor()
        glowStroke.Thickness=26
        glowStroke.Transparency=0.68
        glowStroke.Parent=glowFrame
        remember(glowStroke)

        local coreFrame=Instance.new("Frame")
        coreFrame.Name="CoreRing"
        coreFrame.AnchorPoint=Vector2.new(0.5,0.5)
        coreFrame.Position=UDim2.fromScale(0.5,0.5)
        coreFrame.Size=UDim2.fromScale(0.80,0.80)
        coreFrame.BackgroundTransparency=1
        coreFrame.ZIndex=2
        coreFrame.Parent=gui
        remember(coreFrame)

        local coreCorner=Instance.new("UICorner")
        coreCorner.CornerRadius=UDim.new(1,0)
        coreCorner.Parent=coreFrame
        remember(coreCorner)

        local coreStroke=Instance.new("UIStroke")
        coreStroke.Name="HaloCore"
        coreStroke.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
        coreStroke.LineJoinMode=Enum.LineJoinMode.Round
        coreStroke.Color=ringIndex==2 and secondaryColor() or primaryColor()
        coreStroke.Thickness=9
        coreStroke.Transparency=transparency()
        coreStroke.Parent=coreFrame
        remember(coreStroke)

        state.haloSurfaces[#state.haloSurfaces+1]={
            Gui=gui,
            Core=coreStroke,
            Glow=glowStroke,
            Ring=ringIndex,
        }
    end

    local function createHaloRig(attachmentPart,kind,yOffset,ringIndex,sizeMultiplier)
        local scale=modSize()*(sizeMultiplier or 1)
        local radius=(kind=="Head" and 1.48 or 1.82)*scale
        local diameter=radius*2.45

        -- A transparent physical plate carries two high-DPI SurfaceGuis.
        -- UICorner + UIStroke produces a mathematically perfect full circle,
        -- with no visible segment seams and no catalog mesh orientation issues.
        local plate=Instance.new("Part")
        plate.Name=kind=="Head" and "HighQualityHeadHalo" or "HighQualityFeetHalo"
        plate.Size=Vector3.new(diameter,0.035,diameter)
        plate.Transparency=1
        plate.Anchored=false
        plate.CanCollide=false
        plate.CanTouch=false
        plate.CanQuery=false
        plate.CastShadow=false
        plate.Massless=true
        plate.Parent=state.model
        remember(plate)

        local motor=makeMotor(
            kind.."_PerfectHaloMotor",
            attachmentPart,
            plate,
            CFrame.new(0,yOffset,0)
        )

        makeHaloSurface(plate,Enum.NormalId.Top,ringIndex)
        makeHaloSurface(plate,Enum.NormalId.Bottom,ringIndex)

        addLight(
            plate,
            ringIndex==2 and secondaryColor() or primaryColor(),
            ringIndex+10,
            0.92
        )
        addEmitter(plate,ringIndex+10,0.35)

        state.haloRigs[#state.haloRigs+1]={
            Kind=kind,Anchor=plate,Motor=motor,Ring=ringIndex,Surface=true
        }
    end

    local function createHeadHalo(head)
        createHaloRig(
            head,
            "Head",
            head.Size.Y*0.5+0.72*modSize(),
            1,
            1
        )
    end

    local function createFeetHalo(root,humanoid)
        createHaloRig(
