                        or (UA.dataGetWrapper and UA.DataController.Get ~= UA.dataGetWrapper)
                        or (UA.weaponDataWrapper and UA.DataController.GetWeaponData ~= UA.weaponDataWrapper)
                end
                if UA.EmoteController and UA.getEmotesWrapper then
