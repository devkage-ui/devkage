function StreamerHUDRuntime:ApplyLayout()
if not self.Root then return end
local config=getgenv().__DevKageConfig
local position=tostring(config.streamerHudPosition or "Top Bar")
local scale=math.clamp(tonumber(config.streamerHudScale) or 1,0.75,1.5)
local isBar=position=="Top Bar" or position=="Bottom Bar"
local widthMode=tostring(config.streamerHudWidthMode or "Full Width")
local width=math.floor(math.clamp(tonumber(config.streamerHudWidth) or 660,260,1800)*scale+0.5)
local height=math.floor(math.clamp(tonumber(config.streamerHudHeight) or 26,18,64)*scale+0.5)
local offsetX=math.floor(math.clamp(tonumber(config.streamerHudOffsetX) or 0,-1200,1200)+0.5)
local offsetY=math.floor(math.clamp(tonumber(config.streamerHudOffsetY) or 8,-500,500)+0.5)
local fullWidth=isBar and widthMode=="Full Width"
if fullWidth then self.Root.Size=UDim2.new(1,0,0,height) else self.Root.Size=UDim2.fromOffset(width,height) end
if position=="Bottom Bar" then
self.Root.AnchorPoint=Vector2.new(0.5,1); self.Root.Position=UDim2.new(0.5,offsetX,1,-offsetY)
elseif position=="Top Center" then
self.Root.AnchorPoint=Vector2.new(0.5,0); self.Root.Position=UDim2.new(0.5,offsetX,0,offsetY)
elseif position=="Bottom Center" then
self.Root.AnchorPoint=Vector2.new(0.5,1); self.Root.Position=UDim2.new(0.5,offsetX,1,-offsetY)
elseif position=="Top Right" then
self.Root.AnchorPoint=Vector2.new(1,0); self.Root.Position=UDim2.new(1,-12+offsetX,0,offsetY)
elseif position=="Bottom Right" then
self.Root.AnchorPoint=Vector2.new(1,1); self.Root.Position=UDim2.new(1,-12+offsetX,1,-offsetY)
else
self.Root.AnchorPoint=Vector2.new(0.5,0); self.Root.Position=UDim2.new(0.5,offsetX,0,offsetY)
end
local padding=math.floor(math.clamp(tonumber(config.streamerHudPadding) or 14,0,80)*scale+0.5)
local alignment=tostring(config.streamerHudTextAlignment or "Left")
if alignment=="Auto" then alignment=fullWidth and "Left" or "Center" end
self.Text.Font=Enum.Font.Code
self.Text.TextSize=math.floor(math.clamp(tonumber(config.streamerHudTextSize) or 11,8,22)*scale+0.5)
self.Text.TextXAlignment=alignment=="Right" and Enum.TextXAlignment.Right or (alignment=="Left" and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center)
self.Text.Position=UDim2.fromOffset(padding,4)
self.Text.Size=UDim2.new(1,-padding*2,1,-6)
self.Corner.CornerRadius=fullWidth and UDim.new(0,0) or UDim.new(0,math.floor(math.clamp(tonumber(config.streamerHudCornerRadius) or 0,0,12)*scale+0.5))
end

function StreamerHUDRuntime:ApplyStyle()
if not self.Root then return end
local config=getgenv().__DevKageConfig
local style=tostring(config.streamerHudStyle or "Reference")
local alpha=math.clamp(tonumber(config.streamerHudBackgroundAlpha) or 0.03,0,0.9)
local themeUI=(library.Theme and library.Theme.UI) or Color3.fromRGB(23,23,23)
local themeText=(library.Theme and library.Theme.Text) or Color3.fromRGB(205,205,205)




self.Root.BackgroundColor3=themeUI
self.Root.BackgroundTransparency=style=="Minimal" and math.max(alpha,0.46) or (style=="Glass" and math.max(alpha,0.18) or alpha)
self.Root.BorderColor3=Color3.fromRGB(5,5,5)
self.Root.BorderSizePixel=style=="Minimal" and 0 or 1

local lineThickness=math.floor(math.clamp(tonumber(config.streamerHudLineThickness) or 2,1,6)+0.5)
if self.TopLineHolder then
self.TopLineHolder.Visible=style~="Minimal"
self.TopLineHolder.Size=UDim2.new(1,0,0,math.max(4,lineThickness+2))
end
if self.TopLine then
self.TopLine.ImageColor3=(library.Theme and library.Theme.TopBar) or Color3.fromRGB(255,255,255)
self.TopLine.ImageTransparency=math.clamp(tonumber(library.Theme and library.Theme.TopBarTransparency) or 0,0,1)
end

self.Stroke.Color=Color3.fromRGB(47,47,47)
self.Stroke.Transparency=style=="Broadcast" and 0.35 or 1
self.Stroke.Thickness=math.clamp(tonumber(config.streamerHudStrokeThickness) or 1,0.5,3)
self.Text.Font=Enum.Font.Code
self.Text.TextColor3=themeText
self.Text.TextStrokeTransparency=1
end

function StreamerHUDRuntime:UpdateText()
if not self.Text then return end
local config=getgenv().__DevKageConfig
local accent=(library.Theme and library.Theme.Toggle) or Color3.fromRGB(175,205,75)
local textColor=(library.Theme and library.Theme.Text) or Color3.fromRGB(205,205,205)
local pieces={string.format('<font color="%s">%s</font>',streamerHex(accent),streamerRichEscape(]==================],
    [==================[config.streamerHudLabel or "DevSense"))}
if config.streamerHudShowMode~=false then pieces[#pieces+1]=streamerRichEscape(config.streamerHudModeText or "Matchmaking") end
if config.streamerHudShowFPS~=false then pieces[#pieces+1]=string.format("%dfps",math.floor((tonumber(self.FPS) or 60)+0.5)) end
if config.streamerHudShowPing~=false then pieces[#pieces+1]=string.format("%dms",math.floor((tonumber(self.Ping) or 0)+0.5)) end
if config.streamerHudShowClock~=false then pieces[#pieces+1]=os.date("%H:%M:%S") end
self.Text.TextColor3=textColor
self.Text.Text=table.concat(pieces,' <font color="#787A82">|</font> ')
end

function StreamerHUDRuntime:RefreshConfig()
local enabled=getgenv().__DevKageConfig.streamerHudEnabled==true
if not enabled then if self.Gui then self.Gui.Enabled=false end; return end
if not self:Ensure() then return end
self.Gui.Enabled=true
self:ApplyLayout(); self:ApplyStyle(); self:UpdateText()
end

function StreamerHUDRuntime:Destroy()
if self.Connection then pcall(function() self.Connection:Disconnect() end); self.Connection=nil end
self:DestroyGui()
end

