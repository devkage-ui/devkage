function WorldMarkerRuntime:Refresh()
if self.Scanning then return end
self.Scanning=true
self.Token=self.Token+1
local token=self.Token
task.spawn(function()
local seen=setmetatable({}, {__mode="k"})
local count=0
if VisualsState.world_object_esp then
local descendants=workspace:GetDescendants()
for index,object in ipairs(descendants) do
if token~=self.Token or not VisualsState.world_object_esp then break end
local kind=worldMarkerKind(object)
if kind then
local anchor=worldMarkerAnchor(object)
if anchor then
local localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
local distance=localRoot and (anchor.Position-localRoot.Position).Magnitude or math.huge
if distance<=math.max(50,tonumber(VisualsState.world_object_esp_max_distance) or 1200) then
seen[object]=true
self:Create(object,kind)
count=count+1
if count>=180 then break end
end
end
end
if index%500==0 then task.wait() end
end
end
for object in pairs(self.Markers) do
if not seen[object] or not object.Parent then self:Remove(object) end
end
self.Scanning=false
end)
end

function WorldMarkerRuntime:Update(dt)
self.Elapsed=self.Elapsed+(tonumber(dt) or 0)
local interval=math.clamp(tonumber(VisualsState.world_object_esp_scan_rate) or 1.5,0.25,5)
if self.Elapsed<interval then return end
self.Elapsed=0
if not VisualsState.world_object_esp then
for object in pairs(self.Markers) do self:Remove(object) end
return
end
self:Refresh()
local localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
for object,marker in pairs(self.Markers) do
if not object.Parent or not marker.Anchor or not marker.Anchor.Parent then
self:Remove(object)
else
local color=worldMarkerColor(marker.Kind)
local distance=localRoot and (marker.Anchor.Position-localRoot.Position).Magnitude or 0
marker.Gui.Enabled=VisualsState.world_object_esp_labels==true and distance<=math.max(50,tonumber(VisualsState.world_object_esp_max_distance) or 1200)
marker.Gui.MaxDistance=math.max(50,tonumber(VisualsState.world_object_esp_max_distance) or 1200)
