            local color = Color3.fromHSV(hue,sat,val)
            Content.State = color
            Holder_Outline_Frame.BackgroundColor3 = color
            Holder_Outline_Frame.BackgroundTransparency = Content.Alpha
            SV.BackgroundColor3 = Color3.fromHSV(hue,1,1)
