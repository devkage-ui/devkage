(function()
local SharedSpoofConfig = (type(getgenv) == "function" and getgenv().__DevKageConfig) or {}
local ProfileStatsRuntime = {
    Observed = setmetatable({}, {__mode = "k"}),
    Muting = setmetatable({}, {__mode = "k"}),
    Connections = {},
}

local function profileContext(object)
    local current = object
    for _ = 1, 7 do
        current = current and current.Parent
        if not current then break end
        local n = tostring(current.Name or ""):lower()
        if n:find("profile", 1, true) or n:find("playercard", 1, true)
            or n:find("career", 1, true) or n:find("statistics", 1, true)
            or n == "stats" or n:find("overview", 1, true) then
            return true
        end
    end
    return false
end

local function replaceProfileNumber(text, value)
    text = tostring(text or "")
    local replaced, count = text:gsub("%-?%d[%d,]*", tostring(value), 1)
    if count == 0 then return text end
    return replaced
end

local function patchProfileStatLabel(object)
    if not SpooferState.running then return end
    if not object or not object.Parent or ProfileStatsRuntime.Muting[object] then return end
    if window and window.ScreenGui and object:IsDescendantOf(window.ScreenGui) then return end
    if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end

    local name = tostring(object.Name or ""):lower()
    local text = tostring(object.Text or "")
    local lower = text:lower()
    local inProfile = profileContext(object)
    if not inProfile then return end

    local isStreak = name:find("streak", 1, true) or lower:find("streak", 1, true)
    local isElo = name:find("elo", 1, true) or name:find("rating", 1, true)
        or lower:find("elo", 1, true) or lower:find("rating", 1, true)
    local isLevel = name == "level" or name == "lvl" or name:find("level", 1, true)
        or lower:find("level", 1, true) or lower:match("^lvl[%s:]*%d")
    local isWins = not isStreak and (name == "wins" or name:find("wins", 1, true) or lower:find("wins", 1, true))

    local numericOnly = lower:match("^%s*%-?[%d,]+%s*$") ~= nil
    if numericOnly and not isLevel and not isWins and not isStreak and not isElo then
        local parent = object.Parent
        if parent then
            for _, sibling in ipairs(parent:GetChildren()) do
                if sibling ~= object and (sibling:IsA("TextLabel") or sibling:IsA("TextButton") or sibling:IsA("TextBox")) then
                    local context = (tostring(sibling.Name or "") .. " " .. tostring(sibling.Text or "")):lower()
                    if context:find("level", 1, true) or context:find("lvl", 1, true) then
                        isLevel = true
                        break
                    elseif context:find("streak", 1, true) then
                        isStreak = true
                        break
                    elseif context:find("elo", 1, true) or context:find("rating", 1, true) then
                        isElo = true
                        break
                    elseif context:find("wins", 1, true) then
                        isWins = true
                        break
                    end
                end
            end
        end
    end

    local value
    if isLevel then
        value = tonumber(SharedSpoofConfig.level) or 1
    elseif isWins then
        value = tonumber(SharedSpoofConfig.wins) or 0
    elseif isStreak then
        value = tonumber(SharedSpoofConfig.streak) or 0
    elseif isElo then
        value = tonumber(SharedSpoofConfig.elo) or 0
    else
        return
    end

    local desired = replaceProfileNumber(text, value)
    if desired ~= text then
        ProfileStatsRuntime.Muting[object] = true
        pcall(function() object.Text = desired end)
        ProfileStatsRuntime.Muting[object] = nil
    end
end

local function observeProfileStatLabel(object)
    if not object or ProfileStatsRuntime.Observed[object] then return end
    if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return end
    ProfileStatsRuntime.Observed[object] = true
    patchProfileStatLabel(object)
    ProfileStatsRuntime.Connections[#ProfileStatsRuntime.Connections + 1] = object:GetPropertyChangedSignal("Text"):Connect(function()
        task.defer(patchProfileStatLabel, object)
    end)
end

local function ensureProfileStatsObserver()
    if ProfileStatsRuntime.Started then return end
    ProfileStatsRuntime.Started = true
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then ProfileStatsRuntime.Started = false; return end

    local function attachMainGui(mainGui)
        if not mainGui or mainGui.Name ~= "MainGui" then return end
        ProfileStatsRuntime.Connections[#ProfileStatsRuntime.Connections + 1] = mainGui.DescendantAdded:Connect(function(object)
            task.defer(observeProfileStatLabel, object)
        end)
        task.spawn(function()
            local descendants = mainGui:GetDescendants()
            for index, object in ipairs(descendants) do
                observeProfileStatLabel(object)
                if index % 160 == 0 then task.wait() end
            end
        end)
    end

    local mainGui = playerGui:FindFirstChild("MainGui")
    if mainGui then
        attachMainGui(mainGui)
    else
        ProfileStatsRuntime.Connections[#ProfileStatsRuntime.Connections + 1] = playerGui.ChildAdded:Connect(function(child)
            if child.Name == "MainGui" then attachMainGui(child) end
        end)
    end
end

local function refreshProfileStatsUI()
    ensureProfileStatsObserver()
    local processed = 0
    for object in pairs(ProfileStatsRuntime.Observed) do
        if object and object.Parent then patchProfileStatLabel(object) end
        processed = processed + 1
        if processed % 120 == 0 then task.wait() end
    end
end

SpooferState.RefreshProfileStats = refreshProfileStatsUI
if SpooferState.running then task.defer(refreshProfileStatsUI) end
table.insert(library.CleanupCallbacks,function()
for _,connection in ipairs(ProfileStatsRuntime.Connections) do
pcall(function() connection:Disconnect() end)
end
table.clear(ProfileStatsRuntime.Connections)
end)
end)();

UI.VisualControls = VisualControls
UI.LightingControls = LightingControls
UI.rebuildESPObjects = rebuildESPObjects
end)();

(function()
library.AntiAimIconBase64 = library.AntiAimIconBase64 or [=[]=]

function utility:DecodeBase64(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    data = tostring(data or ""):gsub("[^" .. alphabet .. "=]", "")
    return (data:gsub(".", function(char)
        if char == "=" then return "" end
        local value = alphabet:find(char, 1, true)
        if not value then return "" end
        value = value - 1
        local bits = ""
        for shift = 5, 0, -1 do
            bits = bits .. (((value // (2 ^ shift)) % 2 == 1) and "1" or "0")
        end
        return bits
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(bits)
        if #bits ~= 8 then return "" end
        local value = 0
        for index = 1, 8 do
            if bits:sub(index, index) == "1" then
                value = value + (2 ^ (8 - index))
            end
        end
        return string.char(value)
    end))
end

function utility:ResolveAntiAimIcon()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local customAsset = (type(env.getcustomasset) == "function" and env.getcustomasset)
        or (type(env.getsynasset) == "function" and env.getsynasset)
        or (type(getcustomasset) == "function" and getcustomasset)
        or (type(getsynasset) == "function" and getsynasset)
    local writer = (type(env.writefile) == "function" and env.writefile)
        or (type(writefile) == "function" and writefile)
    local checker = (type(env.isfile) == "function" and env.isfile)
        or (type(isfile) == "function" and isfile)
    if type(customAsset) == "function" and type(writer) == "function" then
        local path = "devkage_anti_aim_icon.png"
        local exists = false
        if type(checker) == "function" then
            local ok, result = pcall(checker, path)
            exists = ok and result == true
        end
        if not exists then
            pcall(writer, path, utility:DecodeBase64(library.AntiAimIconBase64))
        end
        local ok, asset = pcall(customAsset, path)
        if ok and type(asset) == "string" and asset ~= "" then return asset end
    end
    return ""
end

