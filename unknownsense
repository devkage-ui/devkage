            BorderSizePixel = 0,
            Parent = Holder_Outline_Frame,
            Position = UDim2.new(1,-12,0.5,-3),
            Size = UDim2.new(0,7,0,6),
            Image = "rbxassetid://8532000591",
            ImageColor3 = Color3.fromRGB(255,255,255),
            ZIndex = 5
        })

