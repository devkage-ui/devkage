        })
        utility:RenderObject("TextLabel", {
            AnchorPoint=Vector2.new(0,0),BackgroundColor3=Color3.fromRGB(0,0,0),BackgroundTransparency=1,BorderColor3=Color3.fromRGB(0,0,0),BorderSizePixel=0,
            Parent=Content_Holder,Position=UDim2.new(0,41,0,0),Size=UDim2.new(1,-41,0,10),ZIndex=3,
            Font="Code",RichText=true,Text=Content.Name,TextColor3=Color3.fromRGB(205,205,205),TextSize=9,TextStrokeTransparency=1,TextXAlignment="Left"
        })
        utility:RenderObject("TextLabel", {
            AnchorPoint=Vector2.new(0,0),BackgroundColor3=Color3.fromRGB(0,0,0),BackgroundTransparency=1,BorderColor3=Color3.fromRGB(0,0,0),BorderSizePixel=0,
            Parent=Content_Holder,Position=UDim2.new(0,41,0,0),Size=UDim2.new(1,-41,0,10),ZIndex=3,
            Font="Code",RichText=true,Text=Content.Name,TextColor3=Color3.fromRGB(205,205,205),TextSize=9,TextStrokeTransparency=1,TextTransparency=1,TextXAlignment="Left"
        })
        local Content_Holder_Box = utility:RenderObject("Frame", {
            BackgroundColor3=Color3.fromRGB(12,12,12),BackgroundTransparency=0,BorderColor3=Color3.fromRGB(0,0,0),BorderSizePixel=0,
            Parent=Content_Holder,Position=UDim2.new(0,40,0,12),Size=UDim2.new(1,-98,0,16),ZIndex=3
        })
        local Box_Inner = utility:RenderObject("Frame", {
            BackgroundColor3=Color3.fromRGB(23,23,23),BackgroundTransparency=0,BorderColor3=Color3.fromRGB(0,0,0),BorderSizePixel=0,
            Parent=Content_Holder_Box,Position=UDim2.new(0,1,0,1),Size=UDim2.new(1,-2,1,-2),ZIndex=3
        })
        local Box_TextBox = utility:RenderObject("TextBox", {
            BackgroundColor3=Color3.fromRGB(0,0,0),BackgroundTransparency=1,BorderColor3=Color3.fromRGB(0,0,0),BorderSizePixel=0,
            Parent=Box_Inner,Position=UDim2.new(0,4,0,0),Size=UDim2.new(1,-8,1,0),ZIndex=4,
            Font="Code",PlaceholderColor3=Color3.fromRGB(155,155,155),PlaceholderText=Content.Placeholder,
            Text=Content.Value,TextColor3=Color3.fromRGB(255,255,255),TextSize=11,TextStrokeTransparency=1,TextXAlignment="Left"
        })

        function Content:Set(value, silent)
            value = tostring(value or "")
            if Content.DigitsOnly then value = value:gsub("%D", "") end
            if Content.Numeric and value ~= "" and not tonumber(value) then
                Content.Updating = true
                Box_TextBox.Text = Content.Value
                Content.Updating = false
                return false
            end
            if #value > Content.MaxLength then value=value:sub(1,Content.MaxLength) end
            Content.Value=value
            if Box_TextBox.Text ~= value then
                Content.Updating = true
                Box_TextBox.Text=value
                Content.Updating = false
            end
            if not silent then utility:SafeCallback(Content.Callback, Content.Value) end
            return true
        end
        function Content:Get() return Content.Value end

        Box_TextBox:GetPropertyChangedSignal("Text"):Connect(function()
            if Content.Updating then return end
            Content:Set(Box_TextBox.Text)
        end)
        Content:Set(Content.Value,true)
    end
    return utility:RegisterControl(Content, Properties)
end

