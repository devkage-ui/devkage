local function setColorCorrection(enabled,color,brightness,contrast,saturation)
clearSaturationStack()
if enabled then
local e=AdvancedLighting.colorCorrection or getOrCreateEffect("ColorCorrectionEffect","DevKage_ColorCorrection")
AdvancedLighting.colorCorrection=e
e.Enabled=true
e.TintColor=color
e.Brightness=math.clamp(brightness,-1,1)
e.Contrast=math.clamp(contrast,-1,1)
local remaining = math.clamp(tonumber(saturation) or 0,-5,5)
e.Saturation = math.clamp(remaining,-1,1)
remaining = remaining - e.Saturation
local index = 1
while math.abs(remaining) > 0.001 and index <= 4 do
local extra = Instance.new("ColorCorrectionEffect")
extra.Name = "DevKage_SaturationBoost" .. index
extra.Enabled = true
extra.Saturation = math.clamp(remaining,-1,1)
extra.Parent = LightingService
table.insert(SaturationStack,extra)
remaining = remaining - extra.Saturation
index = index + 1
end
elseif AdvancedLighting.colorCorrection then
AdvancedLighting.colorCorrection.Enabled=false
end
end
