            or humanoid.SeatPart or humanoid.Sit or state == stateTypes.Seated
            or state == stateTypes.Ragdoll or state == stateTypes.FallingDown
            or (humanoid.PlatformStand and not self.FlightActive) then
            self:Suspend()
            self:SetStatus("Movement: paused by character state")
            return
        end
        dt = finite(dt, 1 / 60, 0, 0.1)
        local cfg = self:Config()
        local camera = Workspace.CurrentCamera
        self:ApplyNoClip(request.NoClip)
        if request.Flight and camera then
            self:ApplyFlight(camera, cfg)
        else
            self:ReleaseFlight()
        end
        if self.FlightActive or request.Spin then
            self:ApplyOrientation(camera, request.Spin, cfg, dt)
        else
            self:ReleaseOrientation()
        end
        self:ApplySpeedAndAirStop(request, camera, cfg)
        if request.Flight and not camera then
            self:SetStatus("Movement: waiting for camera")
        elseif self:InputBlocked() then
            self:SetStatus("Movement: input paused while menu or chat is open")
        else
            self:SetStatus("Movement: active")
        end
    end

    function Movement:StepSafely(dt)
        if not self.Alive or os.clock() < self.RetryAt then return end
        local ok, err = pcall(self.Step, self, dt)
        if ok then
            self.LastError = nil
            return
        end
        -- Release partial constraints and property writes before a bounded retry.
        pcall(self.Suspend, self)
        self.RetryAt = os.clock() + 1
        local message = tostring(err)
        if self.LastError ~= message then warn("[DevKage Movement] " .. message) end
        self.LastError = message
        self:SetStatus("Movement: character API unavailable; retrying")
    end

    function Movement:Wrap(target, key, replacement)
        if type(target) ~= "table" or type(target[key]) ~= "function" then return end
        self.Wrappers[#self.Wrappers + 1] = {
            Target = target, Key = key, Original = target[key], Replacement = replacement,
        }
        target[key] = replacement
    end

    function Movement:Destroy()
        if not self.Alive then return end
        self.Alive = false
        disconnectAll(self.Connections)
        self:ReleaseCharacter()
        for index = #self.Wrappers, 1, -1 do
            local entry = self.Wrappers[index]
            if entry.Target[entry.Key] == entry.Replacement then
                entry.Target[entry.Key] = entry.Original
            end
        end
        table.clear(self.Wrappers)
