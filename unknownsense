        end
        if self.FlightActive then return end
        local direction = self:MoveVector(camera, false)
        if request.Speed then
            local speed = finite(cfg.knifeSpeedValue, 5, 1, 200)
            if cfg.knifeSpeedStyle == "Velocity" then
