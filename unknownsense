        end

        local function commitAlpha()
            Content.Alpha = math.clamp(tonumber(aBox.Text) or 0,0,100) / 100
            redraw(true)
            writeBoxes()
        end

        utility:CreateConnection(rBox.FocusLost,commitRGB)
        utility:CreateConnection(gBox.FocusLost,commitRGB)
        utility:CreateConnection(bBox.FocusLost,commitRGB)
        utility:CreateConnection(aBox.FocusLost,commitAlpha)

