        referenceResolveGuiHost()

    if not host then
        return false
    end

    local screenGui =
        Instance.new("ScreenGui")


    screenGui.Name = "AimSightGUI"

    screenGui.ResetOnSpawn = false




    screenGui.DisplayOrder = 2147483000

    screenGui.IgnoreGuiInset = true


    pcall(function() screenGui.OnTopOfCoreBlur = true end)
    pcall(function() screenGui.ClipToDeviceSafeArea = false end)

    screenGui.ZIndexBehavior =
        Enum.ZIndexBehavior.Global

    pcall(function()
        screenGui:SetAttribute(
            "DevKageCursorProtocol",
            runtime.Protocol
        )

        screenGui:SetAttribute(
            "DevKageCursorOwner",
            runtime.InstanceId
        )

        screenGui:SetAttribute(
            "DevKageMaskShardCompatibilityOnly",
            true
        )
    end)

    local parentOk =
        pcall(function()
            screenGui.Parent = host
        end)

