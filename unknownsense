local function vp3_clear()
    VP3.token = VP3.token + 1
    VP3.loading = false
    vp3D.CurrentCamera = nil
    for _, key in ipairs({"model","cam","world"}) do
        if VP3[key] then pcall(function() VP3[key]:Destroy() end); VP3[key] = nil end
    end
    VP3.rot = math.pi
