local function save_config_file(name, cfg)
name = tostring(name or ""):gsub("[^%w_%-]", "")
if name == "" then return false, "Enter a valid config name" end
if name:sub(1,1)=="_" then return false,"Config names cannot start with an underscore" end
local folderOk, folderError = ensure_folder()
if not folderOk then return false, folderError end
if type(writefile) ~= "function" then return false, "This executor does not provide file writing" end
local data = gather_state(cfg)
local encodedOk, encoded = pcall(function() return HttpService:JSONEncode(data) end)
if not encodedOk then return false, "Could not encode config: " .. tostring(encoded) end
local wrote, writeError = pcall(writefile, CONFIG_FOLDER .. "/" .. name .. ".json", encoded)
if not wrote then return false, "Could not save config: " .. tostring(writeError) end
pcall(UA.save)
return true
end

local function configColorFromTable(value, fallback)
if typeof(value) == "Color3" then return value end
if type(value) == "table" then
local r, g, b = tonumber(value[1]), tonumber(value[2]), tonumber(value[3])
if r and g and b then
return Color3.fromRGB(math.clamp(r,0,255), math.clamp(g,0,255), math.clamp(b,0,255))
end
end
return fallback
end

local function applyRuntimeState(target, source)
if type(source) ~= "table" then return end
for key, value in pairs(source) do
if target[key] ~= nil then
local targetType = typeof(target[key])
if targetType == "Color3" then
target[key] = configColorFromTable(value, target[key])
elseif targetType == "boolean" then
target[key] = value == true
elseif targetType == "number" then
target[key] = tonumber(value) or target[key]
elseif targetType == "string" then
target[key] = tostring(value)
end
end
end
end

local function read_config_data(name)
name = tostring(name or ""):gsub("[^%w_%-]", "")
if name == "" then return false, "Invalid config name" end
if name:sub(1,1)=="_" then return false,"Config names cannot start with an underscore" end

local folderOk, folderError = ensure_folder()
if not folderOk then return false, folderError end

local path = CONFIG_FOLDER .. "/" .. name .. ".json"
if type(readfile) ~= "function" then return false, "This executor does not provide file reading" end
if type(isfile)=="function" then
local existsOk, exists = pcall(isfile, path)
if existsOk and exists == false then return false, "Config not found" end
end

local readOk, raw = pcall(readfile, path)
if not readOk then return false,"Could not read config: "..tostring(raw) end
if type(raw) ~= "string" or raw == "" then return false,"Config is empty" end

local decodedOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
if not decodedOk or type(data) ~= "table" then return false, "Config contains invalid JSON" end
return true, data
end

local function load_config_file(name)
local readOk, data = read_config_data(name)
if not readOk then return false, data end

local profileData = type(data.profile) == "table" and data.profile or data
for k, v in pairs(profileData) do
    if defaultConfig[k] ~= nil then
        getgenv().__DevKageConfig[k] = v
    end
end

applyRuntimeState(VisualsState, data.visuals)
VisualsState.animation_id=tostring(VisualsState.animation_id or ""):match("%d+") or ""
VisualsState.animation_start_percent=math.clamp(tonumber(VisualsState.animation_start_percent) or 0,0,99)
VisualsState.animation_end_percent=math.clamp(tonumber(VisualsState.animation_end_percent) or 100,1,100)
if VisualsState.animation_end_percent<=VisualsState.animation_start_percent then VisualsState.animation_end_percent=math.min(100,VisualsState.animation_start_percent+1) end
applyRuntimeState(AntiAimState, data.antiAim)
if type(data.antiAim)=="table" then
local modernAA=data.antiAim
if modernAA.yaw_mode==nil and modernAA.mode~=nil then
local legacy=tostring(modernAA.mode)
if legacy=="Backwards" then AntiAimState.yaw_mode="Backwards"
elseif legacy=="Random" then AntiAimState.yaw_mode="Random"
elseif legacy=="Custom" then AntiAimState.yaw_mode="Custom"
elseif legacy=="Forwards" then AntiAimState.yaw_mode="Offset"; AntiAimState.yaw_offset=0
elseif legacy=="Look Up" then AntiAimState.pitch_mode="Look Up"
elseif legacy=="Look Down" then AntiAimState.pitch_mode="Look Down" end
end
if modernAA.pitch_angle==nil and modernAA.custom_pitch~=nil then
