if not VisualsState.threat_compass_enabled then if self.Gui then self.Gui.Enabled=false end; return end
if not self:EnsureGui() then return end
self.Gui.Enabled=true
self.Bar.Position=UDim2.new(0.5,0,0,math.clamp(tonumber(VisualsState.threat_compass_y) or 68,0,400))
local camera=workspace.CurrentCamera
local localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if not camera or not localRoot then return end
local look=camera.CFrame.LookVector
local heading=(math.deg(math.atan2(-look.X,-look.Z))+360)%360
local cardinals={"N","NE","E","SE","S","SW","W","NW"}
local cardinal=cardinals[(math.floor((heading+22.5)/45)%8)+1]
self.Heading.Text=string.format("%s  %03d°",cardinal,math.floor(heading+0.5)%360)
local candidates={}
local maxDistance=math.max(25,tonumber(VisualsState.threat_compass_max_distance) or 1200)
for _,player in ipairs(Players:GetPlayers()) do
if player~=LocalPlayer and not shouldSkipESPPlayer(player) then
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
local root=character and character:FindFirstChild("HumanoidRootPart")
if humanoid and humanoid.Health>0 and root then
local delta=root.Position-localRoot.Position
local distance=delta.Magnitude
if distance<=maxDistance then candidates[#candidates+1]={Player=player,Root=root,Distance=distance,Delta=delta} end
end
end
end
table.sort(candidates,function(a,b) return a.Distance<b.Distance end)
local active={}
local maxTargets=math.clamp(math.floor(tonumber(VisualsState.threat_compass_max_targets) or 8),1,20)
for index=1,math.min(#candidates,maxTargets) do
local entry=candidates[index]
local player=entry.Player
active[player]=true
local marker=self:GetMarker(player)
if marker then
local direction=entry.Distance>0.001 and entry.Delta.Unit or Vector3.new(0,0,-1)
local localDirection=camera.CFrame:VectorToObjectSpace(direction)
local bearing=math.atan2(localDirection.X,-localDirection.Z)
local x=0.5+math.clamp(bearing/math.pi,-1,1)*0.48
marker.Position=UDim2.new(x,0,0,22)
local sameTeam=LocalPlayer.Team~=nil and player.Team~=nil and LocalPlayer.Team==player.Team
local visible=isESPCharacterVisible(player.Character,false)
local color=sameTeam and VisualsState.radar_team_color or (visible and VisualsState.threat_compass_visible_color or VisualsState.threat_compass_color)
marker.TextColor3=color
local pieces={"▼"}
