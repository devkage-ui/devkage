function BindManager:RefreshControl(control)
    if control and control.BindValueLabel then
        local key = self:KeyText(control.BindKey)
        control.BindValueLabel.Text = key ~= "-" and ("[" .. key .. "]") or ""
        control.BindValueLabel.TextColor3 = control.BindMode == "Always"
            and control.Window.Accent or Color3.fromRGB(125, 125, 125)
    end
end

function BindManager:RefreshActive()
    if not self.ActiveList or not self.ActiveFrame then return end
    for _, child in ipairs(self.ActiveList:GetChildren()) do
        if child.Name == "BindEntry" then child:Destroy() end
    end

    local count = 0
    for index, control in ipairs(self.Order) do
        local hasBind = type(control.BindKey) == "table" and control.BindKey[2] ~= nil
        local active = control:Get() == true and (hasBind or control.BindMode == "Always")
        if active then
            count = count + 1
            local row = Instance.new("Frame")
            row.Name = "BindEntry"
            row.BackgroundTransparency = 1
            row.Size = UDim2.new(1, 0, 0, 15)
