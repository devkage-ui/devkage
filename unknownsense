local function find_teleport_queue()
local env = (type(getgenv) == "function" and getgenv()) or _G
local candidates = {
    rawget(env, "queue_on_teleport"),
    rawget(env, "queueonteleport"),
    rawget(env, "queue_on_tp"),
    type(queue_on_teleport) == "function" and queue_on_teleport or nil,
    type(queueonteleport) == "function" and queueonteleport or nil,
    type(queue_on_tp) == "function" and queue_on_tp or nil,
}
if type(syn) == "table" then candidates[#candidates+1] = syn.queue_on_teleport end
if type(fluxus) == "table" then candidates[#candidates+1] = fluxus.queue_on_teleport end
for _, candidate in ipairs(candidates) do
    if type(candidate) == "function" then return candidate end
end
return nil
end

local function queue_script_autoload(stub)
local queue = find_teleport_queue()
if not queue then return false, "teleport queue API unavailable" end
local ok, err = pcall(queue, stub)
return ok, ok and nil or tostring(err)
end

local function write_autoexec_stubs(stub)
if type(writefile) ~= "function" then return false end
local wrote = false

local folders = existing_autoexec_folders()
for _, folder in ipairs(folders) do
    local ok = pcall(writefile, folder .. "/" .. SCRIPT_AUTOEXEC_NAME, stub)
    if ok then wrote = true end
end

if #folders == 0 and type(isfolder) ~= "function" then
    local ok = pcall(writefile, "autoexec/" .. SCRIPT_AUTOEXEC_NAME, stub)
    if ok then wrote = true end
end

return wrote
end

local function remove_autoexec_stubs()
if type(delfile) ~= "function" then return end
for _, folder in ipairs({"autoexec","Autoexec","autoexecute","AutoExecute","scripts/autoexec","scripts/Autoexec"}) do
    local path = folder .. "/" .. SCRIPT_AUTOEXEC_NAME
    local shouldDelete = true
    if type(isfile) == "function" then
        local ok, exists = pcall(isfile, path)
        shouldDelete = ok and exists == true
    end
    if shouldDelete then pcall(delfile, path) end
end
end

local function configure_script_autoload(enabled, bootRefresh)
local settings = read_script_settings()
settings.AutoLoad = enabled == true
local saved, saveError = write_script_settings(settings)
if not saved then return false, saveError end

if not enabled then
    remove_autoexec_stubs()
    if type(delfile) == "function" and type(isfile) == "function" then
        local ok, exists = pcall(isfile, SCRIPT_PAYLOAD_FILE)
        if ok and exists then pcall(delfile, SCRIPT_PAYLOAD_FILE) end
    end
    return true, "Script auto-load disabled"
end

local source = type(getgenv) == "function" and getgenv().__DEVKAGE_EMBEDDED_SOURCE or nil
if (type(source) ~= "string" or source == "") and type(readfile) == "function" then
    local ok, existing = pcall(readfile, SCRIPT_PAYLOAD_FILE)
    if ok then source = existing end
end
if type(source) ~= "string" or source == "" then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, "Packaged source is unavailable"
end
if type(writefile) ~= "function" then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, "This executor cannot write the auto-load payload"
end

local payloadOk, payloadErr = pcall(writefile, SCRIPT_PAYLOAD_FILE, source)
if not payloadOk then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, tostring(payloadErr)
end

local stub = build_script_autoload_stub()

local queued, queueError = queue_script_autoload(stub)
local autoexecWritten = write_autoexec_stubs(stub)

if not queued and not autoexecWritten then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, "Executor exposes neither a working teleport queue nor an autoexec folder"
end

if queued and autoexecWritten then
    return true, "Auto Load enabled (teleports + executor autoexec)"
elseif queued then
    return true, "Auto Load enabled for teleports"
else
    return true, "Auto Load installed in executor autoexec"
end
end

local _script_boot_settings = read_script_settings()

if _script_boot_settings.AutoLoad == true then
task.defer(function()
    local ok, err = configure_script_autoload(true, true)
    if not ok then warn("[DevKage AutoLoad] refresh failed: " .. tostring(err)) end
end)
end

