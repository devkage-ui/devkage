local function getRainbowAuraColor(elapsed)
local base = RainbowAuraState.color
if RainbowAuraState.mode ~= "Rainbow" then
return base
end
local palette=RainbowAuraPaletteProfiles[RainbowAuraState.palette] or RainbowAuraPaletteProfiles.Spectrum
local phase=(elapsed*0.12*math.max(RainbowAuraState.speed,0.01))%1
if palette.Mode=="Spectrum" then
local h,s,v=Color3.toHSV(base)
return Color3.fromHSV((h+phase)%1,math.max(s,0.85),math.clamp(v,0.15,1))
elseif palette.Mode=="Monochrome" then
local wave=(math.sin(elapsed*math.max(RainbowAuraState.speed,0.01)*1.4)+1)*0.5
return base:Lerp(Color3.new(1,1,1),0.08+wave*0.42)
elseif palette.Mode=="Custom" then
local wave=(math.sin(elapsed*math.max(RainbowAuraState.speed,0.01)*1.2)+1)*0.5
return base:Lerp(RainbowAuraState.secondaryColor,wave)
elseif palette.Primary then
local wave=(math.sin(elapsed*math.max(RainbowAuraState.speed,0.01)*1.25)+1)*0.5
return palette.Primary:Lerp(palette.Secondary,wave)
else
local h=phase
return Color3.fromHSV(h,palette.Saturation or 0.65,palette.Value or 1)
end
end

local function getRainbowAuraSecondaryColor(elapsed,primary)
local palette=RainbowAuraPaletteProfiles[RainbowAuraState.palette] or RainbowAuraPaletteProfiles.Spectrum
if RainbowAuraState.mode~="Rainbow" or palette.Mode=="Custom" then return RainbowAuraState.secondaryColor end
if palette.Mode=="Spectrum" then
local h=select(1,Color3.toHSV(primary))
return Color3.fromHSV((h+0.16)%1,0.88,1)
end
if palette.Mode=="Monochrome" then return primary:Lerp(Color3.new(1,1,1),0.62) end
if palette.Primary then return palette.Secondary:Lerp(palette.Primary,(math.sin(elapsed*0.8)+1)*0.18) end
local h=select(1,Color3.toHSV(primary))
return Color3.fromHSV((h+(palette.Offset or 0.14))%1,palette.Saturation or 0.55,palette.Value or 1)
end

