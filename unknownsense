            if not silent then utility:SafeCallback(Content.Callback, Content:Get()) end
            if library.KeybindManager then library.KeybindManager:RefreshActive() end
        end
        function Content:Get() return Content.State end

        local lastLeftClick = 0
        local leftClickToken = 0
        utility:CreateConnection(Content_Holder_Button.MouseButton1Click, function()
            local now = os.clock()
            leftClickToken = leftClickToken + 1
            local token = leftClickToken
            if now - lastLeftClick <= 0.30 then
                lastLeftClick = 0
                if library.KeybindManager then library.KeybindManager:ShowMenu(Content) end
                return
            end
            lastLeftClick = now
            task.delay(0.31, function()
                if token ~= leftClickToken then return end
                Content:Set(not Content:Get())
            end)
        end)
        utility:CreateConnection(Content_Holder_Button.MouseButton2Click, function()
            leftClickToken = leftClickToken + 1
            lastLeftClick = 0
