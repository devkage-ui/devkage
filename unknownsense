            MenuInputRuntime.Guarding = true
            pcall(function()
                MenuModalRelease.Modal = false
            end)
            pcall(function()
                if uis.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                    uis.MouseBehavior = Enum.MouseBehavior.LockCenter
                end
            end)
            pcall(function()
                if uis.MouseIconEnabled ~= false then
                    uis.MouseIconEnabled = false
                end
            end)
            MenuInputRuntime.Guarding = false
        end

        local function restoreGameplayMouseState()
            MenuInputRuntime.Guarding = true
            pcall(function()
                MenuModalRelease.Modal = false
            end)
            pcall(function()
                uis.MouseBehavior = PreviousMouseBehavior
            end)
            pcall(function()
                uis.MouseIconEnabled = PreviousMouseIconEnabled
            end)
            MenuInputRuntime.Guarding = false
        end

        function Window:SetCursorControlMode(mode)
            -- DevKage cursor control is always the physical mouse.  Legacy
            -- "Free Cursor"/"Cursor Lock" config values are intentionally
            -- normalized to Mouse so the custom cursor never switches to a
            -- screen-center control source.
            local previousMode = Window.CursorControlMode
            mode = "Mouse"
            Window.CursorControlMode = mode

            if Window.Enabled then
                applyMenuMouseState()
            elseif previousMode == "Cursor Lock" then
                restoreSavedMouseState()
            end

            return mode
        end

        function Window:GetCursorControlMode()
            return Window.CursorControlMode
        end

