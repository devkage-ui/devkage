local function getESPFlags(player)
local flags = {}
if VisualsState.show_teamname and player.Team then
table.insert(flags, tostring(player.Team.Name))
end
if player == LocalPlayer then
table.insert(flags, "LOCAL")
end
if player.Character and player.Character:FindFirstChildOfClass("ForceField") then
table.insert(flags, "FF")
end
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
local root=character and character:FindFirstChild("HumanoidRootPart")
if VisualsState.esp_visibility_flag and character then
table.insert(flags,isESPCharacterVisible(character,false) and "VISIBLE" or "HIDDEN")
end
if VisualsState.esp_health_percent and humanoid then
local ratio=math.clamp(humanoid.Health/math.max(humanoid.MaxHealth,1),0,1)
table.insert(flags,string.format("%d%%",math.floor(ratio*100+0.5)))
end
if VisualsState.esp_low_health_warning and humanoid then
local threshold=math.clamp(tonumber(VisualsState.esp_low_health_threshold) or 25,1,99)/100
if humanoid.Health/math.max(humanoid.MaxHealth,1)<=threshold then table.insert(flags,"LOW") end
end
if VisualsState.esp_velocity_flag and root then
local speed=root.AssemblyLinearVelocity.Magnitude
table.insert(flags,string.format("%.0f s/s",speed))
end
if VisualsState.esp_user_id_flag then table.insert(flags,"ID:"..tostring(player.UserId)) end
if VisualsState.esp_spawn_protection_flag and character and character:FindFirstChildOfClass("ForceField") then table.insert(flags,"SPAWN") end
if VisualsState.esp_target_warning and root then
local camera=workspace.CurrentCamera
if camera then
local screen,onScreen=camera:WorldToViewportPoint(root.Position)
if onScreen and screen.Z>0 then
local mouse=uis:GetMouseLocation()
local radius=math.clamp(tonumber(getgenv().__DevKageConfig.aimFOV) or 90,10,1000)
if (Vector2.new(screen.X,screen.Y)-mouse).Magnitude<=radius then table.insert(flags,"TARGET") end
end
end
end
return table.concat(flags, " | ")
