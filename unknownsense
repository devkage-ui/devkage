        Numeric     = utility:GetProperty(Properties, {"numeric", "Numeric"}, false) == true,
        DigitsOnly  = utility:GetProperty(Properties, {"digitsonly", "DigitsOnly"}, false) == true,
        MaxLength   = tonumber(utility:GetProperty(Properties, {"maxlength", "MaxLength"}, 999)) or 999,
        Callback    = Properties.callback or Properties.Callback or function() end,
