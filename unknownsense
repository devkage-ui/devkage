KnifeCombatRuntime.InstallRivalsNoRecoil = function()
    local playerScripts=LocalPlayer:FindFirstChild("PlayerScripts")
    local modules=playerScripts and playerScripts:FindFirstChild("Modules")
    local itemTypes=modules and modules:FindFirstChild("ItemTypes")
    local gunScript=itemTypes and itemTypes:FindFirstChild("Gun")
    if not gunScript or not gunScript:IsA("ModuleScript") then return false end

    local ok,gunModule=pcall(require,gunScript)
    if not ok or type(gunModule)~="table" or type(gunModule._Recoil)~="function" then
        return false
    end

    local existing=Environment.__DevKageRivalsNativeCombat
    if type(existing)=="table"
        and existing.Gun==gunModule
        and type(existing.RecoilWrapper)=="function"
        and gunModule._Recoil==existing.RecoilWrapper then
        existing.Runtime=KnifeCombatRuntime
        KnifeCombatRuntime.RivalsNativeCombatBridge=existing
        KnifeCombatRuntime.RivalsGunModule=gunModule
        KnifeCombatRuntime.RivalsRecoilWrapper=existing.RecoilWrapper
        return true
    end

    local bridge=type(existing)=="table" and existing or {}
    bridge.Runtime=KnifeCombatRuntime
    bridge.Gun=gunModule
    bridge.RecoilOriginal=gunModule._Recoil

    bridge.RecoilWrapper=function(self,multiplier,...)
        local runtime=bridge.Runtime
        local config=Environment.__DevKageConfig
        if runtime and runtime.Alive
            and Environment.__DevKageCombatRuntime==runtime
            and type(config)=="table"
            and config.noRecoilEnabled==true then
            return
        end
        return bridge.RecoilOriginal(self,multiplier,...)
    end

    gunModule._Recoil=bridge.RecoilWrapper
    Environment.__DevKageRivalsNativeCombat=bridge
    KnifeCombatRuntime.RivalsNativeCombatBridge=bridge
    KnifeCombatRuntime.RivalsGunModule=gunModule
    KnifeCombatRuntime.RivalsRecoilOriginal=bridge.RecoilOriginal
    KnifeCombatRuntime.RivalsRecoilWrapper=bridge.RecoilWrapper
    return true
end

KnifeCombatRuntime.InstallBloxNoRecoil = function()
    if KnifeCombatRuntime.BloxWeaponModule then return true end
    local components = ReplicatedStorage:FindFirstChild("Components")
    local weaponScript = components and components:FindFirstChild("Weapon")
    if not weaponScript or not weaponScript:IsA("ModuleScript") then return false end

    local ok, weaponModule = pcall(require,weaponScript)
    if not ok or type(weaponModule) ~= "table" then return false end

    local patched = 0
    for key, value in pairs(weaponModule) do
        if type(value) == "function" then
            local lower = tostring(key):lower()
            local recoilLike = lower == "recoil" or lower == "_recoil"
                or lower == "applyrecoil" or lower == "addrecoil"
                or lower == "camerarecoil" or lower == "camera_recoil"
                or lower == "recoilcamera"
            local getterLike = lower:find("get",1,true) == 1
                or lower:find("calc",1,true) == 1
                or lower:find("compute",1,true) == 1
            if recoilLike and not getterLike then
                local original = value
                local wrapper = function(...)
                    if KnifeCombatRuntime.NoRecoilActive() then return end
                    return original(...)
                end
                KnifeCombatRuntime.BloxRecoilOriginals[key] = original
                KnifeCombatRuntime.BloxRecoilWrappers[key] = wrapper
                weaponModule[key] = wrapper
                patched = patched + 1
            end
        end
    end

    KnifeCombatRuntime.BloxWeaponModule = weaponModule
    return patched > 0
end

local PhantomRecoilFields = {
    "camkickmin","camkickmax","aimcamkickmin","aimcamkickmax",
    "aimtranskickmin","aimtranskickmax","transkickmin","transkickmax",
    "rotkickmin","rotkickmax","aimrotkickmin","aimrotkickmax",
}

KnifeCombatRuntime.CountPhantomRecoilFields = function(data)
    if type(data) ~= "table" then return 0 end
    local count = 0
    for _, key in ipairs(PhantomRecoilFields) do
        if rawget(data,key) ~= nil then count = count + 1 end
    end
    return count
end

KnifeCombatRuntime.ApplyPhantomGunData = function(data)
    if type(data) ~= "table" or KnifeCombatRuntime.CountPhantomRecoilFields(data) < 3 then
        return false
    end
    local originals = KnifeCombatRuntime.PhantomGunDataOriginals[data]
    if not originals then
        originals = {}
        for _, key in ipairs(PhantomRecoilFields) do
            if rawget(data,key) ~= nil then originals[key] = data[key] end
        end
        KnifeCombatRuntime.PhantomGunDataOriginals[data] = originals
    end
    for key in pairs(originals) do data[key] = Vector3.zero end
    return true
end

KnifeCombatRuntime.RestorePhantomGunData = function()
    for data, originals in pairs(KnifeCombatRuntime.PhantomGunDataOriginals) do
        if type(data) == "table" and type(originals) == "table" then
            for key, value in pairs(originals) do data[key] = value end
        end
        KnifeCombatRuntime.PhantomGunDataOriginals[data] = nil
    end
end

KnifeCombatRuntime.InstallPhantomNoRecoil = function()
    if KnifeCombatRuntime.PhantomLoadGunWrapper then return true end
    if KnifeCombatRuntime.PhantomRecoilScanDone then return false end
    KnifeCombatRuntime.PhantomRecoilScanDone = true
    if type(getgc) ~= "function" then return false end

    local ok, objects = pcall(getgc,true)
    if not ok or type(objects) ~= "table" then return false end
    local characterModule
    for _, object in next, objects do
        if type(object) == "table"
            and type(rawget(object,"loadgun")) == "function"
            and type(rawget(object,"loadgrenade")) == "function" then
            characterModule = object
            break
        end
    end
    if not characterModule then return false end

    local original = characterModule.loadgun
    local wrapper
    wrapper = function(...)
        local args = table.pack(...)
        if KnifeCombatRuntime.NoRecoilActive() then
            for i = 1,args.n do
                if type(args[i]) == "table" then
                    KnifeCombatRuntime.ApplyPhantomGunData(args[i])
                end
            end
        end
        return original(table.unpack(args,1,args.n))
    end

    KnifeCombatRuntime.PhantomCharacterModule = characterModule
    KnifeCombatRuntime.PhantomLoadGunOriginal = original
    KnifeCombatRuntime.PhantomLoadGunWrapper = wrapper
    characterModule.loadgun = wrapper

    -- Apply immediately to already-loaded weapon data tables.
    if KnifeCombatRuntime.NoRecoilActive() then
        for _, object in next, objects do
            if type(object) == "table" then
                KnifeCombatRuntime.ApplyPhantomGunData(object)
            end
        end
    end
    return true
end

KnifeCombatRuntime.InstallGenericNoRecoil = function()
    if KnifeCombatRuntime.GenericRecoilScanDone then return false end
    KnifeCombatRuntime.GenericRecoilScanDone = true
    if type(getgc) ~= "function" then return false end
    local ok, objects = pcall(getgc,true)
    if not ok or type(objects) ~= "table" then return false end
    local patched = 0
    for _, object in next, objects do
        if type(object) == "table" and not KnifeCombatRuntime.GenericRecoilPatched[object] then
            local shootLike = type(rawget(object,"StartShooting")) == "function"
                or type(rawget(object,"Shoot")) == "function"
                or type(rawget(object,"Fire")) == "function"
            local recoilKey
            for _, key in ipairs({"_Recoil","ApplyRecoil","applyRecoil","AddRecoil","addRecoil"}) do
                if type(rawget(object,key)) == "function" then recoilKey = key break end
            end
            if shootLike and recoilKey then
                local original = object[recoilKey]
                local wrapper = function(...)
                    if KnifeCombatRuntime.NoRecoilActive() then return end
                    return original(...)
                end
                object[recoilKey] = wrapper
                KnifeCombatRuntime.GenericRecoilPatched[object] = {
                    Key=recoilKey,Original=original,Wrapper=wrapper
                }
                patched = patched + 1
            end
        end
    end
    return patched > 0
end

KnifeCombatRuntime.ApplyItemLibraryWeaponMods = function()
    local config=Environment.__DevKageConfig
    if type(config)~="table" then return false end
    local modules=ReplicatedStorage:FindFirstChild("Modules")
    local itemModule=modules and modules:FindFirstChild("ItemLibrary")
    if not itemModule or not itemModule:IsA("ModuleScript") then return false end
    local ok,itemLib=pcall(require,itemModule)
    if not ok or type(itemLib)~="table" or type(itemLib.Items)~="table" then return false end
    KnifeCombatRuntime.ItemLibrary=itemLib
    for name,item in pairs(itemLib.Items) do
        if type(item)=="table" then
            local saved=KnifeCombatRuntime.ItemLibraryOriginals[name]
            if not saved then
                saved={}
                for _,key in ipairs({"ShootRecoil","ShootSpread","AimSpreadMultiplier","ShootSpreadPerVelocityUnit","ShootSpreadPerVelocityLimit"}) do
                    if item[key]~=nil then saved[key]=item[key] end
                end
                KnifeCombatRuntime.ItemLibraryOriginals[name]=saved
            end
            if config.noRecoilEnabled==true and saved.ShootRecoil~=nil then item.ShootRecoil=0 elseif saved.ShootRecoil~=nil then item.ShootRecoil=saved.ShootRecoil end
            if config.noSpreadEnabled==true then
                for _,key in ipairs({"ShootSpread","AimSpreadMultiplier","ShootSpreadPerVelocityUnit","ShootSpreadPerVelocityLimit"}) do
                    if saved[key]~=nil then item[key]=0 end
                end
            else
                for _,key in ipairs({"ShootSpread","AimSpreadMultiplier","ShootSpreadPerVelocityUnit","ShootSpreadPerVelocityLimit"}) do
                    if saved[key]~=nil then item[key]=saved[key] end
                end
            end
        end
    end
    return true
end

KnifeCombatRuntime.RestoreItemLibraryWeaponMods = function()
    local itemLib=KnifeCombatRuntime.ItemLibrary
    if type(itemLib)=="table" and type(itemLib.Items)=="table" then
        for name,saved in pairs(KnifeCombatRuntime.ItemLibraryOriginals) do
            local item=itemLib.Items[name]
            if type(item)=="table" then for key,value in pairs(saved) do item[key]=value end end
        end
    end
end

KnifeCombatRuntime.InstallNoRecoilAdapters = function(force)
    if KnifeCombatRuntime.NoRecoilInstallStarted then return end
    if KnifeCombatRuntime.NoRecoilAdaptersInstalled and not force then return end
    KnifeCombatRuntime.NoRecoilInstallStarted = true

    task.spawn(function()
        local installed = false

        -- RIVALS: exact ItemTypes.Gun._Recoil adapter from the supplied source.
        local rivalsOk, rivalsInstalled = pcall(KnifeCombatRuntime.InstallRivalsNoRecoil)
        if rivalsOk and rivalsInstalled then installed = true end

        -- Blox Strikes: only patch explicitly named recoil methods if the
        -- current Weapon module actually exposes one. Never scan/hook unknown
        -- functions because that can catch a firing method.
        if KnifeCombatRuntime.IsBloxStrikes() then
            local bloxOk, bloxInstalled = pcall(KnifeCombatRuntime.InstallBloxNoRecoil)
            if bloxOk and bloxInstalled then installed = true end
        end

        -- Phantom-style gun-data tables use known camera/rotation kick fields.
        if not KnifeCombatRuntime.IsRivals() and not KnifeCombatRuntime.IsBloxStrikes() then
            local camera = Workspace.CurrentCamera
            local looksPhantom = Workspace:FindFirstChild("Players") ~= nil
                and camera ~= nil and camera:FindFirstChild("Main") ~= nil
            if looksPhantom then
                local pfOk, pfInstalled = pcall(KnifeCombatRuntime.InstallPhantomNoRecoil)
                if pfOk and pfInstalled then installed = true end
            end
        end

        KnifeCombatRuntime.NoRecoilAdaptersInstalled = installed
        KnifeCombatRuntime.NoRecoilInstallStarted = false
    end)
end

