local AnimPreview={world=nil,model=nil,camera=nil,track=nil,liveTrack=nil,rotation=math.pi,token=0,loading=false,liveAnimate=nil,liveAnimateDisabled=nil}
local function animationSegmentBounds(track)
local length=track and tonumber(track.Length) or 0
if length<=0 then return nil,nil end
local startPercent=math.clamp(tonumber(VisualsState.animation_start_percent) or 0,0,99)
local endPercent=math.clamp(tonumber(VisualsState.animation_end_percent) or 100,1,100)
if endPercent<=startPercent then endPercent=math.min(100,startPercent+1) end
return length*(startPercent/100),length*(endPercent/100)
end
local function applyAnimationSegment(track)
if not track then return end
task.spawn(function()
local deadline=os.clock()+3
while track and tonumber(track.Length)<=0 and os.clock()<deadline do task.wait(0.03) end
if not track then return end
local startTime=animationSegmentBounds(track)
if startTime then pcall(function() track.TimePosition=startTime end) end
end)
end
local function enforceAnimationSegment(track)
if not track or not track.IsPlaying then return end
local startTime,endTime=animationSegmentBounds(track)
if not startTime or not endTime then return end
if track.TimePosition+0.001>=endTime then
if VisualsState.animation_looped then
pcall(function() track.TimePosition=startTime end)
else
pcall(function() track:Stop(0.08) end)
end
elseif track.TimePosition<startTime-0.05 then
pcall(function() track.TimePosition=startTime end)
end
end
local function restoreLiveAnimate()
local animate=AnimPreview.liveAnimate
if animate and animate.Parent and AnimPreview.liveAnimateDisabled~=nil then
pcall(function() animate.Disabled=AnimPreview.liveAnimateDisabled end)
end
AnimPreview.liveAnimate=nil
AnimPreview.liveAnimateDisabled=nil
end
local function stopAnimationTracks()
if AnimPreview.track then pcall(function() AnimPreview.track:Stop(0.08) end); AnimPreview.track=nil end
if AnimPreview.liveTrack then pcall(function() AnimPreview.liveTrack:Stop(0.08) end); AnimPreview.liveTrack=nil end
UI.ESPAnimationTrack=nil
UI.ESPLiveAnimationTrack=nil
restoreLiveAnimate()
end
local function clearAnimPreview()
AnimPreview.token=AnimPreview.token+1
AnimPreview.loading=false
stopAnimationTracks()
if AnimPreview.model then pcall(function() AnimPreview.model:Destroy() end); AnimPreview.model=nil end
if AnimPreview.camera then pcall(function() AnimPreview.camera:Destroy() end); AnimPreview.camera=nil end
if AnimPreview.world then pcall(function() AnimPreview.world:Destroy() end); AnimPreview.world=nil end
end
local function updateAnimCamera()
if not AnimPreview.camera or not AnimPreview.model then return end
local root=AnimPreview.model:FindFirstChild("HumanoidRootPart")
if not root then return end
local radius=6.2
AnimPreview.camera.CFrame=CFrame.new(root.Position+Vector3.new(math.sin(AnimPreview.rotation)*radius,0.45,math.cos(AnimPreview.rotation)*radius),root.Position+Vector3.new(0,0.15,0))
end
local function loadAnimAvatar(onReady)
if AnimPreview.model and AnimPreview.model.Parent then
if onReady then task.defer(onReady,AnimPreview.model) end
return
end
if AnimPreview.loading then
local waitToken=AnimPreview.token
task.spawn(function()
local deadline=os.clock()+5
while AnimPreview.loading and waitToken==AnimPreview.token and os.clock()<deadline do task.wait(0.03) end
if waitToken==AnimPreview.token and AnimPreview.model and onReady then onReady(AnimPreview.model) end
end)
return
end
AnimPreview.loading=true
AnimPreview.token=AnimPreview.token+1
local token=AnimPreview.token
animStatus.Text="Loading avatar…"; animStatus.Visible=true
task.spawn(function()
local ok,model=pcall(Players.CreateHumanoidModelFromUserId,Players,LocalPlayer.UserId)
if token~=AnimPreview.token then AnimPreview.loading=false; if model then pcall(function() model:Destroy() end) end return end
if not ok or not model then AnimPreview.loading=false; animStatus.Text="Avatar failed"; return end
if AnimPreview.model then pcall(function() AnimPreview.model:Destroy() end) end
if AnimPreview.camera then pcall(function() AnimPreview.camera:Destroy() end); AnimPreview.camera=nil end
if AnimPreview.world then pcall(function() AnimPreview.world:Destroy() end) end
AnimPreview.world=Instance.new("WorldModel")
AnimPreview.world.Parent=animViewport
AnimPreview.model=model
model.Parent=AnimPreview.world
local hum=model:FindFirstChildOfClass("Humanoid")
