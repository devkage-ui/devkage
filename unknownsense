KnifeCombatRuntime.Step = function(dt)
    if not KnifeCombatRuntime.Alive then return end
    local config = Environment.__DevKageConfig
    if type(config) ~= "table" then return end
    local now = os.clock()

    if KnifeCombatRuntime.StartupGate then return end
    KnifeCombatRuntime.StepBunnyHop(dt)

    if not KnifeCombatRuntime.IsRivals()
        and (config.noRecoilEnabled==true or config.noSpreadEnabled==true)
        and now-KnifeCombatRuntime.LastItemStatApply>0.5 then
        KnifeCombatRuntime.LastItemStatApply=now
        pcall(KnifeCombatRuntime.ApplyItemLibraryWeaponMods)
    end

    if config.noRecoilEnabled == true
        and not KnifeCombatRuntime.NoRecoilAdaptersInstalled
        and now - KnifeCombatRuntime.LastNoRecoilAttempt > 2 then
        KnifeCombatRuntime.LastNoRecoilAttempt = now
        KnifeCombatRuntime.InstallNoRecoilAdapters()
    end

    if config.noSpreadEnabled == true
        and (not KnifeCombatRuntime.SpreadInstalled
            or type(KnifeCombatRuntime.GameplayUtility) ~= "table"
            or KnifeCombatRuntime.GameplayUtility.GetSpread ~= KnifeCombatRuntime.SpreadWrapper) then
        KnifeCombatRuntime.QueueModuleLoad(false)
        KnifeCombatRuntime.InstallNoSpread()
    end

    -- Silent Aim removed: only non-aim combat helpers run here.
end

