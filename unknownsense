function UA.RefreshOwnedCatalogs()
    local emotes, weapons = {}, {}
    if ua_emotesEnabled() then
        local catalog = ua_rebuildEmoteCatalog()
        for name, entry in pairs(catalog) do emotes[name] = entry end
    end
    if ua_weaponsEnabled() and UA.CosmeticLibrary and UA.CosmeticLibrary.Cosmetics then
        for name, cosmetic in pairs(UA.CosmeticLibrary.Cosmetics) do
            if cosmetic and ua_isNotFinisher(name) and not ua_isEmote(cosmetic.Type, name) then
                weapons[name] = cosmetic
            end
        end
    end
    UA.ownedEmotes, UA.ownedWeapons = emotes, weapons
    return emotes, weapons
end

