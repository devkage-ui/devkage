local function apply_fullbright(enabled, value)
local lighting = game:GetService("Lighting")
if enabled then
if not VisualsState.original_ambient then
VisualsState.original_ambient = lighting.Ambient
end
if VisualsState.original_brightness == nil then
VisualsState.original_brightness = lighting.Brightness
end
local ambientLevel = math.clamp(value * 25.5, 0, 255)
lighting.Ambient    = Color3.fromRGB(ambientLevel, ambientLevel, ambientLevel)
lighting.Brightness = value
else
lighting.Ambient = VisualsState.ambient_override and VisualsState.ambient_color or VisualsState.world_ambient
if VisualsState.original_brightness ~= nil then lighting.Brightness = VisualsState.original_brightness end
end
end

local function apply_ambient(enabled, color)
local lighting = game:GetService("Lighting")
color = color or VisualsState.ambient_color
if enabled then
if not VisualsState.original_ambient then
VisualsState.original_ambient = lighting.Ambient
VisualsState.original_outdoor = lighting.OutdoorAmbient
end
lighting.Ambient = color
lighting.OutdoorAmbient = color
else
if VisualsState.fullbright then
local level=math.clamp(VisualsState.fullbright_value*25.5,0,255)
lighting.Ambient=Color3.fromRGB(level,level,level)
else
lighting.Ambient=VisualsState.world_ambient
end
lighting.OutdoorAmbient=VisualsState.outdoor_ambient
end
end

local function apply_fov(enabled, value)
local cam = workspace.CurrentCamera
if not cam then return end
if enabled then
if not VisualsState.original_fov then
VisualsState.original_fov = cam.FieldOfView
end
VisualsState.fov_value = math.clamp(tonumber(value) or VisualsState.fov_value or 70, 1, 120)
cam.FieldOfView = VisualsState.fov_value
else
if VisualsState.original_fov then
cam.FieldOfView = VisualsState.original_fov
end
end
end

local function apply_fog(enabled)
local lighting = game:GetService("Lighting")
local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
if enabled then
if atmosphere then
if not VisualsState.original_fog then
VisualsState.original_fog = atmosphere.Density
VisualsState.original_fog_haze = atmosphere.Haze
end
atmosphere.Density = 0
atmosphere.Haze    = 0
end
if VisualsState.original_fog_start == nil then VisualsState.original_fog_start = lighting.FogStart end
if VisualsState.original_fog_end == nil then VisualsState.original_fog_end = lighting.FogEnd end
lighting.FogEnd   = 100000
lighting.FogStart = 100000
else
if atmosphere and VisualsState.original_fog then
atmosphere.Density = VisualsState.original_fog
atmosphere.Haze = VisualsState.original_fog_haze or atmosphere.Haze
end
if VisualsState.original_fog_end ~= nil then lighting.FogEnd = VisualsState.original_fog_end end
if VisualsState.original_fog_start ~= nil then lighting.FogStart = VisualsState.original_fog_start end
end
end

local ESPVisibilityCache=setmetatable({}, {__mode="k"})

local function getESPWorldDistance(player)
local localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
local targetRoot=player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
if not localRoot or not targetRoot then return math.huge end
return (targetRoot.Position-localRoot.Position).Magnitude
end

local function isESPCharacterVisible(character,force)
if not character then return false end
local cached=ESPVisibilityCache[character]
local now=os.clock()
if not force and cached and now-cached.At<0.09 then return cached.Visible end
local camera=workspace.CurrentCamera
local target=character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart")
if not camera or not target then return false end
local origin=camera.CFrame.Position
local direction=target.Position-origin
if direction.Magnitude<0.01 then return true end
local params=RaycastParams.new()
params.FilterType=Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances=LocalPlayer.Character and {LocalPlayer.Character} or {}
params.IgnoreWater=true
pcall(function() params.RespectCanCollide=false end)
local ok,result=pcall(function() return workspace:Raycast(origin,direction,params) end)
local visible=false
if ok then
visible=result==nil or (result.Instance and result.Instance:IsDescendantOf(character))
end
ESPVisibilityCache[character]={At=now,Visible=visible}
return visible
end

local function getESPDistanceFade(player)
if not VisualsState.esp_distance_fade then return 0 end
local distance=getESPWorldDistance(player)
local start=math.max(0,tonumber(VisualsState.esp_fade_start) or 850)
local finish=math.max(start+1,tonumber(VisualsState.esp_max_distance) or 2500)
return math.clamp((distance-start)/(finish-start),0,0.78)
end

local function shouldSkipESPPlayer(player)
local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
if VisualsState.dormant and humanoid and humanoid.Health<=0 then return true end
if VisualsState.teamcheck and LocalPlayer.Team~=nil and player.Team~=nil and player.Team==LocalPlayer.Team then return true end
if VisualsState.esp_distance_limit and getESPWorldDistance(player)>math.max(1,tonumber(VisualsState.esp_max_distance) or 2500) then return true end
if VisualsState.esp_visible_only and player.Character and not isESPCharacterVisible(player.Character,false) then return true end
return false
end

local function refresh_esp_highlights()
for player, hl in pairs(VisualsState.highlights_table) do
if not player.Parent or not hl.Parent or (player.Character and hl.Adornee ~= player.Character) then
pcall(function() hl:Destroy() end)
VisualsState.highlights_table[player] = nil
end
end
if not VisualsState.esp_enabled then
for player, hl in pairs(VisualsState.highlights_table) do
pcall(function() hl:Destroy() end)
end
VisualsState.highlights_table = {}
return
end
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer then
local skip = shouldSkipESPPlayer(player)
if not skip and player.Character then
if not VisualsState.highlights_table[player] then
local hl = Instance.new("Highlight")
hl.Name         = "DevKage_ESP"
hl.Adornee      = player.Character
hl.FillColor    = VisualsState.bounding_box_color
hl.FillTransparency = VisualsState.bounding_box_alpha
hl.OutlineColor = VisualsState.glow_color
hl.OutlineTransparency = VisualsState.glow_alpha
hl.DepthMode    = Enum.HighlightDepthMode.AlwaysOnTop
hl.Parent       = player.Character
VisualsState.highlights_table[player] = hl
end
local hl = VisualsState.highlights_table[player]
if hl then
local distanceFade=getESPDistanceFade(player)
hl.Enabled = VisualsState.highlights
hl.FillColor = VisualsState.bounding_box_color
hl.FillTransparency = VisualsState.bounding_box and math.clamp(VisualsState.bounding_box_alpha+distanceFade,0,1) or 1
hl.OutlineColor = VisualsState.glow_color
hl.OutlineTransparency = VisualsState.glow and math.clamp(VisualsState.glow_alpha+distanceFade*0.85,0,1) or 1
end
elseif VisualsState.highlights_table[player] then
pcall(function() VisualsState.highlights_table[player]:Destroy() end)
VisualsState.highlights_table[player] = nil
end
end
end
end

local function getESPPart(character, kind)
if not character then return nil end
local names = {
Head = {"Head"},
Center = {"HumanoidRootPart", "UpperTorso", "Torso"},
Feet = {"LeftFoot", "RightFoot", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg", "HumanoidRootPart"},
Top = {"Head", "UpperTorso", "Torso"},
Bottom = {"HumanoidRootPart", "LowerTorso", "Torso"}
}
for _, name in ipairs(names[kind] or names.Center) do
local part = character:FindFirstChild(name)
if part and part:IsA("BasePart") then return part end
end
return character:FindFirstChildWhichIsA("BasePart")
end

