            addWing(-1,15,1.22,1.18*size,1); addWing(1,15,1.22,1.18*size,1)
            addMantle(size)
            addHalo(1,0.72*size,1.24*size,math.rad(82),math.rad(5),60,0.036*size)
            addHalo(2,0.86*size,1.68*size,math.rad(-82),math.rad(-7),68,0.026*size)
            addCrystalOrbit(12,2.35*size,0.05*size,0.90*size,math.rad(70))
            addEnergyCore(1.05*size)
        else
            addWing(-1,14,1.05,1.16*size,1); addWing(1,14,1.05,1.16*size,1)
            addWing(-1,9,0.68,0.82*size,2); addWing(1,9,0.68,0.82*size,2)
            addHalo(1,0.70*size,1.18*size,math.rad(5),0,52,0.048*size)
            addHalo(2,0.98*size,1.50*size,math.rad(-8),math.rad(4),58,0.035*size)
            addAngelOrbs(6,2.10*size,0.45*size)
        end

        addFinishingGlow(root,character,size)

        local frameElapsed=0
        local renderInterval=tostring(getgenv().__DevKageConfig.avatarModsQuality or "High")=="Performance" and (1/30) or (1/60)
        state.connection = RunService.RenderStepped:Connect(function(dt)
            frameElapsed=frameElapsed+(tonumber(dt) or 0)
            if frameElapsed<renderInterval then return end
            frameElapsed=math.max(0,frameElapsed-renderInterval)
            if getgenv().__DevKageConfig.avatarModsEnabled ~= true or state.character ~= character or not character.Parent then return end
            local liveRoot = character:FindFirstChild("HumanoidRootPart")
            local liveHead = character:FindFirstChild("Head")
            local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or liveRoot
            if not liveRoot or not liveHead or not torso then return end

            local now = os.clock()
            local speed = math.max(tonumber(getgenv().__DevKageConfig.avatarModsSpeed) or 1,0.05)
            local alpha = math.clamp(tonumber(getgenv().__DevKageConfig.avatarModsAlpha) or 0.18,0,0.92)
            local motionAmount,motionRate=motionSettings()
            speed=speed*motionRate
            local color = animatedColor(now,0)
            local secondary=configSecondaryColor()
            local scale = math.clamp(tonumber(getgenv().__DevKageConfig.avatarModsSize) or 1,0.55,2.0)
            local bright = color:Lerp(Color3.new(1,1,1),0.32)
            local pulseAmount=math.clamp(tonumber(getgenv().__DevKageConfig.avatarModsPulse) or 0.18,0,0.75)
            local pulseWave=(math.sin(now*speed*1.45)+1)*0.5
            local pulseBrightness=1+(pulseWave-0.5)*pulseAmount
            local pulseAlpha=math.clamp(alpha-(pulseWave-0.5)*pulseAmount*0.38,0,0.94)

            if state.light then state.light.Color=color:Lerp(secondary,0.20); state.light.Brightness=math.max(tonumber(getgenv().__DevKageConfig.avatarModsBrightness) or 3,0)*pulseBrightness end
            if state.highlight then state.highlight.FillColor=color; state.highlight.OutlineColor=bright end
            if state.emitter then
                state.emitter.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,bright),ColorSequenceKeypoint.new(0.52,color),ColorSequenceKeypoint.new(1,secondary)})
                state.emitter.Rate=22*qualityMultiplier()*(0.90+pulseWave*0.10)
            end

            for _,object in ipairs(state.objects) do
                if object and object.Parent and object:IsA("Trail") then
                    local tintIndex=tonumber(object:GetAttribute("DevKageAvatarTintIndex")) or 1
                    local trailColor=animatedColor(now,tintIndex*0.09)
                    object.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,trailColor:Lerp(Color3.new(1,1,1),0.32)),ColorSequenceKeypoint.new(0.55,trailColor),ColorSequenceKeypoint.new(1,secondary)})
                end
            end

            for _,entry in ipairs(state.entries) do
                local part = entry.Part
                if part and part.Parent then
                    local count=math.max(tonumber(entry.Count) or 1,1)
                    local phase=((tonumber(entry.Index) or 1)-1)/count+(tonumber(entry.Layer) or 0)*0.11
                    local entryColor=animatedColor(now,phase)
                    part.Color = entryColor:Lerp(Color3.new(1,1,1),entry.Kind=="Core" and 0.44 or 0.18)
                    part.Transparency = math.clamp(pulseAlpha + ((entry.Kind=="Wing") and 0.06 or 0),0.035,0.92)
                    if entry.Kind == "Halo" then
                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*((entry.Ring%2==0) and -0.20 or 0.20)
                        local bob = math.sin(now*speed*1.4 + entry.Ring)*0.045*scale*motionAmount
                        local base
                        if math.abs(entry.Height) > 1.5*scale then
                            base = liveRoot.CFrame * CFrame.new(0,entry.Height+bob,0)
                        else
                            base = liveHead.CFrame * CFrame.new(0,entry.Height+bob,0)
                        end
                        base = base * CFrame.Angles(entry.TiltX,0,entry.TiltZ)
                        local r = entry.Radius
                        local pos = (base * CFrame.new(math.cos(angle)*r,0,math.sin(angle)*r)).Position
                        local tangent = base:VectorToWorldSpace(Vector3.new(-math.sin(angle),0,math.cos(angle)))
                        part.CFrame = CFrame.new(pos,pos+tangent)
                    elseif entry.Kind == "Wing" then
                        local f = (entry.Index-1)/math.max(entry.Count-1,1)
                        local flap = math.sin(now*speed*1.65 + entry.Index*0.08 + entry.Layer*0.45)*0.085*motionAmount
                        local layer = tonumber(entry.Layer) or 1
                        local side = entry.Side
                        local spread = entry.Spread
                        local x = side*(0.66 + f*(2.75*spread) + (layer-1)*0.16)*scale
                        local y = (0.72 - f*1.62 + (layer-1)*0.32)*scale
                        local z = (0.36 + f*1.15 + (layer-1)*0.16)*scale
                        local sweep = side*(0.36 + f*0.66 + flap)
                        local roll = side*math.rad(19 + f*30 - (layer-1)*4)
                        local pitch = math.rad(-18 + f*22)
                        part.CFrame = torso.CFrame * CFrame.new(x,y,z) * CFrame.Angles(pitch,sweep,roll)
                    elseif entry.Kind == "Orb" then
                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*(0.42 + (entry.Index%2)*0.05)
                        local y = math.sin(angle*1.5 + entry.Index)*entry.Vertical*motionAmount + 0.35*scale
                        part.CFrame = CFrame.new(liveRoot.Position + Vector3.new(math.cos(angle)*entry.Radius,y,math.sin(angle)*entry.Radius))
                    elseif entry.Kind == "Crown" then
                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*0.08
                        local radius = entry.Radius or 0.72*scale
                        local y = entry.Height or 1.0*scale
                        part.CFrame = liveHead.CFrame * CFrame.new(math.cos(angle)*radius,y,math.sin(angle)*radius) * CFrame.Angles(0,-angle,math.rad(16))
                    elseif entry.Kind == "Crystal" then
                        local angle=((entry.Index-1)/entry.Count)*math.pi*2+now*speed*((entry.Index%2==0) and -0.38 or 0.38)
                        local vertical=entry.Height+math.sin(angle*1.55+entry.Index)*0.34*scale*motionAmount
                        local base=liveRoot.CFrame*CFrame.Angles(entry.Tilt or 0,0,math.sin(now*0.35)*0.08)
                        local pos=(base*CFrame.new(math.cos(angle)*entry.Radius,vertical,math.sin(angle)*entry.Radius)).Position
                        part.CFrame=CFrame.new(pos)*CFrame.Angles(now*speed*0.7+entry.Index,angle,math.rad(45))
                    elseif entry.Kind == "Core" then
                        local bob=math.sin(now*speed*1.35)*0.10*scale*motionAmount
                        local coreScale=1+(pulseWave-0.5)*pulseAmount*0.34
                        part.CFrame=torso.CFrame*CFrame.new(0,0.28+bob,-0.72)
                        part.Size=Vector3.new(0.42,0.42,0.42)*(entry.Size or 1)*coreScale
                    elseif entry.Kind == "CoreOrbit" then
                        local angle=((entry.Index-1)/entry.Count)*math.pi*2+now*speed*(0.92+entry.Index*0.08)
                        local center=(torso.CFrame*CFrame.new(0,0.28,-0.72)).Position
                        local radius=entry.Radius or 0.7*scale
                        part.CFrame=CFrame.new(center+Vector3.new(math.cos(angle)*radius,math.sin(angle*1.8)*0.22*scale,math.sin(angle)*radius))
                    elseif entry.Kind == "Mantle" then
                        local f=(entry.Index-1)/math.max(entry.Count-1,1)
                        local sway=math.sin(now*speed*1.2+entry.Index*0.3)*0.04*motionAmount
                        local x=entry.Side*(0.42+f*0.66)*scale
                        local y=(0.64-f*0.34)*scale
                        local z=(-0.20+f*0.24)*scale
                        part.CFrame=torso.CFrame*CFrame.new(x,y,z)*CFrame.Angles(math.rad(-18+f*12),entry.Side*(0.42+sway),entry.Side*math.rad(24+f*12))
                    end
                end
            end
        end)
    end

    function API:Refresh()
        if getgenv().__DevKageConfig.avatarModsEnabled ~= true then
            clearVisualsOnly()
            return
        end
        local character = LocalPlayer.Character
        if character then task.defer(function() build(character) end) end
    end

    function API:SetEnabled(value)
        getgenv().__DevKageConfig.avatarModsEnabled = value == true
        if value then self:Refresh() else clearVisualsOnly() end
    end

    state.characterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        if getgenv().__DevKageConfig.avatarModsEnabled == true then
            task.delay(0.15,function()
                if character.Parent then build(character) end
            end)
        end
    end)

    if getgenv().__DevKageConfig.avatarModsEnabled == true then task.defer(function() API:Refresh() end) end
    return API
end)();
end

