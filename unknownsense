function BindManager:RefreshMenu()
    local control = self.MenuControl
    if not control or not self.Menu then return end
    self.MenuTitle.Text = "bind  •  " .. string.lower(tostring(control.Name))
    for mode, button in pairs(self.MenuButtons) do
        local selected = control.BindMode == mode
        button.BackgroundColor3 = selected and Color3.fromRGB(31, 34, 27) or Color3.fromRGB(24, 24, 24)
        button.TextColor3 = selected and control.Window.Accent or Color3.fromRGB(195, 195, 195)
    end
    if self.CaptureControl == control then
        self.MenuKeyButton.Text = "press a key..."
        self.MenuKeyButton.TextColor3 = control.Window.Accent
    else
        self.MenuKeyButton.Text = "key  [ " .. self:KeyText(control.BindKey) .. " ]"
        self.MenuKeyButton.TextColor3 = Color3.fromRGB(205, 205, 205)
    end
end

function BindManager:SetMode(control, mode)
    if mode ~= "Hold" and mode ~= "Toggle" and mode ~= "Always" then return end
    control.BindMode = mode
    if mode == "Always" then
        control:Set(true)
    elseif mode == "Hold" and control.BindKey then
        control:Set(false)
    end
    self:RefreshControl(control)
    self:RefreshMenu()
    self:RefreshActive()
end

function BindManager:ShowMenu(control)
    if not control or not control.Window then return end
    self:EnsureUI(control.Window)
    self.MenuControl = control
    self.CaptureControl = nil
    self:RefreshMenu()
    local mouse = uis:GetMouseLocation()
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    local x = math.clamp(mouse.X + 8, 4, math.max(4, viewport.X - 190))
    local y = math.clamp(mouse.Y + 8, 4, math.max(4, viewport.Y - 182))
    self.Menu.Position = UDim2.fromOffset(x, y)
    self.Menu.Visible = true
end

function BindManager:HideMenu()
    self.CaptureControl = nil
    self.MenuControl = nil
    if self.Menu then self.Menu.Visible = false end
end

function BindManager:Register(control, properties)
    self:EnsureUI(control.Window)
    self.Counter = self.Counter + 1
    local id = utility:GetProperty(properties or {}, {"flag", "Flag", "id", "Id", "idx", "Idx"}, nil)
    id = id and tostring(id) or ("toggle:" .. tostring(self.Counter) .. ":" .. tostring(control.Name))
    if self.Controls[id] and self.Controls[id] ~= control then
        id = id .. "#" .. tostring(self.Counter)
    end
    control.BindId = id
    control.BindMode = control.BindMode or "Toggle"
    control.BindKey = control.BindKey or nil
    self.Controls[id] = control
    table.insert(self.Order, control)

    local pending = getgenv and getgenv().__DevKagePendingKeybinds
    if type(pending) == "table" and type(pending[id]) == "table" then
        local data = pending[id]
        if data.mode == "Hold" or data.mode == "Toggle" or data.mode == "Always" then
            control.BindMode = data.mode
        end
        if type(data.keyType) == "string" and type(data.keyName) == "string" then
            control.BindKey = {data.keyType, data.keyName}
        end
        if control.BindMode == "Always" then control:Set(true) end
    end
    self:RefreshControl(control)
    self:RefreshActive()
end

function BindManager:Serialize()
    local output = {}
    for id, control in pairs(self.Controls) do
        output[id] = {
            mode = control.BindMode or "Toggle",
            keyType = control.BindKey and control.BindKey[1] or nil,
            keyName = control.BindKey and control.BindKey[2] or nil,
        }
    end
    return output
end

function BindManager:Apply(data)
    if type(data) ~= "table" then return end
    if getgenv then getgenv().__DevKagePendingKeybinds = data end
    for id, bind in pairs(data) do
        local control = self.Controls[id]
        if control and type(bind) == "table" then
            if bind.mode == "Hold" or bind.mode == "Toggle" or bind.mode == "Always" then
                control.BindMode = bind.mode
            end
            if type(bind.keyType) == "string" and type(bind.keyName) == "string" then
                control.BindKey = {bind.keyType, bind.keyName}
            else
                control.BindKey = nil
            end
            if control.BindMode == "Always" then control:Set(true) end
            self:RefreshControl(control)
        end
    end
    self:RefreshActive()
end

