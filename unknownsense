local __devkageEnv = (type(getgenv) == "function" and getgenv()) or _G
__devkageEnv.__DEVKAGE_PACKAGE_BUILD = "DevKage-v5.2.1-opiumware-stringfix-20260822"
__devkageEnv.__DEVKAGE_EMBEDDED_SOURCE = __DEVKAGE_EMBEDDED_SOURCE

-- CURRENT-ONLY PREBOOT CLEANUP
-- If this newest full build itself is placed in executor Auto Execute, remove
-- recognizable older DevKage siblings before the embedded runtime can refresh
-- autoload.  This prevents an older full copy from continually rewriting the
-- legacy payload on every client launch.  The current file is preserved because
-- it contains the unique v5.2 build label below.
do
    local folders = {"autoexec","Autoexec","autoexecute","AutoExecute","scripts/autoexec","scripts/Autoexec"}
    local currentLabel = "DevKage-v5.2.1-opiumware-stringfix-20260822"

    local function inspect(path)
        -- Keep this preboot cleanup executor-safe.  Some executors/obfuscators
        -- rewrite colon-style string methods and can turn path:gsub()/lower()
        -- into a missing synthetic method.  Use the string library directly
        -- and contain every inspection so cleanup can never abort DevKage boot.
        pcall(function()
            if type(path) ~= "string" or type(readfile) ~= "function" or type(delfile) ~= "function" then return end
            local lower = string.lower(string.gsub(path, "\\", "/"))
            if string.sub(lower, -4) ~= ".lua" and string.sub(lower, -5) ~= ".luau" then return end
            local ok, content = pcall(readfile, path)
            if not ok or type(content) ~= "string" then return end
            local devkage = string.find(content, "DEVKAGE packaged coexistence build", 1, true)
                or string.find(content, "[DevKage AutoLoad]", 1, true)
                or string.find(content, "_devkage_autoload_payload", 1, true)
                or string.find(content, "__DEVKAGE_PACKAGE_BUILD", 1, true)
            if devkage and not string.find(content, currentLabel, 1, true) then
                pcall(delfile, path)
            end
        end)
    end

    for _, folder in ipairs(folders) do
        if type(listfiles) == "function" then
            local ok, paths = pcall(listfiles, folder)
            if ok and type(paths) == "table" then
                for _, path in ipairs(paths) do inspect(path) end
            end
        end
    end
end

-- AUTO-EXECUTE BOOT GUARD
--
-- Executor-native Auto Execute runs much earlier than normal manual execution.
-- The embedded DevKage source captures Players.LocalPlayer and CurrentCamera in
-- locals during startup, so launching before those objects exist permanently
-- poisons that run with nil references.  Wait here, outside the embedded source,
-- so absolutely every feature inside it starts against the same ready client.
do
    local __devkagePlayers = game:GetService("Players")
    local __devkageWorkspace = game:GetService("Workspace")

    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    while not __devkagePlayers.LocalPlayer do
        task.wait(0.1)
    end

    local __devkageLocalPlayer = __devkagePlayers.LocalPlayer
    while __devkageLocalPlayer and not __devkageLocalPlayer:FindFirstChildOfClass("PlayerGui") do
        task.wait(0.1)
        __devkageLocalPlayer = __devkagePlayers.LocalPlayer
    end

    while not __devkageWorkspace.CurrentCamera do
        task.wait(0.1)
    end

    task.wait(0.25)
end

