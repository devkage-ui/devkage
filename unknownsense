local WorldMarkerObjectiveWords={"objective","capture","control","terminal","generator","bomb","flag","checkpoint","extract","exit","portal","quest"}

local function worldMarkerContains(name,words)
local lower=tostring(name or ""):lower()
for _,word in ipairs(words) do if lower:find(word,1,true) then return true end end
return false
end

local function worldMarkerCharacterObject(object)
local model=object and object:FindFirstAncestorOfClass("Model")
return model and model:FindFirstChildOfClass("Humanoid")~=nil
end

local function worldMarkerAnchor(object)
if not object then return nil,nil end
if object:IsA("ProximityPrompt") or object:IsA("ClickDetector") then
local parent=object.Parent
if parent and parent:IsA("Attachment") then parent=parent.Parent end
if parent and parent:IsA("BasePart") then return parent,parent end
end
if object:IsA("Tool") then
local handle=object:FindFirstChild("Handle") or object:FindFirstChildWhichIsA("BasePart",true)
return handle,object
end
if object:IsA("Model") then
local part=object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart",true)
return part,object
end
if object:IsA("BasePart") then return object,object end
return nil,nil
end

local function worldMarkerKind(object)
if not object or not object.Parent then return nil end
if tostring(object.Name):find("^DevKage") then return nil end
if worldMarkerCharacterObject(object) then return nil end
if (object:IsA("ProximityPrompt") or object:IsA("ClickDetector")) and VisualsState.world_object_esp_prompts then return "PROMPT" end
if VisualsState.world_object_esp_objectives and worldMarkerContains(object.Name,WorldMarkerObjectiveWords) then return "OBJECTIVE" end
if VisualsState.world_object_esp_loot and (object:IsA("Tool") or worldMarkerContains(object.Name,WorldMarkerLootWords)) then return "LOOT" end
return nil
end

local function worldMarkerColor(kind)
if kind=="PROMPT" then return VisualsState.world_object_esp_prompt_color end
if kind=="OBJECTIVE" then return VisualsState.world_object_esp_objective_color end
return VisualsState.world_object_esp_color
end

