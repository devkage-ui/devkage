local function ua_installDataSpoof()
    if UA.dataInstalled then return end
    UA.dataInstalled = true
    local DataController = UA.DataController
    UA.originalDataGet = DataController.Get
    UA.originalGetWeaponData = DataController.GetWeaponData

    local dataGetWrapper
    dataGetWrapper = function(self, key)
        if DataController.Get ~= dataGetWrapper then
            ua_markExternalStack()
            return UA.originalDataGet(self, key)
        end
        if not ua_isActiveInstance() then return UA.originalDataGet(self, key) end
        local data = UA.originalDataGet(self, key)
        if key == "CosmeticInventory" then
            local proxy = {}
            if type(data) == "table" then for k, v in pairs(data) do proxy[k] = v end end
            return setmetatable(proxy, {
                __index = function(_, k)
                    if ua_shouldSpoofCosmetic(k) then return true end
                    return nil
                end
            })
        end
        if key == "FavoritedCosmetics" and ua_weaponsEnabled() then
            local result = type(data) == "table" and ua_cloneTable(data) or {}
            for weapon, favs in pairs(UA.weaponFavorites) do
                result[weapon] = result[weapon] or {}
                for name, isFav in pairs(favs) do
                    if ua_isNotFinisher(name) and not ua_isEmote(nil, name) then result[weapon][name] = isFav end
                end
            end
            return result
        end
        return data
    end
    DataController.Get = dataGetWrapper
    UA.dataGetWrapper = dataGetWrapper

    if type(UA.originalGetWeaponData) == "function" then
        local weaponDataWrapper
        weaponDataWrapper = function(self, weaponName)
            if DataController.GetWeaponData ~= weaponDataWrapper then
                ua_markExternalStack()
                return UA.originalGetWeaponData(self, weaponName)
            end
            if not ua_isActiveInstance() then return UA.originalGetWeaponData(self, weaponName) end
            local data = UA.originalGetWeaponData(self, weaponName)
            if not data then return nil end

            local weaponCosmetics = ua_weaponsEnabled() and UA.weaponEquipped[weaponName] or nil
            if not weaponCosmetics then return data end

            local merged = {}
            for key, value in pairs(data) do merged[key] = value end
            merged.Name = weaponName

            if weaponCosmetics then
                for cosmeticType, cosmeticData in pairs(weaponCosmetics) do
                    merged[cosmeticType] = cosmeticData
                end
            end
            return merged
        end
        DataController.GetWeaponData = weaponDataWrapper
        UA.weaponDataWrapper = weaponDataWrapper
    end
end

local function ua_rebuildEmoteCatalog()
    local catalog = {}
    if UA.CosmeticLibrary and UA.CosmeticLibrary.Cosmetics then
        for name, cosmetic in pairs(UA.CosmeticLibrary.Cosmetics) do
            if cosmetic and ua_isNotFinisher(name) and ua_isEmote(cosmetic.Type, name) then
                catalog[name] = {
                    Name = name,
                    Type = cosmetic.Type,
                    ObjectID = cosmetic.ObjectID,
                    Enum = cosmetic.Enum,
                }
            end
        end
    end
    UA.emoteCatalog = catalog
    UA.emoteAugmentedTables = setmetatable({}, {__mode = "k"})
    return catalog
end

local function ua_applyEmoteSnapshot()
    if not ua_emotesEnabled() or not UA.EmoteController or not UA.CosmeticLibrary then return false end

    local catalog = UA.emoteCatalog
    if not catalog or not next(catalog) then
        catalog = ua_rebuildEmoteCatalog()
    end

    -- Do not replace GetEmotes. Ask the current controller (including any
    -- protected script's current state) for its live table and augment it.
    local ok, emotes = pcall(function()
        local getter = UA.EmoteController.GetEmotes
        if type(getter) ~= "function" then return nil end
        return getter(UA.EmoteController)
    end)

    if ok and type(emotes) == "table" then
        for name, entry in pairs(catalog) do
            if emotes[name] == nil then
                pcall(function() emotes[name] = entry end)
            end
        end
        UA.emoteLastTable = emotes
    end

    -- Best-effort ownership without wrapping DataController.Get.  Some games
    -- expose their live inventory tables directly; when they do, augment them
    -- in place.  If another script returns a proxy/readonly table, pcall keeps
    -- this harmless.
    if UA.DataController and type(UA.DataController.Get) == "function" then
        for _, key in ipairs({"CosmeticInventory", "EmoteInventory"}) do
            local got, inventory = pcall(function()
                return UA.DataController:Get(key)
            end)
            if got and type(inventory) == "table" then
                for name in pairs(catalog) do
                    if inventory[name] == nil then
                        pcall(function() inventory[name] = true end)
                    end
                end
            end
        end
    end

    return ok and type(emotes) == "table"
end

local function ua_startEmoteSnapshotLoop()
    if UA.emoteSnapshotStarted then
        return
    end
    UA.emoteSnapshotStarted = true

    task.spawn(function()
        while ua_isActiveInstance() do
            if ua_emotesEnabled() and UA.ready then
                pcall(ua_applyEmoteSnapshot)
            end
            task.wait(1)
        end
        UA.emoteSnapshotStarted = false
    end)
end

local function ua_installEmoteController()
    -- Black-box coexistence mode never replaces EmoteController.GetEmotes.
    -- It only augments the live table returned by whatever implementation is
    -- current after the protected script loads.
    if not UA.EmoteController then return end
    UA.emoteControllerInstalled = true
    ua_rebuildEmoteCatalog()
    ua_startEmoteSnapshotLoop()
    pcall(ua_applyEmoteSnapshot)
end

local function ua_syncWeaponEntry(weaponName, cosmeticType, cosmeticName, options)
    weaponName = tostring(weaponName or "")
    cosmeticType = tostring(cosmeticType or "")
    if weaponName == "" or cosmeticType == "" then return end
    UA.weaponLoadout[weaponName] = UA.weaponLoadout[weaponName] or {}
    UA.weaponEquipped[weaponName] = UA.weaponEquipped[weaponName] or {}

    if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
        UA.weaponLoadout[weaponName][cosmeticType] = nil
        UA.weaponEquipped[weaponName][cosmeticType] = nil
        if not next(UA.weaponLoadout[weaponName]) then UA.weaponLoadout[weaponName] = nil end
        if not next(UA.weaponEquipped[weaponName]) then UA.weaponEquipped[weaponName] = nil end
        return
    end

    options = type(options) == "table" and options or {}
    local cloned = ua_cloneCosmetic(cosmeticName, cosmeticType, {
        inverted = options.IsInverted,
        favoritesOnly = options.OnlyUseFavorites,
    })
    if not cloned then return end
    UA.weaponEquipped[weaponName][cosmeticType] = cloned
    UA.weaponLoadout[weaponName][cosmeticType] = {
        name = cosmeticName,
        seed = cloned.Seed,
        inverted = cloned.Inverted == true,
        favoritesOnly = cloned.OnlyUseFavorites == true,
    }
end

local function ua_recordEmote(args)
    if UA.replayingEmotes or not ua_emotesEnabled() then return end
    local weaponName, cosmeticType, cosmeticName, options = args[1], args[2], args[3], args[4]
    if not ua_isEmote(cosmeticType, cosmeticName) then return end

    local weaponKey = tostring(weaponName or "")
    local typeKey = tostring(cosmeticType or "Emote")
    local slot = (weaponKey ~= "" and weaponKey or "Default") .. "|" .. typeKey

    if not cosmeticName or cosmeticName == "" or cosmeticName == "None" then
        UA.emoteLoadout[slot] = nil
        if UA.emoteEquipped[weaponKey] then
            UA.emoteEquipped[weaponKey][typeKey] = nil
            if not next(UA.emoteEquipped[weaponKey]) then UA.emoteEquipped[weaponKey] = nil end
        end
        ua_environment().__DevKageEmoteLoadout = UA.emoteLoadout
        ua_environment().__DevKageEmoteEquipped = UA.emoteEquipped
        ua_requestReplicate("WeaponInventory")
        ua_requestReplicate("EmoteInventory")
        task.defer(UA.save)
        return
    end

    options = type(options) == "table" and options or {}
    cosmeticName = tostring(cosmeticName)

    UA.emoteLoadout[slot] = {
        weaponName = weaponKey,
        cosmeticType = typeKey,
        cosmeticName = cosmeticName,
        isInverted = options.IsInverted ]==================],
    [==================[== true,
        onlyUseFavorites = options.OnlyUseFavorites == true,
    }

    local cloned = ua_cloneCosmetic(cosmeticName, typeKey, {
        inverted = options.IsInverted,
        favoritesOnly = options.OnlyUseFavorites,
    })
    if cloned and weaponKey ~= "" then
        UA.emoteEquipped[weaponKey] = UA.emoteEquipped[weaponKey] or {}
        UA.emoteEquipped[weaponKey][typeKey] = cloned
    end

    ua_environment().__DevKageEmoteLoadout = UA.emoteLoadout
    ua_environment().__DevKageEmoteEquipped = UA.emoteEquipped

    ua_requestReplicate("WeaponInventory")
    ua_requestReplicate("EmoteInventory")
    task.defer(UA.save)
end

local function ua_installRemoteHooks()
    if UA.remoteHooksInstalled or type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then return end
    UA.remoteHooksInstalled = true

    local oldNamecall
    local callback

    callback = function(self, ...)
        -- One-way chaining only.  Never inspect the raw metatable and never
        -- jump around the current hook chain; those patterns can form cycles
        -- when a second script installs another __namecall hook after DevKage.
        if getnamecallmethod() ~= "FireServer" then
            return oldNamecall(self, ...)
        end

        -- Unrelated remotes go straight through with no DevKage work.
        if self ~= UA.EquipRemote and self ~= UA.FavoriteRemote then
            return oldNamecall(self, ...)
        end

        if not ua_isActiveInstance() or UA.externalStackDetected then
            return oldNamecall(self, ...)
        end

        local args = table.pack(...)
        local handled = false

