local function startRainbowAura()
destroyRainbowAura()
local config = getgenv().__DevKageConfig
RainbowAuraState.enabled = config.rainbowAuraEnabled == true
RainbowAuraState.mode = tostring(config.rainbowAuraMode or "Rainbow")
RainbowAuraState.color = auraColorFromConfig(config.rainbowAuraColor, Color3.fromRGB(255,80,220))
RainbowAuraState.secondaryColor = auraColorFromConfig(config.rainbowAuraSecondaryColor, Color3.fromRGB(90,170,255))
RainbowAuraState.alpha = math.clamp(tonumber(config.rainbowAuraAlpha) or 0.35, 0, 1)
RainbowAuraState.auraType = tostring(config.rainbowAuraType or "Character")
RainbowAuraState.speed = math.max(tonumber(config.rainbowAuraSpeed) or 1, 0.01)
RainbowAuraState.brightness = math.max(tonumber(config.rainbowAuraBrightness) or 2, 0)
RainbowAuraState.palette = tostring(config.rainbowAuraPalette or "Spectrum")
RainbowAuraState.quality = tostring(config.rainbowAuraQuality or "High")
RainbowAuraState.scale = math.clamp(tonumber(config.rainbowAuraScale) or 1,0.5,2.5)
RainbowAuraState.density = math.clamp(tonumber(config.rainbowAuraDensity) or 1,0.25,3)
RainbowAuraState.pulse = math.clamp(tonumber(config.rainbowAuraPulse) or 0.22,0,0.8)
RainbowAuraState.ground = config.rainbowAuraGround ~= false
RainbowAuraState.trails = config.rainbowAuraTrails ~= false

if not RainbowAuraState.enabled then
    return
end

if LocalPlayer.Character then
    task.spawn(function()
        applyRainbowAura(LocalPlayer.Character)
    end)
end

RainbowAuraState.characterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
    if not RainbowAuraState.enabled then return end
    task.wait(0.15)
    applyRainbowAura(character)
end)
end

