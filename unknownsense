    UA.originalOwnsCosmeticForWeapon = CosmeticLibrary.OwnsCosmeticForWeapon

    local ownsCosmeticWrapper
    ownsCosmeticWrapper = function(self, inventory, name, weapon)
        if CosmeticLibrary.OwnsCosmetic ~= ownsCosmeticWrapper then
            ua_markExternalStack()
            if UA.originalOwnsCosmetic then return UA.originalOwnsCosmetic(self, inventory, name, weapon) end
