function ELOAutoLoadRuntime:SetEnabled(enabled)
    local config = getgenv().__DevKageConfig
    if type(config) ~= "table" then return false end

    config.eloLiveSyncAutoLoad = enabled == true
    if enabled then
        SpooferState.savedELOAutoLoad = true
        SpooferState.savedELO = normalizeSpoofELO(config.elo)
    else
        SpooferState.savedELOAutoLoad = false
    end

    self:Stop()

    if not enabled then return true end

    config.eloLiveSync = true
    self:ApplyOnce(true)




    self.Connection = RunService.Heartbeat:Connect(function(deltaTime)
        local current = getgenv().__DevKageConfig
        if type(current) ~= "table" then return end

        if current.eloLiveSyncAutoLoad ~= true and SpooferState.savedELOAutoLoad ~= true then
            self:Stop()
            return
        end

        if SpooferState.savedELOAutoLoad == true then
            current.eloLiveSyncAutoLoad = true
            if SpooferState.savedELO ~= nil then
                current.elo = normalizeSpoofELO(SpooferState.savedELO)
            end
        end
        current.eloLiveSync = true
        current.spoofELO = true
        current.rankDisplay = "Use Spoofed ELO"

        local dt = tonumber(deltaTime) or 0
        self.Elapsed = self.Elapsed + dt
        self.PresentationElapsed = self.PresentationElapsed + dt

        if self.Elapsed >= 0.75 then
            self.Elapsed = 0
            self:ApplyOnce(false)
        end

        if self.PresentationElapsed >= 2.5 then
            self.PresentationElapsed = 0
            self:ApplyOnce(true)
        end
    end)

    if type(MaskShard) == "table" and type(MaskShard.Connections) == "table" then
        MaskShard.Connections[#MaskShard.Connections + 1] = self.Connection
    end

    return true
end

