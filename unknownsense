            local mouse = pointerPosition(input)
            if kind == "sv" then
                local width = math.max(SV.AbsoluteSize.X,1)
                local height = math.max(SV.AbsoluteSize.Y,1)
                sat = math.clamp((mouse.X - SV.AbsolutePosition.X) / width,0,1)
                val = 1 - math.clamp((mouse.Y - SV.AbsolutePosition.Y) / height,0,1)
            elseif kind == "hue" then
                local height = math.max(Hue.AbsoluteSize.Y,1)
                hue = math.clamp((mouse.Y - Hue.AbsolutePosition.Y) / height,0,1)
            elseif kind == "alpha" then
                local height = math.max(AlphaBar.AbsoluteSize.Y,1)
                Content.Alpha = math.clamp((mouse.Y - AlphaBar.AbsolutePosition.Y) / height,0,1)
            end
            redraw(true)
