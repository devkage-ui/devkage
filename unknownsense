local function refreshRapidFireWeapons(preferEquipped, loadModule)
    local names = rapidFireWeaponNames(loadModule == true)
    RapidFireRuntime.WeaponOptions = names

    if rapidFireWeaponDrop then
        rapidFireWeaponDrop.Options = names
    end

    local config = getgenv().__DevKageConfig
    local wanted = tostring(config.rapidFireSelectedWeapon or "")

    local equipped = rapidFireGetEquippedTool()
    if preferEquipped and equipped then
        wanted = tostring(equipped.Name)
    end

    local index = 1
    for i, name in ipairs(names) do
        if tostring(name) == wanted then
            index = i
            break
        end
    end

    if rapidFireWeaponDrop then
        rapidFireWeaponDrop:Set(index, true)
        RapidFireRuntime.SelectedWeapon =
            tostring(rapidFireWeaponDrop:GetValue() or "")
    else
        RapidFireRuntime.SelectedWeapon = tostring(names[index] or "")
    end

    config.rapidFireSelectedWeapon = RapidFireRuntime.SelectedWeapon

    if rapidFireRateSlider then
        rapidFireRateSlider:Set(
            rapidFireDelayPercent(RapidFireRuntime.SelectedWeapon),
            true
        )
    end

    rapidFireUpdateStatus(RapidFireRuntime.SelectedWeapon)
end

