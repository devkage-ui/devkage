local function save_config_file(name, cfg)
name = tostring(name or ""):gsub("[^%w_%-]", "")
if name == "" then return false, "Enter a valid config name" end
if name:sub(1,1)=="_" then return false,"Config names cannot start with an underscore" end
local folderOk, folderError = ensure_folder()
if not folderOk then return false, folderError end
if type(writefile) ~= "function" then return false, "This executor does not provide file writing" end
local data = gather_state(cfg)
local encodedOk, encoded = pcall(function() return HttpService:JSONEncode(data) end)
if not encodedOk then return false, "Could not encode config: " .. tostring(encoded) end
local wrote, writeError = pcall(writefile, CONFIG_FOLDER .. "/" .. name .. ".json", encoded)
if not wrote then return false, "Could not save config: " .. tostring(writeError) end
pcall(UA.save)
return true
end

local function configColorFromTable(value, fallback)
if typeof(value) == "Color3" then return value end
if type(value) == "table" then
local r, g, b = tonumber(value[1]), tonumber(value[2]), tonumber(value[3])
if r and g and b then
return Color3.fromRGB(math.clamp(r,0,255), math.clamp(g,0,255), math.clamp(b,0,255))
end
end
return fallback
end

local function applyRuntimeState(target, source)
if type(source) ~= "table" then return end
for key, value in pairs(source) do
if target[key] ~= nil then
local targetType = typeof(target[key])
if targetType == "Color3" then
target[key] = configColorFromTable(value, target[key])
elseif targetType == "boolean" then
target[key] = value == true
elseif targetType == "number" then
target[key] = tonumber(value) or target[key]
elseif targetType == "string" then
target[key] = tostring(value)
end
end
end
end

local function load_config_file(name)
name = tostring(name or ""):gsub("[^%w_%-]", "")
if name == "" then return false, "Invalid config name" end
if name:sub(1,1)=="_" then return false,"Config names cannot start with an underscore" end
