        if self:KeyDown(Enum.KeyCode.D)]==================],
    [==================[ or self:KeyDown(Enum.KeyCode.Right) then rawX = rawX + 1 end
        if self:KeyDown(Enum.KeyCode.A) or self:KeyDown(Enum.KeyCode.Left) then rawX = rawX - 1 end
        if self:KeyDown(Enum.KeyCode.W) or self:KeyDown(Enum.KeyCode.Up) then rawZ = rawZ + 1 end
        if self:KeyDown(Enum.KeyCode.S) or self:KeyDown(Enum.KeyCode.Down) then rawZ = rawZ - 1 end
