end

local function compileLuaSource(source)
local compiler=loadstring or load
if type(compiler)~="function" then return false,nil,"compiler unavailable" end
local ok,fn,compileError=pcall(compiler,source,"DevKageLuaEditor")
if not ok then ok,fn,compileError=pcall(compiler,source) end
if not ok then return false,nil,tostring(fn) end
if type(fn)~="function" then return false,nil,tostring(compileError or "compile failed") end
return true,fn,nil
end

local function executeLuaEditor()
local source=tostring(luaEditor.Text or "")
if source:match("^%s*$") then setLuaStatus("Nothing to execute"); return end
getgenv().__DevKageConfig.luaCode=source
local compiled,fn,compileError=compileLuaSource(source)
if not compiled then
setLuaStatus("Compile error • " .. tostring(compileError):gsub("[\r\n]+"," "):sub(1,100))
warn("[DevKage Lua] Compile error:",compileError)
return
end
luaExecutionToken=luaExecutionToken+1
local token=luaExecutionToken
local started=os.clock()
setLuaStatus("Running")
luaExecutionThread=task.spawn(function()
local ran,runtimeError=xpcall(fn,function(err)
return debug and debug.traceback and debug.traceback(tostring(err),2) or tostring(err)
end)
if token~=luaExecutionToken then return end
luaExecutionThread=nil
if ran then
setLuaStatus(string.format("Completed in %.3fs",os.clock()-started))
else
setLuaStatus("Runtime error • " .. tostring(runtimeError):gsub("[\r\n]+"," "):sub(1,100))
warn("[DevKage Lua] Runtime error:\n"..tostring(runtimeError))
end
end)
end

local function stopLuaExecution(showStatus)
luaExecutionToken=luaExecutionToken+1
if luaExecutionThread and type(task.cancel)=="function" then pcall(task.cancel,luaExecutionThread) end
luaExecutionThread=nil
if showStatus then setLuaStatus("Stopped") end
end

