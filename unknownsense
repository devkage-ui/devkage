local function referenceUpdateRotation(settings, deltaTime)
    local runtime =
        ReferenceCursorRuntime

    local angleOffset =
        referenceCursorNumber(
            settings.AngleOffset,
            0,
            0,
            360
        )

    if settings.Spin ~= true then
        runtime.currentRotationSpeed = 0

        runtime.smoothedRotation =
            angleOffset

        return
            angleOffset
    end





    local baseRotationSpeed =
        referenceCursorNumber(
            settings.SpinSpeed,
            288,
            0,
            360
        ) / 360

    if runtime.currentRotationSpeed <= 0 then
        runtime.currentRotationSpeed =
            baseRotationSpeed
    end

    local direction =
        tostring(
            settings.SpinDirection
            or "Clockwise"
        ) == "Counter Clockwise"
        and -1
        or 1



    runtime.rotationProgress =
        (
            runtime.rotationProgress
            + runtime.currentRotationSpeed
                * deltaTime
                * direction
        ) % 1

    runtime.currentRotationSpeed =
        referenceCalculateRotationSpeed(
            runtime.rotationProgress,
            baseRotationSpeed
        )

    local spinRange =
        referenceCursorNumber(
            settings.SpinRange,
            360,
            1,
            360
        )

    local style =
        tostring(
            settings.SpinStyle
            or "Static"
        )

    local targetRotation

    if style == "Ping Pong" then
        targetRotation =
            angleOffset
            + math.sin(
                runtime.rotationProgress
                * math.pi
                * 2
            )
            * (spinRange * 0.5)
    elseif style == "Stepped" then
        local arms =
            math.max(
                1,
                math.floor(
                    referenceCursorNumber(
                        settings.ArmCount,
                        4,
                        1,
                        12
                    ) + 0.5
                )
            )

        local step =
            spinRange
            / arms

        targetRotation =
            angleOffset
            + math.floor(
                (
                    runtime.rotationProgress
                    * spinRange
                ) / step
            ) * step
    else

        targetRotation =
            angleOffset
            + runtime.rotationProgress
                * spinRange
    end




    local smoothing =
        settings.SmoothSpin == true
        and math.clamp(
            deltaTime * 12,
            0,
            1
        )
        or 1

    runtime.smoothedRotation =
        referenceSmoothRotation(
            runtime.smoothedRotation,
            targetRotation,
            smoothing
        )

    return
        runtime.smoothedRotation
end





local function referenceRouteCursorLayer()
    local runtime = ReferenceCursorRuntime
    if not runtime.ScreenGui or not runtime.AimContainer then return end






    local menuGui = library.Window and library.Window.ScreenGui
    local target = (library.Window and library.Window.Enabled == true and menuGui and menuGui.Parent)
        and menuGui
        or runtime.ScreenGui

    for _, object in ipairs({runtime.AimContainer, runtime.MainText, runtime.SecondText}) do
        if object and object.Parent ~= target then
            pcall(function() object.Parent = target end)
        end
    end
end





local function referenceCursorRender(deltaTime)
    local runtime =
        ReferenceCursorRuntime

    if not runtime.Running then return end

    local dt =
        math.max(
            tonumber(deltaTime) or 0,
            0
        )

    local revision =
        tonumber(
            cursorBridge.Revision
        ) or 0

    if runtime.Revision ~= revision then
        runtime.Revision = revision
        referenceCursorReadSettings()
    end

    local settings =
        runtime.Settings

    if next(settings) == nil then
        referenceCursorReadSettings()
        settings = runtime.Settings
    end

    runtime.LastGuiCheck =
        runtime.LastGuiCheck
        + dt

    if not runtime.ScreenGui
        or runtime.ScreenGui.Parent == nil
        or not runtime.AimContainer
        or runtime.AimContainer.Parent == nil then

        if runtime.LastGuiCheck >= 0.10 then
            runtime.LastGuiCheck = 0
            referenceCreateCursorGui()
        end
    elseif runtime.LastGuiCheck >= 1 then
        runtime.LastGuiCheck = 0
    end

    if not runtime.ScreenGui
        or not runtime.AimContainer then

        referenceSetBridgeOwnership(false)
        return
    end

    local enabled =
        settings.Enabled ~= false

    referenceRouteCursorLayer()





    if library.Window and library.Window.Enabled == true then
        pcall(function()
            if uis.MouseBehavior ~= Enum.MouseBehavior.Default then
                uis.MouseBehavior = Enum.MouseBehavior.Default
            end
        end)
    end

    runtime.ScreenGui.Enabled =
        enabled

    local menuOpen = library.Window and library.Window.Enabled == true

    referenceSetBridgeOwnership(
        enabled and not menuOpen
    )

    referenceApplyNativeMouseState(
        enabled and not menuOpen
    )

    if runtime.AimContainer then runtime.AimContainer.Visible = enabled and not menuOpen end
    if menuOpen then
        if runtime.MainText then runtime.MainText.Visible = false end
        if runtime.SecondText then runtime.SecondText.Visible = false end
        return
    end

    if not enabled then
        return
    end

    runtime.time =
        runtime.time
        + dt

    local cursorPosition =
        referenceCursorPosition(
            settings
        )

    runtime.AimContainer.Position =
        UDim2.new(
            0,
            cursorPosition.X,
            0,
            cursorPosition.Y
        )

    local centerRadius =
        referenceCursorNumber(
            settings.CenterRadius,
            12.5,
            0,
            60
        )

    local squashX =
        referenceCursorNumber(
            settings.SquashX,
            1,
            0.25,
            2
        )

    local squashY =
        referenceCursorNumber(
            settings.SquashY,
            1,
            0.25,
            2
        )


    runtime.AimContainer.Size =
        UDim2.new(
            0,
            centerRadius
                * 2
                * squashX,
            0,
            centerRadius
                * 2
                * squashY
        )

    runtime.AimContainer.Rotation =
        referenceUpdateRotation(
            settings,
            dt
        )

    local lineThickness =
        referenceCursorNumber(
            settings.LineWidth,
            3,
            1,
            10
        )

    local lineLength =
        referenceCursorNumber(
            settings.LineLength,
            25,
            1,
            100
        )

    local pulseSpeed =
        referenceCursorNumber(
            settings.PulseSpeed,
            2.5,
            0,
            8
        )

    local pulse =
        pulseSpeed > 0
        and referenceSmoothPulse(
            runtime.time,
            pulseSpeed
        )
        or 0








    local minLength =
        -(lineLength * 0.4)

    local maxLength =
        -(lineLength * 1.2)

    local currentLength =
        minLength
        + (
            maxLength
            - minLength
        ) * pulse

    local armCount =
        referenceEnsureExtraArmCount(
            settings.ArmCount
        )

    if armCount == 4 then
        referenceApplyFourArmLayout(
            settings,
            currentLength,
            lineThickness
        )
    else
        referenceApplyRadialLayout(
            settings,
            currentLength,
            lineThickness,
            armCount
        )
    end

    local firstColor =
        referenceResolveColor(
            settings,
            runtime.time,
            1,
            armCount
        )

    for index, line in ipairs(runtime.Lines) do
        local visible =
            index <= armCount

        line.Frame.Visible =
            visible

        if visible then
            local color =
                referenceResolveColor(
                    settings,
                    runtime.time,
                    index,
                    armCount
                )

            line.Frame.BackgroundColor3 =
                color

            referenceApplyGlow(
                settings,
                line,
                color,
                armCount == 4
            )
        else
            line.Glow.Visible = false
        end
    end

    referenceApplyText(
      ]==================],
    [==================[  settings,
        cursorPosition,
        firstColor
    )
end





function ReferenceCursorRuntime:Stop()
    if not self.Running then
        return true
    end

    self.Running = false

    referenceSetBridgeOwnership(
        false
    )

    referenceApplyNativeMouseState(
        false
    )

    referenceDestroyCursorGui()

    if cursorBridgeEnv.__DevKageIntegratedCursorRuntime == self then
        cursorBridgeEnv.__DevKageIntegratedCursorRuntime = nil
    end

    if type(MaskShard) == "table"
        and type(MaskShard.Runtime) == "table"
        and MaskShard.Runtime.CursorRenderer == self then

        MaskShard.Runtime.CursorRenderer = nil
    end

    return true
end

