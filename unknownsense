            return math.clamp(math.floor((tonumber(value) or 0) + 0.5), 0, 255)
        end

        local function writeBoxes()
            rBox.Text = tostring(math.floor(Content.State.R * 255 + 0.5))
            gBox.Text = tostring(math.floor(Content.State.G * 255 + 0.5))
            bBox.Text = tostring(math.floor(Content.State.B * 255 + 0.5))
            aBox.Text = tostring(math.floor(Content.Alpha * 100 + 0.5))
        end

        local function redraw(invokeCallback)
            local color = Color3.fromHSV(hue,sat,val)
            Content.State = color
            Holder_Outline_Frame.BackgroundColor3 = color
            Holder_Outline_Frame.BackgroundTransparency = Content.Alpha
            SV.BackgroundColor3 = Color3.fromHSV(hue,1,1)
            AlphaBar.BackgroundColor3 = color
            Preview.BackgroundColor3 = color
            Preview.BackgroundTransparency = Content.Alpha
            SVMarker.Position = UDim2.new(sat,0,1-val,0)
            HueMarker.Position = UDim2.new(0,-2,hue,0)
            AlphaMarker.Position = UDim2.new(0,-2,Content.Alpha,0)
            if invokeCallback ~= false then
                utility:SafeCallback(Content.Callback, Content.State, Content.Alpha)
            end
        end

        local function pointerPosition(input)
            if input and input.Position then
                return Vector2.new(input.Position.X, input.Position.Y)
            end
            local mouse = uis:GetMouseLocation()
            return Vector2.new(mouse.X, mouse.Y)
        end

        local function refreshFromPointer(kind, input)
            local mouse = pointerPosition(input)
            if kind == "sv" then
                local width = math.max(SV.AbsoluteSize.X,1)
                local height = math.max(SV.AbsoluteSize.Y,1)
                sat = math.clamp((mouse.X - SV.AbsolutePosition.X) / width,0,1)
                val = 1 - math.clamp((mouse.Y - SV.AbsolutePosition.Y) / height,0,1)
            elseif kind == "hue" then
                local height = math.max(Hue.AbsoluteSize.Y,1)
                hue = math.clamp((mouse.Y - Hue.AbsolutePosition.Y) / height,0,1)
            elseif kind == "alpha" then
                local height = math.max(AlphaBar.AbsoluteSize.Y,1)
                Content.Alpha = math.clamp((mouse.Y - AlphaBar.AbsolutePosition.Y) / height,0,1)
            end
            redraw(true)
            writeBoxes()
        end

        function Content:Set(state, alpha, silent)
            if type(state) == "table" then
                alpha = state.Alpha or state.alpha or alpha
                state = state.Color or state.color
            end
            if typeof(state) ~= "Color3" then return false end
            if alpha ~= nil then
                Content.Alpha = math.clamp(tonumber(alpha) or 0,0,1)
            end
            Content.State = state
            hue,sat,val = Color3.toHSV(state)
            redraw(silent ~= true)
            writeBoxes()
            return true
        end

        function Content:Get()
            return Content.State
        end

        function Content:GetAlpha()
            return Content.Alpha
        end

        local function positionPopup()
            if not Popup.Visible then return end
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1920,1080)
            local holderPos = Content_Holder.AbsolutePosition
            local holderSize = Content_Holder.AbsoluteSize
            local popupW, popupH = 238, 220
            local x = holderPos.X + holderSize.X - popupW
            local y = holderPos.Y + holderSize.Y + 4
            if y + popupH > viewport.Y - 4 then
                y = holderPos.Y - popupH - 4
            end
            x = math.clamp(x,4,math.max(4,viewport.X-popupW-4))
            y = math.clamp(y,4,math.max(4,viewport.Y-popupH-4))
            Popup.Position = UDim2.fromOffset(math.floor(x),math.floor(y))
        end

        local function inside(guiObject, position)
            local p = guiObject.AbsolutePosition
            local s = guiObject.AbsoluteSize
            return position.X >= p.X and position.X <= p.X+s.X
                and position.Y >= p.Y and position.Y <= p.Y+s.Y
        end

        function Content.Content:Refresh()
            redraw(false)
            writeBoxes()
        end

        function Content.Content:Close()
            Content.Content.Open = false
            Popup.Visible = false
            dragging = nil
            dragInput = nil
            if outsideConnection then
                pcall(function() outsideConnection:Disconnect() end)
                outsideConnection = nil
            end
            if popupFollowConnection then
                pcall(function() popupFollowConnection:Disconnect() end)
                popupFollowConnection = nil
            end
        end

        local function openPicker()
            Content.Section:CloseContent()
            Content.Content.Open = true
            Content.Section.Content = Content.Content
            Popup.Visible = true
            hue,sat,val = Color3.toHSV(Content.State)
            positionPopup()
            redraw(false)
            writeBoxes()
            if not popupFollowConnection then
                popupFollowConnection = game:GetService("RunService").RenderStepped:Connect(function()
                    if Popup.Visible then positionPopup() end
                end)
                table.insert(library.Connections, popupFollowConnection)
            end
            task.defer(function()
                if not Content.Content.Open then return end
                outsideConnection = uis.InputBegan:Connect(function(input)
                    if not Content.Content.Open then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    local p = pointerPosition(input)
                    if not inside(Popup,p) and not inside(Content_Holder,p) then
                        Content.Content:Close()
                        if Content.Section.Content == Content.Content then
                            Content.Section.Content = {}
                        end
                    end
                end)
            end)
        end

        utility:CreateConnection(Content_Holder_Button.Activated, function()
            if Content.Content.Open then
                Content.Content:Close()
                if Content.Section.Content == Content.Content then
                    Content.Section.Content = {}
                end
            else
                openPicker()
            end
        end)

        local function beginDrag(kind, input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging = kind
            dragInput = input.UserInputType == Enum.UserInputType.Touch and input or nil
            refreshFromPointer(kind,input)
        end

        utility:CreateConnection(SVHit.InputBegan, function(input) beginDrag("sv",input) end)
        utility:CreateConnection(HueHit.InputBegan, function(input) beginDrag("hue",input) end)
        utility:CreateConnection(AlphaHit.InputBegan, function(input) beginDrag("alpha",input) end)

        utility:CreateConnection(uis.InputChanged, function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                refreshFromPointer(dragging,input)
            elseif input.UserInputType == Enum.UserInputType.Touch and input == dragInput then
                refreshFromPointer(dragging,input)
            end
        end)

        utility:CreateConnection(uis.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or (input.UserInputType == Enum.UserInputType.Touch and (not dragInput or input == dragInput)) then
                dragging = nil
                dragInput = nil
            end
        end)

        local function commitRGB()
            local color = Color3.fromRGB(clampByte(rBox.Text),clampByte(gBox.Text),clampByte(bBox.Text))
            hue,sat,val = Color3.toHSV(color)
            redraw(true)
            writeBoxes()
        end

        local function commitAlpha()
            Content.Alpha = math.clamp(tonumber(aBox.Text) or 0,0,100) / 100
            redraw(true)
            writeBoxes()
        end

        utility:CreateConnection(rBox.FocusLost,commitRGB)
        utility:CreateConnection(gBox.FocusLost,commitRGB)
        utility:CreateConnection(bBox.FocusLost,commitRGB)
        utility:CreateConnection(aBox.FocusLost,commitAlpha)

        Content:Set(Content.State,Content.Alpha,true)
    end

    return utility:RegisterControl(Content, Properties)
end

function sections:CreateInput(Properties)
    Properties = Properties or {}
    local Content = {
        Name        = Properties.name or Properties.Name or Properties.title or Properties.Title or "Input",
        Value       = tostring(utility:GetProperty(Properties, {"default", "Default", "state", "State", "value", "Value"}, "")),
