RunService.RenderStepped:Wait()
end
if token==blacklistFlashToken and blacklistFlashFrame.Parent then
blacklistFlashFrame.Visible=false
blacklistFlashFrame.BackgroundTransparency=1
blacklistFlashStroke.Transparency=1
blacklistFlashLabel.TextTransparency=1
end
end)
end

