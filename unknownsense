local installed = {}
local seen = {}

local function tryWrite(folder)
if seen[folder] then return end
seen[folder] = true

-- Only use a folder the executor already exposes. Never create a guessed
-- "autoexec" folder and report success when the executor will not execute it.
if type(isfolder) ~= "function" then return end
