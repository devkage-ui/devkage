KnifeCombatRuntime.StepBunnyHop = function(dt)
    local config = Environment.__DevKageConfig
    if type(config) ~= "table" or config.bunnyHopEnabled ~= true then return end

    local focused
    pcall(function() focused = UserInputService:GetFocusedTextBox() end)
    if focused then return end
    if not UserInputService:IsKeyDown(Enum.KeyCode.Space) then return end

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return end

    local state = humanoid:GetState()
    local onGround = humanoid.FloorMaterial ~= Enum.Material.Air
        or state == Enum.HumanoidStateType.Running
        or state == Enum.HumanoidStateType.RunningNoPhysics
        or state == Enum.HumanoidStateType.Landed

    if onGround then
        humanoid.Jump = true
        pcall(humanoid.ChangeState, humanoid, Enum.HumanoidStateType.Jumping)
        return
    end

    local velocity = root.AssemblyLinearVelocity
    local horizontal = Vector3.new(velocity.X,0,velocity.Z)
    local speed = horizontal.Magnitude

    local moveDirection = humanoid.MoveDirection
    local direction
    if moveDirection.Magnitude > 0.05 then
        direction = Vector3.new(moveDirection.X,0,moveDirection.Z).Unit
    elseif speed > 0.05 then
        direction = horizontal.Unit
    else
        return
    end

    local maxSpeed = math.clamp(tonumber(config.bunnyHopMaxSpeed) or 28,16,120)
    local boost = math.clamp(tonumber(config.bunnyHopBoost) or 0.4,0,3)
    local frameScale = math.clamp((tonumber(dt) or (1/60)) * 60,0.25,4)

    -- Start from the character's actual horizontal speed. When a custom
    -- controller zeroes horizontal velocity during the jump, use WalkSpeed as
    -- a conservative baseline instead of doing nothing.
    local baseSpeed = speed
    if baseSpeed < 0.1 then
        baseSpeed = math.min(math.max(tonumber(humanoid.WalkSpeed) or 16,16),maxSpeed)
    end

    local newSpeed = math.min(baseSpeed + boost * frameScale,maxSpeed)
    local newVelocity = Vector3.new(
        direction.X * newSpeed,
        velocity.Y,
        direction.Z * newSpeed
    )

    pcall(function() root.AssemblyLinearVelocity = newVelocity end)
    -- Compatibility fallback for controllers that still observe BasePart.Velocity.
    pcall(function() root.Velocity = newVelocity end)
end

KnifeCombatRuntime.UninstallNoSpread = function()
    if KnifeCombatRuntime.SpreadInstalled
        and type(KnifeCombatRuntime.GameplayUtility) == "table"
        and KnifeCombatRuntime.GameplayUtility.GetSpread == KnifeCombatRuntime.SpreadWrapper
        and type(KnifeCombatRuntime.OriginalGetSpread) == "function" then
        KnifeCombatRuntime.GameplayUtility.GetSpread = KnifeCombatRuntime.OriginalGetSpread
    end
    KnifeCombatRuntime.SpreadInstalled = false
    KnifeCombatRuntime.SpreadWrapper = nil
    KnifeCombatRuntime.OriginalGetSpread = nil
end

KnifeCombatRuntime.InstallNoSpread = function()
    local config=Environment.__DevKageConfig
    if not KnifeCombatRuntime.Alive or type(config)~="table"
        or config.noSpreadEnabled~=true then
        return false
    end

    if KnifeCombatRuntime.IsRivals() then
        local modules=ReplicatedStorage:FindFirstChild("Modules")
        local gameplayScript=modules and modules:FindFirstChild("GameplayUtility")
        if not gameplayScript or not gameplayScript:IsA("ModuleScript") then return false end

        local ok,gameplay=pcall(require,gameplayScript)
        if not ok or type(gameplay)~="table" or type(gameplay.GetSpread)~="function" then
            return false
        end

        local bridge=Environment.__DevKageRivalsNativeCombat
        if type(bridge)~="table" then
            bridge={Runtime=KnifeCombatRuntime}
            Environment.__DevKageRivalsNativeCombat=bridge
        end

        bridge.Runtime=KnifeCombatRuntime

        if bridge.Gameplay==gameplay
            and type(bridge.SpreadWrapper)=="function"
            and gameplay.GetSpread==bridge.SpreadWrapper then
            KnifeCombatRuntime.RivalsNativeCombatBridge=bridge
            KnifeCombatRuntime.GameplayUtility=gameplay
            KnifeCombatRuntime.SpreadWrapper=bridge.SpreadWrapper
            KnifeCombatRuntime.SpreadInstalled=true
            return true
        end

        bridge.Gameplay=gameplay
        bridge.SpreadOriginal=gameplay.GetSpread
        bridge.SpreadWrapper=function(spread,aimMultiplier,isAiming,isCrouching,pelletIndex,totalPellets,consistent,...)
            local runtime=bridge.Runtime
            local liveConfig=Environment.__DevKageConfig
            if runtime and runtime.Alive
                and Environment.__DevKageCombatRuntime==runtime
                and type(liveConfig)=="table"
                and liveConfig.noSpreadEnabled==true then
                return ZeroCFrame
            end
            return bridge.SpreadOriginal(
                spread,aimMultiplier,isAiming,isCrouching,pelletIndex,totalPellets,consistent,...
            )
        end

        gameplay.GetSpread=bridge.SpreadWrapper
        KnifeCombatRuntime.RivalsNativeCombatBridge=bridge
        KnifeCombatRuntime.GameplayUtility=gameplay
        KnifeCombatRuntime.OriginalGetSpread=bridge.SpreadOriginal
        KnifeCombatRuntime.SpreadWrapper=bridge.SpreadWrapper
        KnifeCombatRuntime.SpreadInstalled=true
        return true
    end

    local gameplay=KnifeCombatRuntime.GameplayUtility
    if type(gameplay)~="table" or type(gameplay.GetSpread)~="function" then return false end
    if KnifeCombatRuntime.SpreadInstalled and gameplay.GetSpread==KnifeCombatRuntime.SpreadWrapper then
        return true
    end

    local original=gameplay.GetSpread
    local wrapper
    wrapper=function(...)
        local liveConfig=Environment.__DevKageConfig
        if KnifeCombatRuntime.Alive and type(liveConfig)=="table"
            and liveConfig.noSpreadEnabled==true then
            return ZeroCFrame
        end
        return original(...)
    end

    KnifeCombatRuntime.OriginalGetSpread=original
    KnifeCombatRuntime.SpreadWrapper=wrapper
    gameplay.GetSpread=wrapper
    KnifeCombatRuntime.SpreadInstalled=true
    return true
end

KnifeCombatRuntime.LoadModules = function()
    if not KnifeCombatRuntime.Alive or not KnifeCombatRuntime.IsRivals() then return false end
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local utilityModule = modules and modules:FindFirstChild("Utility")
    local enumModule = modules and modules:FindFirstChild("EnumLibrary")
    local gameplayModule = modules and modules:FindFirstChild("GameplayUtility")
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local controllers = playerScripts and playerScripts:FindFirstChild("Controllers")
    local fighterModule = controllers and controllers:FindFirstChild("FighterController")
    if utilityModule and utilityModule:IsA("ModuleScript") then
        local ok, value = pcall(require, utilityModule)
        if ok and type(value) == "table" then KnifeCombatRuntime.Utility = value end
    end
    if enumModule and enumModule:IsA("ModuleScript") then
        local ok, value = pcall(require, enumModule)
        if ok and type(value) == "table" then KnifeCombatRuntime.EnumLibrary = value end
    end
    if gameplayModule and gameplayModule:IsA("ModuleScript") then
        local ok, value = pcall(require, gameplayModule)
        if ok and type(value) == "table" then KnifeCombatRuntime.GameplayUtility = value end
    end
    if fighterModule and fighterModule:IsA("ModuleScript") then
        local ok, value = pcall(require, fighterModule)
        if ok and type(value) == "table" then KnifeCombatRuntime.FighterController = value end
    end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local replication = remotes and remotes:FindFirstChild("Replication")
    local fighterRemotes = replication and replication:FindFirstChild("Fighter")
    local useItem = fighterRemotes and fighterRemotes:FindFirstChild("UseItem")
    KnifeCombatRuntime.UseItemRemote =
        useItem and useItem:IsA("RemoteEvent") and useItem or nil
    KnifeCombatRuntime.Loaded =
        type(KnifeCombatRuntime.Utility) == "table"
        and type(KnifeCombatRuntime.EnumLibrary) == "table"
        and type(KnifeCombatRuntime.FighterController) == "table"
        and KnifeCombatRuntime.UseItemRemote ~= nil
    KnifeCombatRuntime.InstallNoSpread()
    return KnifeCombatRuntime.Loaded
end

KnifeCombatRuntime.QueueModuleLoad = function(force)
    if KnifeCombatRuntime.Loading or not KnifeCombatRuntime.Alive then return end
    local now = os.clock()
    if not force and now < KnifeCombatRuntime.NextLoadAttempt then return end
    KnifeCombatRuntime.NextLoadAttempt = now + 1
    KnifeCombatRuntime.Loading = true
    task.spawn(function()
        local ok, loaded = pcall(KnifeCombatRuntime.LoadModules)
        KnifeCombatRuntime.Loading = false
        if not KnifeCombatRuntime.Alive then return end
        if not ok then
            KnifeCombatRuntime.SetStatus("Combat modules failed to load")
        elseif loaded then
            KnifeCombatRuntime.SetStatus("RIVALS combat modules ready")
        elseif KnifeCombatRuntime.IsRivals() then
            KnifeCombatRuntime.SetStatus("Waiting for RIVALS match modules")
        else
            KnifeCombatRuntime.SetStatus("Generic combat helpers ready")
        end
    end)
end

KnifeCombatRuntime.GetLocalFighter = function()
