local function createLocalSpoofVisual(player, userId)
    if not player then return false, "player missing" end

    local uid = tonumber(userId)
    if not uid or uid <= 0 then return false, "invalid avatar id" end
    uid = math.floor(uid)

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid then return false, "character not ready" end

    SpooferState.visualToken = (SpooferState.visualToken or 0) + 1
    local token = SpooferState.visualToken

    if SpooferState.avatarCharacter ~= character or not SpooferState.originalAvatarDescription then
        local okOriginal, original = pcall(function()
            return humanoid:GetAppliedDescription()
        end)
        if okOriginal and original then
            SpooferState.avatarCharacter = character
            SpooferState.originalAvatarDescription = original
        end
    end

    local okAppearance, appearance = pcall(function()
        return Players:GetCharacterAppearanceAsync(uid)
    end)
    if token ~= SpooferState.visualToken or player.Character ~= character then
        if appearance then pcall(function() appearance:Destroy() end) end
        return false, "superseded"
    end
    if not okAppearance or not appearance then
        return false, "avatar appearance failed"
    end

    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Accessory")
            or object:IsA("Shirt")
            or object:IsA("Pants")
            or object:IsA("ShirtGraphic")
            or object:IsA("BodyColors")
            or object:IsA("CharacterMesh") then
            pcall(function() object:Destroy() end)
        end
    end

    for _, object in ipairs(appearance:GetChildren()) do
        if object:IsA("Shirt")
            or object:IsA("Pants")
            or object:IsA("ShirtGraphic")
            or object:IsA("BodyColors")
            or object:IsA("CharacterMesh") then
            pcall(function() object.Parent = character end)
        elseif object:IsA("Accessory") then
            pcall(function() humanoid:AddAccessory(object) end)
        elseif object:IsA("MeshPart") then
            local livePart = character:FindFirstChild(object.Name)
            if livePart and livePart:IsA("MeshPart") then
                pcall(function() livePart.MeshId = object.MeshId end)
                pcall(function() livePart.TextureID = object.TextureID end)
            end
        end
    end

    local fetchedFace = appearance:FindFirstChild("face", true)
    local liveHead = character:FindFirstChild("Head")
    if fetchedFace and fetchedFace:IsA("Decal") and liveHead then
        local oldFace = liveHead:FindFirstChild("face")
        if oldFace then pcall(function() oldFace:Destroy() end) end
        pcall(function() fetchedFace:Clone().Parent = liveHead end)
    end

    local parent = character.Parent
    if parent then
        pcall(function()
            character.Parent = nil
            character.Parent = parent
        end)
    end

    pcall(function() appearance:Destroy() end)

    if token ~= SpooferState.visualToken or player.Character ~= character then
        return false, "superseded"
    end

    return true
end

