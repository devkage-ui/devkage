    local function enforceStats()
        if not privacy.Active then return end
        local level = tonumber(config.level) or 1
        local elo = normalizeSpoofELO(config.elo)
        local streak = tonumber(config.streak) or 0
        local wins = tonumber(config.wins) or 0
        local kills = tonumber(config.kills) or 0

        if config.spoofLevel~=false and player:GetAttribute("Level") ~= level then
            pcall(function() player:SetAttribute("Level", level) end)
        end
        if config.spoofStreak~=false and player:GetAttribute("StatisticDuelsWinStreak") ~= streak then
            pcall(function() player:SetAttribute("StatisticDuelsWinStreak", streak) end)
        end
        if config.spoofELO~=false then applySpoofELOValues(player,elo) else pcall(SpoofRankRuntime.Apply,player,config) end
        if config.spoofWins~=false and player:GetAttribute("Wins") ~= wins then
            pcall(function() player:SetAttribute("Wins", wins) end)
        end
        if config.spoofWins~=false and player:GetAttribute("StatisticDuelsWins") ~= wins then
            pcall(function() player:SetAttribute("StatisticDuelsWins", wins) end)
        end
        if config.spoofWins~=false and player:GetAttribute("DuelsWins") ~= wins then
            pcall(function() player:SetAttribute("DuelsWins", wins) end)
        end
        if config.spoofKills~=false then
            for _,attribute in ipairs({"Kills","Eliminations","StatisticEliminations","StatisticKills"}) do
                if player:GetAttribute(attribute)~=kills then pcall(function() player:SetAttribute(attribute,kills) end) end
            end
        end
        SpooferState.ApplyBadgeAttributes(player,config)

        local leaderstats = player:FindFirstChild("CustomLeaderstats") or player:FindFirstChild("leaderstats")
        if leaderstats then
            local lvl = leaderstats:FindFirstChild("Level")
            local strk = leaderstats:FindFirstChild("Win Streak") or leaderstats:FindFirstChild("Winstreak")
            local winv = leaderstats:FindFirstChild("Wins") or leaderstats:FindFirstChild("Total Wins")
            local killv=leaderstats:FindFirstChild("Kills") or leaderstats:FindFirstChild("Eliminations") or leaderstats:FindFirstChild("KOs")
            if config.spoofLevel~=false and lvl and lvl.Value ~= level then pcall(function() lvl.Value = level end) end
            if config.spoofStreak~=false and strk and strk.Value ~= streak then pcall(function() strk.Value = streak end) end
            if config.spoofWins~=false and winv and winv.Value ~= wins then pcall(function() winv.Value = wins end) end
            if config.spoofKills~=false and killv and killv.Value~=kills then pcall(function() killv.Value=kills end) end
        end
    end

