end)
return ok
end

local function spawnCombatSound(kind,content,volume,pitch,force,allowFallback,maxLength)
PlayerESPUtilityRuntime.soundSerial=PlayerESPUtilityRuntime.soundSerial+1
local serial=PlayerESPUtilityRuntime.soundSerial
local requestedLengthCap=math.clamp(tonumber(maxLength) or 0,0,10)
local sound=Instance.new("Sound")
sound.Name="DevKageCombat_"..kind.."_"..PlayerESPCombatHttpService:GenerateGUID(false):gsub("%-","")
sound.SoundId=normalizedCombatSoundContent(content,PLAYER_ESP_FALLBACK_SOUND)
sound.Volume=math.clamp(tonumber(volume) or 0.5,0,10)
sound.PlaybackSpeed=math.clamp(tonumber(pitch) or 1,0.25,3)
sound.Looped=false
sound.Archivable=true
sound.PlayOnRemove=false
sound:SetAttribute("DevKageSerial",serial)
sound.Parent=PlayerESPSoundService

PlayerESPUtilityRuntime.combatSoundInstances[sound]=true
if kind=="hit" then PlayerESPUtilityRuntime.hitSound=sound else PlayerESPUtilityRuntime.killSound=sound end

local completed=false
local playAttempts=0
local endedConnection
local loadedConnection
local playedConnection
local function disconnectLocalConnections()
for _,connection in ipairs({endedConnection,loadedConnection,playedConnection}) do
if connection then pcall(function() connection:Disconnect() end) end
end
endedConnection=nil; loadedConnection=nil; playedConnection=nil
end
local function markPlayed()
if completed then return end
completed=true
setCombatSoundStatus(((kind=="hit") and "Hit" or "Kill").." sound playing")
local lengthCap=requestedLengthCap
if lengthCap>0 then
task.delay(lengthCap,function()
if not sound.Parent or sound:GetAttribute("DevKageSerial")~=serial then return end
sound:SetAttribute("DevKageCancelled",true)
disconnectLocalConnections()
removeCombatSound(sound)
setCombatSoundStatus(((kind=="hit") and "Hit" or "Kill")..string.format(" sound capped at %.2fs",lengthCap))
end)
end
end
local function confirmPlayback()
if completed or not sound.Parent then return end
if sound.IsPlaying and (sound.IsLoaded or sound.TimeLength>0) then markPlayed() end
end
local function requestPlayback()
if completed or not sound.Parent or sound:GetAttribute("DevKageCancelled")==true or playAttempts>=2 then return false end
playAttempts=playAttempts+1
local requested=startCombatSound(sound)
if requested then task.delay(0.06,confirmPlayback) end
return requested
end
local function playWhenReady()
if not sound.Parent or sound:GetAttribute("DevKageCancelled")==true then return end
if sound.IsLoaded or sound.TimeLength>0 then
requestPlayback()
end
end

endedConnection=sound.Ended:Connect(function()
disconnectLocalConnections()
task.delay(0.03,function() removeCombatSound(sound) end)
end)
registerPlayerESPCombatConnection(endedConnection)
loadedConnection=sound.Loaded:Connect(playWhenReady)
registerPlayerESPCombatConnection(loadedConnection)
playedConnection=sound.Played:Connect(function()
if sound.IsLoaded or sound.TimeLength>0 then markPlayed() else task.delay(0.06,confirmPlayback) end
end)
registerPlayerESPCombatConnection(playedConnection)

if sound.IsLoaded then
playWhenReady()
else
setCombatSoundStatus("Loading "..((kind=="hit") and "hit" or "kill").." sound…")
-- Sound:Play queues playback for assets that are still loading.  Preloading in
-- parallel and allowing one verified retry covers both local packaged sounds
-- and permission-gated custom IDs without ever treating a pcall as audible.
requestPlayback()
task.spawn(function()
pcall(function() PlayerESPContentProvider:PreloadAsync({sound}) end)
if not completed and not sound.IsPlaying then requestPlayback() else confirmPlayback() end
end)
end

task.delay(1.35,function()
if completed or not sound.Parent then return end
if sound.IsPlaying and (sound.IsLoaded or sound.TimeLength>0) then markPlayed(); return end
sound:SetAttribute("DevKageCancelled",true)
disconnectLocalConnections()
removeCombatSound(sound)
if allowFallback and VisualsState.kill_sound_fallback~=false and content~=PLAYER_ESP_FALLBACK_SOUND then
PlayerESPUtilityRuntime.soundFallbacks=PlayerESPUtilityRuntime.soundFallbacks+1
setCombatSoundStatus("Primary unavailable • using local fallback")
spawnCombatSound(kind,PLAYER_ESP_FALLBACK_SOUND,volume,kind=="hit" and 1.42 or 1.04,force,false,0)
else
setCombatSoundStatus("Sound unavailable in this experience")
if force then
pcall(function()
library:Notify({Message=((kind=="hit") and "Hit" or "Kill").." sound is unavailable; try another preset or asset ID.",Duration=4})
end)
end
end
end)

-- Capped clips clean up shortly after their requested length.  Uncapped
-- custom IDs keep enough lifetime to finish naturally while Ended still
-- performs the normal immediate cleanup.
PlayerESPDebris:AddItem(sound,requestedLengthCap>0 and math.max(12,requestedLengthCap+4) or 120)
return true
end

