function library.ExtraVisualRuntime:MaterialFromName(name)
    name = tostring(name or "Neon")
    if name == "Metallic" or name == "Metal" then return Enum.Material.Metal end
    if name == "ForceField" then return Enum.Material.ForceField end
    if name == "Glass" then return Enum.Material.Glass end
    if name == "SmoothPlastic" then return Enum.Material.SmoothPlastic end
    if name == "Plastic" then return Enum.Material.Plastic end
    return Enum.Material.Neon
end

function library.ExtraVisualRuntime:IsArmModel(model)
    if not model then return false end
    local segments = {}
    for segment in tostring(model.Name or ""):gmatch("[^%-]+") do
        segments[#segments + 1] = segment:match("^%s*(.-)%s*$"):lower()
    end
    if #segments >= 2 then
        local tag = segments[2]
        if tag == "arms" or tag == "arm" then return true end
        if tag:find("arm", 1, true)
            and not tag:find("charm", 1, true)
            and not tag:find("armor", 1, true) then
            return true
        end
        if tag:find("glove", 1, true) then return true end
        return false
    end
    local n = tostring(model.Name or ""):lower()
    return n:find("arms", 1, true) ~= nil
        or n:find("glove", 1, true) ~= nil
end

function library.ExtraVisualRuntime:IsArmPart(part, model)
    if not part or not part:IsA("BasePart") then return false end

    local n = tostring(part.Name or ""):lower():gsub("[%s_%-]", "")
    for _, blocked in ipairs({"handguard","handle","foregrip","charm","armor","hitbox","collision","trigger","proxy"}) do
        if n:find(blocked, 1, true) then return false end
    end

    if model and self:IsArmModel(model) then return true end

    local current = part.Parent
    while current and current ~= model do
        local parentName = tostring(current.Name or ""):lower()
        if parentName == "arms" or parentName == "leftarm" or parentName == "rightarm"
            or parentName == "left arm" or parentName == "right arm"
            or parentName == "hands" or parentName == "gloves"
            or parentName:find("glove", 1, true)
            or parentName:find("sleeve", 1, true) then
            return true
        end
        if parentName:find("arm", 1, true)
            and not parentName:find("armor", 1, true)
            and not parentName:find("handguard", 1, true)
            and not parentName:find("foregrip", 1, true)
            and not parentName:find("charm", 1, true) then
            return true
        end
        current = current.Parent
    end

    return n:find("leftarm", 1, true) ~= nil
        or n:find("rightarm", 1, true) ~= nil
        or n:find("leftupperarm", 1, true) ~= nil
        or n:find("rightupperarm", 1, true) ~= nil
        or n:find("leftlowerarm", 1, true) ~= nil
        or n:find("rightlowerarm", 1, true) ~= nil
        or n:find("lefthand", 1, true) ~= nil
        or n:find("righthand", 1, true) ~= nil
        or n:find("forearm", 1, true) ~= nil
        or n:find("upperarm", 1, true) ~= nil
        or n:find("lowerarm", 1, true) ~= nil
        or n:find("glove", 1, true) ~= nil
        or n:find("sleeve", 1, true) ~= nil
        or n:find("finger", 1, true) ~= nil
        or n:find("wrist", 1, true) ~= nil
        or n:find("palm", 1, true) ~= nil
        or n:find("thumb", 1, true) ~= nil
        or n == "arms" or n == "arm" or n == "hands" or n == "hand"
end

function library.ExtraVisualRuntime:RememberViewPart(part)
    local saved = self.ViewOriginals[part]
    if not saved then
        saved = {
            Color = part.Color,
            Material = part.Material,
            Transparency = part.Transparency,
            Reflectance = part.Reflectance,
            LocalTransparencyModifier = part.LocalTransparencyModifier,
            MaterialVariant = part.MaterialVariant,
            Visuals = {},
        }
        if part:IsA("MeshPart") then
            saved.TextureID = part.TextureID
        end
        self.ViewOriginals[part] = saved
    end




    for _, visual in ipairs(part:GetDescendants()) do
        if saved.Visuals[visual] == nil then
            if visual:IsA("Texture") or visual:IsA("Decal") then
                saved.Visuals[visual] = {Kind = "Texture", Transparency = visual.Transparency}
            elseif visual:IsA("SurfaceAppearance") then
                local data = {Kind = "SurfaceAppearance"}
                pcall(fun]==================],
    [==================[ction() data.ColorMap = visual.ColorMap end)
                pcall(function() data.MetalnessMap = visual.MetalnessMap end)
                pcall(function() data.NormalMap = visual.NormalMap end)
                pcall(function() data.RoughnessMap = visual.RoughnessMap end)
                saved.Visuals[visual] = data
            elseif visual:IsA("SpecialMesh") then
                saved.Visuals[visual] = {
                    Kind = "SpecialMesh",
                    TextureId = visual.TextureId,
                    VertexColor = visual.VertexColor,
                }
            elseif visual:IsA("WrapLayer") then
                saved.Visuals[visual] = {Kind = "WrapLayer", Parent = visual.Parent}
            end
        end
    end

    return saved
end

function library.ExtraVisualRuntime:ClearViewGlow(part)
    local highlight = self.ViewGlowHighlights[part]
    if highlight then
        pcall(function() highlight:Destroy() end)
        self.ViewGlowHighlights[part] = nil
    end
end

function library.ExtraVisualRuntime:UpdateViewGlow(part, arm, materialName, color)
    local amount = math.clamp(tonumber(VisualsState.viewmodel_weapon_glow) or 0, 0, 1)
    local shouldGlow = not arm
        and VisualsState.viewmodel_weapon_chams == true
        and tostring(materialName or "") == "Neon"
        and amount > 0

    if not shouldGlow then
        self:ClearViewGlow(part)
        return
    end

    local highlight = self.ViewGlowHighlights[part]
    if not highlight or not highlight.Parent then
        highlight = Instance.new("Highlight")
        highlight.Name = "DevKageViewmodelNeonGlow"
        highlight.Adornee = part
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = part
        self.ViewGlowHighlights[part] = highlight
    end

    pcall(function()
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.FillTransparency = math.clamp(1 - amount * 0.32, 0.68, 1)
        highlight.OutlineTransparency = math.clamp(1 - amount * 0.82, 0.18, 1)
    end)
end

function library.ExtraVisualRuntime:RestoreViewPart(part, saved)
    if not part or not part.Parent or type(saved) ~= "table" then return end
    pcall(function()
        part.Color = saved.Color
        part.Material = saved.Material
        part.Transparency = saved.Transparency
        part.Reflectance = saved.Reflectance
        part.LocalTransparencyModifier = saved.LocalTransparencyModifier or 0
        part.MaterialVariant = saved.MaterialVariant or ""
        if part:IsA("MeshPart") and saved.TextureID ~= nil then
            part.TextureID = saved.TextureID
        end
    end)

    for visual, data in pairs(saved.Visuals or {}) do
        if visual and type(data) == "table" then
            pcall(function()
                if data.Kind == "Texture" and visual.Parent then
                    visual.Transparency = data.Transparency
                elseif data.Kind == "SurfaceAppearance" and visual.Parent then
                    if data.ColorMap ~= nil then visual.ColorMap = data.ColorMap end
                    if data.MetalnessMap ~= nil then visual.MetalnessMap = data.MetalnessMap end
                    if data.NormalMap ~= nil then visual.NormalMap = data.NormalMap end
                    if data.RoughnessMap ~= nil then visual.RoughnessMap = data.RoughnessMap end
                elseif data.Kind == "SpecialMesh" and visual.Parent then
                    visual.TextureId = data.TextureId or ""
                    if data.VertexColor ~= nil then visual.VertexColor = data.VertexColor end
                elseif data.Kind == "WrapLayer" and not visual.Parent and data.Parent and data.Parent.Parent then
                    visual.Parent = data.Parent
                end
            end)
        end
    end
    self:ClearViewGlow(part)
end

function library.ExtraVisualRuntime:RestoreViewmodel()
    for part, saved in pairs(self.ViewOriginals) do
        self:RestoreViewPart(part, saved)
        self.ViewOriginals[part] = nil
    end
    for part in pairs(self.ViewGlowHighlights) do
        self:ClearViewGlow(part)
    end
end

function library.ExtraVisualRuntime:ApplyViewPart(part, arm, model)
    if not part or not part:IsA("BasePart") or part.Transparency >= 0.999 then return end
    local enabled = arm and VisualsState.viewmodel_arm_chams or VisualsState.viewmodel_weapon_chams
    if not enabled then
        local saved = self.ViewOriginals[part]
        if saved then
            self:RestoreViewPart(part, saved)
            self.ViewOriginals[part] = nil
        else
            self:ClearViewGlow(part)
        end
        return
    end

    local saved = self:RememberViewPart(part)
    local color = arm and VisualsState.viewmodel_arm_color or VisualsState.viewmodel_weapon_color
    local materialName = arm and VisualsState.viewmodel_arm_material or VisualsState.viewmodel_weapon_material
    local transparency = arm and VisualsState.viewmodel_arm_transparency or VisualsState.viewmodel_weapon_transparency

    pcall(function()
        part.Color = color
        part.Material = self:MaterialFromName(materialName)
        part.MaterialVariant = ""
        part.Transparency = math.clamp(tonumber(transparency) or 0, 0, 0.95)
        part.LocalTransparencyModifier = 0
        part.Reflectance = (not arm and (materialName == "Metallic" or materialName == "Metal")) and 0.16 or 0
        if part:IsA("MeshPart") then
            part.TextureID = ""
        end

        for visual, data in pairs(saved.Visuals or {}) do
            if visual then
                if data.Kind == "Texture" and visual.Parent then
                    visual.Transparency = 1
                elseif data.Kind == "SurfaceAppearance" and visual.Parent then
                    pcall(function() visual.ColorMap = "" end)
                    pcall(function() visual.MetalnessMap = "" end)
                    pcall(function() visual.NormalMap = "" end)
                    pcall(function() visual.RoughnessMap = "" end)
                elseif data.Kind == "SpecialMesh" and visual.Parent then
                    visual.TextureId = ""
                    visual.VertexColor = Vector3.new(color.R, color.G, color.B)
                elseif data.Kind == "WrapLayer" and visual.Parent then
                    visual.Parent = nil
                end
            end
        end
    end)

    self:UpdateViewGlow(part, arm, materialName, color)
end

function library.ExtraVisualRuntime:RefreshViewmodel()
    if not VisualsState.viewmodel_arm_chams and not VisualsState.viewmodel_weapon_chams then
        self:RestoreViewmodel()
        return
    end

    local camera = workspace.CurrentCamera
    local character = LocalPlayer.Character
    local viewModels = workspace:FindFirstChild("ViewModels")
    local firstPerson = viewModels and viewModels:FindFirstChild("FirstPerson")

    local function firstPersonRoot(part)
        if not firstPerson or not part or not part:IsDescendantOf(firstPerson) then return nil end
        local current = part
        while current and current.Parent and current.Parent ~= firstPerson do
            current = current.Parent
        end
        return current and current.Parent == firstPerson and current or part:FindFirstAncestorOfClass("Model")
    end

    local function relevant(part)
        if not part or not part.Parent then return false end
        if firstPerson and part:IsDescendantOf(firstPerson) then return true end
        if camera and part:IsDescendantOf(camera) then return true end
        if character and part:IsDescendantOf(character) then
            return self:IsArmPart(part) or part:FindFirstAncestorOfClass("Tool") ~= nil
        end
        return false
    end

    for part, saved in pairs(self.ViewOriginals) do
        if not relevant(part) then
            self:RestoreViewPart(part, saved)
            self.ViewOriginals[part] = nil
        end
    end




    if firstPerson then
        for _, object in ipairs(firstPerson:GetDescendants()) do
            if object:IsA("BasePart") and object.Name ~= "HumanoidRootPart" then
                local model = firstPersonRoot(object)
                self:ApplyViewPart(object, self:IsArmPart(object, model), model)
            end
        end
    end



    if camera then
        for _, object in ipairs(camera:GetDescendants()) do
            if object:IsA("BasePart") and object.Name ~= "HumanoidRootPart" then
                self:ApplyViewPart(object, self:IsArmPart(object), object:FindFirstAncestorOfClass("Model"))
            end
        end
    end

    if character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                local inTool = object:FindFirstAncestorOfClass("Tool") ~= nil
                local arm = self:IsArmPart(object)
                if arm or inTool then
                    self:ApplyViewPart(object, arm and not inTool, object:FindFirstAncestorOfClass("Model"))
                end
            end
        end
    end
end

function library.ExtraVisualRuntime:SetThirdPerson(enabled)
    enabled = enabled == true
    if not self.ThirdPersonRenderName then
        local okGuid, guid = pcall(function()
            return game:GetService("HttpService"):GenerateGUID(false):gsub("%-", "")
        end)
        self.ThirdPersonRenderName = "DevKageThirdPersonCamera_" .. (okGuid and guid or tostring(math.floor(os.clock() * 1000000)))
    end
    local renderName = self.ThirdPersonRenderName

    if enabled then
        if not self.ThirdPersonSaved then
            local camera = workspace.CurrentCamera
            self.ThirdPersonSaved = {
                CameraMode = LocalPlayer.CameraMode,
                MinZoom = LocalPlayer.CameraMinZoomDistance,
                MaxZoom = LocalPlayer.CameraMaxZoomDistance,
                CameraType = camera and camera.CameraType or nil,
                CameraSubject = camera and camera.CameraSubject or nil,
            }
        end

        local distance = math.clamp(tonumber(VisualsState.third_person_distance) or 5, 5, 90)
        pcall(function()
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMinZoomDistance = distance
            LocalPlayer.CameraMaxZoomDistance = distance
        end)

        if not self.ThirdPersonBound then
            self.ThirdPersonBound = true
            pcall(function()
                RunService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value + 20, function()
                    if not VisualsState.third_person then return end
                    local camera = workspace.CurrentCamera
                    local character = LocalPlayer.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    local head = character and character:FindFirstChild("Head")
                    if not camera or not humanoid or not root or humanoid.Health <= 0 then return end

                    local wantedDistance = math.clamp(tonumber(VisualsState.third_person_distance) or 5, 5, 90)
                    pcall(function()
                        LocalPlayer.CameraMode = Enum.CameraMode.Classic
                        LocalPlayer.CameraMinZoomDistance = wantedDistance
                        LocalPlayer.CameraMaxZoomDistance = wantedDistance
                        camera.CameraType = Enum.CameraType.Custom
                        camera.CameraSubject = humanoid
                    end)

                    local look = camera.CFrame.LookVector
                    if look.Magnitude < 0.001 then look = root.CFrame.LookVector end
                    look = look.Unit
                    local focusPosition = (head and head:IsA("BasePart")) and head.Position or (root.Position + Vector3.new(0, 1.5, 0))
                    local cameraPosition = focusPosition - (look * wantedDistance)
                    pcall(function()
                        camera.CFrame = CFrame.lookAt(cameraPosition, focusPosition, Vector3.new(0, 1, 0))
                        camera.Focus = CFrame.new(focusPosition)
                    end)
                end)
            end)
        end
    else
        if self.ThirdPersonBound then
            pcall(function() RunService:UnbindFromRenderStep(renderName) end)
            self.ThirdPersonBound = false
        end
        local saved = self.ThirdPersonSaved
        self.ThirdPersonSaved = nil
        if saved then
            pcall(function()
                LocalPlayer.CameraMode = saved.CameraMode
                LocalPlayer.CameraMinZoomDistance = saved.MinZoom
                LocalPlayer.CameraMaxZoomDistance = saved.MaxZoom
                local camera = workspace.CurrentCamera
                if camera then
                    if saved.CameraType then camera.CameraType = saved.CameraType end
                    if saved.CameraSubject then camera.CameraSubject = saved.CameraSubject end
                end
            end)
        end
    end
end

function library.ExtraVisualRuntime:IsCharacterVisible(character)
    local camera = workspace.CurrentCamera
    if not camera or not character then return false end
    local target = character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
    if not target or not target:IsA("BasePart") then return false end

    local origin = camera.CFrame.Position
    local direction = target.Position - origin
    if direction.Magnitude <= 0.01 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.FilterDescendantsInstances = {LocalPlayer.Character, camera}
    local result = workspace:Raycast(origin, direction, params)
    return result == nil or (result.Instance and result.Instance:IsDescendantOf(character))
end

function library.ExtraVisualRuntime:UpdateEnemyChams()
    if not VisualsState.chams then return end
    for player, highlight in pairs(VisualsState.chams_table) do
        local character = player and player.Character
        if highlight and highlight.Parent and character and highlight.Adornee == character and player ~= LocalPlayer then
            local fill = VisualsState.chams_color
            if VisualsState.enemy_visibility_colors then
                fill = self:IsCharacterVisible(character) and VisualsState.enemy_visible_color or VisualsState.enemy_hidden_color
            end
            pcall(function()
                highlight.FillColor = fill
                highlight.DepthMode = VisualsState.esp_outline_through_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                if VisualsState.enemy_chams_glow then
                    highlight.OutlineColor = VisualsState.enemy_chams_glow_color
                    highlight.OutlineTransparency = math.clamp(tonumber(VisualsState.enemy_chams_glow_alpha) or 0.08, 0, 1)
                else
                    highlight.OutlineColor = VisualsState.chams_outline_color
                    highlight.OutlineTransparency = VisualsState.esp_outline and math.clamp(VisualsState.chams_outline_alpha, 0, 1) or 1
                end
            end)
            local light = ESPAppearanceRuntime.lights[player]
            if light and light.Parent then
                pcall(function() light.Color = fill end)
            end
        end
    end
end

function library.ExtraVisualRuntime:IsDroppedTool(tool)
    if not tool or not tool:IsA("Tool") or not tool:IsDescendantOf(workspace) then return false end
    local model = tool:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return false end
    return true
end

function library.ExtraVisualRuntime:RefreshWorldTools()
    for tool, highlight in pairs(self.ToolHighlights) do
        if not VisualsState.world_tool_esp or not self:IsDroppedTool(tool) or not highlight.Parent then
            pcall(function() highlight:Destroy() end)
            self.ToolHighlights[tool] = nil
        end
    end
    if not VisualsState.world_tool_esp then return end

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Tool") and self:IsDroppedTool(object) and not self.ToolHighlights[object] then
            local adornee = object:FindFirstChild("Handle") or object:FindFirstChildWhichIsA("BasePart", true)
            if adornee then
                local highlight = Instance.new("Highlight")
                highlight.Name = "DevKage_WorldToolESP"
                highlight.Adornee = adornee
                highlight.FillColor = VisualsState.world_tool_esp_color
                highlight.FillTransparency = 0.55
                highlight.OutlineColor = VisualsState.world_tool_esp_color
                highlight.OutlineTransparency = VisualsState.world_tool_esp_glow and 0.05 or 0.45
                highlight.DepthMode = VisualsState.world_tool_esp_through_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                highlight.Parent = object
                self.ToolHighlights[object] = highlight
            end
        end
    end

    for _, highlight in pairs(self.ToolHighlights) do
        if highlight and highlight.Parent then
