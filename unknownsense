-- immediately breaking Auto Load.  Old marker-prefixed v15 payloads are safely
-- normalized by normalize_script_autoload_source().
if not source and type(readfile) == "function" then
    if type(isfile) ~= "function" then
        local ok, existing = pcall(readfile, SCRIPT_PAYLOAD_FILE)
        if ok then
            source = normalize_script_autoload_source(existing)
        end
    else
        local checked, exists = pcall(isfile, SCRIPT_PAYLOAD_FILE)
        if not checked or exists == true then
            local ok, existing = pcall(readfile, SCRIPT_PAYLOAD_FILE)
            if ok then
                source = normalize_script_autoload_source(existing)
            end
        end
    end
end

if not source then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, "Packaged source is unavailable"
end

if type(writefile) ~= "function" then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, "This executor cannot write the auto-load payload"
end

local folderOk, folderError = ensure_folder()
if not folderOk then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, folderError
end

-- Save the raw current source, matching the known-working reference file.  This
-- is the full embedded DevKage program, so every feature/config path remains in
-- the payload rather than trying to reconstruct a partial script at boot.
local payloadOk, payloadErr = pcall(writefile, SCRIPT_PAYLOAD_FILE, source)
if not payloadOk then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, tostring(payloadErr)
end

-- Keep the old shared payload fresh as a compatibility redirect.  Very old
-- DevKage stubs require the v15 first-line marker and build file; newer legacy
-- stubs strip that marker before compiling.  Writing the CURRENT source here
-- means either kind of stale queued loader still resolves to this newest build.
local legacyPayload = "-- DEVKAGE_AUTOLOAD_BUILD:DevKage-v15-reference-cursor-rapidfire-current\n" .. source
pcall(writefile, CONFIG_FOLDER .. "/_devkage_autoload_payload.lua", legacyPayload)
pcall(writefile, SCRIPT_BUILD_FILE, "DevKage-v15-reference-cursor-rapidfire-current")

-- Record the unique current build separately for diagnostics/current-only
-- ownership.  This file is not required for execution.
pcall(writefile, CONFIG_FOLDER .. "/_devkage_autoload_current.txt", SCRIPT_AUTOLOAD_BUILD)

local stub = build_script_autoload_stub()

local queued, queueError = queue_script_autoload(stub)
local autoexecWritten, autoexecPaths = write_autoexec_stubs(stub)

if not queued and not autoexecWritten then
    if not bootRefresh then
        settings.AutoLoad = false
        write_script_settings(settings)
    end
    return false, "Executor exposes neither a working teleport queue nor a writable autoexec folder"
end

env.__DEVKAGE_AUTOEXEC_PATHS = autoexecPaths
env.__DEVKAGE_AUTOLOAD_BUILD = SCRIPT_AUTOLOAD_BUILD
env.__DEVKAGE_AUTOLOAD_PAYLOAD_REFRESHED_AT = os.clock()

local pathText = autoexecWritten and table.concat(autoexecPaths, ", ") or ""

if queued and autoexecWritten then
    return true, "Auto Load enabled (teleports + executor autoexec) | " .. pathText
elseif queued then
    return true, "Auto Load enabled for teleports"
else
    return true, "Auto Load installed in executor autoexec | " .. pathText
end
end

local _script_boot_settings = read_script_settings()

if _script_boot_settings.AutoLoad == true then
    -- The reference file defers the refresh so normal DevKage initialization is
    -- not blocked by folder probing, file writes, or a teleport-queue provider.
    task.defer(function()
        local ok, err = configure_script_autoload(true, true)
        if not ok then
            warn("[DevKage AutoLoad] refresh failed: " .. tostring(err))
        end
    end)
end

