local function playCombatSound(kind,force)
kind=(kind=="hit") and "hit" or "kill"
local content,volume,enabled,pitch,presetName=combatSoundSettings(kind)
if not force and not enabled then return false end

local now=tick()
local stampKey=(kind=="hit") and "hitGlobalLastAt" or "killGlobalLastAt"
local minGap=(kind=="hit") and 0.045 or 0.12
if not force and now-(tonumber(PlayerESPUtilityRuntime[stampKey]) or 0)<minGap then return false end
PlayerESPUtilityRuntime[stampKey]=now
local maxLength=0
if presetName=="Custom ID" then
maxLength=kind=="hit" and VisualsState.hit_sound_length or VisualsState.kill_sound_length
end
return spawnCombatSound(kind,content,volume,pitch,force,true,maxLength)
end

