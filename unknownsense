    local function patchDuelHistoryObject(object)
        if config.duelHistoryEnabled~=true or not object
            or not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then return false end
        local hierarchy=""
        local current=object
        for _=1,9 do
            if not current then break end
            hierarchy=hierarchy.." "..tostring(current.Name or ""):lower()
            current=current.Parent
        end
        local normalized=SpooferState.Key(hierarchy)
        if not (normalized:find("duelhistory",1,true) or normalized:find("matchhistory",1,true)
            or (normalized:find("duel",1,true) and normalized:find("history",1,true))) then return false end
        local name=SpooferState.Key(object.Name)
        local text=tostring(object.Text or "")
        local value
        if name:find("displayname",1,true) then value=tostring(config.duelDisplayName or "")
        elseif name:find("username",1,true) then value=tostring(config.duelUsername or "")
        elseif]==================],
    [==================[ name:find("team1score",1,true) or name:find("score1",1,true) then value=math.max(0,math.floor(tonumber(config.duelTeam1Score) or 5))
        elseif name:find("team2score",1,true) or name:find("score2",1,true) then value=math.max(0,math.floor(tonumber(config.duelTeam2Score) or 0))
        elseif name:find("elochange",1,true) or name:find("ratingchange",1,true) then value=math.floor(tonumber(config.duelELOChange) or 35)
        elseif name:find("kills",1,true) or name:find("eliminations",1,true) then value=math.max(0,math.floor(tonumber(config.duelKills) or 15))
        elseif name:find("deaths",1,true) then value=math.max(0,math.floor(tonumber(config.duelDeaths) or 2))
        elseif name:find("assists",1,true) then value=math.max(0,math.floor(tonumber(config.duelAssists) or 6))
        elseif name:find("damage",1,true) then value=math.max(0,math.floor(tonumber(config.duelDamage) or 5000))
        elseif name=="elo" or name:find("rating",1,true) or name=="mmr" then value=normalizeSpoofELO(config.duelELO or 2000)
        elseif name:find("mode",1,true) then value=tostring(config.duelMode or "Ranked")
        elseif name:find("result",1,true) or name:find("outcome",1,true) then value=tostring(config.duelResult or "Win")
        elseif name:find("map",1,true) or name:find("arena",1,true) then value=tostring(config.duelMap or "Arena")
        end
        if value==nil or tostring(value)=="" then return false end
        local nextText=type(value)=="number" and replaceFirstNumber(text,value) or tostring(value)
        if nextText==text then return false end
        setTextLocal(object,nextText)
        return true
    end

