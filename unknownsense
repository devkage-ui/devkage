function AntiAimMovement:WakeCharacter()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 or root.Anchored then return end

    pcall(function()
        if not humanoid.PlatformStand and not humanoid.Sit then
            if humanoid.FloorMaterial == Enum.Material.Air then
                humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                local velocity = root.AssemblyLinearVelocity
                if velocity.Magnitude < 0.05 then
                    root.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                end
            else
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end)
end

function AntiAimMovement:SetNoClip(enabled)
    local wasActive = self.noclipConnection ~= nil or AntiAimState.noclip_enabled == true
    AntiAimState.noclip_enabled = enabled == true
    if self.noclipConnection then
        pcall(function() self.noclipConnection:Disconnect() end)
        self.noclipConnection = nil
    end
    if not AntiAimState.noclip_enabled then
        if wasActive or next(self.collisionOriginals) ~= nil then
            self:RestoreCollisions()
        end
        return
    end

    self.noclipConnection = RunService.Stepped:Connect(function()
        if not AntiAimState.noclip_enabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if self.collisionOriginals[part] == nil then
                    self.collisionOriginals[part] = part.CanCollide
                end
                if part.CanCollide then part.CanCollide = false end
            end
        end
    end)
end

function AntiAimMovement:ClearFlightRig(releaseCharacter)
    local root = self.flightRoot
    local humanoid = self.flightHumanoid
    local savedAutoRotate = self.flightAutoRotate
    local savedPlatformStand = self.flightPlatformStand
    local savedSit = self.flightSit
    local hadFlightRig = root ~= nil
        or self.flightAttachment ~= nil
        or self.flightVelocity ~= nil
        or self.flightOrientation ~= nil
        or self.flightBodyVelocity ~= nil
        or self.flightBodyGyro ~= nil

    for _, object in ipairs({self.flightBodyGyro, self.flightBodyVelocity, self.flightOrientation, self.flightVelocity, self.flightAttachment}) do
        if object then pcall(function() object:Destroy() end) end
    end

    if humanoid and humanoid.Parent then
        pcall(function()
            if savedAutoRotate ~= nil then
                humanoid.AutoRotate = AntiAimState.enabled and false or savedAutoRotate
            end
            if savedPlatformStand ~= nil then humanoid.PlatformStand = savedPlatformStand end
            if savedSit ~= nil then humanoid.Sit = savedSit end
        end)
    end

    self.flightRoot = nil
    self.flightHumanoid = nil
    self.flightAutoRotate = nil
    self.flightPlatformStand = nil
    self.flightSit = nil
    self.flightAttachment = nil
    self.flightVelocity = nil
    self.flightOrientation = nil
    self.flightBodyVelocity = nil
    self.flightBodyGyro = nil

    if releaseCharacter == true and hadFlightRig then
        task.defer(function()
            if AntiAimState.flight_enabled then return end
            local character = LocalPlayer.Character
            local liveHumanoid = character and character:FindFirstChildOfClass("Humanoid")
            local liveRoot = character and character:FindFirstChild("HumanoidRootPart")
            if not liveHumanoid or not liveRoot or liveHumanoid.Health <= 0 or liveRoot.Anchored then return end

            pcall(function()
                for _, name in ipairs({"DevKageFlightVelocity", "DevKageFlightOrientation", "DevKageFlightVelocityLegacy", "DevKageFlightGyroLegacy", "DevKageFlightAttachment"}) do
                    local stale = liveRoot:FindFirstChild(name)
                    if stale then stale:Destroy() end
                end

                local look = liveRoot.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude > 0.001 then
                    liveRoot.CFrame = CFrame.lookAt(liveRoot.Position, liveRoot.Position + flat.Unit, Vector3.new(0, 1, 0))
                end
                liveRoot.AssemblyAngularVelocity = Vector3.zero

                if liveHumanoid.FloorMaterial == Enum.Material.Air then
                    liveHumanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                    local velocity = liveRoot.AssemblyLinearVelocity
                    liveRoot.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(velocity.Y, -10), velocity.Z)
                else
                    liveHumanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end)
    end
end

function AntiAimMovement:BuildFlightRig(root, humanoid)
    self:ClearFlightRig(false)
    if not root or not humanoid then return false end

    self.flightRoot = root
    self.flightHumanoid = humanoid
    self.flightAutoRotate = humanoid.AutoRotate
    self.flightPlatformStand = humanoid.PlatformStand
    self.flightSit = humanoid.Sit
    pcall(function() humanoid.AutoRotate = false end)

    local attachment = Instance.new("Attachment")
    attachment.Name = "DevKageFlightAttachment"
    attachment.Parent = root
    self.flightAttachment = attachment

    local modernOk = pcall(function()
        local velocity = Instance.new("LinearVelocity")
        velocity.Name = "DevKageFlightVelocity"
        velocity.Attachment0 = attachment
        velocity.RelativeTo = Enum.ActuatorRelativeTo.World
        velocity.MaxForce = 1000000000
        velocity.VectorVelocity = Vector3.zero
        velocity.Parent = root
        self.flightVelocity = velocity

        local orientation = Instance.new("AlignOrientation")
        orientation.Name = "DevKageFlightOrientation"
        orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        orientation.Attachment0 = attachment
        orientation.MaxTorque = 1000000000
        orientation.Responsiveness = 35
        orientation.RigidityEnabled = false
        orientation.CFrame = root.CFrame
        orientation.Parent = root
        self.flightOrientation = orientation
    end)

    if not modernOk then
        if self.flightVelocity then pcall(function() self.flightVelocity:Destroy() end); self.flightVelocity = nil end
        if self.flightOrientation then pcall(function() self.flightOrientation:Destroy() end); self.flightOrientation = nil end
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "DevKageFlightVelocityLegacy"
        bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVelocity.P = 25000
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = root
        self.flightBodyVelocity = bodyVelocity

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "DevKageFlightGyroLegacy"
        bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro.P = 50000
        bodyGyro.D = 1200
        bodyGyro.CFrame = root.CFrame
        bodyGyro.Parent = root
        self.flightBodyGyro = bodyGyro
    end
    return true
end

function AntiAimMovement:SetFlight(enabled)
    local wasActive = self.flightConnection ~= nil
        or self.flightRoot ~= nil
        or self.flightVelocity ~= nil
        or self.flightBodyVelocity ~= nil
        or AntiAimState.flight_enabled == true
    AntiAimState.flight_enabled = enabled == true
    if self.flightConnection then
        pcall(function() self.flightConnection:Disconnect() end)
        self.flightConnection = nil
    end
    if wasActive then
        self:ClearFlightRig(not AntiAimState.flight_enabled)
    end
    if not AntiAimState.flight_enabled then return end

    self.flightConnection = RunService.RenderStepped:Connect(function()
        if not AntiAimState.flight_enabled then return end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then
            if self.flightRoot then self:ClearFlightRig(false) end
            return
        end
        if self.flightRoot ~= root or (not self.flightVelocity and not self.flightBodyVelocity) then
            if not self:BuildFlightRig(root, humanoid) then return end
        end
        if humanoid.AutoRotate then pcall(function() humanoid.AutoRotate = false end) end

        local camera = workspace.CurrentCamera
        if not camera then return end
        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        local mousePosition = uis:GetMouseLocation()
        local aimRay = camera:ViewportPointToRay(mousePosition.X, mousePosition.Y)
        local aimDirection = aimRay.Direction
        if aimDirection.Magnitude > 0.001 then
            aimDirection = aimDirection.Unit
        elseif look.Magnitude > 0.001 then
            aimDirection = look.Unit
        else
            aimDirection = Vector3.new(0, 0, -1)
        end
        local sideways = right.Magnitude > 0.001 and right.Unit or Vector3.new(1, 0, 0)

        local direction = Vector3.zero
        if uis:IsKeyDown(Enum.KeyCode.W) then direction += aimDirection end
        if uis:IsKeyDown(Enum.KeyCode.S) then direction -= aimDirection end
        if uis:IsKeyDown(Enum.KeyCode.D) then direction += sideways end
        if uis:IsKeyDown(Enum.KeyCode.A) then direction -= sideways end
        if direction.Magnitude > 1 then direction = direction.Unit end

        local speed = math.clamp(tonumber(AntiAimState.flight_speed) or 120, 10, 500)
        local targetVelocity = direction * speed
        if self.flightVelocity then
            pcall(function() self.flightVelocity.VectorVelocity = targetVelocity end)
        elseif self.flightBodyVelocity then
            pcall(function() self.flightBodyVelocity.Velocity = targetVelocity end)
        else
            pcall(function() root.AssemblyLinearVelocity = targetVelocity end)
        end

        local up = camera.CFrame.UpVector
        if math.abs(aimDirection:Dot(up)) > 0.98 then up = Vector3.new(0, 1, 0) end
        local facing = CFrame.lookAt(root.Position, root.Position + aimDirection, up)
        if self.flightOrientation then
            pcall(function() self.flightOrientation.CFrame = facing end)
        elseif self.flightBodyGyro then
            pcall(function() self.flightBodyGyro.CFrame = facing end)
        end
    end)
end

function AntiAimMovement:Cleanup()
    AntiAimState.noclip_enabled = false
    AntiAimState.flight_enabled = false
    if self.noclipConnection then pcall(function() self.noclipConnection:Disconnect() end); self.noclipConnection = nil end
    if self.flightConnection then pcall(function() self.flightConnection:Disconnect() end); self.flightConnection = nil end
    self:RestoreCollisions()
    self:ClearFlightRig(true)
end

