function CreatorOverlayRuntime:Update(dt)
self.Frames=self.Frames+1
self.Elapsed=self.Elapsed+(tonumber(dt) or 0)
if not VisualsState.creator_overlay_enabled then
if self.Gui then self.Gui.Enabled=false end
return
end
if not self:Ensure() then return end
self.Gui.Enabled=not (VisualsState.creator_hide_when_menu_open and library.Window.Enabled)
if not self.Gui.Enabled then return end
self:ApplyLayout()
self.Watermark.Visible=VisualsState.creator_watermark==true
if self.Elapsed>=0.35 then
self.FPS=self.Frames/math.max(self.Elapsed,0.001)
self.Frames=0; self.Elapsed=0
local stats={}
if VisualsState.creator_fps_counter then stats[#stats+1]=string.format("%d FPS",math.floor(self.FPS+0.5)) end
if VisualsState.creator_session_clock then
local seconds=math.max(0,math.floor(os.clock()-self.StartedAt))
stats[#stats+1]=string.format("%02d:%02d",math.floor(seconds/60),seconds%60)
end
if VisualsState.creator_place_name then stats[#stats+1]=tostring(game.Name or "Experience") end
self.Stats.Text=table.concat(stats,"  •  ")
end
end

