do
    local core = AntiAimState.core
    core.PersistentKeys = {}
    for key, value in pairs(AntiAimState) do
        if key ~= "core" then core.PersistentKeys[key] = typeof(value) end
    end
    core.Runtime = {
        generation = 0, connections = {}, characterConnections = {},
        savedHumanoids = {}, savedNecks = {}, savedRoots = {},
        poseTargets = {}, priorityConnections = {},
        elapsed = 0, spin = 0, offsetSpin = 0, lastPush = nil,
        lastRandom = nil, randomAngle = 0, lastDamageFlip = -math.huge,
        bindName = "DevKage_AntiAim_v3", bound = false, paused = false,
    }
end

function AntiAimState.Number(key)
    local core = AntiAimState.core
    local value = tonumber(AntiAimState[key])
    if not value or value ~= value or math.abs(value) == math.huge then
        value = tonumber(core.Defaults[key]) or 0
    end
    local range = core.Ranges[key]
    if range then value = math.clamp(value, range[1], range[2]) end
    return value
end

function AntiAimState.CanonicalMode(value, options, aliases, fallback)
    value = tostring(value or "")
    if table.find(options, value) then return value end
    return aliases[value] or aliases[value:upper()] or fallback
end

function AntiAimState.Normalize()
    local core = AntiAimState.core
    for key in pairs(core.Ranges) do AntiAimState[key] = AntiAimState.Number(key) end
    for key, kind in pairs(core.PersistentKeys) do
        if kind == "boolean" then AntiAimState[key] = AntiAimState[key] == true end
    end
    AntiAimState.yaw_mode = AntiAimState.CanonicalMode(AntiAimState.yaw_mode, core.YawModes, core.YawAliases, "Backward")
    AntiAimState.pitch_mode = AntiAimState.CanonicalMode(AntiAimState.pitch_mode, core.PitchModes, core.PitchAliases, "Down")
    AntiAimState.velocity_slow_mode = AntiAimState.CanonicalMode(AntiAimState.velocity_slow_mode, core.VelocityModes, core.YawAliases, "Safe Jitter")
    AntiAimState.velocity_move_mode = AntiAimState.CanonicalMode(AntiAimState.velocity_move_mode, core.VelocityModes, core.YawAliases, "Jitter")

    if AntiAimState.velocity_slow_mode == "Velocity Snap" then AntiAimState.velocity_slow_mode = "Safe Jitter" end
    if AntiAimState.velocity_move_mode == "Velocity Snap" then AntiAimState.velocity_move_mode = "Jitter" end
    if not table.find(core.YawBases, AntiAimState.yaw_base) then AntiAimState.yaw_base = "Camera" end
    if AntiAimState.freestand_direction ~= "Left" then AntiAimState.freestand_direction = "Right" end
    AntiAimState.preset = core.PresetAliases[AntiAimState.preset] or AntiAimState.preset
    if AntiAimState.preset ~= "Custom" and not core.Presets[AntiAimState.preset] then AntiAimState.preset = "Custom" end
    local preset = core.Presets[AntiAimState.preset]
    if preset and (preset.yaw ~= AntiAimState.yaw_mode or preset.pitch ~= AntiAimState.pitch_mode) then
        AntiAimState.preset = "Custom"
    end
    local seen = {}
    for _, key in ipairs(core.KeyFields) do
        local value = tostring(AntiAimState[key] or "None"):gsub("^Enum%.KeyCode%.", "")
        if not table.find(core.KeyOptions, value) or seen[value] then value = "None" end
        AntiAimState[key] = value
        if value ~= "None" then seen[value] = true end
    end
    AntiAimState.schema_version = 3
end

function AntiAimState.SyncControls()
    local core = AntiAimState.core
    for key, control in pairs(core.Controls or {}) do
        local value = AntiAimState[key]
        if value ~= nil and type(control.Set) == "function" then
            if control.Options then
                control:Set(table.find(control.Options, value) or 1, true)
            elseif control.GetAlpha then
                control:Set(value, control:GetAlpha(), true)
            else
                control:Set(value, true)
            end
        end
    end
end

function AntiAimState.ResetMotion()
    local runtime = AntiAimState.core.Runtime
    runtime.elapsed, runtime.spin, runtime.offsetSpin = 0, 0, 0
    runtime.lastRandom, runtime.lastPush, runtime.lastYawMode = nil, nil, nil
    runtime.randomAngle = 0
    runtime.smoothYaw, runtime.smoothPitch, runtime.smoothRoll = nil, nil, nil
    runtime.desiredRotation, runtime.desiredPitch, runtime.desiredRoll = nil, nil, nil
    AntiAimState.targetPlayer, AntiAimState.lastTargetUpdate = nil, nil
end

function AntiAimState.Import(source, legacy)
    source = type(source) == "table" and source or {}
    legacy = type(legacy) == "table" and legacy or {}
    if next(source) == nil and legacy.aa_enabled == nil and legacy.aa_mode == nil
        and legacy.aa_custom_yaw == nil and legacy.aa_custom_pitch == nil
        and legacy.aa_jitter == nil and legacy.aa_random_range == nil then return end
    local core = AntiAimState.core
    local values = {}
    for key, value in pairs(source) do values[key] = value end
    for oldKey, key in pairs(core.PascalFields) do
        i]==================],
    [==================[f values[key] == nil and source[oldKey] ~= nil then values[key] = source[oldKey] end
    end
    if values.enabled == nil then values.enabled = legacy.aa_enabled end
    if tonumber(source.schema_version) ~= 3 then
        local oldYaw = values.yaw_mode or source.mode or legacy.aa_mode
        local oldPitch = values.pitch_mode
        values.yaw_mode = core.YawAliases[oldYaw] or oldYaw
        values.pitch_mode = core.PitchAliases[oldPitch] or oldPitch
        if oldYaw == "Look Up" or oldYaw == "Look Down" then
            values.pitch_mode = oldYaw == "Look Up" and "Up" or "Down"
            values.yaw_mode = "Backward"
        end
        if oldYaw == "Custom" then values.static_yaw_offset = source.custom_yaw or legacy.aa_custom_yaw or 180 end
        if oldYaw == "Offset" then values.static_yaw_offset = source.yaw_offset or 0; values.yaw_offset = 0 end
        if source.custom_yaw == nil and legacy.aa_custom_yaw and values.static_yaw_offset == nil then
            values.static_yaw_offset = legacy.aa_custom_yaw
        end
        values.pitch_custom = source.pitch_angle or source.custom_pitch or legacy.aa_custom_pitch or values.pitch_custom
        values.random_interval = values.random_interval or source.update_delay
        values.pitch_jitter_range = values.pitch_jitter_range or source.pitch_jitter_angle
        values.pitch_jitter_speed = values.pitch_jitter_speed or source.pitch_speed
        if values.random_range == nil and (source.random_min or source.random_max) then
            values.random_range = math.max(math.abs(tonumber(source.random_min) or 0), math.abs(tonumber(source.random_max) or 0))
        end
        if values.random_range == nil then values.random_range = legacy.aa_random_range end
        if source.yaw_smoothing ~= nil then
            values.smooth_enabled = (tonumber(source.yaw_smoothing) or 0) > 0
            values.smooth_speed = math.max(0.1, tonumber(source.yaw_smoothing) or 18)
        end

        if source.spin_speed and tonumber(source.spin_speed) ~= 0 and values.yaw_mode ~= "Offset Spin" then
            values.yaw_mode = "Spin"
        elseif (tonumber(source.jitter_angle) or 0) > 0 or source.jitter == true or legacy.aa_jitter == true then
            values.yaw_mode = "Jitter"
            values.jitter_range = source.jitter_angle or source.jitter_range or legacy.aa_jitter_range or 15
        end
        if oldPitch == "Look Up" then values.pitch_up = -70 end
        if oldPitch == "Look Down" then values.pitch_down = 70 end


        if source.Enabled == nil and source.YawMode == nil then
            if source.body_only_mode == nil then values.body_only_mode = false end
            if source.desync_enabled == nil then values.desync_enabled = false end
            if source.velocity_snap_enabled == nil then values.velocity_snap_enabled = false end
        end
    end
    for key, kind in pairs(core.PersistentKeys) do
        local value = values[key]
        if value ~= nil then
            if kind == "Color3" then
                if typeof(value) == "Color3" then AntiAimState[key] = value
                elseif type(value) == "table" and tonumber(value[1]) and tonumber(value[2]) and tonumber(value[3]) then
                    AntiAimState[key] = Color3.fromRGB(math.clamp(tonumber(value[1]), 0, 255), math.clamp(tonumber(value[2]), 0, 255), math.clamp(tonumber(value[3]), 0, 255))
                end
            elseif kind == "boolean" then AntiAimState[key] = value == true
            elseif kind == "number" then AntiAimState[key] = tonumber(value) or AntiAimState[key]
            elseif kind == "string" then AntiAimState[key] = tostring(value) end
        end
    end
    local presetName = core.PresetAliases[AntiAimState.preset] or AntiAimState.preset
    if source.Preset and core.Presets[presetName] then
        AntiAimState.preset = presetName
        AntiAimState.yaw_mode = core.Presets[presetName].yaw
        AntiAimState.pitch_mode = core.Presets[presetName].pitch
    end
    AntiAimState.Normalize()
    AntiAimState.ResetMotion()
end

local function aa_findNeck(character)
    if not character then return nil end
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local neck = torso and torso:FindFirstChild("Neck")
    if not neck then
        local head = character:FindFirstChild("Head")
        neck = head and head:FindFirstChild("Neck")
    end
    return neck and neck:IsA("Motor6D") and neck or nil
end

function AntiAimState.DisconnectList(connections)
    for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
    table.clear(connections)
end

function AntiAimState.RestorePose(character, release)
    local runtime = AntiAimState.core.Runtime


    runtime.desiredRotation, runtime.desiredPitch, runtime.desiredRoll = nil, nil, nil
    for humanoid, original in pairs(runtime.savedHumanoids) do
        if not character or humanoid.Parent == character then
            if humanoid.Parent then pcall(function() humanoid.AutoRotate = original end) end
            if release then runtime.savedHumanoids[humanoid] = nil end
        end
    end
    for neck, original in pairs(runtime.savedNecks) do
        if not character or neck:IsDescendantOf(character) then
            if neck.Parent then pcall(function() neck.C0 = original end) end
            if release then runtime.savedNecks[neck] = nil end
        end
    end
    for root, originalRotation in pairs(runtime.savedRoots) do
        if not character or root.Parent == character then
            if root.Parent and not root.Anchored then


                pcall(function() root.CFrame = CFrame.new(root.Position) * originalRotation end)
            end
            if release then runtime.savedRoots[root] = nil end
        end
    end
end

local function aa_restore()
    local core = AntiAimState.core
    local runtime = core.Runtime
    runtime.generation = runtime.generation + 1
    if runtime.bound then
        pcall(function() RunService:UnbindFromRenderStep(runtime.bindName) end)
        runtime.bound = false
    end
    AntiAimState.DisconnectList(runtime.connections)
    AntiAimState.DisconnectList(runtime.characterConnections)
    AntiAimState.DisconnectList(runtime.priorityConnections)
    table.clear(runtime.poseTargets)
    AntiAimState.RestorePose(nil, true)
    runtime.character, runtime.humanoid, runtime.root = nil, nil, nil
    runtime.characterBaseYaw, runtime.paused = nil, false
    runtime.lastDamageFlip = -math.huge
    AntiAimState.lastYaw, AntiAimState.lastPitch, AntiAimState.lastRoll, AntiAimState.lastAppliedYaw = nil, nil, nil, nil
    AntiAimState.ResetMotion()
end

function AntiAimState.BindCharacter(character, root, humanoid)
    local runtime = AntiAimState.core.Runtime
    if not character or not character.Parent then return false end
    humanoid = humanoid or character:FindFirstChildOfClass("Humanoid")
    root = root or character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then return false end
    if runtime.character == character and runtime.humanoid == humanoid and runtime.root == root
        and runtime.playerCharacter == LocalPlayer.Character then return true end
    if runtime.character then AntiAimState.RestorePose(nil, true) end
    AntiAimState.DisconnectList(runtime.characterConnections)
    AntiAimState.DisconnectList(runtime.priorityConnections)
    table.clear(runtime.poseTargets)
    runtime.character, runtime.humanoid, runtime.root = character, humanoid, root
    runtime.playerCharacter = LocalPlayer.Character
    runtime.savedHumanoids[humanoid] = humanoid.AutoRotate
    runtime.savedRoots[root] = root.CFrame.Rotation
    local look = root.CFrame.LookVector
    runtime.characterBaseYaw = math.atan2(-look.X, -look.Z)
    if AntiAimState.RegisterPoseTargets then AntiAimState.RegisterPoseTargets(character, root, humanoid) end
    local generation = runtime.generation
    local previousHealth = humanoid.Health
    runtime.characterConnections[#runtime.characterConnections + 1] = humanoid.HealthChanged:Connect(function(health)
        if generation ~= runtime.generation or runtime.character ~= character then return end
        if AntiAimState.enabled and not runtime.paused and AntiAimState.freestand_auto_flip and health > 0 and health < previousHealth then
            local now = os.clock()
            if now - runtime.lastDamageFlip >= AntiAimState.Number("freestand_hit_cooldown") then
                runtime.lastDamageFlip = now

                AntiAimState.freestand_direction = AntiAimState.freestand_direction == "Right" and "Left" or "Right"
                AntiAimState.SyncControls()
            end
        end
        previousHealth = health
    end)
    runtime.characterConnections[#runtime.characterConnections + 1] = humanoid.Died:Connect(function()
        if generation ~= runtime.generation or runtime.character ~= character then return end
        AntiAimState.RestorePose(nil, true)
        AntiAimState.DisconnectList(runtime.characterConnections)
        AntiAimState.DisconnectList(runtime.priorityConnections)
        table.clear(runtime.poseTargets)
        runtime.character, runtime.humanoid, runtime.root = nil, nil, nil
        AntiAimState.ResetMotion()
    end)
    AntiAimState.ResetMotion()
    runtime.lastDamageFlip = -math.huge
    return true
end

function AntiAimState.IsTargetVisible(targetCharacter, targetRoot)
    if not AntiAimState.target_visible_check then return true end
    if not targetCharacter or not targetRoot then return false end
    local camera = workspace.CurrentCamera
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local origin = camera and camera.CFrame.Position or (root and root.Position)
    if not origin then return false end
    local parameters = RaycastParams.new()
    parameters.IgnoreWater = true
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = character and {character} or {}
    local result = workspace:Raycast(origin, targetRoot.Position - origin, parameters)
    return result == nil or (result.Instance and result.Instance:IsDescendantOf(targetCharacter))
end

function AntiAimState.PickRotationTarget(now)
    now = now or os.clock()
    local cached = AntiAimState.targetPlayer
    if AntiAimState.lastTargetUpdate and now - AntiAimState.lastTargetUpdate < AntiAimState.Number("target_update_delay") then
        local character = cached and cached.Parent and cached.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then return cached end
        if not cached then return nil end
    end
    AntiAimState.lastTargetUpdate = now
    local camera = workspace.CurrentCamera
    local character = LocalPlayer.Character
    local localRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not camera or not localRoot then AntiAimState.targetPlayer = nil; return nil end
    local center = camera.ViewportSize * 0.5
    local best, distance = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not (AntiAimState.target_team_check and LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team) then
            local targetCharacter = player.Character
            local humanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            local root = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and root and (root.Position - localRoot.Position).Magnitude <= AntiAimState.Number("target_max_distance") then
                local point, visible = camera:WorldToViewportPoint(root.Position)
                local screenDistance = (Vector2.new(point.X, point.Y) - center).Magnitude
                if visible and point.Z > 0 and screenDistance <= AntiAimState.Number("target_fov") and screenDistance < distance and AntiAimState.IsTargetVisible(targetCharacter, root) then
                    best, distance = player, screenDistance
                end
            end
        end
    end
    AntiAimState.targetPlayer = best
    return best
end

function AntiAimState.ResolveBaseYaw(root, humanoid, camera, now)
    local mode = AntiAimState.yaw_base
    if mode == "World" then return 0 end
    local look
    if mode == "At Target" then
        local target = AntiAimState.PickRotationTarget(now)
        local targetRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then look = targetRoot.Position - root.Position end
    elseif mode == "Movement" and humanoid.MoveDirection.Magnitude > 0.01 then
        look = humanoid.MoveDirection
    elseif mode == "Character" then
        return AntiAimState.core.Runtime.characterBaseYaw or 0
    end
    look = look or (camera and camera.CFrame.LookVector) or root.CFrame.LookVector
    if look.X * look.X + look.Z * look.Z < 0.000001 then
        return AntiAimState.core.Runtime.characterBaseYaw or 0
    end
    return math.atan2(-look.X, -look.Z)
end

function AntiAimState.LerpAngle(current, target, alpha)
    local difference = (target - current + math.pi) % (math.pi * 2) - math.pi
    return current + difference * math.clamp(alpha, 0, 1)
end

function AntiAimState.ComputeAngles(dt, elapsed, baseYaw, root, humanoid)
    local core, n = AntiAimState.core, AntiAimState.Number
    local runtime = core.Runtime
    local yawMode, pitchMode = AntiAimState.yaw_mode, AntiAimState.pitch_mode
    local velocity = root.AssemblyLinearVelocity
    local speed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
    if yawMode == "Velocity Snap" or AntiAimState.velocity_snap_enabled then
        yawMode = speed < n("velocity_threshold") and AntiAimState.velocity_slow_mode or AntiAimState.velocity_move_mode
        if yawMode == "Velocity Snap" then yawMode = "Safe Jitter" end
    end
    if runtime.lastYawMode ~= yawMode then
        runtime.spin, runtime.offsetSpin = 0, 0
        runtime.lastYawMode = yawMode
    end
    local function flip(rate) return math.floor(elapsed * rate) % 2 == 0 and 1 or -1 end
    local yaw = 180
    if yawMode == "Forward" then yaw = 0
    elseif yawMode == "Left" then yaw = 90
    elseif yawMode == "Right" then yaw = -90
    elseif yawMode == "Static" then yaw = n("static_yaw_offset")
    elseif yawMode == "Jitter" then yaw = 180 + n("jitter_range") * flip(n("jitter_speed"))
    elseif yawMode == "Micro Jitter" then yaw = 180 + n("micro_jitter_range") * flip(n("micro_jitter_speed"))
    elseif yawMode == "Safe Jitter" then yaw = n("safe_jitter_base") + n("safe_jitter_range") * flip(n("safe_jitter_speed"))
    elseif yawMode == "Jitter 180" then yaw = n("jitter_180_base") + n("jitter_180_range") * flip(n("jitter_180_speed"))
    elseif yawMode == "Spin" then runtime.spin = (runtime.spin + n("spin_speed") * dt) % 360; yaw = runtime.spin
    elseif yawMode == "Offset Spin" then runtime.offsetSpin = (runtime.offsetSpin + n("offset_spin_speed") * dt) % 360; yaw = runtime.offsetSpin
    elseif yawMode == "Sway" then yaw = 180 + math.sin(elapsed * n("sway_speed") * math.pi * 2) * n("sway_range")
    elseif yawMode == "Random" then
        if not runtime.lastRandom or elapsed - runtime.lastRandom >= n("random_interval") then
            runtime.randomAngle = (math.random() * 2 - 1) * n("random_range")
            runtime.lastRandom = elapsed
        end
        yaw = runtime.randomAngle
    elseif yawMode == "Freestanding" then
        yaw = n("freestand_base") + n("freestand_flip_angle") * (AntiAimState.freestand_direction == "Right" and 1 or -1)
    elseif yawMode == "Opposite Strafe" then

        local direction = humanoid.MoveDirection
        local lateral = direction.X * math.cos(baseYaw) - direction.Z * math.sin(baseYaw)
        if math.abs(lateral) > 0.01 then yaw = 180 + n("opposite_strafe_offset") * (lateral > 0 and -1 or 1) end
    end
    yaw = yaw + n("yaw_offset")
    if AntiAimState.movement_override then
        if humanoid.FloorMaterial == Enum.Material.Air then yaw = yaw + n("air_yaw_add")
        elseif speed >= n("movement_threshold") then yaw = yaw + n("moving_yaw_add")
        else yaw = yaw + n("standing_yaw_add") end
    end
    if AntiAimState.yaw_invert then yaw = -yaw end
    local pitch = 0
    if pitchMode == "Down" then pitch = n("pitch_down")
    elseif pitchMode == "Up" then pitch = n("pitch_up")
    elseif pitchMode == "Zero" then pitch = n("pitch_zero")
    elseif pitchMode == "Down Override" then pitch = n("pitch_down_override")
    elseif pitchMode == "Up Override" then pitch = n("pitch_up_override")
    elseif pitchMode == "Jitter" then pitch = n("pitch_jitter_range") * flip(n("pitch_jitter_speed"))
    elseif pitchMode == "Custom" then pitch = n("pitch_custom") end
    if yawMode == "Offset Spin" then pitch = n("offset_spin_pitch") end
    local roll = n("roll_angle") + n("roll_jitter") * flip(n("pitch_jitter_speed"))
    runtime.activeYawMode, runtime.activePitchMode = yawMode, yawMode == "Offset Spin" and "Offset Spin" or pitchMode
    return (yaw + 180) % 360 - 180, math.clamp(pitch, -89, 89), math.clamp(roll, -90, 90)
end

function AntiAimState.UpdateStatus(force)
    local core = AntiAimState.core
    if not core.StatusControl then return end
    local now = os.clock()
    if not force and core.lastStatus and now - core.lastStatus < 0.15 then return end
    core.lastStatus = now
    local runtime = core.Runtime
    local text = "Status: Disabled"
    if AntiAimState.enabled then
        if not runtime.character then text = "Status: Waiting for character"
        elseif runtime.paused then text = "Status: Paused"
        else text = (runtime.usingMatchRig and "Match: " or "Active: ") .. tostring(runtime.activeYawMode or AntiAimState.yaw_mode) .. " / " .. tostring(runtime.activePitchMode or AntiAimState.pitch_mode)
            .. (AntiAimState.override_other_anti_aim and " | Priority" or "") end
    end
    core.StatusControl:SetText(text)
end

function AntiAimState.Step(dt)
    if not AntiAimState.enabled then return end
    local core, n = AntiAimState.core, AntiAimState.Number
    local runtime = core.Runtime
    local playerCharacter = LocalPlayer.Character
    local character, resolvedRoot, resolvedHumanoid = AntiAimState.ResolveCharacter()
    if runtime.initialCharacter and runtime.initialCharacter ~= playerCharacter and not AntiAimState.respawn_reapply then

        if core.Apply then core.Apply(false) end
        return
    end
    if not AntiAimState.BindCharacter(character, resolvedRoot, resolvedHumanoid) then AntiAimState.UpdateStatus(false); return end
    local humanoid, root = runtime.humanoid, runtime.root
    if humanoid.Parent ~= character or root.Parent ~= character or humanoid.Health <= 0 then return end
    local paused = (AntiAimState.pause_while_typing and uis:GetFocusedTextBox() ~= nil)
        or (AntiAimState.pause_while_seated and humanoid.SeatPart ~= nil)
        or (AntiAimState.ground_only and humanoid.FloorMaterial == Enum.Material.Air)
        or root.Anchored
    if paused then
        if not runtime.paused then AntiAimState.RestorePose(nil, false); AntiAimState.ResetMotion() end
        runtime.paused = true
        AntiAimState.UpdateStatus(false)
        return
    end
    if runtime.paused then
        runtime.savedRoots[root] = root.CFrame.Rotation
        runtime.savedHumanoids[humanoid] = humanoid.AutoRotate
        runtime.paused = false
    end
    dt = tonumber(dt) or 0
    if dt ~= dt or dt <= 0 or dt == math.huge then return end
    dt = math.min(dt, 1)
    runtime.elapsed = runtime.elapsed + dt
    humanoid.AutoRotate = false
    local baseYaw = AntiAimState.ResolveBaseYaw(root, humanoid, workspace.CurrentCamera, os.clock())
    local yaw, pitch, roll = AntiAimState.ComputeAngles(dt, runtime.elapsed, baseYaw, root, humanoid)
    local desiredYaw = baseYaw + math.rad(yaw)
    local alpha = AntiAimState.smooth_enabled and (1 - math.exp(-n("smooth_speed") * dt)) or 1
    runtime.smoothYaw = AntiAimState.LerpAngle(runtime.smoothYaw or desiredYaw, desiredYaw, alpha)
    runtime.smoothPitch = (runtime.smoothPitch or pitch) + (pitch - (runtime.smoothPitch or pitch)) * alpha
    runtime.smoothRoll = (runtime.smoothRoll or roll) + (roll - (runtime.smoothRoll or roll)) * alpha


    if AntiAimState.fake_lag_enabled and runtime.lastPush and runtime.elapsed - runtime.lastPush + 0.0000001 < n("fake_lag_interval") then
        AntiAimState.UpdateStatus(false)
        return
    end
    runtime.lastPush = runtime.elapsed
    local appliedYaw = runtime.smoothYaw
    if AntiAimState.desync_enabled then
        if not AntiAimState.desync_alternate or math.floor(runtime.elapsed * n("desync_speed") * 2) % 2 == 0 then
            appliedYaw = appliedYaw + math.rad(n("desync_delta"))
        end
    end
    local appliedPitch, appliedRoll = runtime.smoothPitch, runtime.smoothRoll


    runtime.desiredRotation = AntiAimState.body_only_mode
        and CFrame.fromEulerAnglesYXZ(-math.rad(appliedPitch), appliedYaw, math.rad(appliedRoll))
        or CFrame.Angles(0, appliedYaw, 0)
    runtime.desiredPitch, runtime.desiredRoll = appliedPitch, appliedRoll
    AntiAimState.WritePose(false)
    AntiAimState.lastYaw = (math.deg(appliedYaw - baseYaw) + 180) % 360 - 180
    AntiAimState.lastPitch, AntiAimState.lastRoll = appliedPitch, appliedRoll
    AntiAimState.lastAppliedYaw = (math.deg(appliedYaw) + 180) % 360 - 180
    AntiAimState.UpdateStatus(false)
end

local function aa_apply(enabled)
    local core = AntiAimState.core
    if core.Syncing then AntiAimState.enabled = enabled == true; return true end
    aa_restore()
    AntiAimState.enabled = enabled == true and not core.Unloaded
    AntiAimState.Normalize()
    local runtime = core.Runtime
    runtime.initialCharacter = LocalPlayer.Character
    if AntiAimState.enabled then
        local generation = runtime.generation
        runtime.connections[#runtime.connections + 1] = LocalPlayer.CharacterRemoving:Connect(function(character)
            if generation ~= runtime.generation then return end
            AntiAimState.RestorePose(nil, true)
            AntiAimState.DisconnectList(runtime.characterConnections)
            AntiAimState.DisconnectList(runtime.priorityConnections)
            table.clear(runtime.poseTargets)
            runtime.character, runtime.humanoid, runtime.root = nil, nil, nil
            AntiAimState.ResetMotion()
        end)
        runtime.connections[#runtime.connections + 1] = LocalPlayer.CharacterAdded:Connect(function(character)
            if generation ~= runtime.generation then return end
            if not AntiAimState.respawn_reapply and runtime.initialCharacter then aa_apply(false); return end
            runtime.initialCharacter = character

        end)
        local ok, bindError = pcall(function()
            RunService:BindToRenderStep(runtime.bindName, math.floor(AntiAimState.Number("render_priority")), function(dt)
                if generation ~= runtime.generation or not AntiAimState.enabled then return end
                local stepOk, stepError = pcall(AntiAimState.Step, dt)
                if not stepOk and generation == runtime.generation then
                    core.lastError = tostring(stepError)
                    aa_apply(false)
                    warn("[DevKage Anti-Aim] Disabled after runtime error: " .. tostring(stepError))
                end
            end)
        end)
        if ok and AntiAimState.reapply_before_physics then
            runtime.connections[#runtime.connections + 1] = RunService.PreSimulation:Connect(function()
                if generation ~= runtime.generation then return end
                local poseOk, poseError = pcall(AntiAimState.WritePose, true)
                if not]==================],
    [==================[ poseOk then core.lastError = tostring(poseError) end
            end)
        end
        if ok then runtime.bound = true
        else
            aa_restore()
            AntiAimState.enabled = false
            core.lastError = tostring(bindError)
            warn("[DevKage Anti-Aim] Could not start: " .. tostring(bindError))
        end
    end
    AntiAimState.SyncControls()
    AntiAimState.UpdateStatus(true)
    return AntiAimState.enabled == (enabled == true)
end
AntiAimState.core.Apply = aa_apply

library.CleanupCallbacks[#library.CleanupCallbacks + 1] = function()
    aa_apply(false)
    AntiAimState.core.Unloaded = true
    if AntiAimState.core.InputConnection then
        AntiAimState.core.InputConnection:Disconnect()
        AntiAimState.core.InputConnection = nil
    end
end




function AntiAimState.RefreshMatchController()
    local core = AntiAimState.core
    if not AntiAimState.use_match_character or core.Unloaded then return end
    if core.ControllerModule and not core.ControllerModule.Parent then
        core.Controller, core.ControllerModule = nil, nil
    end
    if core.Controller or core.ControllerLoading then return end
    local now = os.clock()
    if core.NextControllerProbe and now < core.NextControllerProbe then return end
    core.NextControllerProbe = now + 1
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local controllers = playerScripts and playerScripts:FindFirstChild("Controllers")
    local module = controllers and controllers:FindFirstChild("FighterController")
    if not module or not module:IsA("ModuleScript") then return end
    core.ControllerLoading = true
    task.spawn(function()
        local ok, controller = pcall(require, module)
        core.ControllerLoading = false
        if core.Unloaded or not module.Parent then return end
        if ok and type(controller) == "table" then
            core.Controller, core.ControllerModule = controller, module
        end
    end)
end

function AntiAimState.ResolveCharacter()
    local core, runtime = AntiAimState.core, AntiAimState.core.Runtime
    AntiAimState.RefreshMatchController()
    if AntiAimState.use_match_character and core.Controller then
        local ok, character, root, humanoid = pcall(function()
            local fighter = core.Controller.LocalFighter
            if not fighter or (fighter.Player and fighter.Player ~= LocalPlayer) then return end
            local entity = fighter.Entity
            local matchRoot = entity and entity.RootPart
            if not matchRoot or not matchRoot.Parent or not matchRoot:IsA("BasePart") then return end
            local model = matchRoot.Parent
            local hum = model:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end
            return model, matchRoot, hum
        end)
        if ok and character then
            runtime.usingMatchRig = true
            return character, root, humanoid
        end
    end
    runtime.usingMatchRig = false
    local character = LocalPlayer.Character
    return character, character and character:FindFirstChild("HumanoidRootPart"),
        character and character:FindFirstChildOfClass("Humanoid")
end

function AntiAimState.RotationDiffers(current, desired)
    return current.LookVector:Dot(desired.LookVector) < 0.999999
        or current.RightVector:Dot(desired.RightVector) < 0.999999
end

function AntiAimState.RegisterPoseTargets(character, root, humanoid)
    local runtime = AntiAimState.core.Runtime
    local generation = runtime.generation
    local function addTarget(model, part, hum)
        if not model or not part or not hum or part.Parent ~= model or hum.Health <= 0 then return end
        for _, target in ipairs(runtime.poseTargets) do if target.root == part then return end end
        runtime.savedRoots[part] = runtime.savedRoots[part] or part.CFrame.Rotation
        if runtime.savedHumanoids[hum] == nil then runtime.savedHumanoids[hum] = hum.AutoRotate end
        local neck = aa_findNeck(model)
        if neck then runtime.savedNecks[neck] = runtime.savedNecks[neck] or neck.C0 end
        runtime.poseTargets[#runtime.poseTargets + 1] = {character=model, root=part, humanoid=hum, neck=neck}
        if not AntiAimState.override_other_anti_aim then return end
        local function repair()
            if generation ~= runtime.generation or not AntiAimState.enabled or runtime.enforcing then return end



            local ok, err = pcall(AntiAimState.WritePose, true)
            if not ok then AntiAimState.core.lastError = tostring(err) end
        end
        runtime.priorityConnections[#runtime.priorityConnections + 1] =
            part:GetPropertyChangedSignal("CFrame"):Connect(repair)
        if neck then
            runtime.priorityConnections[#runtime.priorityConnections + 1] =
                neck:GetPropertyChangedSignal("C0"):Connect(repair)
        end
    end
    addTarget(character, root, humanoid)


    local localCharacter = LocalPlayer.Character
    if localCharacter and localCharacter ~= character then
        addTarget(localCharacter, localCharacter:FindFirstChild("HumanoidRootPart"),
            localCharacter:FindFirstChildOfClass("Humanoid"))
    end
end

function AntiAimState.WritePose(correctionOnly)
    local core, runtime = AntiAimState.core, AntiAimState.core.Runtime
    if not AntiAimState.enabled or core.Syncing or core.Unloaded or runtime.paused
        or runtime.enforcing or not runtime.desiredRotation then return end
    if AntiAimState.pause_while_typing and uis:GetFocusedTextBox() then return end
    local now = os.clock()
    if not runtime.repairWindow or now - runtime.repairWindow >= 1 / 60 then
        runtime.repairWindow, runtime.repairCount = now, 0
    end
    if correctionOnly and (runtime.repairCount or 0) >= 8 then return end
    runtime.enforcing = true
    local changed = false
    local ok, err = pcall(function()
        for _, target in ipairs(runtime.poseTargets) do
            local root, hum, neck = target.root, target.humanoid, target.neck
            if root.Parent == target.character and hum.Parent == target.character
                and hum.Health > 0 and not root.Anchored
                and not (AntiAimState.pause_while_seated and hum.SeatPart)
                and not (AntiAimState.ground_only and hum.FloorMaterial == Enum.Material.Air) then
                hum.AutoRotate = false
                if not correctionOnly or AntiAimState.RotationDiffers(root.CFrame, runtime.desiredRotation) then
                    root.CFrame = CFrame.new(root.Position) * runtime.desiredRotation
                    changed = true
                end
                if neck and neck.Parent then
                    local rest = runtime.savedNecks[neck]
                    if rest then
                        local desired = rest
                        if not AntiAimState.body_only_mode then
                            desired = CFrame.new(rest.Position)
                                * CFrame.Angles(-math.rad(runtime.desiredPitch or 0), 0, math.rad(runtime.desiredRoll or 0))
                                * rest.Rotation
                        end
                        if not correctionOnly or AntiAimState.RotationDiffers(neck.C0, desired)
                            or (neck.C0.Position - desired.Position).Magnitude > 0.0001 then
                            neck.C0 = desired
                            changed = true
                        end
                    end
                end
            end
        end
    end)
    runtime.enforcing = false
    if changed and correctionOnly then runtime.repairCount = (runtime.repairCount or 0) + 1 end
    if not ok then error(err) end
end


local AntiAimMovement = {
    noclipConnection = nil,
    flightConnection = nil,
    collisionOriginals = setmetatable({}, {__mode = "k"}),
    flightRoot = nil,
    flightHumanoid = nil,
    flightAutoRotate = nil,
    flightPlatformStand = nil,
    flightSit = nil,
    flightAttachment = nil,
    flightVelocity = nil,
    flightOrientation = nil,
    flightBodyVelocity = nil,
    flightBodyGyro = nil,
}

function AntiAimMovement:RestoreCollisions()
    for part, canCollide in pairs(self.collisionOriginals) do
        if part and part.Parent then
            pcall(function() part.CanCollide = canCollide end)
        end
    end
    table.clear(self.collisionOriginals)
end

function AntiAimMovement:WakeCharacter()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 or root.Anchored then return end

    pcall(function()
        if not humanoid.PlatformStand and not humanoid.Sit then
            if humanoid.FloorMaterial == Enum.Material.Air then
                humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                local velocity = root.AssemblyLinearVelocity
                if velocity.Magnitude < 0.05 then
                    root.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                end
            else
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end)
end

function AntiAimMovement:SetNoClip(enabled)
    local wasActive = self.noclipConnection ~= nil or AntiAimState.noclip_enabled == true
    AntiAimState.noclip_enabled = enabled == true
    if self.noclipConnection then
        pcall(function() self.noclipConnection:Disconnect() end)
        self.noclipConnection = nil
    end
    if not AntiAimState.noclip_enabled then
        if wasActive or next(self.collisionOriginals) ~= nil then
            self:RestoreCollisions()
        end
        return
    end

    self.noclipConnection = RunService.Stepped:Connect(function()
        if not AntiAimState.noclip_enabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if self.collisionOriginals[part] == nil then
                    self.collisionOriginals[part] = part.CanCollide
                end
                if part.CanCollide then part.CanCollide = false end
            end
        end
    end)
end

function AntiAimMovement:ClearFlightRig(releaseCharacter)
    local root = self.flightRoot
    local humanoid = self.flightHumanoid
    local savedAutoRotate = self.flightAutoRotate
    local savedPlatformStand = self.flightPlatformStand
    local savedSit = self.flightSit
    local hadFlightRig = root ~= nil
        or self.flightAttachment ~= nil
        or self.flightVelocity ~= nil
        or self.flightOrientation ~= nil
        or self.flightBodyVelocity ~= nil
        or self.flightBodyGyro ~= nil

    for _, object in ipairs({self.flightBodyGyro, self.flightBodyVelocity, self.flightOrientation, self.flightVelocity, self.flightAttachment}) do
        if object then pcall(function() object:Destroy() end) end
    end

    if humanoid and humanoid.Parent then
        pcall(function()
            if savedAutoRotate ~= nil then
                humanoid.AutoRotate = AntiAimState.enabled and false or savedAutoRotate
            end
            if savedPlatformStand ~= nil then humanoid.PlatformStand = savedPlatformStand end
            if savedSit ~= nil then humanoid.Sit = savedSit end
        end)
    end

    self.flightRoot = nil
    self.flightHumanoid = nil
    self.flightAutoRotate = nil
    self.flightPlatformStand = nil
    self.flightSit = nil
    self.flightAttachment = nil
    self.flightVelocity = nil
    self.flightOrientation = nil
    self.flightBodyVelocity = nil
    self.flightBodyGyro = nil

    if releaseCharacter == true and hadFlightRig then
        task.defer(function()
            if AntiAimState.flight_enabled then return end
            local character = LocalPlayer.Character
            local liveHumanoid = character and character:FindFirstChildOfClass("Humanoid")
            local liveRoot = character and character:FindFirstChild("HumanoidRootPart")
            if not liveHumanoid or not liveRoot or liveHumanoid.Health <= 0 or liveRoot.Anchored then return end

            pcall(function()
                for _, name in ipairs({"DevKageFlightVelocity", "DevKageFlightOrientation", "DevKageFlightVelocityLegacy", "DevKageFlightGyroLegacy", "DevKageFlightAttachment"}) do
                    local stale = liveRoot:FindFirstChild(name)
                    if stale then stale:Destroy() end
                end

                local look = liveRoot.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude > 0.001 then
                    liveRoot.CFrame = CFrame.lookAt(liveRoot.Position, liveRoot.Position + flat.Unit, Vector3.new(0, 1, 0))
                end
                liveRoot.AssemblyAngularVelocity = Vector3.zero

                if liveHumanoid.FloorMaterial == Enum.Material.Air then
                    liveHumanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                    local velocity = liveRoot.AssemblyLinearVelocity
                    liveRoot.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(velocity.Y, -10), velocity.Z)
                else
                    liveHumanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end)
    end
end

function AntiAimMovement:BuildFlightRig(root, humanoid)
    self:ClearFlightRig(false)
    if not root or not humanoid then return false end

    self.flightRoot = root
    self.flightHumanoid = humanoid
    self.flightAutoRotate = humanoid.AutoRotate
    self.flightPlatformStand = humanoid.PlatformStand
    self.flightSit = humanoid.Sit
    pcall(function() humanoid.AutoRotate = false end)

    local attachment = Instance.new("Attachment")
    attachment.Name = "DevKageFlightAttachment"
    attachment.Parent = root
    self.flightAttachment = attachment

    local modernOk = pcall(function()
        local velocity = Instance.new("LinearVelocity")
        velocity.Name = "DevKageFlightVelocity"
        velocity.Attachment0 = attachment
        velocity.RelativeTo = Enum.ActuatorRelativeTo.World
        velocity.MaxForce = 1000000000
        velocity.VectorVelocity = Vector3.zero
        velocity.Parent = root
        self.flightVelocity = velocity

        local orientation = Instance.new("AlignOrientation")
        orientation.Name = "DevKageFlightOrientation"
        orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        orientation.Attachment0 = attachment
        orientation.MaxTorque = 1000000000
        orientation.Responsiveness = 35
        orientation.RigidityEnabled = false
        orientation.CFrame = root.CFrame
        orientation.Parent = root
        self.flightOrientation = orientation
    end)

    if not modernOk then
        if self.flightVelocity then pcall(function() self.flightVelocity:Destroy() end); self.flightVelocity = nil end
        if self.flightOrientation then pcall(function() self.flightOrientation:Destroy() end); self.flightOrientation = nil end
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "DevKageFlightVelocityLegacy"
        bodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVelocity.P = 25000
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = root
        self.flightBodyVelocity = bodyVelocity

        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "DevKageFlightGyroLegacy"
        bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro.P = 50000
        bodyGyro.D = 1200
        bodyGyro.CFrame = root.CFrame
        bodyGyro.Parent = root
        self.flightBodyGyro = bodyGyro
    end
    return true
end

function AntiAimMovement:SetFlight(enabled)
    local wasActive = self.flightConnection ~= nil
        or self.flightRoot ~= nil
        or self.flightVelocity ~= nil
        or self.flightBodyVelocity ~= nil
        or AntiAimState.flight_enabled == true
    AntiAimState.flight_enabled = enabled == true
    if self.flightConnection then
        pcall(function() self.flightConnection:Disconnect() end)
        self.flightConnection = nil
    end
    if wasActive then
        self:ClearFlightRig(not AntiAimState.flight_enabled)
    end
    if not AntiAimState.flight_enabled then return end

    self.flightConnection = RunService.RenderStepped:Connect(function()
        if not AntiAimState.flight_enabled then return end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then
            if self.flightRoot then self:ClearFlightRig(false) end
            return
        end
        if self.flightRoot ~= root or (not self.flightVelocity and not self.flightBodyVelocity) then
            if not self:BuildFlightRig(root, humanoid) then return end
        end
        if humanoid.AutoRotate then pcall(function() humanoid.AutoRotate = false end) end

        local camera = workspace.CurrentCamera
        if not camera then return end
        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector

        local mousePosition = uis:GetMouseLocation()
        local aimRay = camera:ViewportPointToRay(mousePosition.X, mousePosition.Y)
        local aimDirection = aimRay.Direction
        if aimDirection.Magnitude > 0.001 then
            aimDirection = aimDirection.Unit
        elseif look.Magnitude > 0.001 then
            aimDirection = look.Unit
        else
            aimDirection = Vector3.new(0, 0, -1)
        end
        local sideways = right.Magnitude > 0.001 and right.Unit or Vector3.new(1, 0, 0)

        local direction = Vector3.zero
        if uis:IsKeyDown(Enum.KeyCode.W) then direction += aimDirection end
        if uis:IsKeyDown(Enum.KeyCode.S) then direction -= aimDirection end
        if uis:IsKeyDown(Enum.KeyCode.D) then direction += sideways end
        if uis:IsKeyDown(Enum.KeyCode.A) then direction -= sideways end
        if direction.Magnitude > 1 then direction = direction.Unit end

        local speed = math.clamp(tonumber(AntiAimState.flight_speed) or 120, 10, 500)
        local targetVelocity = direction * speed
        if self.flightVelocity then
            pcall(function() self.flightVelocity.VectorVelocity = targetVelocity end)
        elseif self.flightBodyVelocity then
            pcall(function() self.flightBodyVelocity.Velocity = targetVelocity end)
        else
            pcall(function() root.AssemblyLinearVelocity = targetVelocity end)
        end

        local up = camera.CFrame.UpVector
        if math.abs(aimDirection:Dot(up)) > 0.98 then up = Vector3.new(0, 1, 0) end
        local facing = CFrame.lookAt(root.Position, root.Position + aimDirection, up)
        if self.flightOrientation then
            pcall(function() self.flightOrientation.CFrame = facing end)
        elseif self.flightBodyGyro then
            pcall(function() self.flightBodyGyro.CFrame = facing end)
        end
    end)
end

function AntiAimMovement:Cleanup()
    AntiAimState.noclip_enabled = false
    AntiAimState.flight_enabled = false
    if self.noclipConnection then pcall(function() self.noclipConnection:Disconnect() end); self.noclipConnection = nil end
    if self.flightConnection then pcall(function() self.flightConnection:Disconnect() end); self.flightConnection = nil end
    self:RestoreCollisions()
    self:ClearFlightRig(true)
end

