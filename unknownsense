local function rapidFireSnapshotWeapon(weaponName, data)
    weaponName = tostring(weaponName or "")
    if weaponName == "" or type(data) ~= "table" then return nil end

    local snapshot = RapidFireRuntime.Originals[weaponName]
    if type(snapshot) ~= "table" then
        snapshot = {}
        RapidFireRuntime.Originals[weaponName] = snapshot
    end

    for _, field in ipairs(rapidFireRelevantFields(data)) do
        if snapshot[field] == nil then
            snapshot[field] = data[field]
        end
    end

    return snapshot
end

local function rapidFireRestoreWeapon(weaponName)
    weaponName = tostring(weaponName or "")
    local items = RapidFireRuntime.Items
    local snapshot = RapidFireRuntime.Originals[weaponName]
    local applied = RapidFireRuntime.Applied[weaponName]

    if type(items) ~= "table"
        or type(items[weaponName]) ~= "table"
        or type(snapshot) ~= "table" then
        RapidFireRuntime.Applied[weaponName] = nil
        return false
    end

    local data = items[weaponName]

    for field, originalValue in pairs(snapshot) do
        local lastApplied = type(applied) == "table" and applied[field] or nil




        if lastApplied == nil or data[field] == lastApplied then
            data[field] = originalValue
        end
    end

    RapidFireRuntime.Applied[weaponName] = nil
    return true
end

local function rapidFireRestoreAll()
    for weaponName in pairs(RapidFireRuntime.Originals) do
        pcall(rapidFireRestoreWeapon, weaponName)
    end
end

local function rapidFireApplyWeapon(weaponName, percent)
    local items = rapidFireLoadItems()
    weaponName = tostring(weaponName or "")

    if type(items) ~= "table" or weaponName == "" then
        return false, 0, "ItemLibrary unavailable"
    end

    local data = items[weaponName]
    if type(data) ~= "table" then
        return false, 0, "Weapon data not found"
    end

    local fields = rapidFireRelevantFields(data)
    if #fields == 0 then
        return false, 0, "No supported cooldown fields"
    end



    rapidFireRestoreWeapon(weaponName)

    local snapshot = rapidFireSnapshotWeapon(weaponName, data)
    if type(snapshot) ~= "table" then
        return false, 0, "Could not snapshot weapon"
    end

    percent = math.clamp(tonumber(percent) or 100, 1, 100)

    local applied = {}
    local changed = 0

    for _, field in ipairs(fields) do
        local originalValue = snapshot[field]
        if type(originalValue) == "number" and originalValue > 0 then
            local scaledValue = rapidFireScaledCooldown(originalValue, percent)
            data[field] = scaledValue
            applied[field] = scaledValue
            changed = changed + 1
        end
    end

    RapidFireRuntime.Applied[weaponName] = applied

    local kind
    if rapidFireLooksMeleeData(data) then
        kind = "melee"
    elseif rapidFireLooksGunData(data) then
        kind = "gun"
    else
        kind = "weapon"
    end

    return changed > 0, changed, kind
end

local function rapidFireApplyConfigured()
    local config = getgenv().__DevKageConfig
    if type(config) ~= "table" or config.rapidFireEnabled ~= true then
        rapidFireRestoreAll()
        return
    end





    pcall(RapidFireRuntime.InstallTypeHooks)

    local items = rapidFireLoadItems()
    if type(items) ~= "table" then return end

    if type(config.rapidFireRates) ~= "table" then
        config.rapidFireRates = {}
    end



    for weaponName, data in pairs(items) do
        if type(data) == "table" and #rapidFireRelevantFields(data) > 0 then
            pcall(
                rapidFireApplyWeapon,
                tostring(weaponName),
                rapidFireDelayPercent(tostring(weaponName))
            )
        end
    end
end

local function rapidFireWeaponNames(loadModule)
    local found = {}

    if loadModule then
        local items = rapidFireLoadItems()
        if type(items) == "table" then
            for name, data in pairs(items) do
                if type(data) == "table" and #rapidFireRelevantFields(data) > 0 then
                    found[tostring(name)] = true
                end
            end
        end
    end

    local function scan(container)
        if not container then return end
        for _, object in ipairs(container:GetChildren()) do
            if object:IsA("Tool") then
                found[tostring(object.Name)] = true
            end
        end
    end

    scan(LocalPlayer and LocalPlayer:FindFirstChildOfClass("Backpack"))
    scan(LocalPlayer and LocalPlayer.Character)

    local names = {}
    for name in pairs(found) do
        names[#names + 1] = name
    end

    table.sort(names, function(a, b)
        local items = RapidFireRuntime.Items
        local aData = type(items) == "table" and items[a] or nil
        local bData = type(items) == "table" and items[b] or nil
        local aMelee = rapidFireLooksMeleeData(aData)
        local bMelee = rapidFireLooksMeleeData(bData)

        if aMelee ~= bMelee then
            return aMelee
        end
        return a:lower() < b:lower()
    end)

    if #names == 0 then
        names[1] = "Equipped Weapon"
    end

    return names
end

