if target:sub(1,1)=="_" then library:Notify({Message="Reserved config files cannot be deleted here",Duration=4}); return end
local path = CONFIG_FOLDER .. "/" .. target .. ".json"
local deleted=false
if type(delfile)=="function" then
local shouldDelete=true
if type(isfile)=="function" then
local existsOk,exists=pcall(isfile,path)
shouldDelete=existsOk and exists==true
end
if shouldDelete then deleted=pcall(delfile,path) end
end
if deleted then
if get_autoload() == target then set_autoload("") end
configSelected = nil
configNameBox:Set("")
if autoLoadStatusLabel then autoLoadStatusLabel:SetText("Auto-load: " .. ((get_autoload() ~= "" and get_autoload()) or "none") .. " | selected: none") end
end
rebuildConfigList()
library:Notify({Message=deleted and "Config deleted" or "Config could not be deleted",Duration=4})
end
})

