-- CURSOR POSITION
-- ============================================================

local function referenceCursorPosition(settings)
    -- Always follow the real mouse.  Do not fall back to screen center or a
    -- crosshair position: the DevKage cursor is the UI mouse pointer.
    local mousePosition = uis:GetMouseLocation()
    return Vector2.new(mousePosition.X, mousePosition.Y)
end

-- ============================================================
-- TEXT
-- ============================================================

local function referenceApplyText(
    settings,
    cursorPosition,
    color
)
    local runtime =
        ReferenceCursorRuntime

    local main =
        runtime.MainText

    local second =
        runtime.SecondText

    if not main
        or not second then

        return
    end

    local textEnabled =
        settings.TextEnabled == true
        and settings.Enabled ~= false

    local mainValue =
        tostring(
            settings.MainText
            or "devkage"
        )

    local secondValue =
        tostring(
            settings.SecondText
            or "None"
        )

    main.Visible =
        textEnabled
        and mainValue ~= ""
        and mainValue ~= "None"

    second.Visible =
        textEnabled
        and secondValue ~= ""
        and secondValue ~= "None"

    -- Keep the supplied cursor's exact font every frame.
    main.Font =
        Enum.Font.Arcade

    second.Font =
        Enum.Font.Arcade

    -- Keep TextScaled exactly like the supplied cursor.
    main.TextScaled = true
    second.TextScaled = true

    local mainSize =
        referenceCursorNumber(
            settings.MainTextSize,
            20,
            8,
            40
        )

    local secondSize =
        referenceCursorNumber(
            settings.SecondTextSize,
            15,
            8,
            40
        )

    local mainScale =
        mainSize / 20

    local secondScale =
        secondSize / 15

    -- At the default Main Text Size (20), these are the exact source values:
    -- Size = 150x23 and Position = mouse.X - 70, mouse.Y + 50.
    main.Size =
        UDim2.new(
            0,
            150 * mainScale,
            0,
            23 * mainScale
        )

    main.Position =
        UDim2.new(
            0,
            cursorPosition.X
                - 70 * mainScale,
            0,
            cursorPosition.Y
                + 50
        )

    main.Text =
        mainValue

    main.TextColor3 =
        color

    if runtime.MainTextStroke then
        runtime.MainTextStroke.Enabled =
            settings.TextOutline ~= false

        runtime.MainTextStroke.Thickness = 1

        runtime.MainTextStroke.Color =
            Color3.new(
                0,
                0,
                0
            )

        runtime.MainTextStroke.LineJoinMode =
            Enum.LineJoinMode.Round
    end

    second.Size =
        UDim2.new(
            0,
            150 * secondScale,
            0,
            23 * secondScale
        )

    second.Position =
        UDim2.new(
            0,
            cursorPosition.X
                - 70 * secondScale,
            0,
            cursorPosition.Y
                + 50
                + 24 * mainScale
        )

    second.Text =
        secondValue

    second.TextColor3 =
        color

    if runtime.SecondTextStroke then
        runtime.SecondTextStroke.Enabled =
            settings.TextOutline ~= false

        runtime.SecondTextStroke.Thickness = 1

        runtime.SecondTextStroke.Color =
            Color3.new(
                0,
                0,
                0
            )

        runtime.SecondTextStroke.LineJoinMode =
            Enum.LineJoinMode.Round
    end
end

-- ============================================================
-- BRIDGE / NATIVE MOUSE OWNERSHIP
-- ============================================================

local function referenceSetBridgeOwnership(enabled)
    local runtime =
        ReferenceCursorRuntime

    if enabled then
        cursorBridge.ExternalAttached = true

        cursorBridge.ExternalHeartbeat =
            os.clock()

        cursorBridge.ExternalOwner =
            "DevKageReferenceCursor:"
            .. runtime.InstanceId
    else
        local expected =
            "DevKageReferenceCursor:"
            .. runtime.InstanceId

        if cursorBridge.ExternalOwner == expected
            or cursorBridge.ExternalOwner == nil then

            cursorBridge.ExternalAttached = false
            cursorBridge.ExternalHeartbeat = 0
            cursorBridge.ExternalOwner = nil
        end
    end
end

local function referenceApplyNativeMouseState(enabled)
    local runtime =
        ReferenceCursorRuntime

    if enabled then
        if not runtime.OwnsMouseIcon then
            runtime.PreviousMouseIconEnabled =
                uis.MouseIconEnabled

            runtime.OwnsMouseIcon = true
        end

        -- Keep the custom DevKage cursor as the visible mouse cursor.
        if uis.MouseIconEnabled == true then
            pcall(function()
                uis.MouseIconEnabled = false
            end)
        end
    elseif runtime.OwnsMouseIcon then
        runtime.OwnsMouseIcon = false

        pcall(function()
            uis.MouseIconEnabled =
                runtime.PreviousMouseIconEnabled
        end)
    end
end

-- ============================================================
-- SPIN
-- ============================================================

local function referenceUpdateRotation(settings, deltaTime)
    local runtime =
        ReferenceCursorRuntime

    local angleOffset =
        referenceCursorNumber(
            settings.AngleOffset,
            0,
            0,
            360
        )

    if settings.Spin ~= true then
        runtime.currentRotationSpeed = 0

        runtime.smoothedRotation =
            angleOffset

        return
            angleOffset
    end

    -- Existing Cursor tab expresses speed in degrees/second.
    -- The supplied source used progress-per-second and default 0.8:
    --     288 deg/s / 360 = 0.8
    -- so the default remains exactly the same animation speed.
    local baseRotationSpeed =
        referenceCursorNumber(
            settings.SpinSpeed,
            288,
            0,
            360
        ) / 360

    if runtime.currentRotationSpeed <= 0 then
        runtime.currentRotationSpeed =
            baseRotationSpeed
    end

    local direction =
        tostring(
            settings.SpinDirection
            or "Clockwise"
        ) == "Counter Clockwise"
        and -1
        or 1

    -- Same ordering as the supplied cursor:
    -- advance progress first, then calculate the slowed speed for next frame.
    runtime.rotationProgress =
        (
            runtime.rotationProgress
            + runtime.currentRotationSpeed
                * deltaTime
                * direction
        ) % 1

    runtime.currentRotationSpeed =
        referenceCalculateRotationSpeed(
            runtime.rotationProgress,
            baseRotationSpeed
        )

    local spinRange =
        referenceCursorNumber(
            settings.SpinRange,
            360,
            1,
            360
        )

    local style =
        tostring(
            settings.SpinStyle
            or "Static"
        )

    local targetRotation

    if style == "Ping Pong" then
        targetRotation =
            angleOffset
            + math.sin(
                runtime.rotationProgress
                * math.pi
                * 2
            )
            * (spinRange * 0.5)
    elseif style == "Stepped" then
        local arms =
            math.max(
                1,
                math.floor(
                    referenceCursorNumber(
                        settings.ArmCount,
                        4,
                        1,
                        12
                    ) + 0.5
                )
            )

        local step =
            spinRange
            / arms

        targetRotation =
            angleOffset
            + math.floor(
                (
                    runtime.rotationProgress
                    * spinRange
                ) / step
            ) * step
    else
        -- Static = the supplied cursor's normal continuous rotation.
        targetRotation =
            angleOffset
            + runtime.rotationProgress
                * spinRange
    end

    -- The source cursor used smoothing = 1, meaning no altered easing.
    -- Keep that exact default. Existing Smooth Spin can deliberately soften
    -- it when the user enables that Cursor-tab setting.
    local smoothing =
        settings.SmoothSpin == true
        and math.clamp(
            deltaTime * 12,
            0,
            1
        )
        or 1

    runtime.smoothedRotation =
        referenceSmoothRotation(
            runtime.smoothedRotation,
            targetRotation,
            smoothing
        )

    return
        runtime.smoothedRotation
end

-- ============================================================
-- RENDER LOOP
-- ============================================================

local function referenceCursorRender(deltaTime)
    local runtime =
        ReferenceCursorRuntime

    if not runtime.Running then return end

    local dt =
        math.max(
            tonumber(deltaTime) or 0,
            0
        )

    local revision =
        tonumber(
            cursorBridge.Revision
        ) or 0

    if runtime.Revision ~= revision then
        runtime.Revision = revision
        referenceCursorReadSettings()
    end

    local settings =
        runtime.Settings

    if next(settings) == nil then
        referenceCursorReadSettings()
        settings = runtime.Settings
    end

    runtime.LastGuiCheck =
        runtime.LastGuiCheck
        + dt

    if not runtime.ScreenGui
        or runtime.ScreenGui.Parent == nil
        or not runtime.AimContainer
        or runtime.AimContainer.Parent == nil then

        if runtime.LastGuiCheck >= 0.10 then
            runtime.LastGuiCheck = 0
            referenceCreateCursorGui()
        end
    elseif runtime.LastGuiCheck >= 1 then
        runtime.LastGuiCheck = 0
    end

    if not runtime.ScreenGui
        or not runtime.AimContainer then

        referenceSetBridgeOwnership(false)
        return
    end

    local enabled =
        settings.Enabled ~= false

    -- When DevKage is open in first person, the game camera may attempt to
    -- restore LockCenter after the menu's normal input pass. Release it again
    -- here in the cursor render path so the DevKage cursor can actually move
    -- over and interact with the UI.
    if window and window.Enabled == true then
        pcall(function()
            if uis.MouseBehavior ~= Enum.MouseBehavior.Default then
                uis.MouseBehavior = Enum.MouseBehavior.Default
            end
        end)
    end

    runtime.ScreenGui.Enabled =
        enabled

    referenceSetBridgeOwnership(
        enabled
    )

    referenceApplyNativeMouseState(
        enabled
    )

    if not enabled then
        return
    end

    runtime.time =
        runtime.time
        + dt

    local cursorPosition =
        referenceCursorPosition(
            settings
        )

    runtime.AimContainer.Position =
        UDim2.new(
            0,
            cursorPosition.X,
            0,
            cursorPosition.Y
        )

    local centerRadius =
        referenceCursorNumber(
            settings.CenterRadius,
            12.5,
            0,
            60
        )

    local squashX =
        referenceCursorNumber(
            settings.SquashX,
            1,
            0.25,
            2
        )

    local squashY =
        referenceCursorNumber(
            settings.SquashY,
            1,
            0.25,
            2
        )

    -- Default CenterRadius 12.5 gives the exact supplied 25x25 container.
    runtime.AimContainer.Size =
        UDim2.new(
            0,
            centerRadius
                * 2
                * squashX,
            0,
            centerRadius
                * 2
                * squashY
        )

    runtime.AimContainer.Rotation =
        referenceUpdateRotation(
            settings,
            dt
        )

    local lineThickness =
        referenceCursorNumber(
            settings.LineWidth,
            3,
            1,
            10
        )

    local lineLength =
        referenceCursorNumber(
            settings.LineLength,
            25,
            1,
            100
        )

    local pulseSpeed =
        referenceCursorNumber(
            settings.PulseSpeed,
            2.5,
            0,
            8
        )

    local pulse =
        pulseSpeed > 0
        and referenceSmoothPulse(
            runtime.time,
            pulseSpeed
        )
        or 0

    -- The source cursor used:
    --     minLength = -10
    --     maxLength = -30
    -- with LineLength conceptually 25.
    --
    -- Scale those exact ratios so Line Length in the existing Cursor tab
    -- changes the same shape without replacing the animation.
    local minLength =
        -(lineLength * 0.4)

    local maxLength =
        -(lineLength * 1.2)

    local currentLength =
        minLength
        + (
            maxLength
            - minLength
        ) * pulse

    local armCount =
        referenceEnsureExtraArmCount(
            settings.ArmCount
        )

    if armCount == 4 then
        referenceApplyFourArmLayout(
            settings,
            currentLength,
            lineThickness
        )
    else
        referenceApplyRadialLayout(
            settings,
            currentLength,
            lineThickness,
            armCount
        )
    end

    local firstColor =
        referenceResolveColor(
            settings,
            runtime.time,
            1,
            armCount
        )

    for index, line in ipairs(runtime.Lines) do
        local visible =
            index <= armCount

        line.Frame.Visible =
            visible

        if visible then
            local color =
                referenceResolveColor(
                    settings,
                    runtime.time,
                    index,
                    armCount
                )

            line.Frame.BackgroundColor3 =
                color

            referenceApplyGlow(
                settings,
                line,
                color,
                armCount == 4
            )
        else
            line.Glow.Visible = false
        end
    end

    referenceApplyText(
        settings,
        cursorPosition,
        firstColor
    )
end

-- ============================================================
-- LIFECYCLE
-- ============================================================

function ReferenceCursorRuntime:Stop()
    if not self.Running then
        return true
    end

    self.Running = false

    referenceSetBridgeOwnership(
        false
    )

    referenceApplyNativeMouseState(
        false
    )

    referenceDestroyCursorGui()

    if cursorBridgeEnv.__DevKageIntegratedCursorRuntime == self then
        cursorBridgeEnv.__DevKageIntegratedCursorRuntime = nil
    end

    if type(MaskShard) == "table"
        and type(MaskShard.Runtime) == "table"
        and MaskShard.Runtime.CursorRenderer == self then

        MaskShard.Runtime.CursorRenderer = nil
    end

    return true
end

referenceCursorReadSettings()
referenceCreateCursorGui()

-- Set ownership immediately so the DevKage menu's existing mouse code knows
-- the custom cursor is attached before the first render.
referenceSetBridgeOwnership(
    ReferenceCursorRuntime.Settings.Enabled ~= false
)

local referenceCursorRenderConnection =
    utility:CreateConnection(
        RunService.RenderStepped,
        referenceCursorRender
    )

-- Recreate/validate the cursor after respawn, matching the supplied cursor's
-- CharacterAdded lifecycle without starting another render loop.
local referenceCursorCharacterConnection =
    utility:CreateConnection(
        LocalPlayer.CharacterAdded,
        function()
            task.defer(function()
                if not ReferenceCursorRuntime.Running then
                    return
                end

                task.wait(0.05)

                if not ReferenceCursorRuntime.ScreenGui
                    or ReferenceCursorRuntime.ScreenGui.Parent == nil then

                    referenceCreateCursorGui()
                end
            end)
        end
    )

if type(MaskShard) == "table" then
    if type(MaskShard.RegisterConnection) == "function" then
        MaskShard:RegisterConnection(
            referenceCursorRenderConnection
        )

        MaskShard:RegisterConnection(
            referenceCursorCharacterConnection
        )
    elseif type(MaskShard.Connections) == "table" then
        MaskShard.Connections[
            #MaskShard.Connections + 1
        ] =
            referenceCursorRenderConnection

        MaskShard.Connections[
            #MaskShard.Connections + 1
        ] =
            referenceCursorCharacterConnection
    end

    if type(MaskShard.Runtime) == "table" then
        MaskShard.Runtime.CursorRenderer =
            ReferenceCursorRuntime

        MaskShard.Runtime.CursorProtocol =
            ReferenceCursorRuntime.Protocol

        MaskShard.Runtime.CursorCompatibilityOnly =
            true

        MaskShard.Runtime.CursorVisualModel =
            "DevKageReferenceArcade"
    end
end

table.insert(
    library.CleanupCallbacks,
    function()
        pcall(function()
            referenceCursorRenderConnection:Disconnect()
        end)

        pcall(function()
            referenceCursorCharacterConnection:Disconnect()
        end)

        pcall(function()
            ReferenceCursorRuntime:Stop()
        end)
    end
)

