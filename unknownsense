local function referenceGetRainbowColor(t)
    local r =
        math.sin(t * 0.6) * 0.5 + 0.5

    local g =
        math.sin(t * 0.6 + 2) * 0.5 + 0.5

    local b =
        math.sin(t * 0.6 + 4) * 0.5 + 0.5

    return Color3.new(r, g, b)
end

local function referenceCalculateRotationSpeed(progress, baseRotationSpeed)
    local slowdownStart = 0.6
    local slowdownDuration = 0.35
    local minSlowdownSpeed = 0.3

    if progress >= slowdownStart then
        local slowdownProgress =
            (progress - slowdownStart)
            / slowdownDuration

        local easedProgress =
            slowdownProgress
            * slowdownProgress

        local slowdownFactor =
            1
            - (
                easedProgress
                * (1 - minSlowdownSpeed)
            )

        return
            baseRotationSpeed
            * math.max(
                slowdownFactor,
                minSlowdownSpeed
            )
    end

    return baseRotationSpeed
end

local function referenceSmoothRotation(currentRotation, targetRotation, smoothing)
    return
        currentRotation
        + (
            targetRotation
            - currentRotation
        ) * smoothing
end

local function referenceSmoothPulse(t, speed)
    local rawPulse =
        math.sin(t * speed) * 0.5 + 0.5

    return
        rawPulse
        * rawPulse
end





local function referenceColorLerp(a, b, alpha)
    return
        referenceCursorColor(
            a,
            Color3.new(1, 1, 1)
        ):Lerp(
            referenceCursorColor(
                b,
                a
            ),
            math.clamp(
                tonumber(alpha) or 0,
                0,
                1
            )
        )
end

local function referenceResolveColor(settings, now, index, count)
    local primary =
        referenceCursorColor(
            settings.Color,
            Color3.new(1, 1, 1)
        )

    local secondary =
        referenceCursorColor(
            settings.SecondaryColor,
            Color3.fromRGB(145, 85, 255)
        )

    local spread =
        referenceCursorNumber(
            settings.ColorSpread,
            0.18,
            0,
            1
        )

    local speed =
        referenceCursorNumber(
            settings.ColorSpeed,
            1,
            0,
            5
        )

    local armPhase =
        (
            (index - 1)
            / math.max(count, 1)
        ) * spread




    if settings.Rainbow == true then
        local rainbowScale =
            referenceCursorNumber(
                settings.RainbowSpeed,
                7.2,
                0,
                15
            ) / 7.2

        return
            referenceGetRainbowColor(
                now * rainbowScale
                + armPhase
            )
    end

    local mode =
        tostring(
            settings.ColorMode
            or "Legacy"
        )

    if mode == "Solid" then
        return primary
    end

    if mode == "Two Tone" then
        return
            (index % 2 == 0)
            and secondary
            or primary
    end

    if mode == "Gradient" then
        local alpha =
            count <= 1
            and 0
            or (
                (index - 1)
                / (count - 1)
            )

        return
            referenceColorLerp(
                primary,
                secondary,
                alpha
            )
    end

    if mode == "Color Wave" then
        local wave =
            math.sin(
                (
                    now
                    * math.max(speed, 0.01)
                    * 2
                )
                + armPhase
                    * math.pi
                    * 2
            ) * 0.5 + 0.5

        return
            referenceColorLerp(
                primary,
                secondary,
                wave
            )
    end

    if mode == "RGB Wave" then
        return
            Color3.fromHSV(
                (
                    now
                    * math.max(speed, 0.01)
                    * 0.08
                    + armPhase
                ) % 1,
                0.92,
                1
            )
    end

    if mode == "Ice" then
        local wave =
            math.sin(
                now
                * math.max(speed, 0.25)
                * 2
                + armPhase * 6
            ) * 0.5 + 0.5

        return
            referenceColorLerp(
                Color3.fromRGB(220, 250, 255),
                Color3.fromRGB(65, 180, 255),
                wave
            )
    end

    if mode == "Purple LED" then
        local wave =
            math.sin(
                now
                * math.max(speed, 0.25)
                * 2.5
                + armPhase * 7
            ) * 0.5 + 0.5

        return
            referenceColorLerp(
                Color3.fromRGB(110, 35, 255),
                Color3.fromRGB(240, 90, 255),
                wave
            )
    end

    if mode == "Fire" then
        local wave =
            math.sin(
                now
                * math.max(speed, 0.25)
                * 2.7
                + armPhase * 5
            ) * 0.5 + 0.5

        return
            referenceColorLerp(
                Color3.fromRGB(255, 55, 25),
                Color3.fromRGB(255, 220, 45),
                wave
            )
    end

    if mode == "Toxic" then
        local wave =
            math.sin(
                now
                * math.max(speed, 0.25)
                * 2.2
                + armPhase * 5
            ) * 0.5 + 0.5

        return
            referenceColorLerp(
                Color3.fromRGB(40, 255, 65),
                Color3.fromRGB(190, 255, 35),
                wave
            )
    end


    return
        referenceGetRainbowColor(
            now
            * math.max(speed, 0.01)
        )
end





local function referenceDestroyCursorGui()
    local runtime = ReferenceCursorRuntime




    for _, object in ipairs({runtime.AimContainer, runtime.MainText, runtime.SecondText}) do
        if object then pcall(function() object:Destroy() end) end
    end

    if runtime.ScreenGui then
        pcall(function()
            runtime.ScreenGui:Destroy()
        end)
    end

    runtime.ScreenGui = nil
    runtime.AimContainer = nil
    runtime.Lines = {}
    runtime.MainText = nil
    runtime.MainTextStroke = nil
    runtime.SecondText = nil
    runtime.SecondTextStroke = nil
    runtime.Host = nil
end

