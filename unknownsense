    local function replaceFirstNumber(text, value)
        text = tostring(text or "")
        local replacement = tostring(value)
        local changed = false
        local result = text:gsub("%-?%d[%d,]*", function()
            if changed then return nil end
            changed = true
            return replacement
        end, 1)
        if not changed then
            return text
        end
        return result
    end

    local function closestNumericStatValue(label)
        if not label or not label.Parent then return label end
        if tostring(label.Text or ""):find("%-?%d") then return label end
        local candidates = label.Parent:GetDescendants()
        if #candidates > 48 then return label end
        local best, bestScore
        for _, candidate in ipairs(candidates) do
            if candidate ~= label and (candidate:IsA("TextLabel") or candidate:IsA("TextButton") or candidate:IsA("TextBox")) then
                local candidateText=tostring(candidate.Text or "")
                if candidateText:match("^%s*%-?[%d,]+%s*$") then
                    local score=math.abs((tonumber(candidate.LayoutOrder) or 0)-(tonumber(label.LayoutOrder) or 0))*20
                    pcall(function()
                        local a=label.AbsolutePosition+label.AbsoluteSize*0.5
                        local b=candidate.AbsolutePosition+candidate.AbsoluteSize*0.5
                        score=score+(a-b).Magnitude
                    end)
                    if not bestScore or score<bestScore then best,bestScore=candidate,score end
                end
            end
        end
        return best or label
    end

    local function patchStatsNear(anchor)
        if not anchor or not anchor.Parent then return end
        local level = math.max(0, math.floor((tonumber(config.level) or 1) + 0.5))
        local elo = normalizeSpoofELO(config.elo)
        local streak = math.max(0, math.floor((tonumber(config.streak) or 0) + 0.5))
        local wins = tonumber(config.wins) or 0
        local kills = tonumber(config.kills) or 0

        local cached = privacy.StatTargets[anchor]
        if type(cached) == "table" then
            local alive = false
            if config.spoofLevel~=false and cached.Level and cached.Level.Parent then
                setTextLocal(cached.Level, replaceFirstNumber(cached.Level.Text, level))
                alive = true
            end
            if config.spoofELO~=false and cached.ELO and cached.ELO.Parent then
                setTextLocal(cached.ELO, replaceFirstNumber(cached.ELO.Text, elo))
                alive = true
            end
            if config.spoofStreak~=false and cached.Streak and cached.Streak.Parent then
                setTextLocal(cached.Streak, replaceFirstNumber(cached.Streak.Text, streak))
                alive = true
            end
            if config.spoofWins~=false and cached.Wins and cached.Wins.Parent then
                setTextLocal(cached.Wins, replaceFirstNumber(cached.Wins.Text, wins))
                alive = true
            end
            if config.spoofKills~=false and cached.Kills and cached.Kills.Parent then
                setTextLocal(cached.Kills,replaceFirstNumber(cached.Kills.Text,kills))
                alive=true
            end
            if cached.Platform and cached.Platform.Parent and SpooferState.platformAsset then
                setImageLocal(cached.Platform, SpooferState.platformAsset)
                alive = true
            end
            if alive then return end
            privacy.StatTargets[anchor] = nil
        end

        local found = {}
        local container = anchor.Parent
        for _ = 1, 3 do
            if not container or not container.Parent then break end
            local descendants = container:GetDescendants()
            if #descendants > 90 then break end

            for _, child in ipairs(descendants) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local n = tostring(child.Name or ""):lower()
                    local t = tostring(child.Text or ""):lower()
                    local isStreak = n:find("streak", 1, true) or t:find("streak", 1, true)
                    local isKills=n:find("kills",1,true) or n:find("elimination",1,true) or t:find("kills",1,true) or t:find("elimination",1,true)
                    if config.spoofELO~=false and not found.ELO and (spoofELOName(n) or n:find("elo", 1, true) or n:find("rating", 1, true) or n:find("mmr",1,true)
                        or t:find("elo", 1, true) or t:find("rating", 1, true) or t:find("mmr",1,true) or t:find("rank points",1,true)) then
                        local target=closestNumericStatValue(child)
                        found.ELO = target
                        setTextLocal(target, replaceFirstNumber(target.Text, elo))
                    elseif config.spoofLevel~=false and not found.Level and (n == "level" or n == "lvl" or n:find("level", 1, true) or t:find("level", 1, true) or t:match("^lvl[%s:]*%d")) then
                        found.Level = child
                        setTextLocal(child, replaceFirstNumber(child.Text, level))
                    elseif config.spoofStreak~=false and not found.Streak and isStreak then
                        found.Streak = child
                        setTextLocal(child, replaceFirstNumber(child.Text, streak))
                    elseif config.spoofKills~=false and not found.Kills and isKills then
                        local target=closestNumericStatValue(child)
                        found.Kills=target
                        setTextLocal(target,replaceFirstNumber(target.Text,kills))
                    elseif config.spoofWins~=false and not found.Wins and not isStreak and (n == "wins" or n:find("wins", 1, true) or t:find("wins", 1, true)) then
                        found.Wins = child
                        setTextLocal(child, replaceFirstNumber(child.Text, wins))
                    end
                elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
                    local n = tostring(child.Name or ""):lower()
                    if not found.Platform
                        and (n:find("control", 1, true) or n:find("platform", 1, true))
                        and SpooferState.platformAsset then
                        found.Platform = child
                        setImageLocal(child, SpooferState.platformAsset)
                    end
                end
            end
            if found.Level and found.ELO and found.Streak and found.Wins and found.Kills and found.Platform then break end
            container = container.Parent
        end
        privacy.StatTargets[anchor] = found
    end

