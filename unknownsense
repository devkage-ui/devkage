        Vector2.new(
            0.5,
            0.5
        )

    aimContainer.Active = false
    aimContainer.Selectable = false
    aimContainer.ZIndex = 100000
    aimContainer.Parent = screenGui

    runtime.ScreenGui = screenGui
    runtime.AimContainer = aimContainer
    runtime.Host = host

    runtime.Lines = {
        referenceCreateLine(
            aimContainer,
            "Top"
        ),
        referenceCreateLine(
            aimContainer,
            "Bottom"
        ),
        referenceCreateLine(
            aimContainer,
            "Left"
        ),
        referenceCreateLine(
            aimContainer,
            "Right"
        ),
    }

    runtime.MainText,
    runtime.MainTextStroke =
        referenceCreateTextLabel(
