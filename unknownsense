        end

        local function positionPopup()
            if not Popup.Visible then return end
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1920,1080)
            local holderPos = Content_Holder.AbsolutePosition
            local holderSize = Content_Holder.AbsoluteSize
            local popupW, popupH = 238, 220
            local x = holderPos.X + holderSize.X - popupW
            local y = holderPos.Y + holderSize.Y + 4
            if y + popupH > viewport.Y - 4 then
                y = holderPos.Y - popupH - 4
            end
            x = math.clamp(x,4,math.max(4,viewport.X-popupW-4))
            y = math.clamp(y,4,math.max(4,viewport.Y-popupH-4))
            Popup.Position = UDim2.fromOffset(math.floor(x),math.floor(y))
        end

        local function inside(guiObject, position)
            local p = guiObject.AbsolutePosition
            local s = guiObject.AbsoluteSize
            return position.X >= p.X and position.X <= p.X+s.X
                and position.Y >= p.Y and position.Y <= p.Y+s.Y
        end

        function Content.Content:Refresh()
            redraw(false)
            writeBoxes()
        end

        function Content.Content:Close()
            Content.Content.Open = false
            Popup.Visible = false
            dragging = nil
            dragInput = nil
            if outsideConnection then
                pcall(function() outsideConnection:Disconnect() end)
                outsideConnection = nil
            end
            if popupFollowConnection then
