function VisualsState.skeletonRuntime:RemoveDrawing(object)
    if not object then return end
    pcall(function()
        if type(object.Remove) == "function" then
            object:Remove()
        elseif type(object.Destroy) == "function" then
            object:Destroy()
        end
    end)
end

function VisualsState.skeletonRuntime:RemovePlayer(player)
    local pool = self.Players[player]
    if not pool then return end
    for _, line in ipairs(pool.Lines or {}) do self:RemoveDrawing(line) end
    for _, line in ipairs(pool.Outlines or {}) do self:RemoveDrawing(line) end
    self:RemoveDrawing(pool.Distance)
    self.Players[player] = nil
end

function VisualsState.skeletonRuntime:DestroyAll()
    for player in pairs(self.Players) do
        self:RemovePlayer(player)
    end
end

function VisualsState.skeletonRuntime:NewLine(zindex)
    local line = Drawing.new("Line")
    line.Visible = false
    line.Thickness = math.clamp(tonumber(VisualsState.skeleton_thickness) or 1, 0.5, 5)
    line.Transparency = 1
    line.ZIndex = zindex or 3
    return line
end

function VisualsState.skeletonRuntime:NewText()
    local textObject = Drawing.new("Text")
    textObject.Visible = false
    textObject.Center = true
    textObject.Outline = true
    textObject.OutlineColor = Color3.fromRGB(0,0,0)
    textObject.Color = Color3.fromRGB(220,220,220)
    textObject.Transparency = 1
    textObject.Size = 12
    textObject.ZIndex = 4
    return textObject
end

function VisualsState.skeletonRuntime:CreatePool(player, character)
    self:RemovePlayer(player)
    if not self.Supported then return nil end

    local pool = {
        Character = character,
        Lines = {},
        Outlines = {},
        Distance = self:NewText(),
        Points = {},
        Screen = {},
    }
    for index = 1, #self.Segments do
        pool.Outlines[index] = self:NewLine(2)
        pool.Lines[index] = self:NewLine(3)
    end
    self.Players[player] = pool
    self:SetSkeletonThickness(VisualsState.skeleton_thickness)
    return pool
end

function VisualsState.skeletonRuntime:HidePool(pool)
    if not pool then return end
    for _, line in ipairs(pool.Lines or {}) do line.Visible = false end
    for _, line in ipairs(pool.Outlines or {}) do line.Visible = false end
    if pool.Distance then pool.Distance.Visible = false end
end

function VisualsState.skeletonRuntime:WorldToScreen(worldPosition)
    local camera = workspace.CurrentCamera
    if not camera or typeof(worldPosition) ~= "Vector3" then return nil end
    local point, onScreen = camera:WorldToViewportPoint(worldPosition)
    if not onScreen or point.Z <= 0 then return nil end
    local viewport = camera.ViewportSize
    if point.X < 0 or point.Y < 0 or point.X > viewport.X or point.Y > viewport.Y then
        return nil
    end
    return Vector2.new(point.X, point.Y)
end

function VisualsState.skeletonRuntime:MotorPoint(character, motorName, fallbackPartName)
    local motor = character and character:FindFirstChild(motorName, true)
    if motor and motor:IsA("Motor6D") and motor.Part0 then
        local ok, point = pcall(function()
            return (motor.Part0.CFrame * motor.C0).Position
        end)
        if ok then return point end
    end
    local part = character and character:FindFirstChild(fallbackPartName)
    return part and part:IsA("BasePart") and part.Position or nil
end

function VisualsState.skeletonRuntime:ResolveR6Point(character, name)
    local torso = character:FindFirstChild("Torso")
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    local leftArm = character:FindFirstChild("Left Arm")
    local rightArm = character:FindFirstChild("Right Arm")
    local leftLeg = character:FindFirstChild("Left Leg")
    local rightLeg = character:FindFirstChild("Right Leg")

    if name == "Head" then return head and head.Position or nil end
    if name == "UpperTorso" or name == "LowerTorso" then return torso and torso.Position or nil end
    if name == "Root" then return root and root.Position or (torso and torso.Position or nil) end

    if name == "LeftShoulder" and torso then
        return torso.CFrame:PointToWorldSpace(Vector3.new(-torso.Size.X * 0.5, torso.Size.Y * 0.25, 0))
    elseif name == "RightShoulder" and torso then
        return torso.CFrame:PointToWorldSpace(Vector3.new(torso.Size.X * 0.5, torso.Size.Y * 0.25, 0))
    elseif name == "LeftElbow" then
        return leftArm and leftArm.Position or nil
    elseif name == "RightElbow" then
        return rightArm and rightArm.Position or nil
    elseif name == "LeftHand" and leftArm then
        return leftArm.CFrame:PointToWorldSpace(Vector3.new(0, -leftArm.Size.Y * 0.5, 0))
    elseif name == "RightHand" and rightArm then
        return rightArm.CFrame:PointToWorldSpace(Vector3.new(0, -rightArm.Size.Y * 0.5, 0))
    elseif name == "LeftHip" and torso then
        return torso.CFrame:PointToWorldSpace(Vector3.new(-torso.Size.X * 0.28, -torso.Size.Y * 0.5, 0))
    elseif name == "RightHip" and torso then
        return torso.CFrame:PointToWorldSpace(Vector3.new(torso.Size.X * 0.28, -torso.Size.Y * 0.5, 0))
    elseif name == "LeftKnee" then
        return leftLeg and leftLeg.Position or nil
    elseif name == "RightKnee" then
        return rightLeg and rightLeg.Position or nil
    elseif name == "LeftFoot" and leftLeg then
        return leftLeg.CFrame:PointToWorldSpace(Vector3.new(0, -leftLeg.Size.Y * 0.5, 0))
    elseif name == "RightFoot" and rightLeg then
        return rightLeg.CFrame:PointToWorldSpace(Vector3.new(0, -rightLeg.Size.Y * 0.5, 0))
    end
    return nil
end

function VisualsState.skeletonRuntime:ResolvePoints(character, points)
    table.clear(points)
    if not character then return points end

    if character:FindFirstChild("UpperTorso") then
        local head = character:FindFirstChild("Head")
        local upper = character:FindFirstChild("UpperTorso")
        local lower = character:FindFirstChild("LowerTorso")
        local root = character:FindFirstChild("HumanoidRootPart")
        local leftHand = character:FindFirstChild("LeftHand")
        local rightHand = character:FindFirstChild("RightHand")
        local leftFoot = character:FindFirstChild("LeftFoot")
        local rightFoot = character:FindFirstChild("RightFoot")

        points.Head = head and head.Position or nil
        points.UpperTorso = upper and upper.Position or nil
        points.LowerTorso = lower and lower.Position or nil
        points.Root = root and root.Position or nil

        points.LeftShoulder = self:MotorPoint(character, "LeftShoulder", "UpperTorso")
        points.LeftElbow = self:MotorPoint(character, "LeftElbow", "LeftLowerArm")
        points.LeftHand = leftHand and leftHand.Position or self:MotorPoint(character, "LeftWrist", "LeftLowerArm")

        points.RightShoulder = self:MotorPoint(character, "RightShoulder", "UpperTorso")
        points.RightElbow = self:MotorPoint(character, "RightElbow", "RightLowerArm")
        points.RightHand = rightHand and rightHand.Position or self:MotorPoint(character, "RightWrist", "RightLowerArm")

        points.LeftHip = self:MotorPoint(character, "LeftHip", "LowerTorso")
        points.LeftKnee = self:MotorPoint(character, "LeftKnee", "LeftLowerLeg")
        points.LeftFoot = leftFoot and leftFoot.Position or self:MotorPoint(character, "LeftAnkle", "LeftLowerLeg")

        points.RightHip = self:MotorPoint(character, "RightHip", "LowerTorso")
        points.RightKnee = self:MotorPoint(character, "RightKnee", "RightLowerLeg")
        points.RightFoot = rightFoot and rightFoot.Position or self:MotorPoint(character, "RightAnkle", "RightLowerLeg")
    else
        for _, name in ipairs(self.PointNames) do
            points[name] = self:ResolveR6Point(character, name)
        end
    end
    return points
end

function VisualsState.skeletonRuntime:SetSkeletonThickness(thickness)
    thickness = math.clamp(tonumber(thickness) or 1, 0.5, 5)
    VisualsState.skeleton_thickness = thickness
    for _, pool in pairs(self.Players) do
        for _, line in ipairs(pool.Lines or {}) do
            line.Thickness = thickness
        end
        for _, line in ipairs(pool.Outlines or {}) do
            line.Thickness = math.min(7, thickness + 2)
        end
    end
    return thickness
end

function VisualsState.skeletonRuntime:UpdateSkeleton(targetPlayer)
    if not self.Supported or not targetPlayer or targetPlayer == LocalPlayer then return end

    if not VisualsState.esp_enabled
        or shouldSkipESPPlayer(targetPlayer)
        or (not VisualsState.skeleton and not VisualsState.distance) then
        self:HidePool(self.Players[targetPlayer])
        return
    end

    local character = targetPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not rootPart
        or (VisualsState.dormant and humanoid.Health <= 0) then
        self:HidePool(self.Players[targetPlayer])
        return
    end

    local pool = self.Players[targetPlayer]
    if not pool or pool.Character ~= character then
        pool = self:CreatePool(targetPlayer, character)
    end
    if not pool then return end

    self:ResolvePoints(character, pool.Points)
    for _, name in ipairs(self.PointNames) do
        local worldPoint = pool.Points[name]
        pool.Screen[name] = worldPoint and self:WorldToScreen(worldPoint) or nil
    end

    local skeletonVisible = VisualsState.skeleton == true
    local lineTransparency = 1 - math.clamp(tonumber(VisualsState.glow_alpha) or 0, 0, 1)
    local outlineTransparency = 1 - math.clamp(tonumber(VisualsState.skeleton_outline_alpha) or 0, 0, 1)

    for index, segment in ipairs(self.Segments) do
        local from = pool.Screen[segment[1]]
        local to = pool.Screen[segment[2]]
        local visible = skeletonVisible and from ~= nil and to ~= nil

        local line = pool.Lines[index]
        line.Visible = visible
        if visible then
            line.From = from
            line.To = to
            line.Color = VisualsState.glow_color
            line.Transparency = lineTransparency
            line.Thickness = math.clamp(tonumber(VisualsState.skeleton_thickness) or 1, 0.5, 5)
        end

        local outline = pool.Outlines[index]
        outline.Visible = visible and VisualsState.skeleton_outline == true
        if outline.Visible then
            outline.From = from
            outline.To = to
            outline.Color = VisualsState.skeleton_outline_color
            outline.Transparency = outlineTransparency
            outline.Thickness = math.min(7, math.clamp(tonumber(VisualsState.skeleton_thickness) or 1, 0.5, 5) + 2)
        end
    end

    local distanceText = pool.Distance
    if VisualsState.distance and distanceText then
        local rootScreen = pool.Screen.Root
        local leftFootScreen = pool.Screen.LeftFoot
        local rightFootScreen = pool.Screen.RightFoot
        local centerScreen = rootScreen or pool.Screen.LowerTorso
        if centerScreen then
            local bottomY = centerScreen.Y
            if leftFootScreen then bottomY = math.max(bottomY, leftFootScreen.Y) end
            if rightFootScreen then bottomY = math.max(bottomY, rightFootScreen.Y) end

            local camera = workspace.CurrentCamera
            local distance = camera and (camera.CFrame.Position - rootPart.Position).Magnitude or 0
            distanceText.Text = string.format("%.0f studs", distance)
            distanceText.Position = Vector2.new(centerScreen.X, bottomY + 15)
            distanceText.Size = math.floor(10 * math.clamp(tonumber(VisualsState.text_scale) or 1, 0.75, 1.75) + 0.5)
            distanceText.Color = VisualsState.glow_color
            distanceText.Transparency = 1
            distanceText.Visible = true
        else
            distanceText.Visible = false
        end
    elseif distanceText then
        distanceText.Visible = false
    end
end

function VisualsState.skeletonRuntime:UpdateAll()
    if not self.Supported then return end
    if not VisualsState.esp_enabled or (not VisualsState.skeleton and not VisualsState.distance) then
        for _, pool in pairs(self.Players) do self:HidePool(pool) end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            self:UpdateSkeleton(player)
        end
    end

    for player in pairs(self.Players) do
        if not player.Parent then self:RemovePlayer(player) end
    end
end

local function destroyDetailedESP(player)
if VisualsState.skeletonRuntime then VisualsState.skeletonRuntime:RemovePlayer(player) end
local object = VisualsState.esp_objects[player]
if not object then return end

if object.gui then pcall(function() object.gui:Destroy() end) end
if object.box2d then pcall(function() object.box2d:Destroy() end) end
if object.box3d then pcall(function() object.box3d:Destroy() end) end
if object.tracer then pcall(function() object.tracer:Destroy() end) end
if object.tracerOutline then pcall(function() object.tracerOutline:Destroy() end) end
if object.headMarker then pcall(function() object.headMarker:Destroy() end) end
if object.ammoBack then pcall(function() object.ammoBack:Destroy() end) end
if object.boxCorners then for _, corner in ipairs(object.boxCorners) do pcall(function() corner:Destroy() end) end end
if object.beams then
    for _, beam in ipairs(object.beams) do
        pcall(function() beam:Destroy() end)
    end
end
if object.skeletonOutlines then
    for _, beam in ipairs(object.skeletonOutlines) do
        pcall(function() beam:Destroy() end)
    end
end
if object.attachments then
    for _, attachment in ipairs(object.attachments) do
        pcall(function() attachment:Destroy() end)
    end
end
VisualsState.esp_objects[player] = nil
end

