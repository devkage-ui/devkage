local function apply_fullbright(enabled, value)
local lighting = game:GetService("Lighting")
if enabled then
if not VisualsState.original_ambient then
VisualsState.original_ambient = lighting.Ambient
end
if VisualsState.original_brightness == nil then
VisualsState.original_brightness = lighting.Brightness
end
local ambientLevel = math.clamp(value * 25.5, 0, 255)
lighting.Ambient    = Color3.fromRGB(ambientLevel, ambientLevel, ambientLevel)
lighting.Brightness = value
else
lighting.Ambient = VisualsState.ambient_override and VisualsState.ambient_color or VisualsState.world_ambient
if VisualsState.original_brightness ~= nil then lighting.Brightness = VisualsState.original_brightness end
end
end

local function apply_ambient(enabled, color)
local lighting = game:GetService("Lighting")
color = color or VisualsState.ambient_color
if enabled then
if not VisualsState.original_ambient then
VisualsState.original_ambient = lighting.Ambient
VisualsState.original_outdoor = lighting.OutdoorAmbient
end
lighting.Ambient = color
lighting.OutdoorAmbient = color
else
if VisualsState.fullbright then
local level=math.clamp(VisualsState.fullbright_value*25.5,0,255)
lighting.Ambient=Color3.fromRGB(level,level,level)
else
lighting.Ambient=VisualsState.world_ambient
end
lighting.OutdoorAmbient=VisualsState.outdoor_ambient
end
end

local function apply_fov(enabled, value)
local cam = workspace.CurrentCamera
if not cam then return end
if enabled then
if not VisualsState.original_fov then
VisualsState.original_fov = cam.FieldOfView
end
VisualsState.fov_value = math.clamp(tonumber(value) or VisualsState.fov_value or 70, 1, 120)
cam.FieldOfView = VisualsState.fov_value
else
if VisualsState.original_fov then
cam.FieldOfView = VisualsState.original_fov
end
end
end

local function apply_fog(enabled)
local lighting = game:GetService("Lighting")
local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
if enabled then
if atmosphere then
if not VisualsState.original_fog then
VisualsState.original_fog = atmosphere.Density
VisualsState.original_fog_haze = atmosphere.Haze
end
atmosphere.Density = 0
atmosphere.Haze    = 0
end
if VisualsState.original_fog_start == nil then VisualsState.original_fog_start = lighting.FogStart end
if VisualsState.original_fog_end == nil then VisualsState.original_fog_end = lighting.FogEnd end
lighting.FogEnd   = 100000
lighting.FogStart = 100000
else
if atmosphere and VisualsState.original_fog then
atmosphere.Density = VisualsState.original_fog
atmosphere.Haze = VisualsState.original_fog_haze or atmosphere.Haze
end
if VisualsState.original_fog_end ~= nil then lighting.FogEnd = VisualsState.original_fog_end end
if VisualsState.original_fog_start ~= nil then lighting.FogStart = VisualsState.original_fog_start end
end
end

local function shouldSkipESPPlayer(player)
local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
if VisualsState.dormant and humanoid and humanoid.Health<=0 then return true end
return VisualsState.teamcheck
and LocalPlayer.Team ~= nil
and player.Team ~= nil
and player.Team == LocalPlayer.Team
end

