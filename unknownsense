local function createLocalSpoofVisual(player, userId)
    local assets = SpooferState.AvatarAssets
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local uid = tonumber(userId)
    if not character or not humanoid or not character:FindFirstChild("Head") then return false, "Character appearance is not ready" end
    if not uid or uid <= 0 or uid ~= uid or uid == math.huge then return false, "Invalid avatar ID" end
    uid = math.floor(uid)
    SpooferState.visualToken = (SpooferState.visualToken or 0) + 1
    local token = SpooferState.visualToken
    local function current()
        return token == SpooferState.visualToken and player.Character == character
            and character.Parent and tonumber(SpooferState.avatarOnlyUserId) == uid
    end
    if SpooferState.avatarCharacter ~= character then
        if assets.Backup then assets.Backup:Destroy(); assets.Backup = nil end
        local backup = Instance.new("Model")
        backup.Name = "DevKage_OriginalAppearance"
        for _, object in ipairs(character:GetChildren()) do
            if object:IsA("Accessory") or object:IsA("Shirt") or object:IsA("Pants")
                or object:IsA("ShirtGraphic") or object:IsA("BodyColors")
                or object:IsA("Chara]==================],
    [==================[cterMesh") or object.Name == "Head" then
                local ok, clone = pcall(function() return object:Clone() end)
                if ok and clone then clone.Parent = backup end
            end
        end
        assets.Backup, assets.BackupCharacter = backup, character
        SpooferState.avatarCharacter = character
        local ok, description = pcall(function() return humanoid:GetAppliedDescription() end)
        SpooferState.originalAvatarDescription = ok and description or nil
    end
    local template, loadError = assets.LoadModel(uid, humanoid.RigType)
    if not current() then if template then template:Destroy() end; return false, "superseded" end
    if not template then return false, loadError end
    local description
    local templateHumanoid = template:FindFirstChildOfClass("Humanoid")
    if templateHumanoid then
        local ok, result = pcall(function() return templateHumanoid:GetAppliedDescription() end)
        if ok then description = result end
    end
    if not description then
        local ok, result = assets.TryMethods(Players,
            {"GetHumanoidDescriptionFromUserIdAsync", "GetHumanoidDescriptionFromUserId"}, uid)
        if ok then description = result end
    end
    if not current() then
        if description then description:Destroy() end
        template:Destroy(); return false, "superseded"
    end
    local applied = false


    local cancellationBackup = assets.Backup and assets.Backup:Clone()
    if description then
        applied = assets.TryMethods(humanoid,
            {"ApplyDescriptionResetAsync", "ApplyDescriptionReset", "ApplyDescriptionAsync", "ApplyDescription"}, description)
        description:Destroy()
    end
    if not current() then
        if player.Character == character and character.Parent and cancellationBackup then
            pcall(assets.RepairAppearance, character, humanoid, cancellationBackup, true)
        end
        if cancellationBackup then cancellationBackup:Destroy() end
        template:Destroy(); return false, "superseded"
    end
    if cancellationBackup then cancellationBackup:Destroy() end
    local manifest = assets.Manifest(template)
    local ok, repairResult = true, manifest
    if not applied or not assets.Matches(character, manifest) then
        ok, repairResult = assets.RepairAppearance(character, humanoid, template, not applied)
    end
    template:Destroy()
    if not current() then return false, "superseded" end
    if not ok then return false, repairResult end
    SpooferState.avatarManifest = manifest
    SpooferState.avatarManifestCharacter = character
    SpooferState.avatarManifestUserId = uid
    return true
end

