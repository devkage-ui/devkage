local function referenceApplyFourArmLayout(
    settings,
    currentLength,
    lineThickness
)
    local runtime =
        ReferenceCursorRuntime

    local lines =
        runtime.Lines

    if #lines < 4 then return end

    local top =
        lines[1].Frame

    local bottom =
        lines[2].Frame

    local left =
        lines[3].Frame

    local right =
        lines[4].Frame

    for index = 1, 4 do
        local line =
            lines[index]

        line.Frame.Visible = true

        line.Frame.AnchorPoint =
            Vector2.new(
                0,
                0
            )

        line.Frame.Rotation = 0

        line.Stroke.Enabled = true
        line.Stroke.Thickness = 1
        line.Stroke.Color =
            Color3.new(
                0,
                0,
                0
            )
    end


    top.Size =
        UDim2.new(
            0,
            lineThickness,
            0,
            currentLength
        )

    bottom.Size =
        UDim2.new(
            0,
            lineThickness,
            0,
            currentLength
        )

    left.Size =
        UDim2.new(
            0,
            currentLength,
            0,
            lineThickness
        )

    right.Size =
        UDim2.new(
            0,
            currentLength,
            0,
            lineThickness
        )

    top.Position =
        UDim2.new(
            0.5,
            -lineThickness / 2,
            0,
            0
        )

    bottom.Position =
        UDim2.new(
            0.5,
            -lineThickness / 2,
            1,
            -currentLength
        )

    left.Position =
        UDim2.new(
            0,
            0,
            0.5,
            -lineThickness / 2
        )

    right.Position =
        UDim2.new(
            1,
            -currentLength,
            0.5,
            -lineThickness / 2
        )
end









local function referenceEnsureExtraArmCount(count)
    local runtime =
        ReferenceCursorRuntime

    count =
        math.floor(
            referenceCursorNumber(
                count,
                4,
                1,
                12
            ) + 0.5
        )

    while #runtime.Lines < count do
        runtime.Lines[
            #runtime.Lines + 1
        ] =
            referenceCreateLine(
                runtime.AimContainer,
                "Arm_"
                .. tostring(
                    #runtime.Lines + 1
                )
            )
    end

    return count
end

local function referenceApplyRadialLayout(
    settings,
    currentLength,
    lineThickness,
    armCount
)
    local runtime =
        ReferenceCursorRuntime

    local length =
        math.max(
            1,
            math.abs(currentLength)
        )

    local centerRadius =
        referenceCursorNumber(
            settings.CenterRadius,
            12.5,
            0,
            60
        )

    local squashX =
        referenceCursorNumber(
            settings.SquashX,
            1,
            0.25,
            2
        )

    local squashY =
        referenceCursorNumber(
            settings.SquashY,
            1,
            0.25,
            2
        )

    for index, line in ipairs(runtime.Lines) do
        local visible =
            index <= armCount

        line.Frame.Visible = visible

        if visible then
            local angle =
                ((index - 1) / armCount)
                * 360

            local radians =
                math.rad(angle)

            local x =
                math.sin(radians)
                * centerRadius
                * squashX

            local y =
                -math.cos(radians)
                * centerRadius
                * squashY

            line.Frame.AnchorPoint =
                Vector2.new(
                    0.5,
                    1
                )

            line.Frame.Size =
                UDim2.fromOffset(
                    lineThickness,
                    length
                )

            line.Frame.Position =
                UDim2.new(
                    0.5,
                    x,
                    0.5,
                    y
                )

            line.Frame.Rotation =
                angle

            line.Stroke.Enabled = true
            line.Stroke.Thickness = 1
        end
    end
end





local function referenceCopyFrameGeometry(source, target)
    target.AnchorPoint =
        source.AnchorPoint

    target.Position =
        source.Position

    target.Rotation =
