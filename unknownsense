            RenderTime          = 0.15
        })
        utility:RenderObject("TextLabel", {
            AnchorPoint         = Vector2.new(0.5, 0),
            BackgroundColor3    = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = 1,
            BorderColor3        = Color3.fromRGB(0, 0, 0),
            BorderSizePixel     = 0,
            Parent              = Outline_Frame_Slider,
            Position            = UDim2.new(1, 0, 0.5, 1),
            Size                = UDim2.new(0, 2, 1, 0),
            ZIndex              = 3,
            Font                = "Code",
            RichText            = true,
            Text                = "",
            TextColor3          = Color3.fromRGB(255, 255, 255),
            TextSize            = 11,
            TextStrokeTransparency = 0.5,
            TextTransparency    = 1,
            TextXAlignment      = "Center",
            RenderTime          = 0.15
        })

        function Content:Set(state, silent)
            local numeric = tonumber(state) or Content.Min
            numeric = math.clamp(numeric, Content.Min, Content.Max)
            local steps = math.floor(((numeric - Content.Min) / Content.Step) + 0.5)
            Content.State = math.clamp(Content.Min + (steps * Content.Step), Content.Min, Content.Max)
            if Content.Decimals > 0 then
                Content.State = tonumber(string.format("%." .. Content.Decimals .. "f", Content.State)) or Content.State
            else
                Content.State = math.floor(Content.State + 0.5)
            end
            local shown = Content.Decimals > 0
                and string.format("%." .. Content.Decimals .. "f", Content.State)
                or tostring(Content.State)
            Frame_Slider_Title.Text = "<b>" .. shown .. Content.Ending .. "</b>"
            local range = Content.Max - Content.Min
            local ratio = range > 0 and ((Content.State - Content.Min) / range) or 0
            Outline_Frame_Slider.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
            if not silent then utility:SafeCallback(Content.Callback, Content:Get()) end
        end
        function Content:Refresh(input)
            local Mouse = input and input.Position or utility:MouseLocation()
            local width = math.max(Holder_Outline_Frame.AbsoluteSize.X, 1)
            local offset = math.clamp(Mouse.X - Holder_Outline_Frame.AbsolutePosition.X, 0, width)
            local ratio = offset / width
            Content:Set(Content.Min + (Content.Max - Content.Min) * ratio)
        end
        function Content:Get() return Content.State end

        local function beginSliderDrag(input)
            Content.Holding = true
            Content:Refresh(input)
            Outline_Frame_Gradient.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(215,215,215))
            Frame_Slider_Gradient.Color  = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(215,215,215))
        end

        utility:CreateConnection(Content_Holder_Button.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                beginSliderDrag(input)
            end
        end)
        utility:CreateConnection(Content_Holder_Button.MouseEnter, function()
            Outline_Frame_Gradient.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(215,215,215))
            Frame_Slider_Gradient.Color  = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(215,215,215))
        end)
        utility:CreateConnection(Content_Holder_Button.MouseLeave, function()
            local c = Content.Holding and Color3.fromRGB(215,215,215) or Color3.fromRGB(175,175,175)
            Outline_Frame_Gradient.Color = ColorSequence.new(Color3.fromRGB(255,255,255), c)
            Frame_Slider_Gradient.Color  = ColorSequence.new(Color3.fromRGB(255,255,255), c)
        end)
        utility:CreateConnection(uis.InputChanged, function(input)
            if not Content.Holding then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                Content:Refresh(input)
            end
        end)
        utility:CreateConnection(uis.InputEnded, function(Input)
            if Content.Holding and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
                Content.Holding = false
                Outline_Frame_Gradient.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(175,175,175))
                Frame_Slider_Gradient.Color  = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(175,175,175))
            end
        end)

        Content:Set(Content.State, true)
    end
    return utility:RegisterControl(Content, Properties)
end

