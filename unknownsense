            if type(state) == "table" then
                alpha = state.Alpha or state.alpha or alpha
                state = state.Color or state.color
            end
            if typeof(state) ~= "Color3" then return false end
            if alpha ~= nil then
                Content.Alpha = math.clamp(tonumber(alpha) or 0,0,1)
            end
            Content.State = state
            hue,sat,val = Color3.toHSV(state)
            redraw(silent ~= true)
            writeBoxes()
            return true
        end

        function Content:Get()
            return Content.State
        end

        function Content:GetAlpha()
