        return nil
    end

    local function isOriginalViewportModel(model)
        if not model or not model:IsA("Model") then return false end
        if model:GetAttribute("DevKagePrivacyProxy") == true then return false end

        if tostring(model.Name) == privacy.OriginalName then return true end

        local userIdAttr = model:GetAttribute("UserId")
            or model:GetAttribute("PlayerUserId")
            or model:GetAttribute("OwnerUserId")
        if tonumber(userIdAttr) == privacy.OriginalUserId and privacy.OriginalUserId > 0 then
            return true
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then
            local display = tostring(hum.DisplayName or "")
            if display == privacy.OriginalDisplayName or display == privacy.OriginalName then
                return true
            end
        end
        return false
    end

    local function prepareViewportTemplate(model)
        model:SetAttribute("DevKagePrivacyProxy", true)
        for _, object in ipairs(model:GetDescendants()) do
            if object:IsA("Script") or object:IsA("LocalScript") then
                pcall(function() object:Destroy() end)
            elseif object:IsA("BasePart") then
                object.Anchored = true
                object.CanCollide = false
                object.CanTouch = false
                object.CanQuery = false
                object.CastShadow = true
            end
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
            pcall(function() hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff end)
        end
    end

    local function hideViewportOriginal(model)
        for _, object in ipairs(model:GetDescendants()) do
            if object:IsA("BasePart") then
                if privacy.SavedViewport[object] == nil then
                    privacy.SavedViewport[object] = {Transparency = object.Transparency}
                end
                pcall(function() object.Transparency = 1 end)
            elseif object:IsA("Decal") or object:IsA("Texture") then
                if privacy.SavedViewport[object] == nil then
                    privacy.SavedViewport[object] = {Transparency = object.Transparency}
                end
                pcall(function() object.Transparency = 1 end)
            end
        end
    end

    local function buildViewportProxy(original, force)
        if not privacy.Active or not original or not original.Parent then return end
        if privacy.ViewportProxies[original] then return end
        if not force and not isOriginalViewportModel(original) then return end

        local viewport = findViewportFrame(original)
        if not viewport then return end

        if not privacy.Template then
            privacy.PendingViewport[original] = true
            return
        end

        local clone = privacy.Template:Clone()
        clone.Name = "DevKage_PrivacyAvatar"
        clone:SetAttribute("DevKagePrivacyProxy", true)
        clone.Parent = original.Parent

        local partPairs = {}
        for _, clonePart in ipairs(clone:GetChildren()) do
            if clonePart:IsA("BasePart") then
                local originalPart = original:FindFirstChild(clonePart.Name)
                if originalPart and originalPart:IsA("BasePart") then
                    clonePart.CFrame = originalPart.CFrame
                    partPairs[#partPairs + 1] = {Original = originalPart, Clone = clonePart}
                end
            end
        end

        if #partPairs == 0 then
            pcall(function() clone:Destroy() end)
            return
        end

        hideViewportOriginal(original)
        privacy.ViewportProxies[original] = {
            Model = clone,
            Viewport = viewport,
            Parts = partPairs,
        }
    end

    local function tryViewportObject(object)
        if not privacy.Active or not object then return end
        if object:IsA("Model") then
            if isOriginalViewportModel(object) then
                task.defer(function()
                    if privacy.Active and object.Parent then
                        buildViewportProxy(object)
                    end
                end)
            end
        elseif object:IsA("ViewportFrame") then
            task.defer(function()
                if not privacy.Active or not object.Parent then return end
                for _, child in ipairs(object:GetDescendants()) do
                    if child:IsA("Model") and isOriginalViewportModel(child) then
                        buildViewportProxy(child)
                    end
                end
            end)
        end
    end

    local function patchViewportsNear(anchor)
        local container = anchor and anchor.Parent
        for _ = 1, 4 do
            if not container or not container.Parent then break end
            local descendants = container:GetDescendants()
            if #descendants > 140 then break end
            for _, child in ipairs(descendants) do
                if child:IsA("ViewportFrame") then
                    for _, item in ipairs(child:GetDescendants()) do
                        if item:IsA("Model") and item:GetAttribute("DevKagePrivacyProxy") ~= true
                            and item:FindFirstChildOfClass("Humanoid") then
                            buildViewportProxy(item, true)
                        end
                    end
                end
            end
            container = container.Parent
        end
    end

    local function isProfilePageObject(object)
        local current = object
        for _ = 1, 8 do
            current = current and current.Parent
            if not current then break end
            local n = tostring(current.Name or ""):lower()
            if n:find("profile",1,true) or n:find("career",1,true)
                or n:find("statistics",1,true) or n=="stats"
                or n:find("overview",1,true) then
                return true
            end
        end
        return false
    end

    local function patchGuiObject(object)
        if not privacy.Active or not object or not object.Parent then return end
        if isOwnDevKageGui(object) then return end

        do
            local keys = tostring(config.keys or "")
            local currencyContainer = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
            currencyContainer = currencyContainer and currencyContainer:FindFirstChild("MainGui")
            currencyContainer = currencyContainer and currencyContainer:FindFirstChild("MainFrame")
            currencyContainer = currencyContainer and currencyContainer:FindFirstChild("Lobby")
            currencyContainer = currencyContainer and currencyContainer:FindFirstChild("Currency")
            currencyContainer = currencyContainer and currencyContainer:FindFirstChild("Container")

            if keys ~= "" and currencyContainer and object:IsDescendantOf(currencyContainer) then
                if (object:IsA("ImageLabel") or object:IsA("ImageButton"))
                    and object.Name == "Icon"
                    and tostring(object.Image or "") == "rbxassetid://17860673529" then
                    local holder = object.Parent and object.Parent.Parent
                    local title = holder and holder:FindFirstChild("Title")
                    if title and (title:IsA("TextLabel") or title:IsA("TextButton") or title:IsA("TextBox")) then
                        if tostring(title.Text or "") ~= keys then setTextLocal(title, keys) end
                    end
                elseif (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox"))
                    and object.Name == "Title" then
                    local holder = object.Parent
                    local hasKeysIcon = false
                    if holder then
                        for _, child in ipairs(holder:GetDescendants()) do
                            if (child:IsA("ImageLabel") or child:IsA("ImageButton"))
                                and child.Name == "Icon"
                                and tostring(child.Image or "") == "rbxassetid://17860673529" then
                                hasKeysIcon = true
                                break
                            end
                        end
                    end
                    if hasKeysIcon and tostring(object.Text or "") ~= keys then
                        setTextLocal(object, keys)
                    end
                end
            end
        end
        if isProfilePageObject(object) then
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                local current = tostring(object.Text or "")
                local replaced, changed = replaceIdentityText(current)
                if changed then setTextLocal(object, replaced) end
            elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
                local image = tostring(object.Image or "")
                local n = tostring(object.Name or ""):lower()
                if looksLikeOwnThumbnail(object, image)
                    or n:find("avatar", 1, true) or n:find("headshot", 1, true)
                    or n:find("portrait", 1, true) or n:find("profileimage", 1, true)
                    or n:find("profilepicture", 1, true) then
                    setImageLocal(object, thumbnailFor(object))
                    patchViewportsNear(object)
                end
            end
            return
        end

        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            local current = tostring(object.Text or "")
            local replaced, changed = replaceIdentityText(current)
            if changed then
                setTextLocal(object, replaced)
                patchStatsNear(object)
                patchViewportsNear(object)
            end
        elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
            local image = tostring(object.Image or "")
            if looksLikeOwnThumbnail(object, image) then
                setImageLocal(object, thumbnailFor(object))
                patchStatsNear(object)
                patchViewportsNear(object)
            end
        end
    end

    local function observeObject(object)
        if not privacy.Active or not object or privacy.Observed[object] then return end
        if isOwnDevKageGui(object) then return end
        privacy.Observed[object] = true

        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            patchGuiObject(object)
            addConnection(object:GetPropertyChangedSignal("Text"):Connect(function()
                if privacy.Active and not privacy.Muting[object] then
                    patchGuiObject(object)
                end
            end))
        elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
            patchGuiObject(object)
            addConnection(object:GetPropertyChangedSignal("Image"):Connect(function()
                if privacy.Active and not privacy.Muting[object] then
                    patchGuiObject(object)
                end
            end))
        elseif object:IsA("ViewportFrame") or object:IsA("Model") then
            tryViewportObject(object)
        end
    end

    local function observeRoot(root)
        if not root or not root.Parent then return end
        addConnection(root.DescendantAdded:Connect(function(object)
            if not privacy.Active then return end
            observeObject(object)
        end))

        task.spawn(function()
            local descendants = root:GetDescendants()
            for index, object in ipairs(descendants) do
                if not privacy.Active then return end
                observeObject(object)
                if index % 140 == 0 then task.wait() end
            end
        end)
    end
    privacy.ObserveRoot = observeRoot

    local function enforceStats()
        if not privacy.Active then return end
        local level = tonumber(config.level) or 1
        local elo = tonumber(config.elo) or 0
        local streak = tonumber(config.streak) or 0
        local wins = tonumber(config.wins) or 0

        if player:GetAttribute("Level") ~= level then
            pcall(function() player:SetAttribute("Level", level) end)
        end
        if player:GetAttribute("StatisticDuelsWinStreak") ~= streak then
            pcall(function() player:SetAttribute("StatisticDuelsWinStreak", streak) end)
        end
        if elo > 0 and player:GetAttribute("DisplayELO") ~= elo then
            pcall(function() player:SetAttribute("DisplayELO", elo) end)
        end
        if player:GetAttribute("Wins") ~= wins then
            pcall(function() player:SetAttribute("Wins", wins) end)
        end
        if player:GetAttribute("StatisticDuelsWins") ~= wins then
            pcall(function() player:SetAttribute("StatisticDuelsWins", wins) end)
        end
        if player:GetAttribute("DuelsWins") ~= wins then
            pcall(function() player:SetAttribute("DuelsWins", wins) end)
        end

        local leaderstats = player:FindFirstChild("CustomLeaderstats") or player:FindFirstChild("leaderstats")
        if leaderstats then
            local lvl = leaderstats:FindFirstChild("Level")
            local strk = leaderstats:FindFirstChild("Win Streak") or leaderstats:FindFirstChild("Winstreak")
            local winv = leaderstats:FindFirstChild("Wins") or leaderstats:FindFirstChild("Total Wins")
            if lvl and lvl.Value ~= level then pcall(function() lvl.Value = level end) end
            if strk and strk.Value ~= streak then pcall(function() strk.Value = streak end) end
            if winv and winv.Value ~= wins then pcall(function() winv.Value = wins end) end
        end
    end

    privacy.RefreshStats = enforceStats
    privacy.RefreshAnchors = function()
        if not privacy.Active then return end
        task.spawn(function()
            local processed = 0
            for object, saved in pairs(privacy.SavedGui) do
                if not privacy.Active then return end
                if object and object.Parent and type(saved) == "table" then
                    local anchor = false
                    if saved.Text ~= nil then
                        local _, changed = replaceIdentityText(saved.Text)
                        anchor = changed == true
                    end
                    if not anchor and saved.Image ~= nil
                        and (object:IsA("ImageLabel") or object:IsA("ImageButton")) then
                        anchor = looksLikeOwnThumbnail(object, saved.Image)
                    end
                    if anchor then patchStatsNear(object) end
                end
                processed = processed + 1
                if processed % 80 == 0 then task.wait() end
            end
        end)
    end
    privacy.RefreshAll = function()
        enforceStats()
        privacy.RefreshAnchors()
    end

    for _, attribute in ipairs({"Level", "StatisticDuelsWinStreak", "DisplayELO", "Wins", "StatisticDuelsWins", "DuelsWins"}) do
        addConnection(player:GetAttributeChangedSignal(attribute):Connect(function()
            if privacy.Active then task.defer(enforceStats) end
        end))
    end
    addConnection(player.ChildAdded:Connect(function(child)
        if privacy.Active and child.Name == "CustomLeaderstats" then
            task.defer(enforceStats)
        end
    end))

    local function observeCharacter(character)
        if not privacy.Active or not character then return end
        observeRoot(character)
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.DisplayName = privacy.SpoofDisplayName end)
        end
        task.defer(enforceStats)
    end
    if player.Character then observeCharacter(player.Character) end
    addConnection(player.CharacterAdded:Connect(function(character)
        task.wait(0.1)
        if privacy.Active then observeCharacter(character) end
    end))

    local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
    if playerGui then
        local mainGui = playerGui:FindFirstChild("MainGui")
        if mainGui then
            observeRoot(mainGui)
        else
            addConnection(playerGui.ChildAdded:Connect(function(child)
                if privacy.Active and child.Name == "MainGui" then observeRoot(child) end
            end))
        end
    end

    local coreGui = game:GetService("CoreGui")
    local robloxGui = coreGui and coreGui:FindFirstChild("RobloxGui")
    if robloxGui then observeRoot(robloxGui) end

    task.spawn(function()
        if privacy.TemplateLoading or not privacy.Active then return end
        privacy.TemplateLoading = true
        local ok, model = pcall(function()
            return Players:CreateHumanoidModelFromUserId(privacy.SpoofUserId)
        end)
        privacy.TemplateLoading = false
        if not privacy.Active then
            if model then pcall(function() model:Destroy() end) end
            return
        end
        if ok and model then
            prepareViewportTemplate(model)
            privacy.Template = model
            for original in pairs(privacy.PendingViewport) do
                privacy.PendingViewport[original] = nil
                if original and original.Parent then
                    buildViewportProxy(original)
                end
            end
        end
    end)

    local viewportElapsed = 0
    addConnection(RunService.RenderStepped:Connect(function(dt)
        if not privacy.Active then return end
        viewportElapsed = viewportElapsed + (tonumber(dt) or 0)
        if viewportElapsed < (1 / 30) then return end
        viewportElapsed = 0

        for original, proxy in pairs(privacy.ViewportProxies) do
            if not original or not original.Parent or not proxy.Model or not proxy.Model.Parent then
                if proxy.Model and proxy.Model.Parent then pcall(function() proxy.Model:Destroy() end) end
                privacy.ViewportProxies[original] = nil
            elseif not proxy.Viewport or not proxy.Viewport.Parent then
                if proxy.Model and proxy.Model.Parent then pcall(function() proxy.Model:Destroy() end) end
                privacy.ViewportProxies[original] = nil
            elseif proxy.Viewport.Visible then
                for _, pair in ipairs(proxy.Parts) do
                    if pair.Original and pair.Original.Parent and pair.Clone and pair.Clone.Parent then
                        pair.Clone.CFrame = pair.Original.CFrame
                    end
                end
            end
        end
    end))

    enforceStats()
end

local function StartSpoofer(config)
config = config or getgenv().__DevKageConfig
if type(config) ~= "table" then return false end

SpooferState.startToken = (SpooferState.startToken or 0) + 1
local startToken = SpooferState.startToken

restoreLocalSpoofVisuals()
for _, conn in ipairs(SpooferState.connections) do
    pcall(function() conn:Disconnect() end)
end
SpooferState.connections = {}
SpooferState.running = false
SpooferState.platformAsset = PlatformAssets[
    tostring(config.platform or "DESKTOP"):upper()
] or PlatformAssets.DESKTOP

local avatarUserId = tonumber(config.victim)
if avatarUserId and avatarUserId > 0 then
    avatarUserId = math.floor(avatarUserId)
    SpooferState.avatarOnlyUserId = avatarUserId
    SpooferState.avatarApplyPending = true
    SpooferState.avatarApplyCharacter = nil
    SpooferState.avatarApplyBusy = false

    if SpooferState.avatarOnlyConnection then
        pcall(function() SpooferState.avatarOnlyConnection:Disconnect() end)
        SpooferState.avatarOnlyConnection = nil
    end

    SpooferState.avatarOnlyConnection = game:GetService("RunService").RenderStepped:Connect(function()
        local character = LocalPlayer and LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not character or not humanoid or SpooferState.avatarApplyBusy then return end
        if not SpooferState.avatarApplyPending and SpooferState.avatarApplyCharacter == character then return end

        local currentId = tonumber(SpooferState.avatarOnlyUserId)
        if not currentId or currentId <= 0 then return end

        SpooferState.avatarApplyBusy = true
        SpooferState.avatarApplyPending = false
        task.spawn(function()
            local ok, err = createLocalSpoofVisual(LocalPlayer, currentId)
            if ok and LocalPlayer.Character == character then
                SpooferState.avatarApplyCharacter = character
            elseif err ~= "superseded" then
                SpooferState.avatarApplyPending = true
                warn("[DevKage Spoofer] Avatar apply failed: " .. tostring(err))
            end
            SpooferState.avatarApplyBusy = false
        end)
    end)
    SpooferState.connections[#SpooferState.connections + 1] = SpooferState.avatarOnlyConnection
end

SpooferState.running = true
pcall(updateStats, LocalPlayer, config)
if type(SpooferState.RefreshProfileStats) == "function" then
    task.defer(SpooferState.RefreshProfileStats)
end

task.spawn(function()
    local data = fetchUserData(config.victim)
    if startToken ~= SpooferState.startToken then return end
    if type(data) ~= "table" then
        warn("[DevKage Spoofer] Could not load avatar user data")
        return
    end
    SpooferState.victimData = data

    local targetName = (config.helper and config.helper ~= "") and config.helper or LocalPlayer.Name
    local friend = Players:FindFirstChild(targetName)
    if not friend then
        local deadline = tick() + 6
        repeat
            task.wait(0.1)
            if startToken ~= SpooferState.startToken then return end
            friend = Players:FindFirstChild(targetName)
        until friend or tick() >= deadline
    end
    if not friend then
        warn("[DevKage Spoofer] Target player is not available")
        return
    end
    SpooferState.targetPlayer = friend

    local character = friend.Character
    if not character then
        local deadline = tick() + 8
        repeat
            task.wait(0.1)
            if startToken ~= SpooferState.startToken then return end
            character = friend.Character
        until character or tick() >= deadline
    end
    if startToken ~= SpooferState.startToken then return end

    pcall(function() friend.DisplayName = data.displayName end)
    if character then
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.DisplayName = data.displayName end) end
    end
    pcall(updateStats, friend, config)

    SpooferState.running = true

    installRecordingPrivacySpoof(friend, data, config)
    if type(SpooferState.RefreshProfileStats) == "function" then
        task.defer(SpooferState.RefreshProfileStats)
    end
    if startToken ~= SpooferState.startToken then return end

    do
        local env = (type(getgenv) == "function" and getgenv()) or _G
        env.__DevKageSpooferMetaState = {
            Active = true,
            Player = friend,
            Premium = config.premium == true,
            Verified = config.verified == true,
        }

        if (config.premium == true or config.verified == true) and hookmetamethod and not env.__DevKageSpooferMetaHookInstalled then
            local oldIdx
            oldIdx = hookmetamethod(game, "__index", function(self, key)
                local state = env.__DevKageSpooferMetaState
                if type(state) == "table" and state.Active and self == state.Player then
                    if key == "MembershipType" and state.Premium then
                        return Enum.MembershipType.Premium
                    end
                    if key == "HasVerifiedBadge" and state.Verified then
                        return true
                    end
                end
                return oldIdx(self, key)
            end)
            env.__DevKageSpooferMetaHookInstalled = true
        end
    end

    local respawnConnection = friend.CharacterAdded:Connect(function(newChar)
        if startToken ~= SpooferState.startToken then return end
        restoreLocalSpoofVisuals(true)

        local h = newChar:WaitForChild("Humanoid", 5)
        if h then pcall(function() h.DisplayName = data.displayName end) end
        pcall(updateStats, friend, config)

        task.spawn(function()
            task.wait(0.25)
            if not SpooferState.running
                or startToken ~= SpooferState.startToken
                or friend.Character ~= newChar then
                return
            end
            local privacy = SpooferState.privacy
            if type(privacy) == "table" and type(privacy.RefreshAll) == "function" then
                pcall(privacy.RefreshAll)
            end
        end)
    end)
    SpooferState.connections[#SpooferState.connections + 1] = respawnConnection
end)

return true
end

