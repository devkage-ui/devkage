function BindManager:KeyText(binding)
    if type(binding) ~= "table" or not binding[1] or not binding[2] then return "-" end
    return BindShortNames[binding[2]] or tostring(binding[2]):upper()
end

function BindManager:InputBinding(input)
    if input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
        return {"KeyCode", input.KeyCode.Name}
    end
    local inputType = input.UserInputType
    if inputType == Enum.UserInputType.MouseButton1
        or inputType == Enum.UserInputType.MouseButton2
        or inputType == Enum.UserInputType.MouseButton3 then
        return {"UserInputType", inputType.Name}
    end
    return nil
end

function BindManager:Matches(binding, input)
    if type(binding) ~= "table" or not binding[1] or not binding[2] then return false end
    if binding[1] == "KeyCode" then
        return input.KeyCode and input.KeyCode.Name == binding[2]
    elseif binding[1] == "UserInputType" then
        return input.UserInputType and input.UserInputType.Name == binding[2]
    end
    return false
end

