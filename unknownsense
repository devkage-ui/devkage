part.Size = Vector3.new(thickness, thickness, length)
part.CFrame = CFrame.lookAt((a + b) * 0.5, b)
part.Parent = aa_ensureBacktrackFolder()
return part
end

local function aa_makeGhost(player, rootCF, color, previousPos)
local char = player and player.Character
if not char then return end
local folder = aa_ensureBacktrackFolder()
local model = Instance.new("Model")
model.Name = "BacktrackGhost"
model.Parent = folder
local root = char:FindFirstChild("HumanoidRootPart")
if not root then model:Destroy(); return end
local offset = rootCF * root.CFrame:Inverse()
for _, obj in ipairs(char:GetDescendants()) do
if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
local ghost = Instance.new("Part")
ghost.Name = obj.Name
ghost.Anchored = true
ghost.CanCollide = false
ghost.CanTouch = false
ghost.CanQuery = false
ghost.CastShadow = false
ghost.Material = Enum.Material.ForceField
ghost.Color = color
ghost.Transparency = 0.58
ghost.Size = obj.Size
ghost.CFrame = offset * obj.CFrame
ghost.Shape = obj:IsA("Part") and obj.Shape or Enum.PartType.Block
ghost.Parent = model
end
end
local pos = rootCF.Position
local line = previousPos and aa_makeLine(previousPos, pos, color) or nil
table.insert(AntiAimVisualRuntime.backtrackEntries, {model=model, line=line, born=os.clock(), position=pos})
end

local function aa_updateReferenceFeatures(dt)
local now = os.clock()

if AntiAimState.target_indicator_enabled then
 aa_ensureIndicator()
 AntiAimVisualRuntime.gui.Enabled = true
 local scanDelay = math.max(0.05, math.clamp(tonumber(AntiAimState.scan_interval) or 0.18, 0.01, 2))
 if now - AntiAimVisualRuntime.lastScan >= scanDelay then
  AntiAimVisualRuntime.lastScan = now
  AntiAimVisualRuntime.target = aa_pickTarget(math.clamp(tonumber(AntiAimState.target_radius) or 367, 1, 2000), nil)
 end
 local target = AntiAimVisualRuntime.target
 local frame = AntiAimVisualRuntime.frame
 local camera = workspace.CurrentCamera
 local targetPos = nil
 if target and target.Character then
  local root = target.Character:FindFirstChild("HumanoidRootPart")
  if root and camera then
   local screen, visible = camera:WorldToViewportPoint(root.Position)
   if visible and screen.Z > 0 then targetPos = Vector2.new(screen.X, screen.Y) end
  end
 end
 local width = math.clamp(tonumber(AntiAimState.window_width) or 220, 120, 600)
 local height = math.clamp(tonumber(AntiAimState.window_height) or 74, 54, 300)
 frame.Size = UDim2.fromOffset(width, height)
 if targetPos then
  frame.Position = UDim2.fromOffset(targetPos.X + AntiAimState.offset_x, targetPos.Y + AntiAimState.offset_y)
 else
  local viewport = camera and camera.ViewportSize or Vector2.new(1280,720)
  frame.Position = UDim2.fromOffset(viewport.X*0.5 + AntiAimState.offset_x, viewport.Y*0.5 + AntiAimState.offset_y)
 end
 local color = aa_indicatorColor(now)
 AntiAimVisualRuntime.accentBar.BackgroundColor3 = color
 AntiAimVisualRuntime.barFill.BackgroundColor3 = color
 AntiAimVisualRuntime.stroke.Color = aa_indicatorGlowColor(color)
 AntiAimVisualRuntime.stroke.Enabled = AntiAimState.indicator_glow == true
 AntiAimVisualRuntime.stroke.Transparency = math.clamp(tonumber(AntiAimState.indicator_glow_transparency) or 0.3, 0, 1)
 AntiAimVisualRuntime.title.Text = tostring(AntiAimState.indicator_title or "TARGET INDICATOR")
 local textDelay = math.clamp(tonumber(AntiAimState.text_interval) or 0.1, 0.01, 2)
 local hum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
 local targetHealth = hum and math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1) or 0
 local smooth = math.clamp(tonumber(AntiAimState.bar_smoothness) or 18, 0.1, 60)
 AntiAimVisualRuntime.healthDisplay = AntiAimVisualRuntime.healthDisplay + (targetHealth - AntiAimVisualRuntime.healthDisplay) * (1 - math.exp(-smooth * math.max(dt, 0)))
 AntiAimVisualRuntime.barFill.Size = UDim2.new(math.clamp(AntiAimVisualRuntime.healthDisplay,0,1),0,1,0)
 if now - AntiAimVisualRuntime.lastText >= textDelay then
  AntiAimVisualRuntime.lastText = now
  AntiAimVisualRuntime.name.Text = target and target.Name or "NO TARGET"
  AntiAimVisualRuntime.healthText.Text = hum and string.format("%d HP", math.floor(hum.Health + 0.5)) or "-- HP"
 end
else
 if AntiAimVisualRuntime.gui then AntiAimVisualRuntime.gui.Enabled = false end
 AntiAimVisualRuntime.target = nil
end

if AntiAimState.backtrack_enabled then
 local sampleDelay = math.max(0.05, math.clamp(tonumber(AntiAimState.backtrack_min_delay) or 0.12, 0.02, 2))
 if now - AntiAimVisualRuntime.lastBacktrackSample >= sampleDelay then
  AntiAimVisualRuntime.lastBacktrackSample = now
  local target = AntiAimVisualRuntime.target or aa_pickTarget(2000, math.clamp(tonumber(AntiAimState.backtrack_max_distance) or 250, 10, 5000))
  local char = target and target.Character
  local root = char and char:FindFirstChild("HumanoidRootPart")
  local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
  if root and localRoot and (root.Position-localRoot.Position).Magnitude <= math.clamp(tonumber(AntiAimState.backtrack_max_distance) or 250,10,5000) then
   local targetCF = root.CFrame
   local smoothing = math.clamp(tonumber(AntiAimState.backtrack_ping_smoothing) or 0.2, 0, 0.95)
   if AntiAimVisualRuntime.lastBacktrackCFrame then
    targetCF = AntiAimVisualRuntime.lastBacktrackCFrame:Lerp(targetCF, 1 - smoothing)
   end
   local previousPos = AntiAimVisualRuntime.backtrackEntries[#AntiAimVisualRuntime.backtrackEntries] and AntiAimVisualRuntime.backtrackEntries[#AntiAimVisualRuntime.backtrackEntries].position or nil
   aa_makeGhost(target, targetCF, aa_backtrackColor(now), previousPos)
   while #AntiAimVisualRuntime.backtrackEntries > 24 do
    local oldest = table.remove(AntiAimVisualRuntime.backtrackEntries, 1)
    if oldest then
     if oldest.model then pcall(function() oldest.model:Destroy() end) end
     if oldest.line then pcall(function() oldest.line:Destroy() end) end
    end
   end
   AntiAimVisualRuntime.lastBacktrackCFrame = targetCF
  end
 end
 local lifetime = math.clamp(tonumber(AntiAimState.backtrack_max_delay) or 0.8, sampleDelay, 5)
 local color = aa_backtrackColor(now)
 for i = #AntiAimVisualRuntime.backtrackEntries, 1, -1 do
  local entry = AntiAimVisualRuntime.backtrackEntries[i]
  local age = now - entry.born
  if age >= lifetime then
   if entry.model then pcall(function() entry.model:Destroy() end) end
   if entry.line then pcall(function() entry.line:Destroy() end) end
   table.remove(AntiAimVisualRuntime.backtrackEntries, i)
  else
   local fade = math.clamp(age / lifetime, 0, 1)
   if entry.model then
    for _, p in ipairs(entry.model:GetChildren()) do
     if p:IsA("BasePart") then p.Color=color; p.Transparency=0.58 + fade*0.34 end
    end
   end
   if entry.line then entry.line.Color=color; entry.line.Transparency=0.20 + fade*0.70 end
  end
 end
else
 if #AntiAimVisualRuntime.backtrackEntries > 0 or AntiAimVisualRuntime.backtrackFolder then aa_clearBacktrack() end
end
end

do
local aaVisualElapsed=0
utility:CreateConnection(RunService.Heartbeat, function(dt)
aaVisualElapsed=aaVisualElapsed+(tonumber(dt) or 0)
if aaVisualElapsed < (1/30) then return end
local step=aaVisualElapsed
aaVisualElapsed=0
aa_updateReferenceFeatures(step)
end)
end
