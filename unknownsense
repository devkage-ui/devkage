        if shard.Runtime.CompatibilityOnly ~= true then
            shard.Runtime.CompatibilityOnly = true
            changed = true
        end

        if shard.Active ~= true then
            safeActivate(shard)
            changed = true
        end

        if changed then repairs = repairs + 1 end
        return true
    end

    local function restoreGlobals()
        local changed = false

        if environment.__DevKageMaskShard ~= MaskShard then
            environment.__DevKageMaskShard = MaskShard
            changed = true
