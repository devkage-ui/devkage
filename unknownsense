do
    local environment=(type(getgenv)=="function" and getgenv()) or _G
    local previous=environment.__DevKageSpooferAutoLoadWatcher
    if type(previous)=="table" and previous.Connection then
        pcall(function() previous.Connection:Disconnect() end)
    end

    local watcher={Elapsed=0,LastSignature=SpooferState.autoLoadLastSignature,RetryAt=0}
    environment.__DevKageSpooferAutoLoadWatcher=watcher
    watcher.Connection=RunService.Heartbeat:Connect(function(deltaTime)
        watcher.Elapsed=watcher.Elapsed+(tonumber(deltaTime) or 0)
        if watcher.Elapsed<0.75 then return end
        watcher.Elapsed=0

        local config=getgenv().__DevKageConfig
        if type(config)~="table" or config.autoLoadSpoofer~=true then
            watcher.LastSignature=nil
            return
        end
        if os.clock()<(tonumber(watcher.RetryAt) or 0) then return end

        local signature=SpooferState.AutoLoadSignature(config)
        if not signature or signature==watcher.LastSignature then return end
        local saved=SpooferState.SaveAutoLoad(true)
        if saved then
            watcher.LastSignature=SpooferState.autoLoadLastSignature or signature
        else
            watcher.RetryAt=os.clock()+5
        end
    end)

    table.insert(library.CleanupCallbacks,function()
        if watcher.Connection then pcall(function() watcher.Connection:Disconnect() end) end
        if environment.__DevKageSpooferAutoLoadWatcher==watcher then
            environment.__DevKageSpooferAutoLoadWatcher=nil
        end
    end)
end

