                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*((entry.Ring%2==0) and -0.35 or 0.35)
                        local bob = math.sin(now*speed*1.6 + entry.Ring)*0.045*scale
                        local base
                        if math.abs(entry.Height) > 1.5*scale then
                            base = liveRoot.CFrame * CFrame.new(0,entry.Height+bob,0)
                        else
                            base = liveHead.CFrame * CFrame.new(0,entry.Height+bob,0)
                        end
                        base = base * CFrame.Angles(entry.TiltX,0,entry.TiltZ)
                        local r = entry.Radius
                        part.CFrame = base * CFrame.new(math.cos(angle)*r,0,math.sin(angle)*r) * CFrame.Angles(0,-angle,0)
                    elseif entry.Kind == "Wing" then
                        local flap = math.sin(now*speed*2.0 + entry.Index*0.13)*0.10
                        local n = entry.Index
                        local side = entry.Side
                        local x = side*(0.58 + n*0.26*entry.Spread)*scale
                        local y = (0.75 - n*0.075)*scale
                        local z = (0.42 + n*0.10)*scale
                        local sweep = side*(0.32 + n*0.035 + flap)
                        part.CFrame = torso.CFrame * CFrame.new(x,y,z) * CFrame.Angles(math.rad(-20+n*1.2),sweep,side*math.rad(25+n*2.0))
                    elseif entry.Kind == "Orb" then
                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*(0.65 + (entry.Index%2)*0.12)
                        local y = math.sin(angle*1.7 + entry.Index)*entry.Vertical
                        part.CFrame = CFrame.new(liveRoot.Position + Vector3.new(math.cos(angle)*entry.Radius,y,math.sin(angle)*entry.Radius))
                    elseif entry.Kind == "OrbitFeather" then
                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*0.75
                        local y = 0.35 + math.sin(angle*2.0)*1.05*scale
                        local pos = liveRoot.Position + Vector3.new(math.cos(angle)*entry.Radius,y,math.sin(angle)*entry.Radius)
                        part.CFrame = CFrame.new(pos) * CFrame.Angles(0,-angle,math.rad(28)*math.sin(now*speed+entry.Index))
                    elseif entry.Kind == "Crown" then
                        local angle = ((entry.Index-1)/entry.Count)*math.pi*2 + now*speed*0.12
                        local radius = 0.72*scale
                        part.CFrame = liveHead.CFrame * CFrame.new(math.cos(angle)*radius,1.0*scale,math.sin(angle)*radius) * CFrame.Angles(0,-angle,math.rad(18))
                    end
                end
            end
        end)
    end

    function API:Refresh()
        if getgenv().__DevKageConfig.avatarModsEnabled ~= true then
            clearVisualsOnly()
            return
        end
        local character = LocalPlayer.Character
        if character then task.defer(function() build(character) end) end
    end

    function API:SetEnabled(value)
        getgenv().__DevKageConfig.avatarModsEnabled = value == true
        if value then self:Refresh() else clearVisualsOnly() end
    end

    state.characterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        if getgenv().__DevKageConfig.avatarModsEnabled == true then
            task.delay(0.15,function()
                if character.Parent then build(character) end
            end)
        end
    end)

    if getgenv().__DevKageConfig.avatarModsEnabled == true then task.defer(function() API:Refresh() end) end
    return API
end)();
end

