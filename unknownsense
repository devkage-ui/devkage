function SpooferState.BuildAutoLoadConfig(config)
    config=type(config)=="table" and config or getgenv().__DevKageConfig
    local savedConfig={}
    for _,key in ipairs(__DevKageSpooferConfigKeys) do
        local value=config[key]
        if value~=nil then savedConfig[key]=type(value)=="table" and table.clone(value) or value end
    end
    savedConfig.level=math.max(0,math.floor((tonumber(savedConfig.level) or 999)+0.5))
    savedConfig.streak=math.max(0,math.floor((tonumber(savedConfig.streak) or 100)+0.5))
    savedConfig.wins=math.max(0,math.floor((tonumber(savedConfig.wins) or 0)+0.5))
    savedConfig.kills=math.max(0,math.floor((tonumber(savedConfig.kills) or 0)+0.5))
    savedConfig.elo=normalizeSpoofELO(savedConfig.elo)
    savedConfig.rankDisplay=SpoofRankRuntime.Normalize(savedConfig.rankDisplay)
    savedConfig.archNemesisCutoff=math.clamp(normalizeSpoofELO(savedConfig.archNemesisCutoff or 3601),3601,9999999)
    savedConfig.archRank=SpoofRankRuntime.ArchDivision(savedConfig)
    return savedConfig
end

function SpooferState.AutoLoadSignature(config)
    local savedConfig=SpooferState.BuildAutoLoadConfig(config)
    local ordered={}
    for index,key in ipairs(__DevKageSpooferConfigKeys) do
        ordered[index]={key,savedConfig[key]}
    end
    local ok,encoded=pcall(function() return HttpService:JSONEncode(ordered) end)
    return ok and encoded or nil
end

local ELO_AUTOLOAD_FILE = "devkage/live_elo_autoload.json"

function SpooferState.SaveELOAutoLoad(enabled, elo)
    if type(writefile) ~= "function" then return false, "file writing unavailable" end
    if type(makefolder) == "function" then pcall(makefolder, "devkage") end

    local payload = {
        Enabled = enabled == true,
        ELO = normalizeSpoofELO(elo),
    }
    local ok, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
    if not ok then return false, tostring(encoded) end
    local wrote, err = pcall(writefile, ELO_AUTOLOAD_FILE, encoded)
    if wrote then
        SpooferState.savedELOAutoLoad = payload.Enabled
        SpooferState.savedELO = payload.ELO
    end
    return wrote, wrote and nil or tostring(err)
end

function SpooferState.LoadELOAutoLoad()
    if type(readfile) ~= "function" then return false end
    if type(isfile) == "function" then
        local checked, exists = pcall(isfile, ELO_AUTOLOAD_FILE)
        if checked and not exists then return false end
    end

    local ok, raw = pcall(readfile, ELO_AUTOLOAD_FILE)
    if not ok or type(raw) ~= "string" or raw == "" then return false end
    local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not decodedOk or type(decoded) ~= "table" then return false end

    local config = getgenv().__DevKageConfig
    local enabled = decoded.Enabled == true
    local elo = normalizeSpoofELO(decoded.ELO)
    SpooferState.savedELOAutoLoad = enabled
    SpooferState.savedELO = elo
    if type(config) == "table" then
        config.eloLiveSyncAutoLoad = enabled
        if enabled then
            config.eloLiveSync = true
            config.spoofELO = true
            config.rankDisplay = "Use Spoofed ELO"
            config.elo = elo
        end
    end
    return true
end

function SpooferState.SaveAutoLoad(enabled)
    local config = getgenv().__DevKageConfig
    config.autoLoadSpoofer = enabled == true

    if type(writefile) ~= "function" then
        return false, "file writing unavailable"
    end
    if type(makefolder) == "function" then
        pcall(makefolder, "devkage")
    end

    local savedConfig=SpooferState.BuildAutoLoadConfig(config)

    -- Live ELO Auto Load has its own persistence file. Do not mirror or
    -- overwrite it from the full Spoofer Auto Load path; keeping one owner
    -- removes the startup/config race that could flip ELO autoload on/off.

    local payload = {
        Enabled = config.autoLoadSpoofer,
        Config = savedConfig
    }

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not ok then return false, tostring(encoded) end

    local wrote, err = pcall(writefile, "devkage/spoofer_autoload.json", encoded)
    if wrote then
        SpooferState.autoLoadLastSignature=SpooferState.AutoLoadSignature(config)
        local environment=(type(getgenv)=="function" and getgenv()) or _G
        local watcher=environment.__DevKageSpooferAutoLoadWatcher
        if type(watcher)=="table" then watcher.LastSignature=SpooferState.autoLoadLastSignature end
    end
    return wrote, wrote and nil or tostring(err)
end

