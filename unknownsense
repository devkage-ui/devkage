local PlayerESPSoundService=game:GetService("SoundService")
local PlayerESPDebris=game:GetService("Debris")
local PlayerESPContentProvider=game:GetService("ContentProvider")
local function playPlayerESPKillSound(force)
if not force and not VisualsState.kill_sound_enabled then return false end
if not force then
local now=tick()
if now-(tonumber(PlayerESPUtilityRuntime.killGlobalLastAt) or 0)<0.2 then return false end
PlayerESPUtilityRuntime.killGlobalLastAt=now
end
local id=tostring(VisualsState.kill_sound_id or ""):match("%d+")
if not id then
library:Notify({Message="Enter a kill sound ID first.",Duration=2})
return false
end
if PlayerESPUtilityRuntime.killSound then
pcall(function() PlayerESPUtilityRuntime.killSound:Stop(); PlayerESPUtilityRuntime.killSound:Destroy() end)
PlayerESPUtilityRuntime.killSound=nil
end
local sound=Instance.new("Sound")
sound.Name="DevKage_KillSound"
sound.SoundId="rbxassetid://"..id
sound.Volume=math.clamp(tonumber(VisualsState.kill_sound_volume) or 50,0,100)/100
sound.Looped=false
sound.Parent=PlayerESPSoundService
PlayerESPUtilityRuntime.killSound=sound

task.spawn(function()
pcall(function() PlayerESPContentProvider:PreloadAsync({sound}) end)
if not sound.Parent then return end
local ok,err=pcall(function()
sound.TimePosition=0
if PlayerESPSoundService.PlayLocalSound then
PlayerESPSoundService:PlayLocalSound(sound)
else
sound:Play()
end
end)
if not ok then
pcall(function() sound:Play() end)
if not sound.IsPlaying then
library:Notify({Message="Kill sound could not play: "..tostring(err),Duration=3})
end
end
end)

PlayerESPDebris:AddItem(sound,30)
return true
end

local function playerESPKillCreditedToLocal(plr,humanoid)
if not plr or plr==LocalPlayer or not humanoid then return false end
for _,tagName in ipairs({"creator","Creator","killer","Killer","lastHitBy","LastHitBy"}) do
local tag=humanoid:FindFirstChild(tagName)
if tag then
if tag:IsA("ObjectValue") and tag.Value==LocalPlayer then return true end
if tag:IsA("IntValue") and tonumber(tag.Value)==LocalPlayer.UserId then return true end
if tag:IsA("StringValue") then
local value=tostring(tag.Value)
if value==LocalPlayer.Name or tonumber(value)==LocalPlayer.UserId then return true end
end
end
end
for _,attributeName in ipairs({"KillerUserId","killerUserId","CreatorUserId","creatorUserId","LastHitByUserId","lastHitByUserId"}) do
local value=humanoid:GetAttribute(attributeName)
if value==LocalPlayer.UserId or tostring(value)==LocalPlayer.Name then return true end
value=plr:GetAttribute(attributeName)
if value==LocalPlayer.UserId or tostring(value)==LocalPlayer.Name then return true end
end
return false
end

local function tryPlayerESPKillSound(plr,lastHp,newHp,humanoid)
if not VisualsState.kill_sound_enabled or not plr or plr==LocalPlayer then return end
lastHp=tonumber(lastHp) or 0
newHp=tonumber(newHp) or 0
if lastHp<=0 or newHp>0 then return end
local credited=playerESPKillCreditedToLocal(plr,humanoid)
if not credited then
local env=(type(getgenv)=="function" and getgenv()) or _G
local recent=env.__DevKageLastCombatTarget
credited=type(recent)=="table" and recent.Player==plr and (tick()-(tonumber(recent.Time) or 0))<=8
end
if not credited and tick()-(tonumber(PlayerESPUtilityRuntime.killRecentAttackAt) or 0)<=4.0 then
credited=true
end
if not credited then return end
local now=tick()
if now-(PlayerESPUtilityRuntime.killLastAt[plr] or 0)<0.35 then return end
PlayerESPUtilityRuntime.killLastAt[plr]=now
playPlayerESPKillSound(false)
end

local function watchPlayerESPKillCharacter(plr,character)
if not plr or plr==LocalPlayer or not character then return end
task.spawn(function()
local humanoid=character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid",8)
if not humanoid or not humanoid.Parent then return end
local lastHp=humanoid.Health
utility:CreateConnection(humanoid.HealthChanged,function(newHp)
local previous=lastHp
lastHp=newHp
if previous>0 and newHp<=0 then tryPlayerESPKillSound(plr,previous,newHp,humanoid) end
end)
end)
end
local function watchPlayerESPKillPlayer(plr)
if not VisualsState.kill_sound_enabled or not plr or plr==LocalPlayer then return end
if PlayerESPUtilityRuntime.killWatchedPlayers[plr] then return end
PlayerESPUtilityRuntime.killWatchedPlayers[plr]=true
utility:CreateConnection(plr.CharacterAdded,function(character) watchPlayerESPKillCharacter(plr,character) end)
if plr.Character then watchPlayerESPKillCharacter(plr,plr.Character) end
end

local function killCounterName(name)
local lower=tostring(name or ""):lower()
return lower:find("kill",1,true)~=nil
or lower:find("elimination",1,true)~=nil
or lower:find("elims",1,true)~=nil
or lower:find("knockout",1,true)~=nil
end

local function updateKillCounterObject(object)
if not object or not object.Parent or not killCounterName(object.Name) then return end
if not (object:IsA("IntValue") or object:IsA("NumberValue")) then return end
local value=tonumber(object.Value)
if not value then return end
local previous=PlayerESPUtilityRuntime.killCounterValues[object]
PlayerESPUtilityRuntime.killCounterValues[object]=value
if previous~=nil and value>previous and VisualsState.kill_sound_enabled then
playPlayerESPKillSound(false)
end
end

local function watchKillCounterObject(object)
if not object or not killCounterName(object.Name) then return end
if not (object:IsA("IntValue") or object:IsA("NumberValue")) then return end
if PlayerESPUtilityRuntime.killCounterValues[object]~=nil then return end
PlayerESPUtilityRuntime.killCounterValues[object]=tonumber(object.Value) or 0
utility:CreateConnection(object:GetPropertyChangedSignal("Value"),function()
updateKillCounterObject(object)
end)
end

local function updateKillAttribute(name)
if not killCounterName(name) then return end
local value=tonumber(LocalPlayer:GetAttribute(name))
if not value then return end
local previous=PlayerESPUtilityRuntime.killAttributeValues[name]
PlayerESPUtilityRuntime.killAttributeValues[name]=value
if previous~=nil and value>previous and VisualsState.kill_sound_enabled then
playPlayerESPKillSound(false)
end
end

local function startLocalKillCounterWatcher()
if PlayerESPUtilityRuntime.killCounterStarted then return end
PlayerESPUtilityRuntime.killCounterStarted=true

for name,value in pairs(LocalPlayer:GetAttributes()) do
if killCounterName(name) and tonumber(value) then
PlayerESPUtilityRuntime.killAttributeValues[name]=tonumber(value)
end
end
for _,object in ipairs(LocalPlayer:GetDescendants()) do
watchKillCounterObject(object)
end

pcall(function()
utility:CreateConnection(LocalPlayer.AttributeChanged,function(name)
updateKillAttribute(name)
end)
end)
utility:CreateConnection(LocalPlayer.DescendantAdded,function(object)
task.defer(watchKillCounterObject,object)
end)
end

local function watchLocalAttackTool(tool)
if not tool or not tool:IsA("Tool") or tool:GetAttribute("DevKageKillSoundWatched") then return end
pcall(function() tool:SetAttribute("DevKageKillSoundWatched",true) end)
utility:CreateConnection(tool.Activated,function()
PlayerESPUtilityRuntime.killRecentAttackAt=tick()
local ok,mouse=pcall(function() return LocalPlayer:GetMouse() end)
local targetPart=ok and mouse and mouse.Target or nil
local targetModel=targetPart and targetPart:FindFirstAncestorOfClass("Model") or nil
local targetPlayer=targetModel and Players:GetPlayerFromCharacter(targetModel) or nil
if targetPlayer and targetPlayer~=LocalPlayer then
local env=(type(getgenv)=="function" and getgenv()) or _G
env.__DevKageLastCombatTarget={Player=targetPlayer,Time=tick()}
end
end)
end

local function startLocalAttackWatcher()
if PlayerESPUtilityRuntime.killAttackStarted then return end
PlayerESPUtilityRuntime.killAttackStarted=true
local function watchCharacter(character)
if not character then return end
for _,child in ipairs(character:GetChildren()) do watchLocalAttackTool(child) end
utility:CreateConnection(character.ChildAdded,function(child)
task.defer(watchLocalAttackTool,child)
end)
end
if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
utility:CreateConnection(LocalPlayer.CharacterAdded,function(character)
task.defer(watchCharacter,character)
end)
end

local function startLocalKillFeedWatcher()
if PlayerESPUtilityRuntime.killFeedStarted then return end
PlayerESPUtilityRuntime.killFeedStarted=true
PlayerESPUtilityRuntime.killFeedTexts=PlayerESPUtilityRuntime.killFeedTexts or setmetatable({}, {__mode="k"})
local function looksLikeLocalKill(text)
local lower=tostring(text or ""):lower()
if lower=="" then return false end
if lower:find("killed you",1,true) or lower:find("you were killed",1,true) or lower:find("you died",1,true) or lower:find("defeated by",1,true) then return false end
if lower:find("you eliminated",1,true) or lower:find("you killed",1,true) or lower:find("you defeated",1,true) then return true end
local names={tostring(LocalPlayer.Name or ""):lower(),tostring(LocalPlayer.DisplayName or ""):lower()}
for _,name in ipairs(names) do
if name~="" then
local np=lower:find(name,1,true)
if np then
for _,verb in ipairs({" eliminated "," killed "," defeated "}) do
local vp=lower:find(verb,1,true)
if vp and np<vp then return true end
end
end
end
end
return false
end
local function inspect(object)
if not object or not object.Parent then return end
if not (object:IsA("TextLabel") or object:IsA("TextButton")) then return end
if PlayerESPUtilityRuntime.killFeedTexts[object]~=nil then return end
PlayerESPUtilityRuntime.killFeedTexts[object]=tostring(object.Text or "")
utility:CreateConnection(object:GetPropertyChangedSignal("Text"),function()
local text=tostring(object.Text or "")
local previous=PlayerESPUtilityRuntime.killFeedTexts[object]
PlayerESPUtilityRuntime.killFeedTexts[object]=text
if text~=previous and VisualsState.kill_sound_enabled and looksLikeLocalKill(text) then
playPlayerESPKillSound(false)
end
end)
end
local playerGui=LocalPlayer:FindFirstChild("PlayerGui")
local function attachMainGui(gui)
if not gui or gui.Name~="MainGui" then return end
for _,object in ipairs(gui:GetDescendants()) do inspect(object) end
utility:CreateConnection(gui.DescendantAdded,function(object) task.defer(inspect,object) end)
end
if playerGui then
local mainGui=playerGui:FindFirstChild("MainGui")
if mainGui then
attachMainGui(mainGui)
else
utility:CreateConnection(playerGui.ChildAdded,function(child)
if child.Name=="MainGui" then attachMainGui(child) end
end)
end
end
end

