            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = Holder_Outline_Frame,
            Position = UDim2.new(0,8,0,0),
            Size = UDim2.new(1,-22,1,0),
            ZIndex = 5,
            Font = "Code",
            RichText = true,
            Text = "",
            TextColor3 = Color3.fromRGB(155,155,155),
            TextSize = 9,
            TextStrokeTransparency = 1,
            TextXAlignment = "Left"
        })

