        -- run after normal camera/first-person updates so the menu cursor stays
        -- free while DevKage is visible. One late binding is enough; avoid the
        -- old property-change feedback loops and duplicate RenderStepped loop.
        pcall(function()
            MenuRunService:BindToRenderStep(
                MenuMouseBindName,
                Enum.RenderPriority.Last.Value + 1000000,
