        vp3DLabel.Text, vp3DLabel.Visible = "Enter a valid avatar ID", true
        return
    end
    VP3.token = VP3.token + 1
    local token = VP3.token
    VP3.loading = true
    vp3DLabel.Text, vp3DLabel.Visible = "Loading complete avatar…", true
    task.spawn(function()
        local char
        local ok, err = pcall(function()
            local loadError
            char, loadError = SpooferState.AvatarAssets.LoadModel(math.floor(userId))
            if not char then error(loadError or "Avatar failed to load") end
            if token ~= VP3.token or not vp3D.Parent then return end
            SpooferState.AvatarAssets.PreparePreview(char, false)
            local world = Instance.new("WorldModel")
            char.Parent = world
            local camera = Instance.new("Camera")
            camera.FieldOfView = 35
