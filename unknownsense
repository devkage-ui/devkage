local function aa_pickTarget(radius, maxDistance)
local camera = workspace.CurrentCamera
if not camera then return nil end
local mouse = uis:GetMouseLocation()
local best, bestScreen = nil, math.huge
for _, player in ipairs(Players:GetPlayers()) do
if player ~= LocalPlayer then
local char = player.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
local root = char and char:FindFirstChild("HumanoidRootPart")
if hum and root and hum.Health > 0 then
local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
local worldDistance = localRoot and (root.Position - localRoot.Position).Magnitude or 0
if not maxDistance or worldDistance <= maxDistance then
local screen, visible = camera:WorldToViewportPoint(root.Position)
if visible and screen.Z > 0 then
local d = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
if d <= radius and d < bestScreen then
best = player
bestScreen = d
end
end
end
end
end
end
return best
end

