return function(context)
local LightingService=context.LightingService
local AdvancedLighting=context.AdvancedLighting
local getOrCreateEffect=context.GetOrCreateEffect
local WorldLightingRuntime={Suspended={}}

WorldLightingRuntime.SnapshotMapAtmosphere=function(object)
local snapshot=WorldLightingRuntime.Suspended[object]
if snapshot then return snapshot end
snapshot={
Parent=object.Parent,
Density=object.Density,
Offset=object.Offset,
Color=object.Color,
Decay=object.Decay,
Glare=object.Glare,
Haze=object.Haze,
}
WorldLightingRuntime.Suspended[object]=snapshot
return snapshot
end

WorldLightingRuntime.SuspendMapAtmospheres=function()
for _,object in ipairs(LightingService:GetChildren()) do
if object:IsA("Atmosphere") and tostring(object.Name)~="DevKage_Atmosphere" then
WorldLightingRuntime.SnapshotMapAtmosphere(object)
pcall(function() object.Parent=nil end)
end
end
for object in pairs(WorldLightingRuntime.Suspended) do
if object and object.Parent==LightingService then
pcall(function() object.Parent=nil end)
end
end
end

WorldLightingRuntime.RestoreMapAtmospheres=function()
for object,snapshot in pairs(WorldLightingRuntime.Suspended) do
pcall(function()
object.Density=snapshot.Density
object.Offset=snapshot.Offset
object.Color=snapshot.Color
object.Decay=snapshot.Decay
object.Glare=snapshot.Glare
object.Haze=snapshot.Haze
object.Parent=snapshot.Parent or LightingService
end)
WorldLightingRuntime.Suspended[object]=nil
end
end

WorldLightingRuntime.DestroyDevKageAtmosphere=function()
local object=AdvancedLighting.atmosphere
if object then pcall(function() object:Destroy() end) end
AdvancedLighting.atmosphere=nil
local glow=AdvancedLighting.atmosphereGlow
if glow then pcall(function() glow.Enabled=false end) end
end

WorldLightingRuntime.SetAtmosphereGlow=function(enabled,intensity)
local glowOn=enabled==true and AdvancedLighting.atmosphereEnabled==true and AdvancedLighting.fogEnabled~=true
local e=AdvancedLighting.atmosphereGlow
if glowOn then
if not e or not e.Parent or not e:IsA("BloomEffect") then
e=getOrCreateEffect("BloomEffect","DevKage_AtmosphereGlow")
AdvancedLighting.atmosphereGlow=e
end
e.Enabled=true
e.Intensity=math.clamp(tonumber(intensity) or 1,0,5)
e.Size=36
e.Threshold=0.82
elseif e then
e.Enabled=false
end
end

WorldLightingRuntime.SetAtmosphere=function(enabled,density,offset,color,decay,glare,haze)
local atmosphereOn=enabled==true and AdvancedLighting.fogEnabled~=true
if atmosphereOn then
WorldLightingRuntime.SuspendMapAtmospheres()
local e=AdvancedLighting.atmosphere
if not e or not e.Parent or not e:IsA("Atmosphere") then
e=getOrCreateEffect("Atmosphere","DevKage_Atmosphere")
AdvancedLighting.atmosphere=e
end
e.Density=math.clamp(tonumber(density) or 0,0,1)
e.Offset=math.clamp(tonumber(offset) or 0,-1,1)
e.Color=typeof(color)=="Color3" and color or AdvancedLighting.atmosphereColor
e.Decay=typeof(decay)=="Color3" and decay or AdvancedLighting.atmosphereDecay
e.Glare=math.clamp(tonumber(glare) or 0,0,10)
e.Haze=math.clamp(tonumber(haze) or 0,0,10)
else
WorldLightingRuntime.DestroyDevKageAtmosphere()
if AdvancedLighting.fogEnabled then WorldLightingRuntime.SuspendMapAtmospheres() else WorldLightingRuntime.RestoreMapAtmospheres() end
end
WorldLightingRuntime.SetAtmosphereGlow(atmosphereOn and AdvancedLighting.atmosphereGlowEnabled,AdvancedLighting.atmosphereGlowIntensity)
end

return WorldLightingRuntime
end
