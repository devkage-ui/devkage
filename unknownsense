local function ensure_folder()
if type(isfolder) == "function" then
local ok, exists = pcall(isfolder, CONFIG_FOLDER)
if ok and exists == true then return true end
end

if type(listfiles) == "function" then
local ok, files = pcall(listfiles, CONFIG_FOLDER)
if ok and type(files) == "table" then return true end
end

if type(makefolder) == "function" then
local made, err = pcall(makefolder, CONFIG_FOLDER)
if made then
if type(isfolder) == "function" then
local checked, exists = pcall(isfolder, CONFIG_FOLDER)
if checked and exists == true then return true end
else
return true
end
if type(listfiles) == "function" then
local checked, files = pcall(listfiles, CONFIG_FOLDER)
if checked and type(files) == "table" then return true end
end
elseif type(writefile) ~= "function" then
return false,tostring(err)
end
end

-- Some executors create intermediate workspace folders on writefile().
if type(writefile) == "function" then return true end
return false,"This executor cannot create config folders"
end

local function list_configs()
local folderOk,folderError = ensure_folder()
if not folderOk then return {},folderError end
if type(listfiles) ~= "function" then return {},"This executor does not provide config listing" end
local ok, files = pcall(listfiles, CONFIG_FOLDER)
if not ok or type(files) ~= "table" then return {},"Could not list the config folder" end
local names = {}
for _, f in ipairs(files) do
local normal = tostring(f):gsub("\\", "/")
local name = normal:match("([^/]+)%.json$")
if name and name:sub(1,1) ~= "_" and name:match("^[%w_%-]+$") then table.insert(names, name) end
end
return names,nil
end

local function serialiseRuntimeState(source)
local output = {}
for key, value in pairs(source) do
local runtimeOnly = tostring(key):match("^original_")
or key=="lastYaw" or key=="lastPitch" or key=="lastRoll" or key=="lastAppliedYaw"
or key=="randomYaw" or key=="randomPitch" or key=="randomJitter" or key=="nextRandomUpdate" or key=="lastJitterStep"
or key=="lastTargetUpdate" or key=="targetPlayer" or key=="smoothedYaw" or key=="smoothedPitch" or key=="smoothedRoll" or key=="characterBaseYaw"
local valueType = typeof(value)
if not runtimeOnly and (valueType == "boolean" or valueType == "number" or valueType == "string") then
output[key] = value
elseif not runtimeOnly and valueType == "Color3" then
output[key] = {
math.floor(value.R*255+0.5),
math.floor(value.G*255+0.5),
math.floor(value.B*255+0.5)
}
end
end
return output
end

local function serialiseProfile(cfg)
local output = {}
for key in pairs(defaultConfig) do
local value = cfg[key]
if type(value) == "table" then
output[key] = table.clone(value)
elseif value ~= nil then
output[key] = value
end
end
return output
end

-- REGISTER-SAFE CONFIG HELPERS
-- These helpers intentionally live on getgenv() instead of as persistent locals.
-- DevKage's packaged source is close to Luau's per-function local-register ceiling,
-- so keeping helper names out of the giant outer chunk prevents executor compile failures.
-- Behavior is unchanged: named configs still capture and replay flagged controls.
getgenv().__DevKageSerialiseControlValues = function()
local output = {}
for flag, control in pairs(library.Controls or {}) do
local flagName = tostring(flag or "")
if flagName ~= ""
and not flagName:match("^script%.")
and flagName ~= "visuals.devkage_cursor_enabled"
and flagName ~= "visuals.devkage_cursor_control_mode"
and control
and type(control.Get) == "function" then

local ok, value = pcall(control.Get, control)
if ok then
local valueType = typeof(value)
if valueType == "Color3" then
local alpha = nil
if type(control.GetAlpha) == "function" then
local alphaOk, alphaValue = pcall(control.GetAlpha, control)
if alphaOk then alpha = tonumber(alphaValue) end
end
output[flagName] = {
__devkage_control_type = "Color3",
r = math.floor(value.R * 255 + 0.5),
g = math.floor(value.G * 255 + 0.5),
b = math.floor(value.B * 255 + 0.5),
alpha = alpha
}
elseif type(value) == "boolean"
or type(value) == "number"
or type(value) == "string" then
output[flagName] = value
end
end
end
end
return output
end

getgenv().__DevKageApplySavedControlValues = function(savedValues)
if type(savedValues) ~= "table" then return end
for flag, savedValue in pairs(savedValues) do
local flagName = tostring(flag or "")
local control = library.Controls and library.Controls[flagName]
if control
and type(control.Set) == "function"
and not flagName:match("^script%.")
and flagName ~= "visuals.devkage_cursor_enabled"
and flagName ~= "visuals.devkage_cursor_control_mode" then

if type(savedValue) == "table"
and savedValue.__devkage_control_type == "Color3" then
local color = Color3.fromRGB(
math.clamp(tonumber(savedValue.r) or 255, 0, 255),
math.clamp(tonumber(savedValue.g) or 255, 0, 255),
math.clamp(tonumber(savedValue.b) or 255, 0, 255)
)
pcall(control.Set, control, color, tonumber(savedValue.alpha), false)
elseif type(savedValue) == "boolean"
or type(savedValue) == "number"
or type(savedValue) == "string" then
pcall(control.Set, control, savedValue, false)
end
end
end
end

