if VisualsState.threat_compass_show_distance then pieces[#pieces+1]=string.format("%d",math.floor(entry.Distance+0.5)) end
marker.Text=table.concat(pieces," ")
marker.Visible=true
if not sameTeam and entry.Distance<=math.max(5,tonumber(VisualsState.proximity_alert_distance) or 65) then self:FlashAlert(player,entry.Distance) end
end
end
for player,marker in pairs(self.Markers) do
if not active[player] or not player.Parent then if not player.Parent then pcall(function() marker:Destroy() end); self.Markers[player]=nil else marker.Visible=false end end
end
end

