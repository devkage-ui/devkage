local function aa_randomRange(minimum, maximum)
minimum = math.floor(tonumber(minimum) or 0)
maximum = math.floor(tonumber(maximum) or 0)
if minimum > maximum then minimum, maximum = maximum, minimum end
return math.random(minimum, maximum)
end

function AntiAimState.IsTargetVisible(targetCharacter,targetRoot)
if AntiAimState.target_visible_check~=true then return true end
if not targetCharacter or not targetRoot then return false end
local camera=workspace.CurrentCamera
local localCharacter=LocalPlayer.Character
local localRoot=localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
local origin=camera and camera.CFrame.Position or (localRoot and localRoot.Position)
if not origin then return false end
local parameters=RaycastParams.new()
parameters.IgnoreWater=true
parameters.FilterDescendantsInstances=localCharacter and {localCharacter} or {}
pcall(function() parameters.FilterType=Enum.RaycastFilterType.Exclude end)
local result=workspace:Raycast(origin,targetRoot.Position-origin,parameters)
return result==nil or (result.Instance and result.Instance:IsDescendantOf(targetCharacter))
end

function AntiAimState.PickRotationTarget(now)
now=tonumber(now) or os.clock()
local delay=math.clamp(tonumber(AntiAimState.target_update_delay) or 0.15,0.03,2)
local cached=AntiAimState.targetPlayer
if now-(tonumber(AntiAimState.lastTargetUpdate) or 0)<delay and cached and cached.Parent then
local character=cached.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
if humanoid and humanoid.Health>0 then return cached end
end
AntiAimState.lastTargetUpdate=now
local camera=workspace.CurrentCamera
local localCharacter=LocalPlayer.Character
local localRoot=localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
if not camera or not localRoot then AntiAimState.targetPlayer=nil; return nil end
local viewportCenter=camera.ViewportSize*0.5
local maxDistance=math.clamp(tonumber(AntiAimState.target_max_distance) or 500,10,5000)
local maxRadius=math.clamp(tonumber(AntiAimState.target_fov) or 720,10,3000)
local best,bestDistance=nil,math.huge
for _,player in ipairs(Players:GetPlayers()) do
if player~=LocalPlayer then
local sameTeam=AntiAimState.target_team_check==true and LocalPlayer.Team~=nil and player.Team==LocalPlayer.Team
if not sameTeam then
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
local root=character and character:FindFirstChild("HumanoidRootPart")
if humanoid and root and humanoid.Health>0 then
local worldDistance=(root.Position-localRoot.Position).Magnitude
if worldDistance<=maxDistance and AntiAimState.IsTargetVisible(character,root) then
local screen,visible=camera:WorldToViewportPoint(root.Position)
if visible and screen.Z>0 then
local screenDistance=(Vector2.new(screen.X,screen.Y)-viewportCenter).Magnitude
if screenDistance<=maxRadius and screenDistance<bestDistance then best=player; bestDistance=screenDistance end
end
end
end
end
end
end
AntiAimState.targetPlayer=best
return best
end

function AntiAimState.ResolveBaseYaw(root,humanoid,camera,now)
local mode=tostring(AntiAimState.yaw_base or "Camera")
if mode=="World" then return 0 end
local look
if mode=="At Target" then
local target=AntiAimState.PickRotationTarget(now)
local targetRoot=target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
if targetRoot then look=targetRoot.Position-root.Position end
elseif mode=="Movement" and humanoid and humanoid.MoveDirection.Magnitude>0.01 then
look=humanoid.MoveDirection
elseif mode=="Character" then
if AntiAimState.characterBaseYaw~=nil then return AntiAimState.characterBaseYaw end
look=root.CFrame.LookVector
else
look=camera and camera.CFrame.LookVector or root.CFrame.LookVector
end
if not look then look=camera and camera.CFrame.LookVector or root.CFrame.LookVector end
local flat=look and Vector3.new(look.X,0,look.Z) or Vector3.new(0,0,-1)
if flat.Magnitude<0.001 then flat=Vector3.new(0,0,-1) end
flat=flat.Unit
return math.atan2(-flat.X,-flat.Z)
end

function AntiAimState.LerpAngle(current,target,alpha)
local difference=(target-current+math.pi)%(math.pi*2)-math.pi
return current+difference*math.clamp(tonumber(alpha) or 1,0,1)
end

local function aa_refreshRandoms(now)
local delay = math.clamp(tonumber(AntiAimState.update_delay) or 0.12, 0.01, 1.00)
if now < AntiAimState.nextRandomUpdate then return end
local minimum = math.clamp(tonumber(AntiAimState.random_min) or -180, -180, 180)
local maximum = math.clamp(tonumber(AntiAimState.random_max) or 180, -180, 180)
AntiAimState.randomYaw = aa_randomRange(minimum, maximum)
if AntiAimState.pitch_mode == "Extended Random" then
AntiAimState.randomPitch = aa_randomRange(-180, 180)
else
AntiAimState.randomPitch = aa_randomRange(-89, 89)
end
AntiAimState.nextRandomUpdate = now + delay
end

local function aa_mode_angles(now,humanoid)
now = now or os.clock()
aa_refreshRandoms(now)

local yawMode = AntiAimState.yaw_mode
local yaw = 0
if yawMode == "Offset" then
yaw = math.clamp(tonumber(AntiAimState.yaw_offset) or 0, -180, 180)
elseif yawMode == "Backwards" then
yaw = 180
elseif yawMode == "Forwards" then
yaw = 0
elseif yawMode == "Left" then
yaw = 90
elseif yawMode == "Right" then
yaw = -90
elseif yawMode == "Random" then
yaw = AntiAimState.randomYaw
elseif yawMode == "Custom" then
yaw = math.clamp(tonumber(AntiAimState.custom_yaw) or 0, -180, 180)
elseif yawMode == "Sway" then
local range=math.clamp(math.abs(tonumber(AntiAimState.sway_range) or 45),0,180)
local speed=math.clamp(tonumber(AntiAimState.sway_speed) or 1,0.05,10)
yaw=math.clamp(tonumber(AntiAimState.yaw_offset) or 0,-180,180)+math.sin(now*speed*math.pi*2)*range
elseif yawMode == "Three Way" then
local angle=math.clamp(math.abs(tonumber(AntiAimState.three_way_angle) or 90),0,180)
local speed=math.clamp(tonumber(AntiAimState.jitter_speed) or 8,0.1,30)
local phase=math.floor(now*speed)%3
yaw=math.clamp(tonumber(AntiAimState.yaw_offset) or 0,-180,180)+(phase==0 and -angle or (phase==2 and angle or 0))
else
yaw = 0
end

local spinSpeed = math.clamp(tonumber(AntiAimState.spin_speed) or 0, -720, 720)
yaw = yaw + ((now * spinSpeed) % 360)

local jitterAngle = math.clamp(math.abs(tonumber(AntiAimState.jitter_angle) or 0), 0, 180)
local jitterSpeed=math.clamp(tonumber(AntiAimState.jitter_speed) or 8,0.1,30)
local jitterStep=math.floor(now*jitterSpeed)
if jitterStep~=AntiAimState.lastJitterStep then
AntiAimState.lastJitterStep=jitterStep
AntiAimState.randomJitter=aa_randomRange(-jitterAngle,jitterAngle)
end
if jitterAngle > 0 then
local jitterMode=tostring(AntiAimState.jitter_mode or "Offset")
if jitterMode=="Center" then
yaw=yaw+((jitterStep%2==0) and jitterAngle or 0)
elseif jitterMode=="Random" then
yaw=yaw+(tonumber(AntiAimState.randomJitter) or 0)
elseif jitterMode=="Three Way" then
local phase=jitterStep%3
yaw=yaw+(phase==0 and -jitterAngle or (phase==2 and jitterAngle or 0))
elseif jitterMode~="Off" then
yaw=yaw+((jitterStep%2==0) and jitterAngle or -jitterAngle)
end
end

if AntiAimState.movement_override==true and humanoid then
local addition=0
if humanoid.FloorMaterial==Enum.Material.Air then
addition=tonumber(AntiAimState.air_yaw_add) or 0
elseif humanoid.MoveDirection.Magnitude>0.01 then
local root=humanoid.RootPart
local speed=root and Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude or 0
if speed>=math.clamp(tonumber(AntiAimState.movement_threshold) or 2,0,50) then addition=tonumber(AntiAimState.moving_yaw_add) or 0 else addition=tonumber(AntiAimState.standing_yaw_add) or 0 end
else
addition=tonumber(AntiAimState.standing_yaw_add) or 0
end
yaw=yaw+math.clamp(addition,-180,180)
end

if AntiAimState.yaw_invert==true then yaw=-yaw end
yaw=(yaw+180)%360-180

local pitchMode = AntiAimState.pitch_mode
local pitch = 0
if pitchMode == "Random" then
pitch = math.clamp(AntiAimState.randomPitch, -89, 89)
elseif pitchMode == "Zero" then
pitch = 0
elseif pitchMode == "Look Up" then
pitch = -70
elseif pitchMode == "Look Down" then
pitch = 70
elseif pitchMode == "Custom" then
pitch = math.clamp(tonumber(AntiAimState.pitch_angle) or 0, -89, 89)
elseif pitchMode == "Sine" then
local base=math.clamp(tonumber(AntiAimState.pitch_angle) or 0,-89,89)
local range=math.clamp(math.abs(tonumber(AntiAimState.pitch_jitter_angle) or 25),0,89)
local speed=math.clamp(tonumber(AntiAimState.pitch_speed) or 2,0.05,20)
pitch=math.clamp(base+math.sin(now*speed*math.pi*2)*range,-89,89)
elseif pitchMode == "Jitter" then
local base=math.clamp(tonumber(AntiAimState.pitch_angle) or 0,-89,89)
local range=math.clamp(math.abs(tonumber(AntiAimState.pitch_jitter_angle) or 25),0,89)
pitch=math.clamp(base+((jitterStep%2==0) and range or -range),-89,89)
elseif pitchMode == "Extended Custom" then
pitch = math.clamp(tonumber(AntiAimState.pitch_angle) or 0, -180, 180)
elseif pitchMode == "Extended Random" then
pitch = math.clamp(AntiAimState.randomPitch, -180, 180)
end

local roll=math.clamp(tonumber(AntiAimState.roll_angle) or 0,-90,90)
local rollJitter=math.clamp(math.abs(tonumber(AntiAimState.roll_jitter) or 0),0,90)
if rollJitter>0 then roll=math.clamp(roll+((jitterStep%2==0) and rollJitter or -rollJitter),-90,90) end

return yaw, pitch, roll
end

local function aa_apply(enabled)
aa_restore()
AntiAimState.enabled = enabled == true
if not AntiAimState.enabled then return end

local function setupCharacter(char)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
    if not hum then return end
    if AntiAimState.savedHumanoids[hum] == nil then
        AntiAimState.savedHumanoids[hum] = hum.AutoRotate
    end
    local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
    if root then
        local look = root.CFrame.LookVector
        AntiAimState.characterBaseYaw = math.atan2(-look.X, -look.Z)
    end
    hum.AutoRotate = false
end

if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
AntiAimState.characterConnection = LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    if AntiAimState.enabled and AntiAimState.respawn_reapply ~= false then setupCharacter(char) end
end)

AntiAimState.connection = RunService.RenderStepped:Connect(function(dt)
    if not AntiAimState.enabled then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp or not hum or hum.Health <= 0 then return end
    if AntiAimState.savedHumanoids[hum] == nil then
        if AntiAimState.respawn_reapply == false then return end
        setupCharacter(char)
    end
    local paused = (AntiAimState.pause_while_typing == true and uis:GetFocusedTextBox() ~= nil)
        or (AntiAimState.pause_while_seated == true and hum.SeatPart ~= nil)
        or (AntiAimState.ground_only == true and hum.FloorMaterial == Enum.Material.Air)
    if paused then
        local originalAutoRotate = AntiAimState.savedHumanoids[hum]
        pcall(function() hum.AutoRotate = originalAutoRotate == nil and true or originalAutoRotate end)
        local pausedNeck = aa_findNeck(char)
        local originalNeck = pausedNeck and AntiAimState.savedNecks[pausedNeck]
        if pausedNeck and originalNeck then pcall(function() pausedNeck.C0 = originalNeck end) end
        AntiAimState.smoothedYaw = nil
        AntiAimState.smoothedPitch = nil
        AntiAimState.smoothedRoll = nil
        return
    end
    pcall(function() hum.AutoRotate = false end)

    local now = os.clock()
    local yaw, pitch, roll = aa_mode_angles(now, hum)
    local position = hrp.Position
    local camera = workspace.CurrentCamera
    local baseYaw = AntiAimState.ResolveBaseYaw(hrp, hum, camera, now)
    local desiredYaw = baseYaw + math.rad(yaw)
    local smoothing = math.clamp(tonumber(AntiAimState.yaw_smoothing) or 0, 0, 30)
    local deltaTime = math.max(tonumber(dt) or 0, 1 / 240)
    local alpha = smoothing <= 0 and 1 or (1 - math.exp(-smoothing * deltaTime))
    AntiAimState.smoothedYaw = AntiAimState.LerpAngle(AntiAimState.smoothedYaw or desiredYaw, desiredYaw, alpha)
    AntiAimState.smoothedPitch = (AntiAimState.smoothedPitch or pitch) + (pitch - (AntiAimState.smoothedPitch or pitch)) * alpha
    AntiAimState.smoothedRoll = (AntiAimState.smoothedRoll or roll) + (roll - (AntiAimState.smoothedRoll or roll)) * alpha
    local appliedYaw = AntiAimState.smoothedYaw
    local appliedPitch = AntiAimState.smoothedPitch
    local appliedRoll = AntiAimState.smoothedRoll
    local safeCFrame = CFrame.new(position) * CFrame.Angles(0, appliedYaw, 0)
    pcall(function() hrp.CFrame = safeCFrame end)

    local neck = aa_findNeck(char)
    if neck then
        if AntiAimState.savedNecks[neck] == nil then
            AntiAimState.savedNecks[neck] = neck.C0
        end
        pcall(function()
            neck.C0 = AntiAimState.savedNecks[neck] * CFrame.Angles(math.rad(appliedPitch), 0, math.rad(appliedRoll))
        end)
    end

    AntiAimState.lastYaw = yaw
    AntiAimState.lastPitch = appliedPitch
    AntiAimState.lastRoll = appliedRoll
    AntiAimState.lastAppliedYaw = math.deg(appliedYaw)
end)
end

