PlayerESPUtilityRuntime.LoadSkyboxAsset=function(presetName)
local function findSky(asset)
if not asset then return nil end
if asset:IsA("Sky") then return asset end
for _,descendant in ipairs(asset:GetDescendants()) do if descendant:IsA("Sky") then return descendant end end
return nil
end
local assetId=PlayerESPUtilityRuntime.skyboxAssetIds[presetName]
if not assetId then return nil end
PlayerESPUtilityRuntime.assetSkyTextures=PlayerESPUtilityRuntime.assetSkyTextures or {}
local cached=PlayerESPUtilityRuntime.assetSkyTextures[presetName]
if cached then return cached end
local ok,objects=pcall(function() return game:GetObjects(assetId) end)
if not ok or type(objects)~="table" then return nil end
local extracted=nil
for _,assetObject in ipairs(objects) do
local sourceSky=findSky(assetObject)
if sourceSky and not extracted then
local textures={}
local valid=true
for _,property in ipairs(PlayerESPUtilityRuntime.skyboxFaces) do
local value=""
pcall(function() value=sourceSky[property] end)
if type(value)~="string" or value=="" then valid=false; break end
textures[property]=value
end
if valid then extracted=textures end
end
end
for _,assetObject in ipairs(objects) do pcall(function() assetObject:Destroy() end) end
if extracted then PlayerESPUtilityRuntime.assetSkyTextures[presetName]=extracted end
return extracted
end

