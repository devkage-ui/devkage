local function publishCursorSettings(force)
    local changed=force==true
    for visualKey,runtimeKey in pairs(cursorStateMap) do
        local value=VisualsState[visualKey]
        if value~=nil and cursorBridge.Settings[runtimeKey]~=value then
            cursorBridge.Settings[runtimeKey]=value
            changed=true
        end
    end
    cursorBridge.UIOpen=window and window.Enabled==true
    cursorBridge.ControlMode="Mouse"
    cursorBridge.MainHeartbeat=os.clock()
    if changed then
        cursorBridge.Revision=(tonumber(cursorBridge.Revision) or 0)+1
    end
end

local function syncCursorSetting(key,value)
    VisualsState[key]=value
    local runtimeKey=cursorStateMap[key]
    if runtimeKey then
        cursorBridge.Settings[runtimeKey]=value
        cursorBridge.Revision=(tonumber(cursorBridge.Revision) or 0)+1
    end
    cursorBridge.MainHeartbeat=os.clock()
    if key=="devkage_cursor_control_mode" and window and window.SetCursorControlMode then
        window:SetCursorControlMode(value)
    end
end

