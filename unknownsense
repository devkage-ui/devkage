function WorldWaypointRuntime:Update(dt)
self.Elapsed=self.Elapsed+(tonumber(dt) or 0)
if self.Elapsed<1/30 then return end
self.Elapsed=math.max(0,self.Elapsed-1/30)
if not VisualsState.world_waypoint_enabled or typeof(self.Position)~="Vector3" then if self.Folder then self.Folder.Parent=nil end; return end
if self.Folder and not self.Folder.Parent then self.Folder.Parent=workspace end
if not self:Ensure() then return end
local now=os.clock()
local color=VisualsState.world_waypoint_color
local scale=math.clamp(tonumber(VisualsState.world_waypoint_marker_size) or 1,0.5,3)
local pulse=1+(math.sin(now*2.4)+1)*0.055
self.Marker.Color=color; self.Marker.Size=Vector3.new(0.65,0.65,0.65)*scale*pulse
self.Marker.Position=self.Position+Vector3.new(0,0.45+math.sin(now*1.8)*0.10,0)
self.Base.Color=color; self.Base.Size=Vector3.new(0.10,3.3*scale*pulse,3.3*scale*pulse)
self.Base.CFrame=CFrame.new(self.Position+Vector3.new(0,0.08,0))*CFrame.Angles(0,now*0.22,math.rad(90))
local height=math.clamp(tonumber(VisualsState.world_waypoint_beacon_height) or 18,2,100)
self.Beacon.Color=color; self.Beacon.Visible=VisualsState.world_waypoint_beacon==true
self.Beacon.Size=Vector3.new(0.14*scale,height,0.14*scale)
self.Beacon.Position=self.Position+Vector3.new(0,height*0.5,0)
self.Title.Text=tostring(VisualsState.world_waypoint_label or "VIDEO MARKER")
self.Detail.TextColor3=color
local card=self.Title.Parent
local stroke=card and card:FindFirstChild("Stroke")
local accent=card and card:FindFirstChild("Accent")
if stroke then stroke.Color=color end
if accent then accent.BackgroundColor3=color end
local localRoot=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
local distance=localRoot and (self.Position-localRoot.Position).Magnitude or nil
self.Detail.Text=(VisualsState.world_waypoint_show_distance and distance) and string.format("WAYPOINT  •  %.0f STUDS",distance) or "WAYPOINT"
end

