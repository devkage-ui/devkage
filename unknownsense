local function list_configs()
local folderOk,folderError = ensure_folder()
if not folderOk then return {},folderError end
if type(listfiles) ~= "function" then return {},"This executor does not provide config listing" end
local ok, files = pcall(listfiles, CONFIG_FOLDER)
if not ok or type(files) ~= "table" then return {},"Could not list the config folder" end
local names = {}
for _, f in ipairs(files) do
local normal = tostring(f):gsub("\\", "/")
local name = normal:match("([^/]+)%.json$")
if name and name:sub(1,1) ~= "_" and name:match("^[%w_%-]+$") then table.insert(names, name) end
end
return names,nil
end

local function serialiseRuntimeState(source)
local output = {}
for key, value in pairs(source) do
local runtimeOnly = tostring(key):match("^original_")
or key=="lastYaw" or key=="lastPitch" or key=="randomYaw" or key=="randomPitch" or key=="nextRandomUpdate"
local valueType = typeof(value)
if not runtimeOnly and (valueType == "boolean" or valueType == "number" or valueType == "string") then
output[key] = value
elseif not runtimeOnly and valueType == "Color3" then
output[key] = {
math.floor(value.R*255+0.5),
math.floor(value.G*255+0.5),
math.floor(value.B*255+0.5)
}
end
end
return output
end

local function serialiseProfile(cfg)
local output = {}
for key in pairs(defaultConfig) do
local value = cfg[key]
if type(value) == "table" then
output[key] = table.clone(value)
elseif value ~= nil then
output[key] = value
end
end
return output
end

