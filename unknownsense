local function vp3_updateCamera()
    if not VP3.cam or not VP3.model then return end
    local aspect = math.max(0.25, vp3D.AbsoluteSize.X / math.max(1, vp3D.AbsoluteSize.Y))
    local halfFov = math.rad(VP3.cam.FieldOfView * 0.5)
    local height = math.max(1, VP3.extent.Y)
    local width = math.max(VP3.extent.X, VP3.extent.Z, 1)
    local distance = math.max(height, width / aspect) * 0.55 / math.tan(halfFov) + width * 0.5
    local baseRot = AntiAimState.enabled and math.rad(AntiAimState.lastYaw or 0) or 0
    local angle = math.pi + baseRot
    VP3.cam.CFrame = CFrame.lookAt(
        VP3.center + Vector3.new(math.sin(angle) * distance, height * 0.04, math.cos(angle) * distance),
        VP3.center)
    yawIndicatorLabel.Text = AntiAimState.enabled
        and string.format("Yaw: %d°  Pitch: %d°  Roll: %d°", math.floor((AntiAimState.lastYaw or 0)+0.5), math.floor((AntiAimState.lastPitch or 0)+0.5), math.floor((AntiAimState.lastRoll or 0)+0.5))
        or "Anti-Aim disabled"
end
local function vp3_loadUserId(userId)
