            bytes[#bytes+1]=string.char(math.floor(value/65536)%256)
            if c~=61 then bytes[#bytes+1]=string.char(math.floor(value/256)%256) end
            if d~=61 then bytes[#bytes+1]=string.char(value%256) end
            if #bytes>=24576 then
