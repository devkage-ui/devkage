    -- Mouse is the single source of truth for both cursor position and
    -- cursor control.  This keeps the DevKage pointer on the real mouse even
    -- when a first-person camera previously wrote LockCenter.
    target.PositionMode = "Mouse"
    target.ControlMode = "Mouse"

    target.Color =
        referenceCursorColor(
