RapidFireRuntime.InstallTypeHooks = function()
    if not rapidFireIsRivals() then return false end

    local playerScripts = LocalPlayer and LocalPlayer:FindFirstChild("PlayerScripts")
    if not playerScripts and LocalPlayer then
        playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 8)
    end
    if not playerScripts then return false end

    local modules = playerScripts:FindFirstChild("Modules")
    if not modules then modules = playerScripts:WaitForChild("Modules", 8) end
    local itemTypes = modules and modules:FindFirstChild("ItemTypes")
    if not itemTypes and modules then itemTypes = modules:WaitForChild("ItemTypes", 8) end
    if not itemTypes then return false end

    if not RapidFireRuntime.GunHookInstalled then
        local gunModuleScript = itemTypes:FindFirstChild("Gun")
        if gunModuleScript and gunModuleScript:IsA("ModuleScript") then
            local ok, gunModule = pcall(require, gunModuleScript)
            if ok and type(gunModule) == "table" and type(gunModule.StartShooting) == "function" then
                RapidFireRuntime.GunModule = gunModule
                RapidFireRuntime.OriginalGunStartShooting = gunModule.StartShooting

                local original = RapidFireRuntime.OriginalGunStartShooting
                local wrapper
                wrapper = function(self, ...)
                    local config = getgenv().__DevKageConfig
                    local info = type(self) == "table" and self.Info or nil
                    local oldCooldown = type(info) == "table" and info.ShootCooldown or nil

                    if type(config) == "table"
                        and config.rapidFireEnabled == true
                        and type(oldCooldown) == "number"
                        and oldCooldown > 0 then

                        local percent, weaponName = RapidFireRuntime.HookPercent(info)
                        local baseValue = RapidFireRuntime.HookBaseValue(
                            info,
                            weaponName,
                            "ShootCooldown",
                            oldCooldown
                        )
                        info.ShootCooldown = rapidFireScaledCooldown(baseValue, percent)
                    end

                    local results = table.pack(pcall(original, self, ...))

                    if type(info) == "table" and oldCooldown ~= nil then
                        info.ShootCooldown = oldCooldown
                    end

                    if not results[1] then
                        error(results[2], 0)
                    end
                    return table.unpack(results, 2, results.n)
                end

                RapidFireRuntime.GunWrapper = wrapper
                gunModule.StartShooting = wrapper
                RapidFireRuntime.GunHookInstalled = true
            end
        end
    end

    if not RapidFireRuntime.MeleeHookInstalled then
        local meleeModuleScript = itemTypes:FindFirstChild("Melee")
        if meleeModuleScript and meleeModuleScript:IsA("ModuleScript") then
            local ok, meleeModule = pcall(require, meleeModuleScript)
            if ok and type(meleeModule) == "table" and type(meleeModule.StartShooting) == "function" then
                RapidFireRuntime.MeleeModule = meleeModule
                RapidFireRuntime.OriginalMeleeStartShooting = meleeModule.StartShooting

                local original = RapidFireRuntime.OriginalMeleeStartShooting
                local wrapper
                wrapper = function(self, ...)
                    local config = getgenv().__DevKageConfig
                    local info = type(self) == "table" and self.Info or nil
                    local oldCooldown = type(info) == "table" and info.AttackCooldown or nil

                    if type(config) == "table"
                        and config.rapidFireEnabled == true
                        and type(oldCooldown) == "number"
                        and oldCooldown > 0 then

                        local percent, weaponName = RapidFireRuntime.HookPercent(info)
                        local baseValue = RapidFireRuntime.HookBaseValue(
                            info,
                            weaponName,
                            "AttackCooldown",
                            oldCooldown
                        )
                        info.AttackCooldown = rapidFireScaledCooldown(baseValue, percent)
                    end

                    local results = table.pack(pcall(original, self, ...))

                    if type(info) == "table" and oldCooldown ~= nil then
                        info.AttackCooldown = oldCooldown
                    end

                    if not results[1] then
                        error(results[2], 0)
                    end
                    return table.unpack(results, 2, results.n)
                end

                RapidFireRuntime.MeleeWrapper = wrapper
                meleeModule.StartShooting = wrapper
                RapidFireRuntime.MeleeHookInstalled = true
            end
        end
    end

    return RapidFireRuntime.GunHookInstalled or RapidFireRuntime.MeleeHookInstalled
end

