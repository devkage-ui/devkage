-- ============================================================
-- RIVALS RAPID FIRE
-- ItemLibrary-based cooldown scaling.
--
-- Fire Rate slider semantics:
--     1%   = fastest  (1% of the weapon's original cooldown)
--     100% = slowest  (the weapon's original cooldown)
--
-- This modifies only cooldown-like values in RIVALS ItemLibrary.Items.
-- It does NOT change spread, recoil, accuracy, remotes or metatables.
-- ============================================================
local RapidFireRuntime = {
    GameId = 6035872082,
    Items = nil,
    ItemLibrary = nil,
    LoadAttempted = false,
    Originals = {},
    Applied = {},
    WeaponOptions = {},
    SelectedWeapon = tostring(getgenv().__DevKageConfig.rapidFireSelectedWeapon or ""),
    LastStatus = "",
    MaskShardProtected = true,
    GunModule = nil,
    MeleeModule = nil,
    GunHookInstalled = false,
    MeleeHookInstalled = false,
    OriginalGunStartShooting = nil,
    OriginalMeleeStartShooting = nil,
    GunWrapper = nil,
    MeleeWrapper = nil,
    InfoNameCache = setmetatable({}, {__mode = "k"}),
}

local RAPID_FIRE_MELEE_FIELDS = {
    "AttackCooldown",
    "SwingCooldown",
    "MeleeCooldown",
    "Cooldown",
    "RecoveryTime",
    "ResetTime",
}

local RAPID_FIRE_GUN_FIELDS = {
    "ShootCooldown",
    "ShootBurstCooldown",
}

local function rapidFireIsRivals()
    return tonumber(game.GameId) == RapidFireRuntime.GameId
end

local function rapidFireLoadItems()
    if RapidFireRuntime.Items then
        return RapidFireRuntime.Items
    end
    if RapidFireRuntime.LoadAttempted then
        return nil
    end

    RapidFireRuntime.LoadAttempted = true
    if not rapidFireIsRivals() then return nil end

    local modules = ReplicatedStorage:FindFirstChild("Modules")
    local itemModule = modules and modules:FindFirstChild("ItemLibrary")
    if not itemModule or not itemModule:IsA("ModuleScript") then
        return nil
    end

    local ok, libraryData = pcall(require, itemModule)
    if not ok or type(libraryData) ~= "table" or type(libraryData.Items) ~= "table" then
        return nil
    end

    RapidFireRuntime.ItemLibrary = libraryData
    RapidFireRuntime.Items = libraryData.Items
    return RapidFireRuntime.Items
end

local function rapidFireGetEquippedTool()
    local character = LocalPlayer and LocalPlayer.Character
    if not character then return nil end
    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Tool") then return object end
    end
    return nil
end

local function rapidFireHasNumericField(data, field)
    return type(data) == "table"
        and type(data[field]) == "number"
        and data[field] > 0
end

local function rapidFireLooksMeleeData(data)
    if type(data) ~= "table" then return false end
    for _, field in ipairs(RAPID_FIRE_MELEE_FIELDS) do
        if rapidFireHasNumericField(data, field) then
            return true
        end
    end
    return false
end

local function rapidFireLooksGunData(data)
    if type(data) ~= "table" then return false end
    for _, field in ipairs(RAPID_FIRE_GUN_FIELDS) do
        if rapidFireHasNumericField(data, field) then
            return true
        end
    end
    return false
end

local function rapidFireRelevantFields(data)
    local fields = {}

    -- Melee fields first because this feature is primarily intended for melee.
    for _, field in ipairs(RAPID_FIRE_MELEE_FIELDS) do
        if rapidFireHasNumericField(data, field) then
            fields[#fields + 1] = field
        end
    end

    -- Gun cooldown support remains available without touching accuracy/recoil.
    for _, field in ipairs(RAPID_FIRE_GUN_FIELDS) do
        if rapidFireHasNumericField(data, field) then
            fields[#fields + 1] = field
        end
    end

    return fields
end

local function rapidFireDelayPercent(weaponName)
    local config = getgenv().__DevKageConfig
    if type(config.rapidFireRates) ~= "table" then
        config.rapidFireRates = {}
    end

    local saved = tonumber(config.rapidFireRates[tostring(weaponName or "")])
    local fallback = tonumber(config.rapidFireDefaultRate) or 25

    -- While Rapid Fire is enabled the rate is intentionally global: every
    -- weapon uses the same current slider percentage. Per-weapon saved values
    -- are kept only for compatibility when the feature is off.
    local resolved = config.rapidFireEnabled == true and fallback or (saved or fallback)
    return math.clamp(math.floor(resolved + 0.5), 1, 100)
end

local function rapidFireScaledCooldown(originalValue, percent)
    originalValue = tonumber(originalValue)
    if not originalValue or originalValue <= 0 then
        return originalValue
    end

    percent = math.clamp(tonumber(percent) or 100, 1, 100)

    -- 100% is exactly the game's original value.
    if percent >= 100 then
        return originalValue
    end

    -- Lower percentage = lower cooldown = faster.
    -- Keep a tiny positive floor so code expecting a positive cooldown
    -- does not receive zero.
    return math.max(0.001, originalValue * (percent / 100))
end

-- REGISTER-SAFE RAPID FIRE HELPERS
-- Keep the universal weapon hooks on the existing runtime table so they do not
-- consume additional persistent locals inside the very large DevKage UI function.
RapidFireRuntime.WeaponNameFromInfo = function(info)
    if type(info) ~= "table" then return nil end

    local cached = RapidFireRuntime.InfoNameCache[info]
    if cached then return cached end

    local items = RapidFireRuntime.Items
    if type(items) == "table" then
        for weaponName, data in pairs(items) do
            if data == info then
                local resolved = tostring(weaponName)
                RapidFireRuntime.InfoNameCache[info] = resolved
                return resolved
            end
        end
    end

    for _, key in ipairs({"Name", "ItemName", "WeaponName", "DisplayName"}) do
        local value = rawget(info, key)
        if value ~= nil and tostring(value) ~= "" then
            local resolved = tostring(value)
            RapidFireRuntime.InfoNameCache[info] = resolved
            return resolved
        end
    end

    return nil
end

RapidFireRuntime.HookPercent = function(info)
    local weaponName = RapidFireRuntime.WeaponNameFromInfo(info)
    if weaponName then
        return rapidFireDelayPercent(weaponName), weaponName
    end

    local config = getgenv().__DevKageConfig
    local percent = math.clamp(
        math.floor((tonumber(config.rapidFireDefaultRate) or 25) + 0.5),
        1,
        100
    )
    return percent, nil
end

RapidFireRuntime.HookBaseValue = function(info, weaponName, field, currentValue)
    if weaponName then
        local snapshot = RapidFireRuntime.Originals[weaponName]
        if type(snapshot) == "table" and type(snapshot[field]) == "number" then
            return snapshot[field]
        end
    end
    return currentValue
end

RapidFireRuntime.InstallTypeHooks = function()
    if not rapidFireIsRivals() then return false end

    local playerScripts = LocalPlayer and LocalPlayer:FindFirstChild("PlayerScripts")
    if not playerScripts and LocalPlayer then
        playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 8)
    end
    if not playerScripts then return false end

    local modules = playerScripts:FindFirstChild("Modules")
    if not modules then modules = playerScripts:WaitForChild("Modules", 8) end
    local itemTypes = modules and modules:FindFirstChild("ItemTypes")
    if not itemTypes and modules then itemTypes = modules:WaitForChild("ItemTypes", 8) end
    if not itemTypes then return false end

    if not RapidFireRuntime.GunHookInstalled then
        local gunModuleScript = itemTypes:FindFirstChild("Gun")
        if gunModuleScript and gunModuleScript:IsA("ModuleScript") then
            local ok, gunModule = pcall(require, gunModuleScript)
            if ok and type(gunModule) == "table" and type(gunModule.StartShooting) == "function" then
                RapidFireRuntime.GunModule = gunModule
                RapidFireRuntime.OriginalGunStartShooting = gunModule.StartShooting

                local original = RapidFireRuntime.OriginalGunStartShooting
                local wrapper
                wrapper = function(self, ...)
                    local config = getgenv().__DevKageConfig
                    local info = type(self) == "table" and self.Info or nil
                    local oldCooldown = type(info) == "table" and info.ShootCooldown or nil

                    if type(config) == "table"
                        and config.rapidFireEnabled == true
                        and type(oldCooldown) == "number"
                        and oldCooldown > 0 then

                        local percent, weaponName = RapidFireRuntime.HookPercent(info)
                        local baseValue = RapidFireRuntime.HookBaseValue(
                            info,
                            weaponName,
                            "ShootCooldown",
                            oldCooldown
                        )
                        info.ShootCooldown = rapidFireScaledCooldown(baseValue, percent)
                    end

                    local results = table.pack(pcall(original, self, ...))

                    if type(info) == "table" and oldCooldown ~= nil then
                        info.ShootCooldown = oldCooldown
                    end

                    if not results[1] then
                        error(results[2], 0)
                    end
                    return table.unpack(results, 2, results.n)
                end

                RapidFireRuntime.GunWrapper = wrapper
                gunModule.StartShooting = wrapper
                RapidFireRuntime.GunHookInstalled = true
            end
        end
    end

    if not RapidFireRuntime.MeleeHookInstalled then
        local meleeModuleScript = itemTypes:FindFirstChild("Melee")
        if meleeModuleScript and meleeModuleScript:IsA("ModuleScript") then
            local ok, meleeModule = pcall(require, meleeModuleScript)
            if ok and type(meleeModule) == "table" and type(meleeModule.StartShooting) == "function" then
                RapidFireRuntime.MeleeModule = meleeModule
                RapidFireRuntime.OriginalMeleeStartShooting = meleeModule.StartShooting

                local original = RapidFireRuntime.OriginalMeleeStartShooting
                local wrapper
                wrapper = function(self, ...)
                    local config = getgenv().__DevKageConfig
                    local info = type(self) == "table" and self.Info or nil
                    local oldCooldown = type(info) == "table" and info.AttackCooldown or nil

                    if type(config) == "table"
                        and config.rapidFireEnabled == true
                        and type(oldCooldown) == "number"
                        and oldCooldown > 0 then

                        local percent, weaponName = RapidFireRuntime.HookPercent(info)
                        local baseValue = RapidFireRuntime.HookBaseValue(
                            info,
                            weaponName,
                            "AttackCooldown",
                            oldCooldown
                        )
                        info.AttackCooldown = rapidFireScaledCooldown(baseValue, percent)
                    end

                    local results = table.pack(pcall(original, self, ...))

                    if type(info) == "table" and oldCooldown ~= nil then
                        info.AttackCooldown = oldCooldown
                    end

                    if not results[1] then
                        error(results[2], 0)
                    end
                    return table.unpack(results, 2, results.n)
                end

                RapidFireRuntime.MeleeWrapper = wrapper
                meleeModule.StartShooting = wrapper
                RapidFireRuntime.MeleeHookInstalled = true
            end
        end
    end

    return RapidFireRuntime.GunHookInstalled or RapidFireRuntime.MeleeHookInstalled
end

RapidFireRuntime.UninstallTypeHooks = function()
    if RapidFireRuntime.GunHookInstalled
        and type(RapidFireRuntime.GunModule) == "table"
        and RapidFireRuntime.GunModule.StartShooting == RapidFireRuntime.GunWrapper
        and type(RapidFireRuntime.OriginalGunStartShooting) == "function" then

        RapidFireRuntime.GunModule.StartShooting =
            RapidFireRuntime.OriginalGunStartShooting
    end

    if RapidFireRuntime.MeleeHookInstalled
        and type(RapidFireRuntime.MeleeModule) == "table"
        and RapidFireRuntime.MeleeModule.StartShooting == RapidFireRuntime.MeleeWrapper
        and type(RapidFireRuntime.OriginalMeleeStartShooting) == "function" then

        RapidFireRuntime.MeleeModule.StartShooting =
            RapidFireRuntime.OriginalMeleeStartShooting
    end

    RapidFireRuntime.GunHookInstalled = false
    RapidFireRuntime.MeleeHookInstalled = false
    RapidFireRuntime.GunWrapper = nil
    RapidFireRuntime.MeleeWrapper = nil
end

local function rapidFireSnapshotWeapon(weaponName, data)
    weaponName = tostring(weaponName or "")
    if weaponName == "" or type(data) ~= "table" then return nil end

    local snapshot = RapidFireRuntime.Originals[weaponName]
    if type(snapshot) ~= "table" then
        snapshot = {}
        RapidFireRuntime.Originals[weaponName] = snapshot
    end

    for _, field in ipairs(rapidFireRelevantFields(data)) do
        if snapshot[field] == nil then
            snapshot[field] = data[field]
        end
    end

    return snapshot
end

local function rapidFireRestoreWeapon(weaponName)
    weaponName = tostring(weaponName or "")
    local items = RapidFireRuntime.Items
    local snapshot = RapidFireRuntime.Originals[weaponName]
    local applied = RapidFireRuntime.Applied[weaponName]

    if type(items) ~= "table"
        or type(items[weaponName]) ~= "table"
        or type(snapshot) ~= "table" then
        RapidFireRuntime.Applied[weaponName] = nil
        return false
    end

    local data = items[weaponName]

    for field, originalValue in pairs(snapshot) do
        local lastApplied = type(applied) == "table" and applied[field] or nil

        -- Coexistence-safe restore:
        -- only restore a value if it is still the exact value DevKage applied.
        -- If another script changed it afterward, leave that external value alone.
        if lastApplied == nil or data[field] == lastApplied then
            data[field] = originalValue
        end
    end

    RapidFireRuntime.Applied[weaponName] = nil
    return true
end

local function rapidFireRestoreAll()
    for weaponName in pairs(RapidFireRuntime.Originals) do
        pcall(rapidFireRestoreWeapon, weaponName)
    end
end

local function rapidFireApplyWeapon(weaponName, percent)
    local items = rapidFireLoadItems()
    weaponName = tostring(weaponName or "")

    if type(items) ~= "table" or weaponName == "" then
        return false, 0, "ItemLibrary unavailable"
    end

    local data = items[weaponName]
    if type(data) ~= "table" then
        return false, 0, "Weapon data not found"
    end

    local fields = rapidFireRelevantFields(data)
    if #fields == 0 then
        return false, 0, "No supported cooldown fields"
    end

    -- Always restore our previous patch before recalculating from the
    -- original RIVALS values. This keeps slider changes deterministic.
    rapidFireRestoreWeapon(weaponName)

    local snapshot = rapidFireSnapshotWeapon(weaponName, data)
    if type(snapshot) ~= "table" then
        return false, 0, "Could not snapshot weapon"
    end

    percent = math.clamp(tonumber(percent) or 100, 1, 100)

    local applied = {}
    local changed = 0

    for _, field in ipairs(fields) do
        local originalValue = snapshot[field]
        if type(originalValue) == "number" and originalValue > 0 then
            local scaledValue = rapidFireScaledCooldown(originalValue, percent)
            data[field] = scaledValue
            applied[field] = scaledValue
            changed = changed + 1
        end
    end

    RapidFireRuntime.Applied[weaponName] = applied

    local kind
    if rapidFireLooksMeleeData(data) then
        kind = "melee"
    elseif rapidFireLooksGunData(data) then
        kind = "gun"
    else
        kind = "weapon"
    end

    return changed > 0, changed, kind
end

local function rapidFireApplyConfigured()
    local config = getgenv().__DevKageConfig
    if type(config) ~= "table" or config.rapidFireEnabled ~= true then
        rapidFireRestoreAll()
        return
    end

    -- Hook the game's shared Gun/Melee item-type modules as a live fallback.
    -- That path follows self.Info for whatever weapon is actually firing, so
    -- newly equipped weapons are covered even if ItemLibrary has not been
    -- refreshed since the toggle was enabled.
    pcall(RapidFireRuntime.InstallTypeHooks)

    local items = rapidFireLoadItems()
    if type(items) ~= "table" then return end

    if type(config.rapidFireRates) ~= "table" then
        config.rapidFireRates = {}
    end

    -- Rapid Fire is global when enabled: every supported ItemLibrary weapon
    -- receives either its own saved percentage or the current default rate.
    for weaponName, data in pairs(items) do
        if type(data) == "table" and #rapidFireRelevantFields(data) > 0 then
            pcall(
                rapidFireApplyWeapon,
                tostring(weaponName),
                rapidFireDelayPercent(tostring(weaponName))
            )
        end
    end
end

local function rapidFireWeaponNames(loadModule)
    local found = {}

    if loadModule then
        local items = rapidFireLoadItems()
        if type(items) == "table" then
            for name, data in pairs(items) do
                if type(data) == "table" and #rapidFireRelevantFields(data) > 0 then
                    found[tostring(name)] = true
                end
            end
        end
    end

    local function scan(container)
        if not container then return end
        for _, object in ipairs(container:GetChildren()) do
            if object:IsA("Tool") then
                found[tostring(object.Name)] = true
            end
        end
    end

    scan(LocalPlayer and LocalPlayer:FindFirstChildOfClass("Backpack"))
    scan(LocalPlayer and LocalPlayer.Character)

    local names = {}
    for name in pairs(found) do
        names[#names + 1] = name
    end

    table.sort(names, function(a, b)
        local items = RapidFireRuntime.Items
        local aData = type(items) == "table" and items[a] or nil
        local bData = type(items) == "table" and items[b] or nil
        local aMelee = rapidFireLooksMeleeData(aData)
        local bMelee = rapidFireLooksMeleeData(bData)

        if aMelee ~= bMelee then
            return aMelee
        end
        return a:lower() < b:lower()
    end)

    if #names == 0 then
        names[1] = "Equipped Weapon"
    end

    return names
end

