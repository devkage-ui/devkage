            for _, key in ipairs({"model","cam","world"}) do
                if VP3[key] then VP3[key]:Destroy() end
            end
            VP3.model, VP3.world, VP3.cam = char, world, camera
            VP3.center, VP3.extent = bounds.Position, size
            world.Parent, camera.Parent = vp3D, vp3D
            vp3D.CurrentCamera = camera
            vp3_updateCamera()
            local warning = char:GetAttribute("DevKageAvatarLoadWarning")
            vp3DLabel.Text = warning and "Some avatar assets failed; try Load Avatar again." or ""
            vp3DLabel.Visible = warning ~= nil
        end)
        if token ~= VP3.token then
            if char and char ~= VP3.model then char:Destroy() end
            return
        end
        VP3.loading = false
        if not vp3D.Parent then
            if char and char ~= VP3.model then char:Destroy() end
            return
        end
        if not ok then
            if char and char ~= VP3.model then char:Destroy() end
            vp3DLabel.Text, vp3DLabel.Visible = "Avatar load failed. Try Load Avatar again.", true
            warn("[DevKage Avatar Preview] " .. tostring(err))
