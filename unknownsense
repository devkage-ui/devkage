local function createAttachedPart(character,name,size,color,relativeCFrame,shape,material,transparency)
    local head=character and character:FindFirstChild("Head")
    if not head then return nil end

    local part=Instance.new("Part")
    part.Name=avatarName(name)
    part.Size=size
    part.Color=color
    part.Material=material or Enum.Material.SmoothPlastic
    part.Transparency=transparency or 0
    part.CanCollide=false
    part.CanTouch=false
    part.CanQuery=false
    part.Massless=true
    part.CastShadow=false
    part.Shape=shape or Enum.PartType.Block
    part.CFrame=head.CFrame*relativeCFrame
    part.Parent=character

    local weld=Instance.new("Weld")
    weld.Name="DevKageAvatarWeld"
    weld.Part0=head
    weld.Part1=part
    weld.C0=relativeCFrame
    weld.C1=CFrame.new()
    weld.Parent=part
    return part
end

