function UA.Initialize()
    if UA.ready then
        if ua_emotesEnabled() then
            ua_installEmoteController()
            pcall(ua_applyEmoteSnapshot)
        end
        return true
    end
    if UA.initializing then return false end

    UA.initializing = true
    local environment = ua_environment()
    local previous = environment.__DevKageInventoryActive
    if type(previous) == "table" and previous ~= UA then
        previous.disabled = true
    end
    environment.__DevKageInventoryActive = UA
    environment.__DevKageInventoryBlackBoxMode = true
    UA.disabled = false

    local ok, err = pcall(function()
        local playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 10)
        local controllers = playerScripts and playerScripts:WaitForChild("Controllers", 10)
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        if not controllers or not modules then
            error("native inventory controllers are unavailable")
        end

        UA.Controllers = controllers
        pcall(function()
            UA.EnumLibrary = require(modules:WaitForChild("EnumLibrary", 10))
            if UA.EnumLibrary and UA.EnumLibrary.WaitForEnumBuilder then
                UA.EnumLibrary:WaitForEnumBuilder()
            end
        end)
        UA.CosmeticLibrary = require(modules:WaitForChild("CosmeticLibrary", 10))
        pcall(function() UA.ItemLibrary = require(modules:WaitForChild("ItemLibrary", 10)) end)
        UA.DataController = require(controllers:WaitForChild("PlayerDataController", 10))

        local emoteModule = controllers:FindFirstChild("EmoteController")
            or controllers:WaitForChild("EmoteController", 3)
        if emoteModule then
            pcall(function() UA.EmoteController = require(emoteModule) end)
        end

        -- IMPORTANT: no ownership hooks, no DataController wrappers,
        -- no __namecall hook, no weapon-viewmodel wrappers, and no external
        -- function-reference detector in black-box mode.
        UA.ready = true
        UA.RefreshOwnedCatalogs()

        if ua_emotesEnabled() then
            ua_installEmoteController()
            pcall(ua_applyEmoteSnapshot)
        end
    end)

    UA.initializing = false
    if not ok then
        warn("[DevKage Inventory] " .. tostring(err))
        return false
    end
    return true
end

