function SpoofRankRuntime.Resolve(config)
config=type(config)=="table" and config or getgenv().__DevKageConfig
local selected=SpoofRankRuntime.Normalize(config.rankDisplay)
if selected~="Use Spoofed ELO" then return selected end
local elo=normalizeSpoofELO(config.elo)
local cutoff=math.clamp(normalizeSpoofELO(config.archNemesisCutoff or 3601),3601,9999999)
if elo>=cutoff then return "Archnemesis" end
local rank="Bronze 1"
for _,entry in ipairs(SpoofRankRuntime.Ladder) do
if elo>=entry[1] then rank=entry[2] else break end
end
return rank
end

