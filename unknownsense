hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
if not hum:FindFirstChildOfClass("Animator") then
local animator=Instance.new("Animator"); animator.Parent=hum
end
end
local root=model:FindFirstChild("HumanoidRootPart")
if root then root.Anchored=true; model.PrimaryPart=root; root.CFrame=CFrame.new(0,0,0) end
AnimPreview.camera=Instance.new("Camera")
AnimPreview.camera.Parent=animViewport
animViewport.CurrentCamera=AnimPreview.camera
AnimPreview.rotation=math.pi
updateAnimCamera()
AnimPreview.loading=false
animStatus.Visible=false
if token==AnimPreview.token and onReady then onReady(model) end
end)
end
local function loadTrackForHumanoid(hum,id)
if not hum then return nil,"No humanoid" end
id=tostring(id or ""):match("%d+")
if not id then return nil,"Invalid animation ID" end
local animation=Instance.new("Animation")
animation.AnimationId="rbxassetid://"..id
pcall(function() game:GetService("ContentProvider"):PreloadAsync({animation}) end)
local animator=hum:FindFirstChildOfClass("Animator")
if not animator then
local ok,newAnimator=pcall(function()
local created=Instance.new("Animator")
created.Parent=hum
return created
end)
if ok then animator=newAnimator end
end
local track=nil
local lastError=nil
if animator then
local ok,result=pcall(function() return animator:LoadAnimation(animation) end)
if ok then track=result else lastError=result end
end
if not track then
local ok,result=pcall(function() return hum:LoadAnimation(animation) end)
if ok then track=result else lastError=result end
end
animation:Destroy()
if not track then return nil,"Animation failed / not permitted: "..tostring(lastError or "unknown") end
pcall(function() track.Priority=Enum.AnimationPriority.Action4 end)
pcall(function() track.Looped=false end)
return track,nil
end
local function startTrack(track)
if not track then return false,"No animation track" end
local speed=math.max(tonumber(VisualsState.animation_speed) or 1,0.01)
local ok,err=pcall(function()
track.Looped=false
track.Priority=Enum.AnimationPriority.Action4
track:Play(0.05,1,speed)
track:AdjustSpeed(speed)
end)
if not ok then return false,tostring(err) end
applyAnimationSegment(track)
return true,nil
end
local function playLiveCharacterAnimation(id)
local character=LocalPlayer.Character
if not character then return false,"Character not ready" end
local hum=character:FindFirstChildOfClass("Humanoid")
if not hum then return false,"No humanoid" end
if AnimPreview.liveTrack then pcall(function() AnimPreview.liveTrack:Stop(0.05) end); AnimPreview.liveTrack=nil end
restoreLiveAnimate()
local animate=character:FindFirstChild("Animate")
if animate and animate:IsA("LocalScript") then
AnimPreview.liveAnimate=animate
AnimPreview.liveAnimateDisabled=animate.Disabled
pcall(function() animate.Disabled=true end)
end
for _,playing in ipairs(hum:GetPlayingAnimationTracks()) do
pcall(function() playing:Stop(0.05) end)
end
local track,err=loadTrackForHumanoid(hum,id)
if not track then restoreLiveAnimate(); return false,err end
AnimPreview.liveTrack=track
UI.ESPLiveAnimationTrack=track
local played,playErr=startTrack(track)
if not played then
AnimPreview.liveTrack=nil
UI.ESPLiveAnimationTrack=nil
restoreLiveAnimate()
return false,"Animation play failed: "..tostring(playErr)
end
track.Stopped:Connect(function()
if AnimPreview.liveTrack==track then
AnimPreview.liveTrack=nil
UI.ESPLiveAnimationTrack=nil
restoreLiveAnimate()
end
end)
task.spawn(function()
local deadline=os.clock()+3
while AnimPreview.liveTrack==track and tonumber(track.Length)<=0 and os.clock()<deadline do task.wait(0.05) end
if AnimPreview.liveTrack==track and tonumber(track.Length)<=0 then
animStatus.Text="Animation unavailable or not permitted: "..tostring(id)
animStatus.Visible=true
pcall(function() track:Stop(0.05) end)
end
end)
return true,nil
end
local function playPreviewTrack(id)
loadAnimAvatar(function(model)
if not model or not model.Parent then return end
