local existsOk, exists = pcall(isfile, path)
if existsOk and not exists then return false, "Config not found" end
end
local readOk,raw=pcall(readfile,path)
if not readOk then return false,"Could not read config: "..tostring(raw) end
local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
if not ok or type(data) ~= "table" then return false, "Config contains invalid JSON" end

