local ELOAutoLoadRuntime = {
    Connection = nil,
    Elapsed = 0,
    PresentationElapsed = 0,
}

function ELOAutoLoadRuntime:Stop()
    if self.Connection then
        pcall(function() self.Connection:Disconnect() end)
        self.Connection = nil
    end
    self.Elapsed = 0
    self.PresentationElapsed = 0
end

function ELOAutoLoadRuntime:ApplyOnce(forcePresentation)
    local config = getgenv().__DevKageConfig
    if type(config) ~= "table" then return false end

    local persistedEnabled = SpooferState.savedELOAutoLoad == true
    if config.eloLiveSyncAutoLoad ~= true and not persistedEnabled then return false end

    -- A named config can load after spoofer_autoload.json. Reassert only the
    -- dedicated Live ELO auto-load fields that the user explicitly persisted.
    if persistedEnabled then
        config.eloLiveSyncAutoLoad = true
        if SpooferState.savedELO ~= nil then
            config.elo = normalizeSpoofELO(SpooferState.savedELO)
        end
    end

    config.eloLiveSync = true
    config.spoofELO = true
    config.rankDisplay = "Use Spoofed ELO"
    config.elo = normalizeSpoofELO(config.elo)
    SpooferState.localActive = true

    -- Keep the game's own PlayerDataController view of rating/MMR/ELO in the
    -- same state as the visible player attributes/leaderstats.
    pcall(SpooferState.InstallDataBridge)
    pcall(SpooferState.RefreshClientData)

    pcall(applySpoofELOValues, LocalPlayer, config.elo)
    if SpooferState.targetPlayer then
        pcall(applySpoofELOValues, SpooferState.targetPlayer, config.elo)
    end

    -- Use the same existing presentation refreshers as manual Live ELO Sync.
    -- Profile labels are lightweight enough to refresh every ELO pass; the
    -- broader leaderboard/season refresh is throttled below.
    if type(SpooferState.RefreshProfileStats) == "function" then
        task.defer(SpooferState.RefreshProfileStats)
    end

    if forcePresentation == true then
        pcall(SpoofRankRuntime.InstallSeasonBridge)
        pcall(SpooferState.RefreshLeaderboards)
        pcall(SpoofRankRuntime.RefreshSeasonCharms)
    end

    return true
end

function ELOAutoLoadRuntime:SetEnabled(enabled)
    local config = getgenv().__DevKageConfig
    if type(config) ~= "table" then return false end

    config.eloLiveSyncAutoLoad = enabled == true
    if enabled then
        SpooferState.savedELOAutoLoad = true
        SpooferState.savedELO = normalizeSpoofELO(config.elo)
    else
        SpooferState.savedELOAutoLoad = false
    end

    self:Stop()

    if not enabled then return true end

    config.eloLiveSync = true
    self:ApplyOnce(true)

    -- Keep this runtime alive even when full Spoofer Auto Load is also enabled.
    -- That makes the Live ELO autoload toggle independent and prevents an
    -- auto-execute/multi-inject startup from skipping its heartbeat.
    self.Connection = RunService.Heartbeat:Connect(function(deltaTime)
        local current = getgenv().__DevKageConfig
        if type(current) ~= "table" then return end

        if current.eloLiveSyncAutoLoad ~= true and SpooferState.savedELOAutoLoad ~= true then
            self:Stop()
            return
        end

        if SpooferState.savedELOAutoLoad == true then
            current.eloLiveSyncAutoLoad = true
            if SpooferState.savedELO ~= nil then
                current.elo = normalizeSpoofELO(SpooferState.savedELO)
            end
        end
        current.eloLiveSync = true
        current.spoofELO = true
        current.rankDisplay = "Use Spoofed ELO"

        local dt = tonumber(deltaTime) or 0
        self.Elapsed = self.Elapsed + dt
        self.PresentationElapsed = self.PresentationElapsed + dt

        if self.Elapsed >= 0.75 then
            self.Elapsed = 0
            self:ApplyOnce(false)
        end

        if self.PresentationElapsed >= 2.5 then
            self.PresentationElapsed = 0
            self:ApplyOnce(true)
        end
    end)

    if type(MaskShard) == "table" and type(MaskShard.Connections) == "table" then
        MaskShard.Connections[#MaskShard.Connections + 1] = self.Connection
    end

    return true
end

SpooferState.SetELOAutoLoadRuntimeEnabled = function(enabled)
    return ELOAutoLoadRuntime:SetEnabled(enabled)
end

