local function referenceSetBridgeOwnership(enabled)
    local runtime =
        ReferenceCursorRuntime

    if enabled then
        cursorBridge.ExternalAttached = true

        cursorBridge.ExternalHeartbeat =
            os.clock()

        cursorBridge.ExternalOwner =
            "DevKageReferenceCursor:"
            .. runtime.InstanceId
    else
        local expected =
            "DevKageReferenceCursor:"
            .. runtime.InstanceId

        if cursorBridge.ExternalOwner == expected
            or cursorBridge.ExternalOwner == nil then

            cursorBridge.ExternalAttached = false
            cursorBridge.ExternalHeartbeat = 0
            cursorBridge.ExternalOwner = nil
        end
    end
end

