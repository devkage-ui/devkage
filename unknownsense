    local oldCharacter = SpooferState.avatarCharacter
    local originalDescription = SpooferState.originalAvatarDescription
    SpooferState.avatarCharacter = nil
    SpooferState.originalAvatarDescription = nil

    if not keepPrivacy and oldCharacter and oldCharacter.Parent and originalDescription then
        local humanoid = oldCharacter:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                local methodOk, clientServerMethod = pcall(function()
                    return humanoid.ApplyDescriptionClientServer
                end)
                if methodOk and type(clientServerMethod) == "function" then
                    clientServerMethod(humanoid, originalDescription)
                else
                    humanoid:ApplyDescription(originalDescription)
                end
            end)
        end
    end
    if not keepPrivacy and SpooferState.AvatarAssets then
        SpooferState.AvatarAssets.RestoreBackup(oldCharacter)
    end

end

-- Complete avatar loading and attachment helpers shared by live appearances

SpooferState.AvatarAssets = {Cache = {}, CacheOrder = {}, Limit = 3, Unloaded = false}

function SpooferState.AvatarAssets.TryMethods(object, names, ...)
    local arguments = table.pack(...)
    local lastError
    for _, name in ipairs(names) do
        local ok, result = pcall(function()
            local method = object[name]
            if type(method) ~= "function" then error(name .. " is unavailable") end
            return method(object, table.unpack(arguments, 1, arguments.n))
        end)
        if ok then return true, result end
        lastError = result
    end
    return false, tostring(lastError or "Avatar method unavailable")
end

function SpooferState.AvatarAssets.LoadModel(userId, rigType)
    local assets = SpooferState.AvatarAssets
    if assets.Unloaded then return nil, "Avatar loader stopped" end
    userId = tonumber(userId)
    if not userId or userId <= 0 or userId ~= userId or userId == math.huge then return nil, "Invalid avatar ID" end
    userId = math.floor(userId)
    local key = tostring(userId) .. ":" .. tostring(rigType or "Native")
    local cached = assets.Cache[key]
    if cached then
        local ok, clone = pcall(function() return cached:Clone() end)
        if ok and clone then return clone end
        assets.Cache[key] = nil
    end
    local model, lastError
    if rigType then
        local descriptionOk, description = assets.TryMethods(Players,
            {"GetHumanoidDescriptionFromUserIdAsync", "GetHumanoidDescriptionFromUserId"}, userId)
        if descriptionOk and description then
            local ok, result = assets.TryMethods(Players,
                {"CreateHumanoidModelFromDescriptionAsync", "CreateHumanoidModelFromDescription"}, description, rigType)
            description:Destroy()
            if ok then model = result else lastError = result end
        else lastError = description end
    end
    if not model then
        local ok, result = assets.TryMethods(Players,
            {"CreateHumanoidModelFromUserIdAsync", "CreateHumanoidModelFromUserId"}, userId)
        if ok then model = result else lastError = result end
    end
    if not model or not model:IsA("Model") or not model:FindFirstChild("Head")
        or not model:FindFirstChildOfClass("Humanoid") then
        if typeof(model) == "Instance" then model:Destroy() end
        return nil, tostring(lastError or "Avatar model is incomplete")
    end
    model.Archivable = true
    model:SetAttribute("DevKageAvatarAsset", true)
    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("Script") or object:IsA("LocalScript") then object:Destroy()
        elseif object:IsA("BasePart") then
            object.LocalTransparencyModifier = 0
            object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
        end
    end
    local failedAssets = 0
    local preloadOk, preloadError = pcall(function()
        game:GetService("ContentProvider"):PreloadAsync({model}, function(_, status)
            if status ~= Enum.AssetFetchStatus.Success then failedAssets = failedAssets + 1 end
        end)
    end)
    if not preloadOk or failedAssets > 0 then
        model:SetAttribute("DevKageAvatarLoadWarning", tostring(preloadError or (tostring(failedAssets) .. " assets did not load")))
    end
    if assets.Unloaded then model:Destroy(); return nil, "Avatar loader stopped" end
    if preloadOk and failedAssets == 0 then

        if assets.Cache[key] then assets.Cache[key]:Destroy() end
        local previous = table.find(assets.CacheOrder, key)
        if previous then table.remove(assets.CacheOrder, previous) end
        assets.Cache[key] = model:Clone()
        assets.CacheOrder[#assets.CacheOrder + 1] = key
    end
    while #assets.CacheOrder > assets.Limit do
        local oldest = table.remove(assets.CacheOrder, 1)
        if assets.Cache[oldest] then assets.Cache[oldest]:Destroy(); assets.Cache[oldest] = nil end
    end
    return model
end

function SpooferState.AvatarAssets.PreparePreview(model, allAnchored)
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("BasePart") then
            object.Anchored = allAnchored == true or object == root
            object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
            object.LocalTransparencyModifier = 0
            object.CastShadow = true
        end
    end
    if root then model.PrimaryPart = root; root.Transparency = 1 end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    end
    model:PivotTo(CFrame.new())
end

function SpooferState.AvatarAssets.FindAttachment(character, name, accessory)
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("Attachment") and object.Name == name and object.Parent:IsA("BasePart")
            and not object:IsDescendantOf(accessory) and not object:FindFirstAncestorOfClass("Accessory") then
            return object
        end
    end
end

function SpooferState.AvatarAssets.AttachAccessory(character, humanoid, accessory)
    local assets = SpooferState.AvatarAssets
    local handle = accessory:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return false, "Accessory has no handle: " .. accessory.Name end
    for _, part in ipairs(accessory:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = false, false, false, false
            part.Massless, part.LocalTransparencyModifier = true, 0
        end
    end


    for _, joint in ipairs(accessory:GetDescendants()) do
        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
            for _, field in ipairs({"Part0", "Part1"}) do
                local part = joint[field]
                if part and not part:IsDescendantOf(accessory) then
                    local mapped = character:FindFirstChild(part.Name)
                    joint[field] = mapped and mapped:IsA("BasePart") and mapped or nil
                end
            end
        end
    end
    pcall(function() humanoid:AddAccessory(accessory) end)
    if accessory.Parent ~= character then accessory.Parent = character end
    for _, attachment in ipairs(handle:GetChildren()) do
        if attachment:IsA("Attachment") then
            local target = assets.FindAttachment(character, attachment.Name, accessory)
            if target then
                local previous = handle:FindFirstChild("AccessoryWeld")
                if previous then previous:Destroy() end
                local weld = Instance.new("Weld")
                weld.Name, weld.Part0, weld.Part1 = "AccessoryWeld", target.Parent, handle
                weld.C0, weld.C1 = target.CFrame, attachment.CFrame
                handle.CFrame = target.Parent.CFrame * weld.C0 * weld.C1:Inverse()
                weld.Parent = handle
                return true
            end
        end
    end
    for _, joint in ipairs(accessory:GetDescendants()) do
        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
            local a, b = joint.Part0, joint.Part1
            if a and b then
                local aInside, bInside = a:IsDescendantOf(accessory), b:IsDescendantOf(accessory)
                if aInside ~= bInside then
                    local body = aInside and b or a
                    if body:IsDescendantOf(character) then
                        if joint:IsA("JointInstance") then
                            if aInside then a.CFrame = b.CFrame * joint.C1 * joint.C0:Inverse()
                            else b.CFrame = a.CFrame * joint.C0 * joint.C1:Inverse() end
                        end
                        return true
                    end
                end
            end
        end
    end
    return false, "No matching attachment for " .. accessory.Name
end

function SpooferState.AvatarAssets.AccessoryKey(accessory)
    local handle = accessory:FindFirstChild("Handle")
    local mesh = handle and handle:FindFirstChildOfClass("SpecialMesh")
    local meshId, texture = "", ""
    if handle and handle:IsA("MeshPart") then meshId, texture = handle.MeshId, handle.TextureID
    elseif mesh then meshId, texture = mesh.MeshId, mesh.TextureId end
    return accessory.Name .. "|" .. tostring(meshId) .. "|" .. tostring(texture)
end

function SpooferState.AvatarAssets.HasWeld(accessory, character)
    for _, joint in ipairs(accessory:GetDescendants()) do
        if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
            local a, b = joint.Part0, joint.Part1
            if a and b and a:IsDescendantOf(character) and b:IsDescendantOf(character)
                and a:IsDescendantOf(accessory) ~= b:IsDescendantOf(accessory) then return true end
        end
    end
    return false
end

function SpooferState.AvatarAssets.HeadObjectKey(object)
    if object:IsA("SpecialMesh") then
        return "SpecialMesh|" .. tostring(object.MeshId) .. "|" .. tostring(object.TextureId)
    elseif object:IsA("SurfaceAppearance") then
        return "SurfaceAppearance|" .. tostring(object.ColorMap) .. "|" .. tostring(object.NormalMap)
            .. "|" .. tostring(object.MetalnessMap) .. "|" .. tostring(object.RoughnessMap)
    elseif object:IsA("FaceControls") then return "FaceControls" end
end

function SpooferState.AvatarAssets.Manifest(model)
    local assets = SpooferState.AvatarAssets
    local manifest = {accessories={}, faces={}, headObjects={}}
    for _, object in ipairs(model:GetChildren()) do
        if object:IsA("Accessory") then
            local key = assets.AccessoryKey(object)
            manifest.accessories[key] = (manifest.accessories[key] or 0) + 1
        end
    end
    local head = model:FindFirstChild("Head")
    if head then
        for _, face in ipairs(head:GetChildren()) do
            if face:IsA("Decal") then manifest.faces[tostring(face.Face) .. "|" .. face.Texture] = face.Transparency end
            local key = assets.HeadObjectKey(face)
            if key then manifest.headObjects[key] = true end
        end
        if head:IsA("MeshPart") then manifest.headMesh, manifest.headTexture = head.MeshId, head.TextureID end
        manifest.headTransparency = head.Transparency
    end
    return manifest
end

function SpooferState.AvatarAssets.Matches(character, manifest)
    if not character or not character.Parent or not manifest then return false end
    local assets, counts, faces, headObjects = SpooferState.AvatarAssets, {}, {}, {}
    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Accessory") and assets.HasWeld(object, character) then
            local key = assets.AccessoryKey(object)
            counts[key] = (counts[key] or 0) + 1
        end
    end
    for key, count in pairs(manifest.accessories) do if (counts[key] or 0) < count then return false end end
    local head = character:FindFirstChild("Head")
    if not head then return false end
    for _, face in ipairs(head:GetChildren()) do
        if face:IsA("Decal") then faces[tostring(face.Face) .. "|" .. face.Texture] = face.Transparency end
        local key = assets.HeadObjectKey(face)
        if key then headObjects[key] = true end
    end
    for key, transparency in pairs(manifest.faces) do
        if faces[key] == nil or math.abs(faces[key] - transparency) > 0.001 then return false end
    end
    for key in pairs(manifest.headObjects or {}) do if not headObjects[key] then return false end end
    if manifest.headMesh and (not head:IsA("MeshPart") or head.MeshId ~= manifest.headMesh) then return false end
    if manifest.headTexture and head.TextureID ~= manifest.headTexture then return false end
    if manifest.headTransparency and math.abs(head.Transparency - manifest.headTransparency) > 0.001 then return false end
    return true
end

function SpooferState.AvatarAssets.BuildAccessoryLinks(model)
    local links = {}
    for _, accessory in ipairs(model:GetChildren()) do
        if accessory:IsA("Accessory") then
            local handle = accessory:FindFirstChild("Handle")
            if handle then
                local anchor, offset
                for _, joint in ipairs(accessory:GetDescendants()) do
                    if joint:IsA("JointInstance") and joint.Part0 and joint.Part1 then
                        if joint.Part0 == handle and joint.Part1:IsDescendantOf(model) and not joint.Part1:IsDescendantOf(accessory) then
                            anchor, offset = joint.Part1, joint.C1 * joint.C0:Inverse(); break
                        elseif joint.Part1 == handle and joint.Part0:IsDescendantOf(model) and not joint.Part0:IsDescendantOf(accessory) then
                            anchor, offset = joint.Part0, joint.C0 * joint.C1:Inverse(); break
                        end
                    end
                end
                if anchor then
                    for _, part in ipairs(accessory:GetDescendants()) do
                        if part:IsA("BasePart") then
                            links[#links + 1] = {Part=part, Anchor=anchor, Offset=offset * handle.CFrame:ToObjectSpace(part.CFrame)}
                        end
                    end
                end
            end
        end
    end
    return links
end

function SpooferState.AvatarAssets.UpdateAccessoryLinks(links)
    for _, link in ipairs(links or {}) do
        if link.Part.Parent and link.Anchor.Parent then link.Part.CFrame = link.Anchor.CFrame * link.Offset end
    end
end

function SpooferState.AvatarAssets.RepairAppearance(character, humanoid, template, replaceClothing)
    local assets = SpooferState.AvatarAssets
    local originals, staged, errors = {}, {}, {}
    local available = {}
    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Accessory") then
            local key = assets.AccessoryKey(object)
            available[key] = available[key] or {}
            available[key][#available[key] + 1] = object
        end
        if object:IsA("Accessory") or object:IsA("Shirt") or object:IsA("Pants")
            or object:IsA("ShirtGraphic") or object:IsA("BodyColors") or object:IsA("CharacterMesh") then
            originals[#originals + 1] = object
        end
    end
    local kept = {}
    for _, object in ipairs(template:GetChildren()) do
        if object:IsA("Accessory") then
            local pool = available[assets.AccessoryKey(object)]
            local existing = pool and table.remove(pool)
            local accessory = existing or object:Clone()
            local ok, err = assets.AttachAccessory(character, humanoid, accessory)
            if ok then kept[accessory] = true
            else errors[#errors + 1] = err end
            if not existing then staged[#staged + 1] = accessory end
        elseif replaceClothing and (object:IsA("Shirt") or object:IsA("Pants") or object:IsA("ShirtGraphic")
            or object:IsA("BodyColors") or object:IsA("CharacterMesh")) then
            local clone = object:Clone()
            staged[#staged + 1] = clone
            kept[clone] = true
        end
    end
    if #errors > 0 then
        for _, object in ipairs(staged) do object:Destroy() end
        return false, table.concat(errors, "; ")
    end
    local liveHead, templateHead = character:FindFirstChild("Head"), template:FindFirstChild("Head")
    if liveHead and templateHead then
        if templateHead:IsA("MeshPart") and liveHead:IsA("MeshPart") and templateHead.MeshId ~= liveHead.MeshId then
            local ok, err = pcall(function() liveHead:ApplyMesh(templateHead) end)
            if not ok then
                for _, object in ipairs(staged) do object:Destroy() end
                return false, tostring(err)
            end
        end
        local faceCopies = {}
        for _, object in ipairs(templateHead:GetChildren()) do
            if object:IsA("Decal") or object:IsA("SpecialMesh") or object:IsA("SurfaceAppearance") or object:IsA("FaceControls") then
                faceCopies[#faceCopies + 1] = object:Clone()
            end
        end

        for _, object in ipairs(liveHead:GetChildren()) do
            if object:IsA("Decal") or object:IsA("SpecialMesh") or object:IsA("SurfaceAppearance") or object:IsA("FaceControls") then object:Destroy() end
        end
        for _, object in ipairs(faceCopies) do object.Parent = liveHead end
        if liveHead:IsA("MeshPart") and templateHead:IsA("MeshPart") then liveHead.TextureID = templateHead.TextureID end
        liveHead.Transparency = templateHead.Transparency
    end
    for _, object in ipairs(staged) do
        if not object.Parent then object.Parent = character end
        object:SetAttribute("DevKageAvatarAsset", true)
    end
    if replaceClothing then
        for _, object in ipairs(originals) do if not kept[object] then object:Destroy() end end
    end
    local manifest = assets.Manifest(template)
    if not assets.Matches(character, manifest) then return false, "Avatar face or accessory attachment is incomplete" end
    return true, manifest
end

function SpooferState.AvatarAssets.RestoreBackup(character)
    local assets = SpooferState.AvatarAssets
    local backup = assets.Backup
    assets.Backup = nil
    if not backup then return end
    if character and character == assets.BackupCharacter and character.Parent then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local called, ok, err = pcall(assets.RepairAppearance, character, humanoid, backup, true)
            if not called or not ok then warn("[DevKage Avatar] Appearance restore: " .. tostring(err or ok)) end
        end
    end
    assets.BackupCharacter = nil
    backup:Destroy()
    SpooferState.avatarManifest, SpooferState.avatarManifestCharacter, SpooferState.avatarManifestUserId = nil, nil, nil
end

