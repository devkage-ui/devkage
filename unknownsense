local function getESPPart(character, kind)
if not character then return nil end
local names = {
Head = {"Head"},
Center = {"HumanoidRootPart", "UpperTorso", "Torso"},
Feet = {"LeftFoot", "RightFoot", "LeftLowerLeg", "RightLowerLeg", "Left Leg", "Right Leg", "HumanoidRootPart"},
Top = {"Head", "UpperTorso", "Torso"},
Bottom = {"HumanoidRootPart", "LowerTorso", "Torso"}
}
for _, name in ipairs(names[kind] or names.Center) do
local part = character:FindFirstChild(name)
if part and part:IsA("BasePart") then return part end
end
return character:FindFirstChildWhichIsA("BasePart")
end

local function getRankText(player)
for _, key in ipairs({"Rank", "LeaderboardRank", "DisplayRank", "RankName"}) do
local value = player:GetAttribute(key)
if value ~= nil and tostring(value) ~= "" then return tostring(value) end
