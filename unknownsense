local ModDetectorRuntime = {
    Enabled = false,
    Token = 0,
    StaffIds = {},
    StaffIdsReady = false,
    Connections = {},
    Detected = false,
}

local ModDetectorHttpService = game:GetService("HttpService")
local ModDetectorGroupId = game.CreatorType == Enum.CreatorType.Group and tonumber(game.CreatorId) or nil

local function modDetectorRoleIsStaff(roleName)
    local normalized = " " .. tostring(roleName or ""):lower():gsub("[^%w]+", " ") .. " "
    local words = {
        " moderator ", " mod ", " admin ", " administrator ",
        " staff ", " owner ", " manager ", " developer ", " dev ",
        " contributor ", " script ", " scripter ", " build ", " builder "
    }
    for _, word in ipairs(words) do
        if normalized:find(word, 1, true) then return true end
    end
    return false
end

local function modDetectorSetAlert(active, forceClear)
    active = active == true
    ModDetectorRuntime.Detected = active
    local manager = library and library.KeybindManager
    if not manager or not manager.SetModAlert then return end

    if active then
        manager:SetModAlert(true, window, 240)
    elseif forceClear == true then
        manager:SetModAlert(false, window)
    end
end

local function modDetectorTrack(connection)
    if not connection then return connection end
    ModDetectorRuntime.Connections[#ModDetectorRuntime.Connections + 1] = connection
    if type(MaskShard) == "table" and type(MaskShard.Connections) == "table" then
        MaskShard.Connections[#MaskShard.Connections + 1] = connection
    end
    return connection
end

local function modDetectorReadJson(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or type(body) ~= "string" or body == "" then return nil end
    local decodeOk, data = pcall(function()
        return ModDetectorHttpService:JSONDecode(body)
    end)
    return decodeOk and data or nil
end

local function modDetectorOnlineStaffPresent()
    if not ModDetectorGroupId then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ok, role = pcall(function()
                return plr:GetRoleInGroup(ModDetectorGroupId)
            end)
            if ok and modDetectorRoleIsStaff(role) then
                return true
            end
        end
    end
    return false
end

local function modDetectorLoadStaffIds(token)
    if ModDetectorRuntime.StaffIdsReady then return true end
    if not ModDetectorGroupId then return false end

    local roles = modDetectorReadJson(
        ("https://groups.roblox.com/v1/groups/%d/roles"):format(ModDetectorGroupId)
    )
    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return false end
    if type(roles) ~= "table" or type(roles.roles) ~= "table" then return false end

    local roleIds = {}
    for _, role in ipairs(roles.roles) do
        if type(role) == "table" and tonumber(role.id) and modDetectorRoleIsStaff(role.name) then
            roleIds[#roleIds + 1] = tonumber(role.id)
        end
    end

    local collected = {}
    for _, roleId in ipairs(roleIds) do
        local cursor = ""
        local pageCount = 0
        repeat
            if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return false end
            pageCount = pageCount + 1
            local url = ("https://groups.roblox.com/v1/groups/%d/roles/%d/users?limit=100&sortOrder=Asc"):format(
                ModDetectorGroupId,
                roleId
            )
            if cursor ~= "" then
                url = url .. "&cursor=" .. ModDetectorHttpService:UrlEncode(cursor)
            end

            local data = modDetectorReadJson(url)
            if type(data) ~= "table" or type(data.data) ~= "table" then
                local proxyUrl = ("https://groups.roproxy.com/v1/groups/%d/roles/%d/users?limit=100&sortOrder=Asc"):format(
                    ModDetectorGroupId,
                    roleId
                )
                if cursor ~= "" then
                    proxyUrl = proxyUrl .. "&cursor=" .. ModDetectorHttpService:UrlEncode(cursor)
                end
                data = modDetectorReadJson(proxyUrl)
            end
            if type(data) ~= "table" or type(data.data) ~= "table" then break end

            for _, entry in ipairs(data.data) do
                local userId = tonumber(entry.userId)
                    or tonumber(entry.id)
                    or (type(entry.user) == "table" and tonumber(entry.user.userId))
                    or (type(entry.user) == "table" and tonumber(entry.user.id))
                if userId then collected[userId] = true end
            end

            cursor = tostring(data.nextPageCursor or "")
            task.wait(0.03)
        until cursor == "" or pageCount >= 25
    end

    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return false end
    ModDetectorRuntime.StaffIds = collected
    ModDetectorRuntime.StaffIdsReady = true
    return true
end

local function modDetectorPlayerHasStaffFriend(plr, token)
    if not plr or plr == LocalPlayer then return false end
    if not ModDetectorRuntime.StaffIdsReady or next(ModDetectorRuntime.StaffIds) == nil then return false end

    local ok, pages = pcall(function()
        return Players:GetFriendsAsync(plr.UserId)
    end)
    if not ok or not pages then return false end

    local pageCount = 0
    while token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled do
        pageCount = pageCount + 1
        local page = pages:GetCurrentPage()
        for _, friend in ipairs(page) do
            if ModDetectorRuntime.StaffIds[tonumber(friend.Id)] then
                return true
            end
        end

        if pages.IsFinished or pageCount >= 6 then break end
        local advanced = pcall(function()
            pages:AdvanceToNextPageAsync()
        end)
        if not advanced then break end
        task.wait(0.03)
    end
    return false
end

local function modDetectorScan(token)
    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return end

    if modDetectorOnlineStaffPresent() then
        modDetectorSetAlert(true)
        return
    end

    modDetectorSetAlert(false)

    if not ModDetectorRuntime.StaffIdsReady then
        modDetectorLoadStaffIds(token)
    end
    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and modDetectorPlayerHasStaffFriend(plr, token) then
            modDetectorSetAlert(true)
            return
        end
        if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return end
    end

    modDetectorSetAlert(false)
end

local function modDetectorQueueScan(delaySeconds)
    if not ModDetectorRuntime.Enabled then return end
    local token = ModDetectorRuntime.Token
    task.delay(delaySeconds or 0, function()
        if token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled then
            modDetectorScan(token)
        end
    end)
end

local function setModDetectorEnabled(enabled)
    enabled = enabled == true
    VisualsState.mod_detector_enabled = enabled
    ModDetectorRuntime.Enabled = enabled
    ModDetectorRuntime.Token = ModDetectorRuntime.Token + 1
    if enabled and library and library.KeybindManager and library.KeybindManager.EnsureUI then
        library.KeybindManager:EnsureUI(window)
    end
    modDetectorSetAlert(false, true)

    if not enabled then return end

    local token = ModDetectorRuntime.Token
    task.spawn(function()
        modDetectorScan(token)
        while token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled do
            task.wait(15)
            if token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled then
                modDetectorScan(token)
            end
        end
    end)
end

