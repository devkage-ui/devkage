                pcall(function() object.Enabled = saved.Enabled end)
            end
        end
    end
    table.clear(SpooferState.hiddenState)
    SpooferState.hiddenCharacter = nil

    local oldCharacter = SpooferState.avatarCharacter
    local originalDescription = SpooferState.originalAvatarDescription
    SpooferState.avatarCharacter = nil
    SpooferState.originalAvatarDescription = nil

    if not keepPrivacy and oldCharacter and oldCharacter.Parent and originalDescription then
        local humanoid = oldCharacter:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function()
                local methodOk, clientServerMethod = pcall(function()
                    return humanoid.ApplyDescriptionClientServer
                end)
                if methodOk and type(clientServerMethod) == "function" then
                    clientServerMethod(humanoid, originalDescription)
                else
                    humanoid:ApplyDescription(originalDescription)
                end
            end)
        end
    end
end

local function createLocalSpoofVisual(player, userId)
    if not player then return false, "player missing" end

    local uid = tonumber(userId)
    if not uid or uid <= 0 then return false, "invalid avatar id" end
    uid = math.floor(uid)

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid then return false, "character not ready" end

    SpooferState.visualToken = (SpooferState.visualToken or 0) + 1
    local token = SpooferState.visualToken

    if SpooferState.avatarCharacter ~= character or not SpooferState.originalAvatarDescription then
        local okOriginal, original = pcall(function()
            return humanoid:GetAppliedDescription()
        end)
        if okOriginal and original then
            SpooferState.avatarCharacter = character
            SpooferState.originalAvatarDescription = original
        end
    end

    local okAppearance, appearance = pcall(function()
        return Players:GetCharacterAppearanceAsync(uid)
    end)
    if token ~= SpooferState.visualToken or player.Character ~= character then
        if appearance then pcall(function() appearance:Destroy() end) end
        return false, "superseded"
    end
    if not okAppearance or not appearance then
        return false, "avatar appearance failed"
    end

    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("Accessory")
            or object:IsA("Shirt")
            or object:IsA("Pants")
            or object:IsA("ShirtGraphic")
            or object:IsA("BodyColors")
            or object:IsA("CharacterMesh") then
            pcall(function() object:Destroy() end)
        end
    end

    for _, object in ipairs(appearance:GetChildren()) do
        if object:IsA("Shirt")
            or object:IsA("Pants")
            or object:IsA("ShirtGraphic")
            or object:IsA("BodyColors")
            or object:IsA("CharacterMesh") then
            pcall(function() object.Parent = character end)
        elseif object:IsA("Accessory") then
            pcall(function() humanoid:AddAccessory(object) end)
        elseif object:IsA("MeshPart") then
            local livePart = character:FindFirstChild(object.Name)
            if livePart and livePart:IsA("MeshPart") then
                pcall(function() livePart.MeshId = object.MeshId end)
                pcall(function() livePart.TextureID = object.TextureID end)
            end
        end
    end

    local fetchedFace = appearance:FindFirstChild("face", true)
    local liveHead = character:FindFirstChild("Head")
    if fetchedFace and fetchedFace:IsA("Decal") and liveHead then
        local oldFace = liveHead:FindFirstChild("face")
        if oldFace then pcall(function() oldFace:Destroy() end) end
        pcall(function() fetchedFace:Clone().Parent = liveHead end)
    end

    local parent = character.Parent
    if parent then
        pcall(function()
            character.Parent = nil
            character.Parent = parent
        end)
    end

    pcall(function() appearance:Destroy() end)

    if token ~= SpooferState.visualToken or player.Character ~= character then
        return false, "superseded"
    end

    return true
end

local function updateStats(player, config)
local level = math.max(0, math.floor((tonumber(config.level) or 1) + 0.5))
local streak = math.max(0, math.floor((tonumber(config.streak) or 0) + 0.5))
local wins = tonumber(config.wins) or 0
local kills = tonumber(config.kills) or 0
local elo = normalizeSpoofELO(config.elo)
if config.spoofLevel~=false then pcall(function() player:SetAttribute("Level",level) end) end
if config.spoofStreak~=false then pcall(function() player:SetAttribute("StatisticDuelsWinStreak",streak) end) end
if config.spoofWins~=false then
for _,attribute in ipairs({"Wins","StatisticDuelsWins","DuelsWins"}) do pcall(function() player:SetAttribute(attribute,wins) end) end
end
if config.spoofKills~=false then
for _,attribute in ipairs({"Kills","Eliminations","StatisticEliminations","StatisticKills"}) do pcall(function() player:SetAttribute(attribute,kills) end) end
end
if config.spoofELO~=false then applySpoofELOValues(player,elo) else pcall(SpoofRankRuntime.Apply,player,config) end
SpooferState.ApplyBadgeAttributes(player,config)
local leaderstats = player:FindFirstChild("CustomLeaderstats") or player:FindFirstChild("leaderstats")
if leaderstats then
local lvl  = leaderstats:FindFirstChild("Level")
local strk = leaderstats:FindFirstChild("Win Streak") or leaderstats:FindFirstChild("Winstreak")
local winv = leaderstats:FindFirstChild("Wins") or leaderstats:FindFirstChild("Total Wins")
local killv=leaderstats:FindFirstChild("Kills") or leaderstats:FindFirstChild("Eliminations") or leaderstats:FindFirstChild("KOs")
if lvl and config.spoofLevel~=false then pcall(function() lvl.Value=level end) end
if strk and config.spoofStreak~=false then pcall(function() strk.Value=streak end) end
if winv and config.spoofWins~=false then pcall(function() winv.Value=wins end) end
if killv and config.spoofKills~=false then pcall(function() killv.Value=kills end) end
end
end

local function installRecordingPrivacySpoof(player, data, config)
