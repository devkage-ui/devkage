local function configure_script_autoload(enabled, bootRefresh)
local settings = read_script_settings()
enabled = enabled == true

-- Follow the supplied reference implementation here: persist the user's choice
-- first.  If a manual enable cannot be installed, roll it back below.  During a
-- boot refresh, leave the saved setting enabled so a later compatible executor
-- startup can retry instead of silently forgetting the user's choice.
settings.AutoLoad = enabled
local saved, saveError = write_script_settings(settings)
if not saved then
    return false, saveError
end

if not enabled then
    remove_autoexec_stubs()

    if type(delfile) == "function" then
        for _, path in ipairs({SCRIPT_PAYLOAD_FILE, CONFIG_FOLDER .. "/_devkage_autoload_payload.lua", SCRIPT_BUILD_FILE}) do
            local shouldDelete = true
            if type(isfile) == "function" then
                local ok, exists = pcall(isfile, path)
                shouldDelete = not ok or exists == true
            end
            if shouldDelete then
                pcall(delfile, path)
            end
        end
    end

    local env = (type(getgenv) == "function" and getgenv()) or _G
    env.__DEVKAGE_AUTOLOAD_BUILD = nil
    env.__DEVKAGE_AUTOEXEC_PATHS = nil
    env.__DEVKAGE_AUTOLOAD_PAYLOAD_REFRESHED_AT = nil
    return true, "Script auto-load disabled"
end

