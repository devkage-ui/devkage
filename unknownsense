if className=="SunRaysEffect" then return AdvancedLighting.sunRaysEnabled==true end
if className=="DepthOfFieldEffect" then return AdvancedLighting.depthOfFieldEnabled==true end
if className=="ColorCorrectionEffect" then return AdvancedLighting.colorCorrectionEnabled==true end
return false
end

local function worldVisualOwned(object)
if not object then return false end
local name=tostring(object.Name or "")
return name=="DevKage_Atmosphere"
or name:sub(1,14)=="DevKage_Extra_"
or name=="DevKage_AtmosphereGlow"
or name=="DevKage_Bloom"
or name=="DevKage_SunRays"
or name=="DevKage_DepthOfField"
or name=="DevKage_ColorCorrection"
or name:sub(1,23)=="DevKage_SaturationBoost"
end

local function snapshotForeignEffect(object)
if WorldVisualGuard.Snapshots[object] then return WorldVisualGuard.Snapshots[object] end
local snapshot={Class=object.ClassName}
if object:IsA("Atmosphere") then
snapshot.Density=object.Density; snapshot.Offset=object.Offset; snapshot.Color=object.Color
snapshot.Decay=object.Decay; snapshot.Glare=object.Glare; snapshot.Haze=object.Haze
else
pcall(function() snapshot.Enabled=object.Enabled end)
end
WorldVisualGuard.Snapshots[object]=snapshot
return snapshot
end

local function restoreForeignEffect(object,snapshot)
if not object or not object.Parent or type(snapshot)~="table" then return end
pcall(function()
if snapshot.Class=="Atmosphere" and object:IsA("Atmospher]==================],
    [==================[e") then
object.Density=snapshot.Density; object.Offset=snapshot.Offset; object.Color=snapshot.Color
object.Decay=snapshot.Decay; object.Glare=snapshot.Glare; object.Haze=snapshot.Haze
elseif snapshot.Enabled~=nil then
object.Enabled=snapshot.Enabled
end
end)
end

