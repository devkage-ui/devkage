local legacy={bronzei="Bronze 1",bronzeii="Bronze 2",bronzeiii="Bronze 3",silveri="Silver 1",silverii="Silver 2",silveriii="Silver 3",goldi="Gold 1",goldii="Gold 2",goldiii="Gold 3",platinumi="Platinum 1",platinumii="Platinum 2",platinumiii="Platinum 3",diamondi="Diamond 1",diamondii="Diamond 2",diamondiii="Diamond 3",onyxi="Onyx 1",onyxii="Onyx 2",onyxiii="Onyx 3"}
if legacy[wanted] then return legacy[wanted] end
for _,option in ipairs(SpoofRankRuntime.Options) do
if option:lower():gsub("[%s_%-]","")==wanted then return option end
end
return "Use Spoofed ELO"
