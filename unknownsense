function BindManager:SetModAlert(active, window, durationSeconds)
    if (not self.Overlay or not self.Overlay.Parent) and window then
        self:EnsureUI(window)
    end

    active = active == true
    if active then
        local duration = math.max(tonumber(durationSeconds) or 240, 1)


        if not self.ModAlertActive or (tonumber(self.ModAlertExpiresAt) or 0) <= os.clock() then
            self.ModAlertExpiresAt = os.clock() + duration
        end
        self.ModAlertActive = true
    else
        self.ModAlertActive = false
        self.ModAlertExpiresAt = 0
    end

    if self.ModAlertLabel then
        self.ModAlertLabel.Text = "!mod!"
    end
    if self.ModAlertFrame then
        self.ModAlertFrame.Visible = self.ModAlertActive
    end
    self:RefreshActive()
end

function BindManager:SetHackerAlert(active, window, durationSeconds)
    if (not self.Overlay or not self.Overlay.Parent) and window then
        self:EnsureUI(window)
    end
    active = active == true
    if active then
        local duration = math.max(tonumber(durationSeconds) or 12, 1)
        self.HackerAlertExpiresAt = os.clock() + duration
        self.HackerAlertActive = true
    else
        self.HackerAlertActive = false
        self.HackerAlertExpiresAt = 0
    end
    if self.HackerAlertLabel then self.HackerAlertLabel.Text = "!hacker!" end
    if self.HackerAlertFrame then self.HackerAlertFrame.Visible = self.HackerAlertActive end
    self:RefreshActive()
end

function BindManager:RefreshControl(control)
    if control and control.BindValueLabel then
        local key = self:KeyText(control.BindKey)
        if control.InlineBind then
            control.BindValueLabel.Text = self.CaptureControl == control and "..." or key
            if control.BindModeButton then control.BindModeButton.Text = control.BindMode or "Toggle" end
        else
            control.BindValueLabel.Text = key ~= "-" and ("[" .. key .. "]") or ""
        end
        control.BindValueLabel.TextColor3 = control.BindMode == "Always"
            and control.Window.Accent or Color3.fromRGB(125, 125, 125)
    end
end

function BindManager:RefreshActive()
    if self.StartupBatch then self.RefreshPending = true; return end
    self.RefreshPending = false
    if not self.ActiveList or not self.ActiveFrame then return end
    self.ActiveRows = self.ActiveRows or {}
    local count = 0
    for index, control in ipairs(self.Order) do
        local active = control:Get() == true
        local record = self.ActiveRows[control]
        if active then
            count = count + 1
            if not record or not record.Row.Parent then
                local row = Instance.new("Frame")
                row.Name = "BindEntry"; row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, -4, 0, 19); row.ZIndex = 40002; row.Parent = self.ActiveList
                local name = Instance.new("TextLabel")
                name.BackgroundTransparency = 1; name.Size = UDim2.new(0.64, -3, 1, 0)
                name.Font = Enum.Font.Code; name.TextSize = 10; name.TextColor3 = Color3.fromRGB(210, 210, 215)
                name.TextXAlignment = Enum.TextXAlignment.Left; name.TextTruncate = Enum.TextTruncate.AtEnd
                name.ZIndex = 40003; name.Parent = row
                local state = Instance.new("TextLabel")
                state.BackgroundTransparency = 1; state.Position = UDim2.new(0.64, 0, 0, 0)
                state.Size = UDim2.new(0.36, -2, 1, 0); state.Font = Enum.Font.Code; state.TextSize = 9
                state.TextXAlignment = Enum.TextXAlignment.Right; state.ZIndex = 40003; state.Parent = row
                record = {Row=row, Name=name, State=state}; self.ActiveRows[control] = record
            end
            record.Row.Visible = true; record.Row.LayoutOrder = index
            record.Name.Text = tostring(control.Name)
            record.State.Text = string.lower(control.BindMode or "Toggle") .. " [" .. self:KeyText(control.BindKey) .. "]"
            record.State.TextColor3 = control.Window and control.Window.Accent or Color3.fromRGB(175, 205, 75)
        elseif record then record.Row.Visible = false end
    end
    local camera = workspace.CurrentCamera
    local height = camera and camera.ViewportSize.Y or 720
    local alerts = (self.ModAlertActive and 19 or 0) + (self.HackerAlertActive and 19 or 0)
    local listHeight = math.min(count * 19 + alerts + 6, math.max(80, math.floor(height * 0.5)))
    self.ActiveList.Size = UDim2.new(1, -12, 0, listHeight)
    self.ActiveFrame.Size = UDim2.new(0, 260, 0, listHeight + 31)
    self.ActiveFrame.Visible = count > 0 or alerts > 0
end

function BindManager:RefreshMenu()
    local control = self.MenuControl
    if not control or not self.Menu then return end
    self.MenuTitle.Text = "bind  •  " .. string.lower(tostring(control.Name))
    for mode, button in pairs(self.MenuButtons) do
        local selected = control.BindMode == mode
        button.BackgroundColor3 = selected and Color3.fromRGB(31, 34, 27) or Color3.fromRGB(24, 24, 24)
        button.TextColor3 = selected and control.Window.Accent or Color3.fromRGB(195, 195, 195)
    end
    if self.CaptureControl == control then
        self.MenuKeyButton.Text = "press a key..."
        self.MenuKeyButton.TextColor3 = control.Window.Accent
    else
        self.MenuKeyButton.Text = "key  [ " .. self:KeyText(control.BindKey) .. " ]"
        self.MenuKeyButton.TextColor3 = Color3.fromRGB(205, 205, 205)
    end
end

function BindManager:SetMode(control, mode)
    if mode ~= "Hold" and mode ~= "Toggle" and mode ~= "Always" then return end
    if control.InlineBind and self.CaptureControl == control then self.CaptureControl = nil end
    control.BindMode = mode
    if mode == "Always" then
        control:Set(true)
    elseif mode == "Hold" and (control.BindKey or control.InlineBind) then
        control:Set(false)
    end
    self:RefreshControl(control)
    self:RefreshMenu()
    self:RefreshActive()
end

function BindManager:ShowMenu(control)
    if not control or not control.Window then return end
    self:EnsureUI(control.Window)
    local previousCapture = self.CaptureControl
    self.MenuControl = control
    self.CaptureControl = nil
    if previousCapture then self:RefreshControl(previousCapture) end
    self:RefreshMenu()
    local mouse = uis:GetMouseLocation()
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    local x = math.clamp(mouse.X + 8, 4, math.max(4, viewport.X - 190))
    local y = math.clamp(mouse.Y + 8, 4, math.max(4, viewport.Y - 182))
    self.Menu.Position = UDim2.fromOffset(x, y)
    self.Menu.Visible = true
end

function BindManager:HideMenu()
    local previousCapture = self.CaptureControl
    self.CaptureControl = nil
    self.MenuControl = nil
    if previousCapture then self:RefreshControl(previousCapture) end
    if self.Menu then self.Menu.Visible = false end
end

function BindManager:Register(control, properties)
    self:EnsureUI(control.Window)
    if not (properties and properties.PreserveLegacyIndex) then self.Counter = self.Counter + 1 end
    local id = utility:GetProperty(properties or {}, {"flag", "Flag", "id", "Id", "idx", "Idx"}, nil)
    id = id and tostring(id) or ("toggle:" .. tostring(self.Counter) .. ":" .. tostring(control.Name))
    if self.Controls[id] and self.Controls[id] ~= control then
        id = id .. "#" .. tostring(self.Counter)
    end
    control.BindId = id
    control.BindMode = control.BindMode or "Toggle"
    control.BindKey = control.BindKey or nil
    self.Controls[id] = control
    table.insert(self.Order, control)

    local pending = getgenv and getgenv().__DevKagePendingKeybinds
    if type(pending) == "table" and type(pending[id]) == "table" then
        local data = pending[id]
        if data.mode == "Hold" or data.mode == "Toggle" or data.mode == "Always" then
            control.BindMode = data.mode
        end
        if type(data.keyType) == "string" and type(data.keyName) == "string" then
            control.BindKey = {data.keyType, data.keyName}
        elseif control.InlineBind then
            control.BindKey = nil
        end
        if control.InlineBind and control.BindMode == "Hold" then control:Set(false) end
        if control.BindMode == "Always" then control:Set(true) end
    end
    self:RefreshControl(control)
    self:RefreshActive()
end

function BindManager:Serialize()
    local output = {}
    for id, control in pairs(self.Controls) do
        output[id] = {
            mode = control.BindMode or "Toggle",
            keyType = control.BindKey and control.BindKey[1] or nil,
            keyName = control.BindKey and control.BindKey[2] or nil,
        }
    end
    return output
end

function BindManager:Apply(data)
    if type(data) ~= "table" then return end
    if getgenv then getgenv().__DevKagePendingKeybinds = data end
    for id, bind in pairs(data) do
        local control = self.Controls[id]
        if control and type(bind) == "table" then
            if bind.mode == "Hold" or bind.mode == "Toggle" or bind.mode == "Always" then
                control.BindMode = bind.mode
            end
            if type(bind.keyType) == "string" and type(bind.keyName) == "string" then
                control.BindKey = {bind.keyType, bind.keyName}
            else
                control.BindKey = nil
            end
            if control.InlineBind and control.BindMode == "Hold" then control:Set(false) end
            if control.BindMode == "Always" then control:Set(true) end
            self:RefreshControl(control)
        end
    end
    self:RefreshActive()
end

