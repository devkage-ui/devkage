local function script_autoload_payload_build(source)
    if type(source) ~= "string"
        or source:sub(1, #SCRIPT_AUTOLOAD_MARKER_PREFIX) ~= SCRIPT_AUTOLOAD_MARKER_PREFIX then
        return nil
    end

    local newline = source:find("\n", 1, true)
    if not newline then return nil end
    return source:sub(#SCRIPT_AUTOLOAD_MARKER_PREFIX + 1, newline - 1)
end

local function normalize_script_autoload_source(source)
    if type(source) ~= "string" or source == "" then
        return nil
    end




    if source:sub(1, #SCRIPT_AUTOLOAD_MARKER_PREFIX) == SCRIPT_AUTOLOAD_MARKER_PREFIX then
        local newline = source:find("\n", 1, true)
        if not newline then return nil end
        source = source:sub(newline + 1)
    end

    if source == "" then
        return nil
    end

    return source
end

