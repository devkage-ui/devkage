local function syncDevKageLightingControls()
if not LightingControls then return end
for key,control in pairs(LightingControls) do
if key~="visualPreset" then
local value=AdvancedLighting[key]
if value~=nil and control and control.Set then
if control.Options then control:Set(optionIndex(control.Options,value),true)
elseif control.GetAlpha then control:Set(value,control:GetAlpha(),true)
else control:Set(value,true) end
end
end
end
end

