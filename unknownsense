local function tryPlayerESPHitSound(plr,lastHp,newHp,humanoid)
if not VisualsState.hit_sound_enabled or not plr or plr==LocalPlayer then return end
lastHp=tonumber(lastHp) or 0
newHp=tonumber(newHp) or 0
if lastHp<=0 or newHp>=lastHp or newHp<=0 then return end

local credited=playerESPCombatCreditedToLocal(plr,humanoid)
if not credited then credited=recentlyAttackedPlayer(plr,1.5) end
if not credited then return end

local now=tick()
if now-(PlayerESPUtilityRuntime.hitLastAt[plr] or 0)<0.055 then return end
PlayerESPUtilityRuntime.hitLastAt[plr]=now
playPlayerESPHitSound(false)
end

local function tryPlayerESPKillSound(plr,lastHp,newHp,humanoid)
if not VisualsState.kill_sound_enabled or not killHealthDetectionEnabled() or not plr or plr==LocalPlayer then return end
lastHp=tonumber(lastHp) or 0
newHp=tonumber(newHp) or 0
if lastHp<=0 or newHp>0 then return end

local credited=playerESPCombatCreditedToLocal(plr,humanoid)
if not credited then credited=recentlyAttackedPlayer(plr,8) end
if not credited and tick()-(tonumber(PlayerESPUtilityRuntime.killRecentAttackAt) or 0)<=4 then credited=true end
if not credited then return end

local now=tick()
if now-(PlayerESPUtilityRuntime.killLastAt[plr] or 0)<0.35 then return end
PlayerESPUtilityRuntime.killLastAt[plr]=now
playPlayerESPKillSound(false)
end

