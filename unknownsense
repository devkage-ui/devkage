local function getDeflectingState(player, character)
for _, container in ipairs({player, character}) do
if container then
for _, key in ipairs({"Deflecting", "IsDeflecting", "Parrying", "Blocking"}) do
local value = container:GetAttribute(key)
if value ~= nil then return value == true end
local object = container:FindFirstChild(key, true)
if object and object:IsA("BoolValue") then return object.Value end
end
end
end
return false
end

local function rememberAppearanceProperty(instance, property)
if not instance then return end
local props = ESPAppearanceRuntime.originals[instance]
if not props then
props = {}
ESPAppearanceRuntime.originals[instance] = props
end
if props[property] == nil then
local ok, value = pcall(function() return instance[property] end)
if ok then props[property] = {value = value} end
end
end

local function setAppearanceProperty(instance, property, value, enabled)
if not instance then return end
if enabled then
rememberAppearanceProperty(instance, property)
pcall(function() instance[property] = value end)
else
local props = ESPAppearanceRuntime.originals[instance]
local stored = props and props[property]
if stored then
pcall(function() instance[property] = stored.value end)
props[property] = nil
if next(props) == nil then ESPAppearanceRuntime.originals[instance] = nil end
end
end
end

local function restoreCharacterAppearance(character)
if not character then return end
local originalScale = ESPAppearanceRuntime.modelScales[character]
if originalScale then
pcall(function() character:ScaleTo(originalScale) end)
ESPAppearanceRuntime.modelScales[character] = nil
end
for instance, props in pairs(ESPAppearanceRuntime.originals) do
local belongs = false
pcall(function() belongs = instance == character or instance:IsDescendantOf(character) end)
if belongs then
for property, stored in pairs(props) do
pcall(function() instance[property] = stored.value end)
end
ESPAppearanceRuntime.originals[instance] = nil
end
end
end

local function restoreAllESPVisualAppearance()
for character, originalScale in pairs(ESPAppearanceRuntime.modelScales) do
pcall(function() character:ScaleTo(originalScale) end)
end
ESPAppearanceRuntime.modelScales = setmetatable({}, {__mode = "k"})
for instance, props in pairs(ESPAppearanceRuntime.originals) do
for property, stored in pairs(props) do
pcall(function() instance[property] = stored.value end)
end
end
ESPAppearanceRuntime.originals = setmetatable({}, {__mode = "k"})
for player, light in pairs(ESPAppearanceRuntime.lights) do
pcall(function() light:Destroy() end)
ESPAppearanceRuntime.lights[player] = nil
end
ESPAppearanceRuntime.characters = {}
ESPAppearanceRuntime.appearanceKeys = setmetatable({}, {__mode = "k"})
end

local ESPStyleMaterials = {
Neon = Enum.Material.Neon,
ForceField = Enum.Material.ForceField,
Glass = Enum.Material.Glass,
SmoothPlastic = Enum.Material.SmoothPlastic,
Original = nil
}

local function applyCharacterAppearance(player, character)
if not character then return end
ESPAppearanceRuntime.characters[player] = character
local styleActive = VisualsState.chams == true
local material = ESPStyleMaterials[VisualsState.esp_style] or Enum.Material.Neon
if VisualsState.esp_style == "Original" then material = nil end

for _, object in ipairs(character:GetDescendants()) do
if object:IsA("BasePart") then
local isAccessory = object:FindFirstAncestorOfClass("Accessory") ~= nil
local isHead = object.Name == "Head"
local hideAccessory = styleActive and isAccessory and not VisualsState.esp_accessories
local hideHead = styleActive and isHead and VisualsState.esp_head_style == "Hidden"
setAppearanceProperty(object, "LocalTransparencyModifier", 1, hideAccessory or hideHead)

local partMaterial = material
local applyMaterial = styleActive and partMaterial ~= nil and not hideHead
if isHead and styleActive and VisualsState.esp_head_style == "Neon" then
applyMaterial = true
partMaterial = Enum.Material.Neon
end
setAppearanceProperty(object, "Material", partMaterial or object.Material, applyMaterial)
setAppearanceProperty(object, "Color", VisualsState.esp_model_color, styleActive and VisualsState.esp_style ~= "Original" and not hideHead)

if object:IsA("MeshPart") then
setAppearanceProperty(object, "TextureID", "", styleActive and VisualsState.esp_remove_textures)
end
elseif object:IsA("Decal") or object:IsA("Texture") then
setAppearanceProperty(object, "Transparency", 1, styleActive and VisualsState.esp_remove_textures)
elseif object:IsA("SpecialMesh") then
setAppearanceProperty(object, "TextureId", "", styleActive and VisualsState.esp_remove_textures)
elseif object:IsA("Shirt") then
setAppearanceProperty(object, "ShirtTemplate", "", styleActive and VisualsState.esp_hide_clothes)
elseif object:IsA("Pants") then
setAppearanceProperty(object, "PantsTemplate", "", styleActive and VisualsState.esp_hide_clothes)
elseif object:IsA("ShirtGraphic") then
setAppearanceProperty(object, "Graphic", "", styleActive and VisualsState.esp_hide_clothes)
end
end

local humanoid = character:FindFirstChildOfClass("Humanoid")
local bodyHeightScale = humanoid and humanoid:FindFirstChild("BodyHeightScale")
if bodyHeightScale and bodyHeightScale:IsA("NumberValue") then
rememberAppearanceProperty(bodyHeightScale, "Value")
local props = ESPAppearanceRuntime.originals[bodyHeightScale]
local original = props and props.Value and props.Value.value or bodyHeightScale.Value
if VisualsState.devkage_stretch then
pcall(function() bodyHeightScale.Value = math.clamp(original * VisualsState.devkage_stretch_scale, 0.1, 10) end)
else
setAppearanceProperty(bodyHeightScale, "Value", original, false)
end
else
if ESPAppearanceRuntime.modelScales[character] == nil then
local ok, scale = pcall(function() return character:GetScale() end)
if ok and scale then ESPAppearanceRuntime.modelScales[character] = scale end
end
local originalScale = ESPAppearanceRuntime.modelScales[character]
if originalScale then
if VisualsState.devkage_stretch then
pcall(function() character:ScaleTo(math.clamp(originalScale * VisualsState.devkage_stretch_scale, 0.1, 10)) end)
else
pcall(function() character:ScaleTo(originalScale) end)
ESPAppearanceRuntime.modelScales[character] = nil
end
end
end
end

local function destroyChams(player)
local chams = VisualsState.chams_table[player]
if chams then
pcall(function() chams:Destroy() end)
VisualsState.chams_table[player] = nil
end
local light = ESPAppearanceRuntime.lights[player]
if light then
pcall(function() light:Destroy() end)
ESPAppearanceRuntime.lights[player] = nil
end
end

local function refreshChams()
local anyAppearance = VisualsState.chams or VisualsState.devkage_stretch
if not VisualsState.esp_enabled or not anyAppearance then
for player in pairs(VisualsState.chams_table) do destroyChams(player) end
for player, character in pairs(ESPAppearanceRuntime.characters) do
restoreCharacterAppearance(character)
ESPAppearanceRuntime.characters[player] = nil
end
return
end

local validPlayers = {}
local appearanceKey = table.concat({
 tostring(VisualsState.chams), tostring(VisualsState.devkage_stretch), tostring(VisualsState.devkage_stretch_scale),
 tostring(VisualsState.esp_style), tostring(VisualsState.esp_model_color), tostring(VisualsState.esp_remove_textures),
 tostring(VisualsState.esp_hide_clothes), tostring(VisualsState.esp_head_style), tostring(VisualsState.esp_accessories)
}, "|")
for _, player in ipairs(Players:GetPlayers()) do
local isSelf = player == LocalPlayer
local allowedSelf = isSelf and VisualsState.esp_apply_self
local allowedOther = (not isSelf) and player.Character and not shouldSkipESPPlayer(player)
if (allowedSelf or allowedOther) and player.Character then
validPlayers[player] = true
local character = player.Character
if ESPAppearanceRuntime.characters[player] ~= character or ESPAppearanceRuntime.appearanceKeys[player] ~= appearanceKey then
applyCharacterAppearance(player, character)
ESPAppearanceRuntime.appearanceKeys[player] = appearanceKey
end

if VisualsState.chams then
local hl = VisualsState.chams_table[player]
if not hl or hl.Adornee ~= character or not hl.Parent then
if hl then pcall(function() hl:Destroy() end) end
hl = Instance.new("Highlight")
hl.Name = "DevKage_Chams"
hl.Adornee = character
hl.Parent = character
VisualsState.chams_table[player] = hl
end
hl.Enabled = true
hl.DepthMode = VisualsState.esp_outline_through_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
hl.FillColor = VisualsState.chams_color
hl.FillTransparency = math.clamp(VisualsState.chams_alpha,0,1)
hl.OutlineColor = VisualsState.chams_outline_color
hl.OutlineTransparency = VisualsState.esp_outline and math.clamp(VisualsState.chams_outline_alpha,0,1) or 1

local root = character:FindFirstChild("HumanoidRootPart")
local wantGlow = root and VisualsState.enemy_chams_glow and VisualsState.esp_glow_transparency < 0.995
local light = ESPAppearanceRuntime.lights[player]
if wantGlow then
if not light or light.Parent ~= root then
if light then pcall(function() light:Destroy() end) end
light = Instance.new("PointLight")
light.Name = "DevKage_ESPGlow"
light.Shadows = false
light.Parent = root
ESPAppearanceRuntime.lights[player] = light
end
light.Color = VisualsState.esp_model_color
light.Brightness = (1 - math.clamp(VisualsState.esp_glow_transparency,0,1)) * 4
light.Range = 6 + (1 - math.clamp(VisualsState.esp_glow_transparency,0,1)) * 12
else
if light then pcall(function() light:Destroy() end); ESPAppearanceRuntime.lights[player] = nil end
end
else
if VisualsState.chams_table[player] then pcall(function() VisualsState.chams_table[player]:Destroy() end); VisualsState.chams_table[player] = nil end
local light = ESPAppearanceRuntime.lights[player]
if light then pcall(function() light:Destroy() end); ESPAppearanceRuntime.lights[player] = nil end
end
end
end

for player, character in pairs(ESPAppearanceRuntime.characters) do
if not validPlayers[player] then
restoreCharacterAppearance(character)
ESPAppearanceRuntime.characters[player] = nil
ESPAppearanceRuntime.appearanceKeys[player] = nil
destroyChams(player)
end
end
for player in pairs(VisualsState.chams_table) do
if not validPlayers[player] then destroyChams(player) end
end
end

library.ExtraVisualRuntime = library.ExtraVisualRuntime or {
    ViewOriginals = setmetatable({}, {__mode = "k"}),
    ToolHighlights = setmetatable({}, {__mode = "k"}),
    ThirdPersonSaved = nil,
    ThirdPersonBound = false,
    ThirdPersonRenderName = "DevKageThirdPersonCamera",
    FastClock = 0,
    SlowClock = 0,
    ToolClock = 0,
}

function library.ExtraVisualRuntime:MaterialFromName(name)
    name = tostring(name or "Neon")
    if name == "ForceField" then return Enum.Material.ForceField end
    if name == "Glass" then return Enum.Material.Glass end
    if name == "SmoothPlastic" then return Enum.Material.SmoothPlastic end
    if name == "Plastic" then return Enum.Material.Plastic end
    return Enum.Material.Neon
end

function library.ExtraVisualRuntime:IsArmPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local n = tostring(part.Name):lower():gsub("[%s_%-]", "")
    if n:find("handguard", 1, true) then return false end
    return n:find("leftarm", 1, true) ~= nil
        or n:find("rightarm", 1, true) ~= nil
        or n:find("leftupperarm", 1, true) ~= nil
        or n:find("rightupperarm", 1, true) ~= nil
        or n:find("leftlowerarm", 1, true) ~= nil
        or n:find("rightlowerarm", 1, true) ~= nil
        or n:find("lefthand", 1, true) ~= nil
        or n:find("righthand", 1, true) ~= nil
        or n == "arms" or n == "arm" or n == "hands" or n == "hand"
end

function library.ExtraVisualRuntime:RememberViewPart(part)
    if self.ViewOriginals[part] then return end
    self.ViewOriginals[part] = {
        Color = part.Color,
        Material = part.Material,
        Transparency = part.Transparency,
        Reflectance = part.Reflectance,
    }
end

function library.ExtraVisualRuntime:RestoreViewPart(part, saved)
    if not part or not part.Parent or type(saved) ~= "table" then return end
    pcall(function()
        part.Color = saved.Color
        part.Material = saved.Material
        part.Transparency = saved.Transparency
        part.Reflectance = saved.Reflectance
    end)
end

function library.ExtraVisualRuntime:RestoreViewmodel()
    for part, saved in pairs(self.ViewOriginals) do
        self:RestoreViewPart(part, saved)
        self.ViewOriginals[part] = nil
    end
end

function library.ExtraVisualRuntime:ApplyViewPart(part, arm)
    if not part or not part:IsA("BasePart") or part.Transparency >= 0.999 then return end
    local enabled = arm and VisualsState.viewmodel_arm_chams or VisualsState.viewmodel_weapon_chams
    if not enabled then
        local saved = self.ViewOriginals[part]
        if saved then
            self:RestoreViewPart(part, saved)
            self.ViewOriginals[part] = nil
        end
        return
    end

    self:RememberViewPart(part)
    local color = arm and VisualsState.viewmodel_arm_color or VisualsState.viewmodel_weapon_color
    local materialName = arm and VisualsState.viewmodel_arm_material or VisualsState.viewmodel_weapon_material
    local transparency = arm and VisualsState.viewmodel_arm_transparency or VisualsState.viewmodel_weapon_transparency
    pcall(function()
        part.Color = color
        part.Material = self:MaterialFromName(materialName)
        part.Transparency = math.clamp(tonumber(transparency) or 0, 0, 0.95)
        part.Reflectance = 0
    end)
end

function library.ExtraVisualRuntime:RefreshViewmodel()
    if not VisualsState.viewmodel_arm_chams and not VisualsState.viewmodel_weapon_chams then
        self:RestoreViewmodel()
        return
    end

    local camera = workspace.CurrentCamera
    local character = LocalPlayer.Character
    if not camera then return end

    local function relevant(part)
        if not part or not part.Parent then return false end
        if part:IsDescendantOf(camera) then return true end
        if character and part:IsDescendantOf(character) then
            return self:IsArmPart(part) or part:FindFirstAncestorOfClass("Tool") ~= nil
        end
        return false
    end

    for part, saved in pairs(self.ViewOriginals) do
        if not relevant(part) then
            self:RestoreViewPart(part, saved)
            self.ViewOriginals[part] = nil
        end
    end

    for _, object in ipairs(camera:GetDescendants()) do
        if object:IsA("BasePart") and object.Name ~= "HumanoidRootPart" then
            self:ApplyViewPart(object, self:IsArmPart(object))
        end
    end

    if character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                local arm = self:IsArmPart(object)
                local inTool = object:FindFirstAncestorOfClass("Tool") ~= nil
                if arm or inTool then
                    self:ApplyViewPart(object, arm and not inTool)
                end
            end
        end
    end
end

function library.ExtraVisualRuntime:SetThirdPerson(enabled)
    enabled = enabled == true
    local renderName = self.ThirdPersonRenderName or "DevKageThirdPersonCamera"

    if enabled then
        if not self.ThirdPersonSaved then
            local camera = workspace.CurrentCamera
            self.ThirdPersonSaved = {
                CameraMode = LocalPlayer.CameraMode,
                MinZoom = LocalPlayer.CameraMinZoomDistance,
                MaxZoom = LocalPlayer.CameraMaxZoomDistance,
                CameraType = camera and camera.CameraType or nil,
                CameraSubject = camera and camera.CameraSubject or nil,
            }
        end

        local distance = math.clamp(tonumber(VisualsState.third_person_distance) or 5, 5, 90)
        pcall(function()
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMinZoomDistance = distance
            LocalPlayer.CameraMaxZoomDistance = distance
        end)

        if not self.ThirdPersonBound then
            self.ThirdPersonBound = true
            pcall(function()
                RunService:BindToRenderStep(renderName, Enum.RenderPriority.Camera.Value + 20, function()
                    if not VisualsState.third_person then return end
                    local camera = workspace.CurrentCamera
                    local character = LocalPlayer.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    local head = character and character:FindFirstChild("Head")
                    if not camera or not humanoid or not root or humanoid.Health <= 0 then return end

                    local wantedDistance = math.clamp(tonumber(VisualsState.third_person_distance) or 5, 5, 90)
                    pcall(function()
                        LocalPlayer.CameraMode = Enum.CameraMode.Classic
                        LocalPlayer.CameraMinZoomDistance = wantedDistance
                        LocalPlayer.CameraMaxZoomDistance = wantedDistance
                        camera.CameraType = Enum.CameraType.Custom
                        camera.CameraSubject = humanoid
                    end)

                    local look = camera.CFrame.LookVector
                    if look.Magnitude < 0.001 then look = root.CFrame.LookVector end
                    look = look.Unit
                    local focusPosition = (head and head:IsA("BasePart")) and head.Position or (root.Position + Vector3.new(0, 1.5, 0))
                    local cameraPosition = focusPosition - (look * wantedDistance)
                    pcall(function()
                        camera.CFrame = CFrame.lookAt(cameraPosition, focusPosition, Vector3.new(0, 1, 0))
                        camera.Focus = CFrame.new(focusPosition)
                    end)
                end)
            end)
        end
    else
        if self.ThirdPersonBound then
            pcall(function() RunService:UnbindFromRenderStep(renderName) end)
            self.ThirdPersonBound = false
        end
        local saved = self.ThirdPersonSaved
        self.ThirdPersonSaved = nil
        if saved then
            pcall(function()
                LocalPlayer.CameraMode = saved.CameraMode
                LocalPlayer.CameraMinZoomDistance = saved.MinZoom
                LocalPlayer.CameraMaxZoomDistance = saved.MaxZoom
                local camera = workspace.CurrentCamera
                if camera then
                    if saved.CameraType then camera.CameraType = saved.CameraType end
                    if saved.CameraSubject then camera.CameraSubject = saved.CameraSubject end
                end
            end)
        end
    end
end

function library.ExtraVisualRuntime:IsCharacterVisible(character)
    local camera = workspace.CurrentCamera
    if not camera or not character then return false end
    local target = character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("HumanoidRootPart")
    if not target or not target:IsA("BasePart") then return false end

    local origin = camera.CFrame.Position
    local direction = target.Position - origin
    if direction.Magnitude <= 0.01 then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.FilterDescendantsInstances = {LocalPlayer.Character, camera}
    local result = workspace:Raycast(origin, direction, params)
    return result == nil or (result.Instance and result.Instance:IsDescendantOf(character))
end

function library.ExtraVisualRuntime:UpdateEnemyChams()
    if not VisualsState.chams then return end
    for player, highlight in pairs(VisualsState.chams_table) do
        local character = player and player.Character
        if highlight and highlight.Parent and character and highlight.Adornee == character and player ~= LocalPlayer then
            local fill = VisualsState.chams_color
            if VisualsState.enemy_visibility_colors then
                fill = self:IsCharacterVisible(character) and VisualsState.enemy_visible_color or VisualsState.enemy_hidden_color
            end
            pcall(function()
                highlight.FillColor = fill
                highlight.DepthMode = VisualsState.esp_outline_through_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                if VisualsState.enemy_chams_glow then
                    highlight.OutlineColor = VisualsState.enemy_chams_glow_color
                    highlight.OutlineTransparency = math.clamp(tonumber(VisualsState.enemy_chams_glow_alpha) or 0.08, 0, 1)
                else
                    highlight.OutlineColor = VisualsState.chams_outline_color
                    highlight.OutlineTransparency = VisualsState.esp_outline and math.clamp(VisualsState.chams_outline_alpha, 0, 1) or 1
                end
            end)
            local light = ESPAppearanceRuntime.lights[player]
            if light and light.Parent then
                pcall(function() light.Color = fill end)
            end
        end
    end
end

function library.ExtraVisualRuntime:IsDroppedTool(tool)
    if not tool or not tool:IsA("Tool") or not tool:IsDescendantOf(workspace) then return false end
    local model = tool:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then return false end
    return true
end

function library.ExtraVisualRuntime:RefreshWorldTools()
    for tool, highlight in pairs(self.ToolHighlights) do
        if not VisualsState.world_tool_esp or not self:IsDroppedTool(tool) or not highlight.Parent then
            pcall(function() highlight:Destroy() end)
            self.ToolHighlights[tool] = nil
        end
    end
    if not VisualsState.world_tool_esp then return end

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Tool") and self:IsDroppedTool(object) and not self.ToolHighlights[object] then
            local adornee = object:FindFirstChild("Handle") or object:FindFirstChildWhichIsA("BasePart", true)
            if adornee then
                local highlight = Instance.new("Highlight")
                highlight.Name = "DevKage_WorldToolESP"
                highlight.Adornee = adornee
                highlight.FillColor = VisualsState.world_tool_esp_color
                highlight.FillTransparency = 0.55
                highlight.OutlineColor = VisualsState.world_tool_esp_color
                highlight.OutlineTransparency = VisualsState.world_tool_esp_glow and 0.05 or 0.45
                highlight.DepthMode = VisualsState.world_tool_esp_through_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                highlight.Parent = object
                self.ToolHighlights[object] = highlight
            end
        end
    end

    for _, highlight in pairs(self.ToolHighlights) do
        if highlight and highlight.Parent then
            pcall(function()
                highlight.FillColor = VisualsState.world_tool_esp_color
                highlight.OutlineColor = VisualsState.world_tool_esp_color
                highlight.OutlineTransparency = VisualsState.world_tool_esp_glow and 0.05 or 0.45
                highlight.DepthMode = VisualsState.world_tool_esp_through_walls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
            end)
        end
    end
end

function library.ExtraVisualRuntime:Step(dt)
    local delta = tonumber(dt) or 0
    self.FastClock = (self.FastClock or 0) + delta
    self.SlowClock = (self.SlowClock or 0) + delta
    self.ToolClock = (self.ToolClock or 0) + delta

    if VisualsState.third_person then self:SetThirdPerson(true) end

    if self.FastClock >= 0.10 then
        self.FastClock = 0
        self:UpdateEnemyChams()
    end

    if self.SlowClock >= 0.20 then
        self.SlowClock = 0
        self:RefreshViewmodel()
    end

    if self.ToolClock >= 1.0 then
        self.ToolClock = 0
        if VisualsState.world_tool_esp then self:RefreshWorldTools() end
    end
end

if not library.ExtraVisualRuntime.Connection then
    library.ExtraVisualRuntime.Connection = utility:CreateConnection(RunService.Heartbeat, function(dt)
        if library and library.ExtraVisualRuntime then library.ExtraVisualRuntime:Step(dt) end
    end)
end

table.insert(library.CleanupCallbacks, function()
    local runtime = library and library.ExtraVisualRuntime
    if not runtime then return end
    runtime:RestoreViewmodel()
    runtime:SetThirdPerson(false)
    for tool, highlight in pairs(runtime.ToolHighlights or {}) do
        pcall(function() if highlight then highlight:Destroy() end end)
        runtime.ToolHighlights[tool] = nil
    end
end)

