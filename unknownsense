local function capturePlayerESPOriginalSky()
if PlayerESPUtilityRuntime.originalSkyCaptured then return end
PlayerESPUtilityRuntime.originalSkyCaptured=true
local current=Lighting:FindFirstChildOfClass("Sky")
if current and current.Name~="DevKage_PlayerESP_Sky" then
local ok,clone=pcall(function() return current:Clone() end)
if ok then PlayerESPUtilityRuntime.originalSky=clone end
end
end
local function restorePlayerESPOriginalSky()
if PlayerESPUtilityRuntime.sky then
pcall(function() PlayerESPUtilityRuntime.sky:Destroy() end)
PlayerESPUtilityRuntime.sky=nil
end
for _,child in ipairs(Lighting:GetChildren()) do
if child:IsA("Sky") and child.Name=="DevKage_PlayerESP_Sky" then pcall(function() child:Destroy() end) end
end
if PlayerESPUtilityRuntime.originalSky and not Lighting:FindFirstChildOfClass("Sky") then
local ok,clone=pcall(function() return PlayerESPUtilityRuntime.originalSky:Clone() end)
if ok and clone then clone.Parent=Lighting end
end
end
local function applyPlayerESPSkybox()
if not VisualsState.skybox_enabled then
restorePlayerESPOriginalSky()
return
end
capturePlayerESPOriginalSky()
for _,child in ipairs(Lighting:GetChildren()) do
if child:IsA("Sky") and child~=PlayerESPUtilityRuntime.sky then pcall(function() child:Destroy() end) end
end
local textures=PlayerESPSkyboxes[VisualsState.skybox_preset] or PlayerESPSkyboxes.Default
local sky=PlayerESPUtilityRuntime.sky
if not sky or not sky.Parent then
sky=Instance.new("Sky")
sky.Name="DevKage_PlayerESP_Sky"
sky.Parent=Lighting
PlayerESPUtilityRuntime.sky=sky
end
local heavenApplied=false
if VisualsState.skybox_preset=="Heaven" then
local ok,objects=pcall(function() return game:GetObjects("rbxassetid://15359965253") end)
if ok and type(objects)=="table" then
for _,asset in ipairs(objects) do
local source=nil
if asset:IsA("Sky") then source=asset elseif asset.FindFirstChildOfClass then source=asset:FindFirstChildOfClass("Sky") end
if source then
for _,property in ipairs({"SkyboxBk","SkyboxDn","SkyboxFt","SkyboxLf","SkyboxRt","SkyboxUp"}) do
pcall(function() sky[property]=source[property] end)
end
heavenApplied=true
end
pcall(function() asset:Destroy() end)
if heavenApplied then break end
end
end
end
if not heavenApplied then
for property,value in pairs(textures) do pcall(function() sky[property]=value end) end
end
end

