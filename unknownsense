return function(context)
local WorldLightingRuntime=context.Runtime
local AdvancedLighting=context.AdvancedLighting
local VisualsState=context.VisualsState
local setLightingProperty=context.SetLightingProperty
local ReflectionRuntime=context.ReflectionRuntime
local setReflectionQuality=context.SetReflectionQuality

WorldLightingRuntime.BlueSkyTop=function(strength)
local t=math.clamp((tonumber(strength) or 1)/5,0,1)
return Color3.fromRGB(80,150,255):Lerp(Color3.fromRGB(165,215,255),t)
end

WorldLightingRuntime.BlueSkyBottom=function(strength)
local t=math.clamp((tonumber(strength) or 1)/5,0,1)
return Color3.fromRGB(15,40,90):Lerp(Color3.fromRGB(70,120,190),t)
end

WorldLightingRuntime.BlueSkyOutdoor=function(strength)
local t=math.clamp((tonumber(strength) or 1)/5,0,1)
return Color3.fromRGB(85,120,175):Lerp(Color3.fromRGB(150,190,235),t)
end

WorldLightingRuntime.OutdoorBase=function()
if AdvancedLighting.outdoorAmbientEnabled then return AdvancedLighting.outdoorAmbientColor end
if AdvancedLighting.ambientEnabled then return AdvancedLighting.ambientColor end
if AdvancedLighting.blueSkyEnabled then return WorldLightingRuntime.BlueSkyOutdoor(AdvancedLighting.blueSkyStrength) end
return AdvancedLighting.original.OutdoorAmbient
end

WorldLightingRuntime.RestoreOutdoor=function()
setLightingProperty("OutdoorAmbient",WorldLightingRuntime.OutdoorBase())
end

WorldLightingRuntime.RestoreTopShift=function()
if AdvancedLighting.sunColorEnabled then
setLightingProperty("ColorShift_Top",AdvancedLighting.sunColor)
elseif AdvancedLighting.colorShiftTopEnabled then
setLightingProperty("ColorShift_Top",AdvancedLighting.colorShiftTop)
elseif VisualsState.color_shift then
setLightingProperty("ColorShift_Top",VisualsState.color_shift_top)
elseif AdvancedLighting.blueSkyEnabled then
setLightingProperty("ColorShift_Top",WorldLightingRuntime.BlueSkyTop(AdvancedLighting.blueSkyStrength))
else
setLightingProperty("ColorShift_Top",AdvancedLighting.original.ColorShift_Top)
end
end

WorldLightingRuntime.RestoreBottomShift=function()
if AdvancedLighting.colorShiftBottomEnabled then
setLightingProperty("ColorShift_Bottom",AdvancedLighting.colorShiftBottom)
elseif VisualsState.color_shift then
setLightingProperty("ColorShift_Bottom",VisualsState.color_shift_bottom)
elseif AdvancedLighting.blueSkyEnabled then
setLightingProperty("ColorShift_Bottom",WorldLightingRuntime.BlueSkyBottom(AdvancedLighting.blueSkyStrength))
else
setLightingProperty("ColorShift_Bottom",AdvancedLighting.original.ColorShift_Bottom)
end
end

WorldLightingRuntime.SetOutdoorAmbient=function(enabled,color)
if enabled then setLightingProperty("OutdoorAmbient",color)
else WorldLightingRuntime.RestoreOutdoor() end
end

WorldLightingRuntime.SetSunColor=function(enabled,color)
if enabled then
setLightingProperty("ColorShift_Top",color)
setLightingProperty("OutdoorAmbient",WorldLightingRuntime.OutdoorBase():Lerp(color,0.55))
else
WorldLightingRuntime.RestoreTopShift()
WorldLightingRuntime.RestoreOutdoor()
end
end

WorldLightingRuntime.SetColorShiftTop=function(enabled,color)
if AdvancedLighting.sunColorEnabled then setLightingProperty("ColorShift_Top",AdvancedLighting.sunColor)
elseif enabled then setLightingProperty("ColorShift_Top",color)
else WorldLightingRuntime.RestoreTopShift() end
end

WorldLightingRuntime.SetColorShiftBottom=function(enabled,color)
if enabled then setLightingProperty("ColorShift_Bottom",color)
else WorldLightingRuntime.RestoreBottomShift() end
end

WorldLightingRuntime.SetGeographicLatitude=function(enabled,value)
setLightingProperty("GeographicLatitude",enabled and math.clamp(tonumber(value) or 0,-90,90) or AdvancedLighting.original.GeographicLatitude)
end

WorldLightingRuntime.SetGlobalShadows=function(enabled,value)
if enabled then setLightingProperty("GlobalShadows",value==true)
else setLightingProperty("GlobalShadows",AdvancedLighting.original.GlobalShadows) end
end

WorldLightingRuntime.SetShadowSoftness=function(enabled,value)
setLightingProperty("ShadowSoftness",enabled and math.clamp(tonumber(value) or 0.2,0,1) or AdvancedLighting.original.ShadowSoftness)
end

WorldLightingRuntime.SetClockTime=function(enabled,value)
setLightingProperty("ClockTime",enabled and math.clamp(tonumber(value) or 12,0,24) or AdvancedLighting.original.ClockTime)
end

WorldLightingRuntime.SetEnvironmentDiffuse=function(enabled,value)
if enabled then setLightingProperty("EnvironmentDiffuseScale",math.clamp(tonumber(value) or 1,0,1))
elseif ReflectionRuntime.active then setReflectionQuality(true,AdvancedLighting.reflectionQuality)
else setLightingProperty("EnvironmentDiffuseScale",AdvancedLighting.original.EnvironmentDiffuseScale) end
end

WorldLightingRuntime.SetEnvironmentSpecular=function(enabled,value)
if enabled then setLightingProperty("EnvironmentSpecularScale",math.clamp(tonumber(value) or 1,0,1))
elseif ReflectionRuntime.active then setReflectionQuality(true,AdvancedLighting.reflectionQuality)
else setLightingProperty("EnvironmentSpecularScale",AdvancedLighting.original.EnvironmentSpecularScale) end
end

WorldLightingRuntime.RefreshExtended=function()
if AdvancedLighting.globalShadowsEnabled then WorldLightingRuntime.SetGlobalShadows(true,AdvancedLighting.globalShadows) end
if AdvancedLighting.shadowSoftnessEnabled then WorldLightingRuntime.SetShadowSoftness(true,AdvancedLighting.shadowSoftness) end
if AdvancedLighting.clockTimeEnabled then WorldLightingRuntime.SetClockTime(true,AdvancedLighting.clockTime) end
if AdvancedLighting.geographicLatitudeEnabled then WorldLightingRuntime.SetGeographicLatitude(true,AdvancedLighting.geographicLatitude) end
if AdvancedLighting.environmentDiffuseEnabled then WorldLightingRuntime.SetEnvironmentDiffuse(true,AdvancedLighting.environmentDiffuseScale) end
if AdvancedLighting.environmentSpecularEnabled then WorldLightingRuntime.SetEnvironmentSpecular(true,AdvancedLighting.environmentSpecularScale) end
if AdvancedLighting.outdoorAmbientEnabled then WorldLightingRuntime.SetOutdoorAmbient(true,AdvancedLighting.outdoorAmbientColor) end
if AdvancedLighting.sunColorEnabled then
WorldLightingRuntime.SetSunColor(true,AdvancedLighting.sunColor)
elseif AdvancedLighting.colorShiftTopEnabled then
WorldLightingRuntime.SetColorShiftTop(true,AdvancedLighting.colorShiftTop)
end
if AdvancedLighting.colorShiftBottomEnabled then WorldLightingRuntime.SetColorShiftBottom(true,AdvancedLighting.colorShiftBottom) end
end

