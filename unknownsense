local getter=(type(env.gethui)=="function" and env.gethui) or (type(gethui)=="function" and gethui)
if getter then local ok,value=pcall(getter); if ok and value then return value end end
return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui",8)
end

local function streamerColor(value,fallback)
return auraColorFromConfig(value,fallback)
end

local function streamerHex(color)
color=typeof(color)=="Color3" and color or Color3.fromRGB(255,255,255)
return string.format("#%02X%02X%02X",math.floor(color.R*255+0.5),math.floor(color.G*255+0.5),math.floor(color.B*255+0.5))
end

local function streamerRichEscape(value)
return tostring(value or ""):gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"):gsub('"',"&quot;")
end

local function streamerPing()
local ok,value=pcall(function() return LocalPlayer:GetNetworkPing()*1000 end)
if ok and tonumber(value) then return math.max(0,tonumber(value)) end
ok,value=pcall(function() return StreamerStatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
if ok and tonumber(value) then return math.max(0,tonumber(value)) end
return 0
end






