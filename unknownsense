    local function rainbowColor(now,index,fallback)
        if cfg().avatarModsRainbow ~= true then return fallback end
        local hue = (now * 0.10 * animationSpeed() + (index or 0) * 0.037) % 1
        return Color3.fromHSV(hue,0.70,1)
    end

    local function remember(object)
        if object then state.objects[#state.objects + 1] = object end
        return object
    end

    local function safeDestroy(object)
        if object then pcall(function() object:Destroy() end) end
    end

    local function disconnectRender()
        if state.renderConnection then
            pcall(function() state.renderConnection:Disconnect() end)
            state.renderConnection = nil
        end
    end

    local function clearVisuals()
        state.buildToken = state.buildToken + 1
        disconnectRender()
        for index = #state.objects,1,-1 do safeDestroy(state.objects[index]) end
        state.objects = {}
        state.feathers = {}
        state.haloSegments = {}
        state.haloRigs = {}
        state.wingRigs = {}
        state.lights = {}
        state.emitters = {}
        state.trails = {}
        state.haloSurfaces = {}
        state.wingHighlights = {}
        state.model = nil
        state.character = nil
    end

    local function makeInvisibleBone(name,parent)
        local bone = Instance.new("Part")
        bone.Name = name
        bone.Size = Vector3.new(0.18,0.18,0.18)
        bone.Transparency = 1
        bone.CanCollide = false
        bone.CanTouch = false
        bone.CanQuery = false
        bone.CastShadow = false
        bone.Massless = true
        bone.Anchored = false
        bone.Parent = parent
        remember(bone)
        return bone
    end

    local function makeMotor(name,part0,part1,c0)
        local motor = Instance.new("Motor6D")
        motor.Name = name
        motor.Part0 = part0
        motor.Part1 = part1
        motor.C0 = c0 or CFrame.new()
        motor.C1 = CFrame.new()
        motor.Parent = part0
        remember(motor)
        return motor
    end

    local function makeWeld(part0,part1)
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = part0
        weld.Part1 = part1
        weld.Parent = part1
        remember(weld)
        return weld
    end

    local function addLight(parent,color,index,scale)
        local light = Instance.new("PointLight")
        light.Name = "DevKage_AngelGlow"
        light.Color = color
        light.Brightness = glowBrightness() * (scale or 1)
        light.Range = glowSize()
        light.Shadows = false
        light.Parent = parent
        remember(light)
        state.lights[#state.lights + 1] = {
            Light=light,Index=index or 0,Scale=scale or 1
        }
        return light
    end

    local function addEmitter(parent,index,rateScale)
        if cfg().avatarModsParticles == false then return end
        local emitter = Instance.new("ParticleEmitter")
        emitter.Name = "DevKage_AngelMotes"
        emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        emitter.LightEmission = 0.92
        emitter.LightInfluence = 0
        emitter.Rate = 6 * (rateScale or 1)
        emitter.Lifetime = NumberRange.new(0.35,0.70)
        emitter.Speed = NumberRange.new(0.12,0.45)
        emitter.Drag = 1.5
        emitter.SpreadAngle = Vector2.new(26,26)
        emitter.Rotation = NumberRange.new(0,360)
        emitter.RotSpeed = NumberRange.new(-35,35)
        emitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0,0.10),
            NumberSequenceKeypoint.new(0.35,0.16),
            NumberSequenceKeypoint.new(1,0),
        })
        emitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,0.22),
            NumberSequenceKeypoint.new(0.72,0.62),
            NumberSequenceKeypoint.new(1,1),
        })
        emitter.Color = ColorSequence.new(primaryColor(),secondaryColor())
        emitter.Parent = parent
        remember(emitter)
        state.emitters[#state.emitters + 1] = {
            Emitter=emitter,Index=index or 0,Rate=6 * (rateScale or 1)
        }
    end

    local function makeFeather(parentBone,localCFrame,width,length,thickness,layer,index,tip)
        local feather = Instance.new("Part")
        feather.Name = string.format("Feather_%s_%02d",layer,index)
        feather.Size = Vector3.new(width,thickness,length)
        feather.Material = featherMaterial()
        feather.Color = tip and secondaryColor() or primaryColor()
        feather.Transparency = transparency()
        feather.CanCollide = false
        feather.CanTouch = false
        feather.CanQuery = false
        feather.CastShadow = false
        feather.Massless = true
        feather.Anchored = false
        feather.CFrame = parentBone.CFrame * localCFrame
        feather.Parent = state.model
        remember(feather)

        -- Rounded feather profile; asset-free and much less blocky than raw Parts.
        local mesh = Instance.new("SpecialMesh")
        mesh.Name = "FeatherProfile"
        mesh.MeshType = Enum.MeshType.Sphere
        mesh.Scale = Vector3.new(1,1,1)
        mesh.Parent = feather
        remember(mesh)

        makeWeld(parentBone,feather)

        local entry = {Part=feather,Layer=layer,Index=index,Tip=tip == true}
        state.feathers[#state.feathers + 1] = entry

        if qualityProfile().shafts and length >= 2.2 then
            local shaft = Instance.new("Part")
            shaft.Name = "FeatherShaft"
            shaft.Size = Vector3.new(
                math.max(0.025,width * 0.055),
                math.max(0.018,thickness * 0.35),
                length * 0.88
            )
            shaft.Material = Enum.Material.SmoothPlastic
            shaft.Color = Color3.new(
                math.min(1,feather.Color.R * 0.84 + 0.12),
                math.min(1,feather.Color.G * 0.84 + 0.12),
                math.min(1,feather.Color.B * 0.84 + 0.12)
            )
            shaft.Transparency = math.clamp(transparency() + 0.08,0,0.95)
            shaft.CanCollide = false
            shaft.CanTouch = false
            shaft.CanQuery = false
            shaft.CastShadow = false
            shaft.Massless = true
            shaft.Anchored = false
            shaft.CFrame = feather.CFrame * CFrame.new(0,-thickness * 0.32,0)
            shaft.Parent = state.model
            remember(shaft)
            makeWeld(feather,shaft)
            entry.Shaft = shaft
        end

        return feather
    end

    local function addWingTrail(feather,index)
        if cfg().avatarModsTrails == false or not feather then return end
        local a0 = Instance.new("Attachment")
