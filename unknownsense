local function refreshPremiumWeather()
if not AdvancedLighting.weatherEnabled then stopPremiumWeather(); return end
if not PremiumWeatherRuntime.Folder or #PremiumWeatherRuntime.Layers~=premiumWeatherLayerCount()
or PremiumWeatherRuntime.Type~=tostring(AdvancedLighting.weatherType)
or PremiumWeatherRuntime.Quality~=tostring(AdvancedLighting.weatherQuality) then buildPremiumWeather() end
local profile=PremiumWeatherProfiles[AdvancedLighting.weatherType] or PremiumWeatherProfiles.Rain
for _,layer in ipairs(PremiumWeatherRuntime.Layers) do
local emitter=layer.Emitter
if emitter then
local intensity=math.clamp(tonumber(AdvancedLighting.weatherIntensity) or 700,0,5000)
local qualityBudget=AdvancedLighting.weatherQuality=="Performance" and 700 or (AdvancedLighting.weatherQuality=="Ultra" and 2400 or 1500)
local renderAmount=math.min(intensity,qualityBudget)
local speed=math.clamp(tonumber(AdvancedLighting.weatherSpeed) or 70,1,300)
local size=math.clamp(tonumber(AdvancedLighting.weatherSize) or 0.45,0.05,4)
local wind=math.clamp(tonumber(AdvancedLighting.weatherWind) or 0,-180,180)
applyPremiumWeatherEmitter(emitter,profile)
emitter.Rate=renderAmount*layer.Profile.Weight*(profile.RateScale or 1)
emitter.Speed=NumberRange.new(speed*profile.Speed*layer.Profile.Speed*0.75,speed*profile.Speed*layer.Profile.Speed*1.2)
emitter.Lifetime=NumberRange.new(profile.Lifetime*0.72,profile.Lifetime*1.24)
emitter.Acceleration=Vector3.new(wind,profile.Acceleration*speed*0.12,wind*0.18)
local baseColor=AdvancedLighting.weatherColor:Lerp(profile.Tint,profile.TintBlend or 0.5)
local highlight=profile.Style=="Ash" and baseColor:Lerp(Color3.fromRGB(170,170,175),0.20)
or (profile.Style=="Embers" and Color3.fromRGB(255,225,100) or baseColor:Lerp(Color3.new(1,1,1),0.28))
emitter.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,highlight),ColorSequenceKeypoint.new(0.45,baseColor),ColorSequenceKeypoint.new(1,profile.Style=="Embers" and Color3.fromRGB(175,25,8) or baseColor)})
emitter.Size=premiumWeatherSize(profile,size,layer.Profile.Scale)
end
end
end

