function ReferenceESPRuntime:Update(dt)
local needAim=VisualsState.esp_enabled==true and VisualsState.visualize_aimbot==true
local needArrows=VisualsState.esp_enabled==true and VisualsState.offscreen_arrow==true
local needRagdolls=VisualsState.ragdoll_esp==true

if not needAim and not needArrows and not needRagdolls then
if self.AimCircle then self.AimCircle.Visible=false end
for _,arrow in pairs(self.Arrows) do if arrow then arrow.Visible=false end end
return
end




if (needAim or needArrows) and not self:EnsureGui() then return end

local camera=workspace.CurrentCamera
local viewport=camera and camera.ViewportSize or Vector2.new(0,0)
local center=Vector2.new(viewport.X*0.5,viewport.Y*0.5)
local aimCenter=center

if needAim then
    if not camera or not self.AimCircle or not self.AimStroke then return end

    if uis.MouseBehavior==Enum.MouseBehavior.Default then
        local ok,pos=pcall(function() return uis:GetMouseLocation() end)
        if ok and pos then aimCenter=Vector2.new(pos.X,pos.Y) end
    end

    local aimRadius=math.clamp(tonumber(getgenv().__DevKageConfig.aimFOV) or 90,10,1000)
    self.AimCircle.Visible=true
    self.AimCircle.Position=UDim2.fromOffset(aimCenter.X,aimCenter.Y)
    self.AimCircle.Size=UDim2.fromOffset(aimRadius*2,aimRadius*2)
    self.AimStroke.Color=VisualsState.visualize_aimbot_color
    self.AimStroke.Thickness=math.max(0.5,tonumber(VisualsState.visualize_aimbot_thickness) or 1)
elseif self.AimCircle then
    self.AimCircle.Visible=false
end

if needArrows and not camera then return end
local activePlayers={}
for _,player in ipairs(Players:GetPlayers()) do
if player~=LocalPlayer then
activePlayers[player]=true
local arrow=needArrows and self:GetArrow(player) or self.Arrows[player]
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
local root=character and character:FindFirstChild("HumanoidRootPart")
local show=false
if VisualsState.esp_enabled and VisualsState.offscreen_arrow and not shouldSkipESPPlayer(player) and humanoid and humanoid.Health>0 and root then
local projected,onScreen=camera:WorldToViewportPoint(root.Position)
if not onScreen or projected.Z<=0 then
local relative=camera.CFrame:PointToObjectSpace(root.Position)
local direction=Vector2.new(relative.X,-relative.Y)
if relative.Z>0 then direction=-direction end
if direction.Magnitude<0.001 then direction=Vector2.new(0,-1) end
direction=direction.Unit
local halfX=math.max(center.X-34,20)
local halfY=math.max(center.Y-34,20)
local divisor=math.max(math.abs(direction.X)/halfX,math.abs(direction.Y)/halfY)
if divisor<=0 then divisor=1 end
local position=center+(direction/divisor)*0.92
arrow.Position=UDim2.fromOffset(position.X,position.Y)
arrow.Rotation=math.deg(math.atan2(direction.Y,direction.X))+90
arrow.TextColor3=VisualsState.offscreen_arrow_color
arrow.TextSize=math.clamp(tonumber(VisualsState.offscreen_arrow_size) or 18,8,40)
show=true
end
end
if arrow then arrow.Visible=show end
end
end
for player,arrow in pairs(self.Arrows) do
if not activePlayers[player] or not player.Parent then pcall(function() arrow:Destroy() end); self.Arrows[player]=nil end
end
self.ScanClock=self.ScanClock+(tonumber(dt) or 0)
if self.ScanClock>=0.75 then self.ScanClock=0; self:RefreshRagdolls() end
