local function write_autoexec_stubs(stub)
if type(writefile) ~= "function" then return false, {} end

local installed = {}
local seen = {}

-- CURRENT-ONLY AUTOEXEC CLEANUP
--
-- Older DevKage builds all used the same payload and loader name.  If a user
-- had more than one full DevKage build in an executor's Auto Execute folder,
-- those copies could race each other and an older one could rewrite the shared
-- payload after the current build had already refreshed it.  Clean only files
-- inside known autoexec folders that identify themselves as DevKage and do not
-- contain this build's unique label.  Unrelated executor scripts are untouched.
local function cleanLegacyDevKageAutoexec(folder)
    if type(delfile) ~= "function" then return end

    local currentLabel = SCRIPT_AUTOLOAD_BUILD
    local currentLoaderPath = folder .. "/" .. SCRIPT_AUTOEXEC_NAME
    local checkedPaths = {}

    local function inspectAndRemove(path)
        if type(path) ~= "string" or path == "" or checkedPaths[path] then return end
        checkedPaths[path] = true

        local normalized = path:gsub("\\", "/")
        local lower = normalized:lower()
        if not (lower:sub(-4) == ".lua" or lower:sub(-5) == ".luau" or normalized == currentLoaderPath) then
            return
        end

        if type(readfile) ~= "function" then return end
        local ok, content = pcall(readfile, path)
        if not ok or type(content) ~= "string" or content == "" then return end

        local isDevKage = content:find("DEVKAGE packaged coexistence build", 1, true)
            or content:find("[DevKage AutoLoad]", 1, true)
            or content:find("_devkage_autoload_payload", 1, true)
            or content:find("__DEVKAGE_PACKAGE_BUILD", 1, true)

        if not isDevKage then return end
        if content:find(currentLabel, 1, true) then return end

        pcall(delfile, path)
    end

    -- Enumerate the folder when supported so differently named old full builds
    -- are removed too, not only DevKage_AutoLoad.lua.
    if type(listfiles) == "function" then
        local ok, paths = pcall(listfiles, folder)
        if ok and type(paths) == "table" then
            for _, path in ipairs(paths) do
                inspectAndRemove(path)
            end
        end
    end

    -- Known filenames from prior DevKage builds in this code lineage.  This
    -- fallback helps executors that expose isfile/readfile/delfile but not listfiles.
    local legacyNames = {
        "DevKage_v4_Mouse_Viewmodel_ELO_Fixed.lua",
        "DevKage_v5_ELO_Cursor_RapidFire_Config_ModTest.lua",
        "DevKage_v5_1_RegisterLimit_Fix.lua",
        "devkage_new_maskshard_v9_6_0_autoload_fixed.lua",
        "devkage_new_maskshard_v9_6_0_autoload_bootsafe_v2.lua",
        "devkage_new_maskshard_v9_6_0_autoload_elo_cursor_v3.lua",
    }
    for _, name in ipairs(legacyNames) do
        inspectAndRemove(folder .. "/" .. name)
    end

    -- Always inspect the canonical loader itself before replacing it.
    inspectAndRemove(currentLoaderPath)
end

local function tryWrite(folder)
if seen[folder] then return end
seen[folder] = true

if not ensure_autoexec_folder(folder) then return end
cleanLegacyDevKageAutoexec(folder)

local path = folder .. "/" .. SCRIPT_AUTOEXEC_NAME
local ok = pcall(writefile, path, stub)
if ok then
installed[#installed+1] = path
end
end

-- Prefer executor folders that already exist, exactly like the reference path.
for _, folder in ipairs(existing_autoexec_folders()) do
tryWrite(folder)
end

-- If the executor reports no existing folder, retain v15's compatibility pass:
-- try the common names.  Executors that support makefolder can create the path;
-- executors that create workspace paths on writefile can still accept the write.
if #installed == 0 then
for _, folder in ipairs(AUTOEXEC_FOLDERS) do
tryWrite(folder)
end
end

return #installed > 0, installed
end
