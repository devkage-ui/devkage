    local function replacePlain(source, needle, replacement)
        source = tostring(source or "")
        needle = tostring(needle or "")
        replacement = tostring(replacement or "")
        if needle == "" or needle == replacement then return source, false end

        local changed = false
        local out = {}
        local startIndex = 1
        while true do
            local s, e = string.find(source, needle, startIndex, true)
            if not s then
                out[#out + 1] = string.sub(source, startIndex)
                break
            end
            changed = true
            out[#out + 1] = string.sub(source, startIndex, s - 1)
            out[#out + 1] = replacement
            startIndex = e + 1
        end
        return table.concat(out), changed
    end

    local function replaceIdentityText(source)
        local text = tostring(source or "")
        local changedAny = false

        local nextText, changed = replacePlain(text, "@" .. privacy.OriginalName, "@" .. privacy.SpoofName)
        text = nextText
        changedAny = changedAny or changed

        if privacy.OriginalDisplayName ~= privacy.OriginalName then
            nextText, changed = replacePlain(text, privacy.OriginalDisplayName, privacy.SpoofDisplayName)
            text = nextText
            changedAny = changedAny or changed
        end

        nextText, changed = replacePlain(text, privacy.OriginalName, privacy.SpoofName)
        text = nextText
        changedAny = changedAny or changed

        return text, changedAny
    end

