    for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
        local world=cf:PointToWorldSpace(Vector3.new(half.X*x,half.Y*y,half.Z*z))
        local p=camera:WorldToViewportPoint(world)
        if p.Z>0.05 then
            count=count+1; minX=math.min(minX,p.X); maxX=math.max(maxX,p.X); minY=math.min(minY,p.Y); maxY=math.max(maxY,p.Y)
