function ELOAutoLoadRuntime:ApplyOnce(forcePresentation)
    local config = getgenv().__DevKageConfig
    if type(config) ~= "table" then return false end

    local persistedEnabled = SpooferState.savedELOAutoLoad == true
    if config.eloLiveSyncAutoLoad ~= true and not persistedEnabled then return false end



