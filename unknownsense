    local ok, err = pcall(function()
        local players = game:GetService("Players")
        local workspaceService = game:GetService("Workspace")

        if not game:IsLoaded() then
            game.Loaded:Wait()
        end

        local readyDeadline = os.clock() + 20
        while not players.LocalPlayer and os.clock() < readyDeadline do
            task.wait(0.1)
        end
        local localPlayer = players.LocalPlayer
        if not localPlayer then
            error("LocalPlayer unavailable after readiness timeout")
        end

        while not localPlayer:FindFirstChildOfClass("PlayerGui") and os.clock() < readyDeadline do
            task.wait(0.1)
        end
        while not workspaceService.CurrentCamera and os.clock() < readyDeadline do
            task.wait(0.1)
        end

        __devkageEnv.__DEVKAGE_LATE_BOOT_WAITING = true

        -- The other autoexec normally needs roughly 5-7 seconds. 8.5 seconds
        -- gives it headroom while keeping DevKage responsive.
        local lateDelay = tonumber(rawget(__devkageEnv, "__DEVKAGE_LATE_BOOT_DELAY")) or 8.5
        if lateDelay < 7.5 then lateDelay = 7.5 end
        warn(string.format("[DevKage LateBoot] waiting %.1fs for other autoexec", lateDelay))
        task.wait(lateDelay)

        __devkageEnv.__DEVKAGE_LATE_BOOT_WAITING = nil

        local jobId = tostring(game.JobId or "")
        local jobKey = tostring(game.PlaceId) .. ":" .. (jobId ~= "" and jobId or "current")

        -- Claim ownership only AFTER the grace period. This is the key behavior
        -- from the working LateBoot design.
        if __devkageEnv.__DEVKAGE_AUTO_STARTING_JOB == jobKey then
            local lockBuild = tostring(__devkageEnv.__DEVKAGE_AUTOLOAD_RUNNING_BUILD or "")
            local lockAt = tonumber(__devkageEnv.__DEVKAGE_AUTO_STARTING_AT) or 0
            if lockBuild == tostring(__devkageEnv.__DEVKAGE_PACKAGE_BUILD)
                and lockAt > 0 and (os.clock() - lockAt) < 45 then
                return
            end
            __devkageEnv.__DEVKAGE_AUTO_STARTING_JOB = nil
            __devkageEnv.__DEVKAGE_AUTOLOAD_RUNNING_BUILD = nil
            __devkageEnv.__DEVKAGE_AUTO_STARTING_AT = nil
        end

        if __devkageEnv.__DEVKAGE_AUTO_STARTED_JOB == jobKey
            and __devkageEnv.__DEVKAGE_AUTOLOADED_BUILD == __devkageEnv.__DEVKAGE_PACKAGE_BUILD then
            return
        end

        __devkageEnv.__DEVKAGE_AUTO_STARTING_JOB = jobKey
        __devkageEnv.__DEVKAGE_AUTOLOAD_RUNNING_BUILD = __devkageEnv.__DEVKAGE_PACKAGE_BUILD
        __devkageEnv.__DEVKAGE_AUTO_STARTING_AT = os.clock()

