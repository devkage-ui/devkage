local function referenceResolveGuiHost()
    -- The supplied cursor used PlayerGui. DevKage's menu is in CoreGui,
    -- though, so to make this exact cursor remain visible ON TOP of the
    -- DevKage menu we first use the same CoreGui host as the menu.
    --
    -- This changes only layering, not the cursor's geometry or animation.
    if cre then
        return cre
    end

    if LocalPlayer then
        return
            LocalPlayer:FindFirstChildOfClass("PlayerGui")
            or LocalPlayer:WaitForChild("PlayerGui", 8)
    end

    return nil
end

local function referenceCreateCursorGui()
    local runtime =
        ReferenceCursorRuntime

    referenceDestroyCursorGui()

    local host =
        referenceResolveGuiHost()

    if not host then
        return false
    end

    local screenGui =
        Instance.new("ScreenGui")

    -- Keep the original cursor GUI name.
    screenGui.Name = "AimSightGUI"

    screenGui.ResetOnSpawn = false

    -- DevKage's menu ScreenGui uses DisplayOrder 9999. This higher order is
    -- what makes the supplied cursor visible directly on the mouse while the
    -- DevKage UI itself is open.
    screenGui.DisplayOrder = 1000000

    screenGui.IgnoreGuiInset = true

    screenGui.ZIndexBehavior =
        Enum.ZIndexBehavior.Global

    pcall(function()
        screenGui:SetAttribute(
            "DevKageCursorProtocol",
            runtime.Protocol
        )

        screenGui:SetAttribute(
            "DevKageCursorOwner",
            runtime.InstanceId
        )

        screenGui:SetAttribute(
            "DevKageMaskShardCompatibilityOnly",
            true
        )
    end)

    local parentOk =
        pcall(function()
            screenGui.Parent = host
        end)

    if not parentOk
        or screenGui.Parent == nil then

        pcall(function()
            screenGui:Destroy()
        end)

        return false
    end

    local aimContainer =
        Instance.new("Frame")

    aimContainer.Name = "AimContainer"

    aimContainer.BackgroundTransparency = 1

    -- EXACT source-cursor default container dimensions.
    aimContainer.Size =
        UDim2.new(
            0,
            25,
            0,
            25
        )

    aimContainer.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    aimContainer.Active = false
    aimContainer.Selectable = false
    aimContainer.ZIndex = 5
    aimContainer.Parent = screenGui

    runtime.ScreenGui = screenGui
    runtime.AimContainer = aimContainer
    runtime.Host = host

    runtime.Lines = {
        referenceCreateLine(
            aimContainer,
            "Top"
        ),
        referenceCreateLine(
            aimContainer,
            "Bottom"
        ),
        referenceCreateLine(
            aimContainer,
            "Left"
        ),
        referenceCreateLine(
            aimContainer,
            "Right"
        ),
    }

    runtime.MainText,
    runtime.MainTextStroke =
        referenceCreateTextLabel(
            screenGui,
            "MainText"
        )

    runtime.SecondText,
    runtime.SecondTextStroke =
        referenceCreateTextLabel(
            screenGui,
            "SecondText"
        )

    runtime.SecondText.Visible = false

    return true
end

-- ============================================================
-- REFERENCE FOUR-ARM LAYOUT
-- ============================================================

local function referenceApplyFourArmLayout(
    settings,
    currentLength,
    lineThickness
)
    local runtime =
        ReferenceCursorRuntime

    local lines =
        runtime.Lines

    if #lines < 4 then return end

    local top =
        lines[1].Frame

    local bottom =
        lines[2].Frame

    local left =
        lines[3].Frame

    local right =
        lines[4].Frame

    for index = 1, 4 do
        local line =
            lines[index]

        line.Frame.Visible = true

        line.Frame.AnchorPoint =
            Vector2.new(
                0,
                0
            )

        line.Frame.Rotation = 0

        line.Stroke.Enabled = true
        line.Stroke.Thickness = 1
        line.Stroke.Color =
            Color3.new(
                0,
                0,
                0
            )
    end

    -- These four formulas are the supplied cursor's original pulse layout.
    top.Size =
        UDim2.new(
            0,
            lineThickness,
            0,
            currentLength
        )

    bottom.Size =
        UDim2.new(
            0,
            lineThickness,
            0,
            currentLength
        )

    left.Size =
        UDim2.new(
            0,
            currentLength,
            0,
            lineThickness
        )

    right.Size =
        UDim2.new(
            0,
            currentLength,
            0,
            lineThickness
        )

    top.Position =
        UDim2.new(
            0.5,
            -lineThickness / 2,
            0,
            0
        )

    bottom.Position =
        UDim2.new(
            0.5,
            -lineThickness / 2,
            1,
            -currentLength
        )

    left.Position =
        UDim2.new(
            0,
            0,
            0.5,
            -lineThickness / 2
        )

    right.Position =
        UDim2.new(
            1,
            -currentLength,
            0.5,
            -lineThickness / 2
        )
end

-- ============================================================
-- OPTIONAL EXTRA-ARM SUPPORT
--
-- The source cursor itself had four arms. The existing DevKage Cursor tab
-- already exposes Arm Count, so counts other than four are supported without
-- changing the exact four-arm default.
-- ============================================================

local function referenceEnsureExtraArmCount(count)
    local runtime =
        ReferenceCursorRuntime

    count =
        math.floor(
            referenceCursorNumber(
                count,
                4,
                1,
                12
            ) + 0.5
        )

    while #runtime.Lines < count do
        runtime.Lines[
            #runtime.Lines + 1
        ] =
            referenceCreateLine(
                runtime.AimContainer,
                "Arm_"
                .. tostring(
                    #runtime.Lines + 1
                )
            )
    end

    return count
end

local function referenceApplyRadialLayout(
    settings,
    currentLength,
    lineThickness,
    armCount
)
    local runtime =
        ReferenceCursorRuntime

    local length =
        math.max(
            1,
            math.abs(currentLength)
        )

    local centerRadius =
        referenceCursorNumber(
            settings.CenterRadius,
            12.5,
            0,
            60
        )

    local squashX =
        referenceCursorNumber(
            settings.SquashX,
            1,
            0.25,
            2
        )

    local squashY =
        referenceCursorNumber(
            settings.SquashY,
            1,
            0.25,
            2
        )

    for index, line in ipairs(runtime.Lines) do
        local visible =
            index <= armCount

        line.Frame.Visible = visible

        if visible then
            local angle =
                ((index - 1) / armCount)
                * 360

            local radians =
                math.rad(angle)

            local x =
                math.sin(radians)
                * centerRadius
                * squashX

            local y =
                -math.cos(radians)
                * centerRadius
                * squashY

            line.Frame.AnchorPoint =
                Vector2.new(
                    0.5,
                    1
                )

            line.Frame.Size =
                UDim2.fromOffset(
                    lineThickness,
                    length
                )

            line.Frame.Position =
                UDim2.new(
                    0.5,
                    x,
                    0.5,
                    y
                )

            line.Frame.Rotation =
                angle

            line.Stroke.Enabled = true
            line.Stroke.Thickness = 1
        end
    end
end

-- ============================================================
-- GLOW
-- ============================================================

local function referenceCopyFrameGeometry(source, target)
    target.AnchorPoint =
        source.AnchorPoint

    target.Position =
        source.Position

    target.Rotation =
        source.Rotation
end

local function referenceApplyGlow(
    settings,
    line,
    color,
    isHorizontalOrVerticalReference
)
    local glow =
        line.Glow

    if settings.LineGlow ~= true
        or not line.Frame.Visible then

        glow.Visible = false
        return
    end

    local glowThickness =
        referenceCursorNumber(
            settings.GlowThickness,
            30,
            0,
            50
        )

    local glowExtraLength =
        referenceCursorNumber(
            settings.GlowExtraLength,
            15,
            0,
            50
        )

    local glowTransparency =
        referenceCursorNumber(
            settings.GlowTransparency,
            0.43,
            0,
            1
        )

    referenceCopyFrameGeometry(
        line.Frame,
        glow
    )

    local sourceSize =
        line.Frame.AbsoluteSize

    if sourceSize.X >= sourceSize.Y then
        glow.Size =
            UDim2.fromOffset(
                math.max(
                    1,
                    sourceSize.X
                    + glowExtraLength
                ),
                math.max(
                    1,
                    sourceSize.Y
                    + glowThickness
                )
            )
    else
        glow.Size =
            UDim2.fromOffset(
                math.max(
                    1,
                    sourceSize.X
                    + glowThickness
                ),
                math.max(
                    1,
                    sourceSize.Y
                    + glowExtraLength
                )
            )
    end

    glow.BackgroundColor3 = color

    glow.BackgroundTransparency =
        glowTransparency

    glow.Visible = true
end

