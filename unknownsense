local function auraColorFromConfig(value, fallback)
if typeof(value) == "Color3" then
return value
end
if type(value) == "table" then
return Color3.fromRGB(
math.clamp(tonumber(value[1]) or fallback.R * 255, 0, 255),
math.clamp(tonumber(value[2]) or fallback.G * 255, 0, 255),
math.clamp(tonumber(value[3]) or fallback.B * 255, 0, 255)
)
end
return fallback
end

