function SpoofRankRuntime.Normalize(value)
local wanted=tostring(value or "Use Spoofed ELO"):lower():gsub("[%s_%-]","")
if wanted=="auto" or wanted=="auto(elo)" or wanted=="usespoofedelo" then return "Use Spoofed ELO" end
if wanted=="archnem" or wanted=="archnemesis" or wanted=="archnemisis" then return "Archnemesis" end
local legacy={bronzei="Bronze 1",bronzeii="Bronze 2",bronzeiii="Bronze 3",silveri="Silver 1",silverii="Silver 2",silveriii="Silver 3",goldi="Gold 1",goldii="Gold 2",goldiii="Gold 3",platinumi="Platinum 1",platinumii="Platinum 2",platinumiii="Platinum 3",diamondi="Diamond 1",diamondii="Diamond 2",diamondiii="Diamond 3",onyxi="Onyx 1",onyxii="Onyx 2",onyxiii="Onyx 3"}
if legacy[wanted] then return legacy[wanted] end
for _,option in ipairs(SpoofRankRuntime.Options) do
if option:lower():gsub("[%s_%-]","")==wanted then return option end
end
return "Use Spoofed ELO"
end

function SpoofRankRuntime.IsArch(rank)
return SpoofRankRuntime.Normalize(rank)=="Archnemesis"
end

function SpoofRankRuntime.ArchDivision(config)
return math.clamp(math.floor((tonumber(config and config.archRank) or 1)+0.5),1,100)
end

function SpoofRankRuntime.Resolve(config)
config=type(config)=="table" and config or getgenv().__DevKageConfig
local selected=SpoofRankRuntime.Normalize(config.rankDisplay)
if selected~="Use Spoofed ELO" then return selected end
local elo=normalizeSpoofELO(config.elo)
local cutoff=math.clamp(normalizeSpoofELO(config.archNemesisCutoff or 3601),3601,9999999)
if elo>=cutoff then return "Archnemesis" end
local rank="Bronze 1"
for _,entry in ipairs(SpoofRankRuntime.Ladder) do
if elo>=entry[1] then rank=entry[2] else break end
end
return rank
end

function SpoofRankRuntime.ELOFor(rank,config)
rank=SpoofRankRuntime.Normalize(rank)
if rank=="Use Spoofed ELO" then return normalizeSpoofELO(config and config.elo) end
return SpoofRankRuntime.RankELO[rank] or normalizeSpoofELO(config and config.elo)
end

function SpoofRankRuntime.SeasonAllowed(config,season)
if type(config)~="table" or config.charmSpoofEnabled==false then return false end
local index=SpoofRankRuntime.SeasonNames[season]
if index==nil then index=tonumber(tostring(season or ""):match("%d+")) end
if index==nil or index<0 or index>3 then return true end
return config["charmSeason"..tostring(index)]~=false
end

