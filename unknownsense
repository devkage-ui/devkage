            "Feet",
            footOffset(root,humanoid),
            2,
            1.22
        )
    end

    local function build(character)
        clearVisuals()
        if cfg().avatarModsEnabled ~= true or not character or not character.Parent then return end

        local token = state.buildToken + 1
        state.buildToken = token

        local root = character:FindFirstChild("HumanoidRootPart")
            or character:WaitForChild("HumanoidRootPart",8)
        local torso = character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:WaitForChild("UpperTorso",2)
            or character:FindFirstChild("Torso")
        local head = character:FindFirstChild("Head") or character:WaitForChild("Head",5)
        local humanoid = character:FindFirstChildOfClass("Humanoid")

        if token ~= state.buildToken or not root or not torso or not character.Parent then return end
        state.character = character

        local old = character:FindFirstChild("AngelWings")
        if old and old:GetAttribute("DevKageAvatarMods") == true then safeDestroy(old) end

        local model = Instance.new("Model")
        model.Name = "AngelWings"
        model:SetAttribute("DevKageAvatarMods",true)
        model:SetAttribute("DevKageAvatarRenderer","RealisticV2")
        model.Parent = character
        state.model = model
        remember(model)

        local preset = normalizedType()
        if preset == "Angel Wings" then
            createWings(character,torso)
        elseif preset == "Head Halo" then
            if head then createHeadHalo(head) end
        elseif preset == "Feet Halo" then
            createFeetHalo(root,humanoid)
        elseif preset == "Head + Feet Halos" then
            if head then createHeadHalo(head) end
            createFeetHalo(root,humanoid)
        else
            createWings(character,torso)
            if head then createHeadHalo(head) end
            createFeetHalo(root,humanoid)
        end

        local elapsed = 0
        state.renderConnection = RunServiceService.RenderStepped:Connect(function(dt)
            if token ~= state.buildToken
                or state.character ~= character
                or cfg().avatarModsEnabled ~= true
                or not character.Parent then
                return
            end

            local interval = tostring(cfg().avatarModsQuality or "High") == "Performance"
                and (1/30) or (1/60)
            elapsed = elapsed + (tonumber(dt) or 0)
            if elapsed < interval then return end
            elapsed = math.max(0,elapsed - interval)

            local now = os.clock()
            local speed = animationSpeed()
            local amplitude,motionRate = motionProfile()
            local pulse = math.clamp(tonumber(cfg().avatarModsPulse) or 0.18,0,0.75)
            local wave = (math.sin(now * 1.7 * speed) + 1) * 0.5
            local brightnessScale = 1 + (wave - 0.5) * pulse
            local alpha = transparency()

            -- Four animated joints total; all feathers follow their bones.
            for _,rig in ipairs(state.wingRigs) do
                local side = rig.Side
                if rig.RootMotor and rig.RootMotor.Parent then
                    if rig.Pair then
                        -- Real accessory mesh: subtle living motion without
                        -- rotating the entire wing pair sideways.
                        local breathe=math.sin(now*1.35*speed)*0.5+0.5
                        local roll=math.sin(now*1.8*speed*motionRate)*math.rad(1.25)*amplitude
                        rig.RootMotor.Transform=CFrame.Angles(
                            math.rad((-0.75+1.5*breathe)*amplitude),
                            0,
                            roll
                        )
                    else
                        local flap = math.sin(now * 2.55 * speed * motionRate + (side < 0 and 0 or 0.06))
                        local breathe = math.sin(now * 1.15 * speed + 0.7) * 0.18
                        rig.RootMotor.Transform = CFrame.Angles(
                            math.rad((-1.8 + 2.2 * wave) * amplitude),
                            0,
                            math.rad((6.5 * flap + 2.0 * breathe) * amplitude) * -side
                        )
                    end
                end
                if rig.OuterMotor and rig.OuterMotor.Parent then
                    local fold = math.sin(now * 2.55 * speed * motionRate + 0.48)
                    rig.OuterMotor.Transform = CFrame.Angles(
                        0,
                        math.rad((2.0 + 1.8 * wave) * amplitude * side),
                        math.rad((4.2 * fold - 1.5) * amplitude) * -side
                    )
                end
            end

            for _,rig in ipairs(state.haloRigs) do
                if rig.Motor and rig.Motor.Parent then
                    local bob = math.sin(now * 1.45 * speed + rig.Ring * 0.9) * 0.035 * amplitude
                    local spin = math.rad((now * 16 * speed * motionRate) % 360)
                    rig.Motor.Transform = CFrame.new(0,bob,0) * CFrame.Angles(0,spin,0)
                end
            end

            for i,entry in ipairs(state.feathers) do
                local feather = entry.Part
                if feather and feather.Parent then
                    local base = entry.Tip and secondaryColor() or primaryColor()
                    feather.Color = rainbowColor(now,i,base)
                    feather.Transparency = alpha
                    feather.Material = featherMaterial()
                    if entry.Shaft and entry.Shaft.Parent then
                        local c = feather.Color
                        entry.Shaft.Color = Color3.new(
                            math.min(1,c.R * 0.84 + 0.12),
                            math.min(1,c.G * 0.84 + 0.12),
                            math.min(1,c.B * 0.84 + 0.12)
                        )
                        entry.Shaft.Transparency = math.clamp(alpha + 0.08,0,0.95)
                    end
                end
            end

            for i,entry in ipairs(state.haloSegments) do
                local segment = entry.Part
                if segment and segment.Parent then
                    local base = entry.Ring == 2 and secondaryColor() or primaryColor()
                    segment.Color = rainbowColor(now,i + entry.Ring * 17,base)
                    segment.Transparency = alpha
                end
            end

            for i,entry in ipairs(state.haloSurfaces) do
                local base=entry.Ring==2 and secondaryColor() or primaryColor()
                local color=rainbowColor(now,i+entry.Ring*19,base)
                if entry.Core and entry.Core.Parent then
                    entry.Core.Color=color
                    entry.Core.Transparency=alpha
                    entry.Core.Thickness=math.clamp(7+glowBrightness()*0.8,7,16)
                end
                if entry.Glow and entry.Glow.Parent then
                    entry.Glow.Color=color
                    entry.Glow.Thickness=math.clamp(18+glowSize()*0.65,18,50)
                    entry.Glow.Transparency=math.clamp(
                        0.82-(glowBrightness()/18),
                        0.28,
                        0.82
                    )
                end
            end

            for i,highlight in ipairs(state.wingHighlights) do
                if highlight and highlight.Parent then
                    highlight.FillColor=rainbowColor(now,i+31,primaryColor())
                    highlight.FillTransparency=math.clamp(0.90-glowBrightness()*0.018,0.68,0.90)
                end
            end

            for _,entry in ipairs(state.lights) do
                local light = entry.Light
                if light and light.Parent then
                    local base = entry.Index % 2 == 0 and secondaryColor() or primaryColor()
                    light.Color = rainbowColor(now,entry.Index,base)
                    light.Brightness = glowBrightness() * entry.Scale * brightnessScale
                    light.Range = glowSize()
                end
            end

            for _,entry in ipairs(state.trails) do
                local trail = entry.Trail
                if trail and trail.Parent then
                    trail.Color = ColorSequence.new(
                        rainbowColor(now,entry.Index,primaryColor()),
                        rainbowColor(now,entry.Index + 7,secondaryColor())
                    )
                    trail.Enabled = cfg().avatarModsTrails ~= false
                end
            end

            for _,entry in ipairs(state.emitters) do
                local emitter = entry.Emitter
                if emitter and emitter.Parent then
                    emitter.Color = ColorSequence.new(
                        rainbowColor(now,entry.Index,primaryColor()),
                        rainbowColor(now,entry.Index + 5,secondaryColor())
                    )
                    emitter.Enabled = cfg().avatarModsParticles ~= false
                    emitter.Rate = entry.Rate * (0.88 + wave * 0.24)
                end
            end
        end)
    end

    function API:Refresh()
        state.refreshToken = state.refreshToken + 1
        local refreshToken = state.refreshToken
        task.delay(0.08,function()
            if refreshToken ~= state.refreshToken then return end
            if cfg().avatarModsEnabled ~= true then
                clearVisuals()
                return
            end
            local character = player.Character
            if character and character.Parent then build(character) end
        end)
    end

    function API:SetEnabled(value)
        cfg().avatarModsEnabled = value == true
        if value then self:Refresh() else clearVisuals() end
    end

    function API:Destroy()
        state.refreshToken = state.refreshToken + 1
        clearVisuals()
        if state.characterConnection then
            pcall(function() state.characterConnection:Disconnect() end)
            state.characterConnection = nil
        end
    end

    state.characterConnection = player.CharacterAdded:Connect(function(character)
        if cfg().avatarModsEnabled == true then
            task.delay(0.18,function()
                if character.Parent and cfg().avatarModsEnabled == true then build(character) end
            end)
        end
    end)

    if cfg().avatarModsEnabled == true then
        task.defer(function() API:Refresh() end)
    end

    return API
end)()
end

