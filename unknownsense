if humanoid.Health/math.max(humanoid.MaxHealth,1)<=threshold then table.insert(flags,"LOW") end
end
if VisualsState.esp_velocity_flag and root then
local speed=root.AssemblyLinearVelocity.Magnitude
table.insert(flags,string.format("%.0f s/s",speed))
end
if VisualsState.esp_user_id_flag then table.insert(flags,"ID:"..tostring(player.UserId)) end
if VisualsState.esp_spawn_protection_flag and character and character:FindFirstChildOfClass("ForceField") then table.insert(flags,"SPAWN") end
if VisualsState.esp_target_warning and root then
local camera=workspace.CurrentCamera
if camera then
local screen,onScreen=camera:WorldToViewportPoint(root.Position)
if onScreen and screen.Z>0 then
local mouse=uis:GetMouseLocation()
local radius=math.clamp(tonumber(getgenv().__DevKageConfig.aimFOV) or 90,10,1000)
