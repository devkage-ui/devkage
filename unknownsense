local function combatRemoteName(name)
local lower=tostring(name or ""):lower()
return lower:find("kill",1,true)~=nil
or lower:find("elim",1,true)~=nil
or lower:find("combat",1,true)~=nil
or lower:find("death",1,true)~=nil
or lower:find("frag",1,true)~=nil
or lower:find("feed",1,true)~=nil
end

local function combatPayloadCreditsLocal(...)
local packed=table.pack(...)
local state={credited=false,localPosition=nil,otherPlayerPosition=nil,visited=setmetatable({}, {__mode="k"})}
local creditKeys={killer=true,attacker=true,creator=true,source=true,owner=true,winner=true,eliminator=true,lastHitBy=true,last_hit_by=true}
local function isLocalValue(value)
if typeof(value)=="Instance" then
return value==LocalPlayer or (value:IsA("Player") and value.UserId==LocalPlayer.UserId)
end
if type(value)=="number" then return value==LocalPlayer.UserId end
if type(value)=="string" then
local lower=value:lower()
return lower==tostring(LocalPlayer.Name):lower()
or lower==tostring(LocalPlayer.DisplayName):lower()
or tonumber(value)==LocalPlayer.UserId
end
return false
end
local function scan(value,key,depth,position)
if state.credited or depth>3 then return end
local valueType=typeof(value)
if creditKeys[tostring(key or "")] and isLocalValue(value) then state.credited=true; return end
if isLocalValue(value) and not state.localPosition then state.localPosition=position end
if valueType=="Instance" and value:IsA("Player") and value~=LocalPlayer and not state.otherPlayerPosition then state.otherPlayerPosition=position end
if type(value)=="string" and combatTextCreditsLocal(value) then state.credited=true; return end
if type(value)=="table" and not state.visited[value] then
state.visited[value]=true
for childKey,childValue in pairs(value) do scan(childValue,childKey,depth+1,position) end
end
end
for index=1,packed.n do scan(packed[index],nil,0,index) end
if not state.credited and state.localPosition and state.otherPlayerPosition and state.localPosition<state.otherPlayerPosition then
state.credited=true
end
return state.credited
end

