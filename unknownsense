local ChinaHatState = {
connection = nil,
rainbowConnection = nil,
character = nil,
hat = nil,
light = nil,
mesh = nil
}

local function chinaHatColorFromConfig(value, fallback)
if typeof(value) == "Color3" then
return value
end
if type(value) == "table" then
local r = tonumber(value[1])
local g = tonumber(value[2])
local b = tonumber(value[3])
if r and g and b then
return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
end
end
return fallback
end

local function chinaHatColorToConfig(color)
return {
math.floor(color.R * 255 + 0.5),
math.floor(color.G * 255 + 0.5),
math.floor(color.B * 255 + 0.5)
}
end

local function chinaHatScaleFromConfig(value)
if typeof(value) == "Vector3" then
return value
end
if type(value) == "table" then
return Vector3.new(
tonumber(value[1]) or 1.7,
tonumber(value[2]) or 1.1,
tonumber(value[3]) or 1.7
)
end
return Vector3.new(1.7, 1.1, 1.7)
end

local function chinaHatScaleToConfig(value)
return {value.X, value.Y, value.Z}
end

local function RemoveChinaHat()
if ChinaHatState.connection then
pcall(function() ChinaHatState.connection:Disconnect() end)
ChinaHatState.connection = nil
end
if ChinaHatState.rainbowConnection then
pcall(function() ChinaHatState.rainbowConnection:Disconnect() end)
ChinaHatState.rainbowConnection = nil
end
if ChinaHatState.hat then
pcall(function() ChinaHatState.hat:Destroy() end)
end
ChinaHatState.hat = nil
ChinaHatState.light = nil
ChinaHatState.mesh = nil
ChinaHatState.character = nil
end

local function UpdateChinaHatVisual(elapsed)
local config = getgenv().__DevKageConfig
local hat = ChinaHatState.hat
if not hat or not hat.Parent then return end

local primary = chinaHatColorFromConfig(config.chinaHatColor, Color3.fromRGB(255, 105, 180))
local secondary = chinaHatColorFromConfig(config.chinaHatSecondaryColor, Color3.fromRGB(255, 255, 255))
local pattern = tostring(config.chinaHatPattern or "Static")
local speed = math.max(tonumber(config.chinaHatSpeed) or 1, 0.05)
local color = primary

if pattern == "Rainbow" then
    local hue = (elapsed * 0.12 * speed) % 1
    color = Color3.fromHSV(hue, 1, 1)
elseif pattern == "Pulse" then
    local alpha = (math.sin(elapsed * math.pi * speed) + 1) * 0.5
    color = primary:Lerp(secondary, alpha)
elseif pattern == "Gradient" then
    local alpha = (math.sin(elapsed * 0.7 * speed) + 1) * 0.5
    color = primary:Lerp(secondary, alpha)
end

hat.Color = color
if ChinaHatState.light then
    ChinaHatState.light.Color = color
    ChinaHatState.light.Brightness = tonumber(config.chinaHatBrightness) or 0
    ChinaHatState.light.Range = tonumber(config.chinaHatRange) or 12
end
end

local function CreateChinaHat(character)
if not character then return end
local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 10)
if not head then return end

if ChinaHatState.hat and ChinaHatState.hat.Parent then
    pcall(function() ChinaHatState.hat:Destroy() end)
end

local config = getgenv().__DevKageConfig
local scale = chinaHatScaleFromConfig(config.chinaHatScale)
local initialColor = chinaHatColorFromConfig(config.chinaHatColor, Color3.fromRGB(255, 105, 180))

local cone = Instance.new("Part")
cone.Name = "ChineseManHat"
cone.Size = Vector3.new(1, 1, 1)
cone.Color = initialColor
cone.Material = Enum.Material.Neon
cone.Transparency = math.clamp(tonumber(config.chinaHatAlpha) or 0.2, 0, 1)
cone.Anchored = false
cone.CanCollide = false
cone.CanTouch = false
cone.CanQuery = false
cone.CastShadow = false

local mesh = Instance.new("SpecialMesh")
mesh.MeshType = Enum.MeshType.FileMesh
mesh.MeshId = "rbxassetid://1033714"
mesh.Scale = scale
mesh.Parent = cone

local weld = Instance.new("Weld")
weld.Part0 = head
weld.Part1 = cone
weld.C0 = CFrame.new(0, 0.9, 0)
weld.Parent = cone

local light = Instance.new("PointLight")
light.Color = initialColor
light.Brightness = tonumber(config.chinaHatBrightness) or 0
light.Range = tonumber(config.chinaHatRange) or 12
light.Shadows = true
light.Parent = cone

cone.Parent = character

ChinaHatState.character = character
ChinaHatState.hat = cone
ChinaHatState.mesh = mesh
ChinaHatState.light = light

UpdateChinaHatVisual(os.clock())
end

local function StartChinaHat()
local config = getgenv().__DevKageConfig
RemoveChinaHat()

if not config.chinaHatEnabled then
    return
end

local character = LocalPlayer.Character
if character then
    task.spawn(function()
        CreateChinaHat(character)
    end)
end

ChinaHatState.connection = LocalPlayer.CharacterAdded:Connect(function(character)
    if not getgenv().__DevKageConfig.chinaHatEnabled then return end
    task.wait(0.1)
    CreateChinaHat(character)
end)

ChinaHatState.rainbowConnection = RunService.RenderStepped:Connect(function()
    if not getgenv().__DevKageConfig.chinaHatEnabled then return end
    UpdateChinaHatVisual(os.clock())
end)
end

task.defer(function()
if getgenv().__DevKageConfig.chinaHatEnabled then
StartChinaHat()
end
end)

