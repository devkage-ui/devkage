local UA = {}
UA.equipped         = {}
UA.favorites        = {}
UA.constructingWeapon = nil
UA.saveFile         = "unlockall/config.json"

local function ua_isEnabled()
local environment = type(getgenv) == "function" and getgenv() or nil
local config = type(environment) == "table" and environment.__DevKageConfig or nil
return type(config) == "table" and config.unlockall == true
end

local function ua_isNotFinisher(name)
if not name then return false end
local lower = name:lower()
return not (lower:find("finisher") or lower:find("finish") or lower:find("execution"))
end

local function ua_cloneCosmetic(name, cosmeticType, options)
local CosmeticLibrary = ReplicatedStorage.Modules and ReplicatedStorage.Modules:FindFirstChild("CosmeticLibrary")
if not CosmeticLibrary then return nil end
local ok, lib = pcall(require, CosmeticLibrary)
if not ok or not lib then return nil end
local base = lib.Cosmetics and lib.Cosmetics[name]
if not base then return nil end
local data = {}
for key, value in pairs(base) do data[key] = value end
data.Name = name
data.Type = data.Type or cosmeticType
data.Seed = data.Seed or math.random(1, 1000000)
local EnumLib = ReplicatedStorage.Modules and ReplicatedStorage.Modules:FindFirstChild("EnumLibrary")
if EnumLib then
local eok, EnumLibrary = pcall(require, EnumLib)
if eok and EnumLibrary then
local suc, enumId = pcall(EnumLibrary.ToEnum, EnumLibrary, name)
if suc and enumId then data.Enum = enumId; data.ObjectID = data.ObjectID or enumId end
end
end
if options then
if options.inverted ~= nil then data.Inverted = options.inverted end
if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
end
return data
end

function UA.save()
if not writefile then return end
pcall(function()
local config = {equipped = {}, favorites = UA.favorites}
for weapon, cosmetics in pairs(UA.equipped) do
config.equipped[weapon] = {}
for cosmeticType, cosmeticData in pairs(cosmetics) do
if cosmeticData and cosmeticData.Name then
config.equipped[weapon][cosmeticType] = {
name    = cosmeticData.Name,
seed    = cosmeticData.Seed,
inverted= cosmeticData.Inverted
}
end
end
end
if not isfolder("unlockall") then makefolder("unlockall") end
writefile(UA.saveFile, HttpService:JSONEncode(config))
end)
end

function UA.load()
if not readfile or not isfile or not isfile(UA.saveFile) then return end
pcall(function()
local config = HttpService:JSONDecode(readfile(UA.saveFile))
if config.equipped then
for weapon, cosmetics in pairs(config.equipped) do
UA.equipped[weapon] = {}
for cosmeticType, cosmeticData in pairs(cosmetics) do
local cloned = ua_cloneCosmetic(cosmeticData.name, cosmeticType, {inverted=cosmeticData.inverted})
if cloned then
cloned.Seed = cosmeticData.seed
UA.equipped[weapon][cosmeticType] = cloned
end
end
end
end
UA.favorites = config.favorites or {}
end)
end

getgenv().__DevKageUnlockAllSave   = function() UA.save() end
getgenv().__DevKageUnlockAllLoad   = function() UA.load() end
