    function runtime:Normalize(name)
        if name=="Cloudy Moon" or name=="Cloud Ocean" then return name end
        name=tostring(name or ""):lower()
        for _,word in ipairs({"night","moon","star","galaxy","midnight","aurora","gloomy","storm"}) do
