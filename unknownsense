local base = RainbowAuraState.color
if RainbowAuraState.mode ~= "Rainbow" then
return base
end
local h, s, v = Color3.toHSV(base)
local hue = (h + elapsed * 0.12 * math.max(RainbowAuraState.speed, 0.01)) % 1
return Color3.fromHSV(hue, math.max(s, 0.85), math.clamp(v, 0.15, 1))
end

