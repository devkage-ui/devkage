-- AUTO LOAD FIX (reference-compatible)
--
-- The reference build writes the currently executing DevKage source directly to
-- the payload file and lets the executor autoexec/teleport queue read that file
-- on the next boot.  Keep that behavior here.  The old v15 build-marker files
-- are still accepted for compatibility, but they are no longer a hard gate that
-- can prevent a perfectly valid current payload from starting.
--
-- This section intentionally does not touch named-config serialization, feature
-- state, UI controls, Spoofer auto-load, or any runtime outside script auto-load.
local function normalize_script_autoload_source(source)
    if type(source) ~= "string" or source == "" then
        return nil
    end

    -- v15 previously stored a first-line build marker in the payload.  Strip it
    -- when using an old payload as the embedded source so future saves use the
    -- same raw-source format as the supplied reference autoload implementation.
    local markerPrefix = "-- DEVKAGE_AUTOLOAD_BUILD:"
    if source:sub(1, #markerPrefix) == markerPrefix then
        local newline = source:find("\n", 1, true)
        if newline then
            source = source:sub(newline + 1)
        end
    end

    if source == "" then
        return nil
    end

    return source
end

