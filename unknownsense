function HighQualityESPRuntime:SetEnabled(enabled)
    self.Enabled = enabled == true
    self.StartupReady = self.Enabled
    self.EnabledAt = self.Enabled and os.clock() or 0
    self.Cursor = 1
    if not self.Enabled then
        for _,obj in pairs(self.Players) do self:Hide(obj) end
    end
end

function HighQualityESPRuntime:Update()
    if not self.Enabled or not self.StartupReady or not VisualsState.high_quality_esp or not VisualsState.esp_enabled then
        for _,obj in pairs(self.Players) do self:Hide(obj) end
        return
    end

    local camera=workspace.CurrentCamera
    if not camera then return end
    local playersList=Players:GetPlayers()
    local count=#playersList
    if count<=1 then return end

    -- Never construct/update every player's ESP in one frame. During the first
    -- few seconds after enabling, process one player per tick; afterwards use
    -- a small fixed budget. Visual quality is unchanged, only work scheduling.
    local budget=(os.clock()-(self.EnabledAt or 0)<3) and 1 or 3
    local processed=0
    local attempts=0
    while processed<budget and attempts<count do
        if self.Cursor>count then self.Cursor=1 end
        local player=playersList[self.Cursor]
        self.Cursor=self.Cursor+1
        attempts=attempts+1
        if player and player~=LocalPlayer then
            self:UpdatePlayer(player,camera)
            processed=processed+1
        end
    end

    -- Cheap stale cleanup; no character projection involved.
    for player in pairs(self.Players) do
        if not player.Parent then self:Remove(player) end
    end
end

