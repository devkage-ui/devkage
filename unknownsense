local function loadPlayerBlacklist()
PlayerBlacklist = {}
if type(readfile)~="function" then return end
if type(isfile)=="function" then
local existsOk,exists=pcall(isfile,BLACKLIST_FILE)
if existsOk and not exists then return end
end
local readOk,raw=pcall(readfile,BLACKLIST_FILE)
if not readOk then return end
local ok,data=pcall(function() return HttpService:JSONDecode(raw) end)
if not ok or type(data)~="table" then return end
for userId,entry in pairs(data) do
local id=tostring((type(entry)=="table" and entry.userId) or userId)
if tonumber(id) then
PlayerBlacklist[id]=type(entry)=="table" and entry or {userId=tonumber(id),name=tostring(entry)}
end
end
end

local function savePlayerBlacklist()
local folderOk,folderError=ensure_folder()
if not folderOk then return false,folderError end
if type(writefile)~="function" then return false,"This executor does not provide file writing" end
local encodedOk,encoded=pcall(function() return HttpService:JSONEncode(PlayerBlacklist) end)
if not encodedOk then return false,tostring(encoded) end
local wrote,err=pcall(writefile,BLACKLIST_FILE,encoded)
return wrote,wrote and nil or tostring(err)
end

local function isPlayerBlacklisted(playerOrId)
local id=typeof(playerOrId)=="Instance" and playerOrId.UserId or playerOrId
return PlayerBlacklist[tostring(id)]~=nil
end

local function setPlayerBlacklisted(player,blocked,reason)
if not player then return false,"Select a player first" end
if player==LocalPlayer then return false,"You cannot blacklist yourself" end
local key=tostring(player.UserId)
local previous=PlayerBlacklist[key]
if blocked then
local cleanedReason=tostring(reason or ""):sub(1,180)
PlayerBlacklist[key]={
userId=player.UserId,
name=player.Name,
displayName=player.DisplayName,
reason=cleanedReason,
addedAt=(type(previous)=="table" and previous.addedAt) or os.time()
}
else
PlayerBlacklist[key]=nil
end
local saved,err=savePlayerBlacklist()
if not saved then PlayerBlacklist[key]=previous end
if rebuildServerPlayerList then rebuildServerPlayerList() end
if rebuildBlacklistList then rebuildBlacklistList() end
return saved,err
end

