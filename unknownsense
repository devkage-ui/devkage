local function rapidFireDelayPercent(weaponName)
    local config = getgenv().__DevKageConfig
    if type(config.rapidFireRates) ~= "table" then
        config.rapidFireRates = {}
    end

    local saved = tonumber(config.rapidFireRates[tostring(weaponName or "")])
    local fallback = tonumber(config.rapidFireDefaultRate) or 25




    local resolved = config.rapidFireEnabled == true and fallback or (saved or fallback)
    return math.clamp(math.floor(resolved + 0.5), 1, 100)
end

local function rapidFireScaledCooldown(originalValue, percent)
    originalValue = tonumber(originalValue)
    if not originalValue or originalValue <= 0 then
        return originalValue
    end

    percent = math.clamp(tonumber(percent) or 100, 1, 100)


    if percent >= 100 then
        return originalValue
    end




    return math.max(0.001, originalValue * (percent / 100))
end




