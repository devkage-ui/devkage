(function()
local Workspace = game:GetService("Workspace")

local Runtime = {
    Connections = {},
    TextureToken = 0,
    AvatarToken = 0,
    OriginalProperties = setmetatable({}, {__mode="k"}),
    OriginalAnimations = setmetatable({}, {__mode="k"}),
    Textures = {},
}

local function rememberProperty(instance, property)
    if not instance then return end
    local bucket = Runtime.OriginalProperties[instance]
    if not bucket then
        bucket = {}
        Runtime.OriginalProperties[instance] = bucket
    end
    if bucket[property] == nil then
        local ok, value = pcall(function() return instance[property] end)
        if ok then bucket[property] = value end
    end
end

local function setRemembered(instance, property, value)
    if not instance then return false end
    rememberProperty(instance, property)
    return pcall(function() instance[property] = value end)
end

local function setLocalHidden(part, hidden)
    if not part or not part:IsA("BasePart") then return end
    setRemembered(part, "Transparency", hidden and 1 or 0)
    pcall(function()
        rememberProperty(part, "LocalTransparencyModifier")
        part.LocalTransparencyModifier = hidden and 1 or 0
    end)
end

local function restoreAvatarProperties()
    for instance, properties in pairs(Runtime.OriginalProperties) do
        if instance and instance.Parent then
            for property, value in pairs(properties) do
                pcall(function() instance[property] = value end)
            end
        end
    end
    table.clear(Runtime.OriginalProperties)

    for animation, animationId in pairs(Runtime.OriginalAnimations) do
        if animation and animation.Parent then
            pcall(function() animation.AnimationId = animationId end)
        end
    end
    table.clear(Runtime.OriginalAnimations)
end

local function isCharacterPart(part)
    local model = part and part:FindFirstAncestorOfClass("Model")
    return model and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local MINECRAFT_TEXTURE = "rbxassetid://1876545003"
local TEXTURE_NAME = "DevKageMinecraftTexture"

local function partIsWhite(part)
    local c = part.Color
    return c.R >= 0.82 and c.G >= 0.82 and c.B >= 0.82
end

local function clearWorldTextures()
    Runtime.TextureToken = Runtime.TextureToken + 1
    for index = #Runtime.Textures, 1, -1 do
        local texture = Runtime.Textures[index]
        if texture and texture.Parent then pcall(function() texture:Destroy() end) end
        Runtime.Textures[index] = nil
    end

    local objects = Workspace:GetDescendants()
    for index, object in ipairs(objects) do
        if object:IsA("Texture") and object.Name == TEXTURE_NAME then
            pcall(function() object:Destroy() end)
        end
        if index % 300 == 0 then task.wait() end
    end
end

local function textureEligible(part)
    if not part:IsA("BasePart") or part.Transparency >= 1 then return false end
    if part.Name:find("^DevKage") then return false end
    if isCharacterPart(part) then return false end
    if VisualsState.world_texture_white_only and not partIsWhite(part) then return false end
    return true
end

local function addTexturesToPart(part)
    if not VisualsState.world_minecraft_texture or not textureEligible(part) then return end
    if part:FindFirstChild(TEXTURE_NAME) then return end

    local tile = math.max(0.25, tonumber(VisualsState.world_texture_tile_size) or 9)
    local transparency = math.clamp(tonumber(VisualsState.world_texture_transparency) or 0, 0, 1)

    for _, face in ipairs(Enum.NormalId:GetEnumItems()) do
        local texture = Instance.new("Texture")
        texture.Name = TEXTURE_NAME
        texture.Texture = MINECRAFT_TEXTURE
        texture.Face = face
        texture.StudsPerTileU = tile
        texture.StudsPerTileV = tile
        texture.Transparency = transparency
        texture.ZIndex = 1
        texture.Parent = part
        Runtime.Textures[#Runtime.Textures+1] = texture
    end
end

local function refreshWorldTextureSettings()
    local tile = math.max(0.25, tonumber(VisualsState.world_texture_tile_size) or 9)
    local transparency = math.clamp(tonumber(VisualsState.world_texture_transparency) or 0, 0, 1)
    for index = #Runtime.Textures, 1, -1 do
        local texture = Runtime.Textures[index]
        if not texture or not texture.Parent then
            table.remove(Runtime.Textures, index)
        else
            texture.StudsPerTileU = tile
            texture.StudsPerTileV = tile
            texture.Transparency = transparency
        end
    end
end

local function rebuildWorldTextures()
    Runtime.TextureToken = Runtime.TextureToken + 1
    local token = Runtime.TextureToken
    task.spawn(function()
        local objects = Workspace:GetDescendants()
        for index, object in ipairs(objects) do
            if token ~= Runtime.TextureToken then return end
            if object:IsA("Texture") and object.Name == TEXTURE_NAME then
                pcall(function() object:Destroy() end)
            end
            if index % 250 == 0 then task.wait() end
        end
        table.clear(Runtime.Textures)

        if not VisualsState.world_minecraft_texture then return end

        objects = Workspace:GetDescendants()
        for index, object in ipairs(objects) do
            if token ~= Runtime.TextureToken or not VisualsState.world_minecraft_texture then return end
            if object:IsA("BasePart") then addTexturesToPart(object) end
            if index % 100 == 0 then task.wait() end
        end
    end)
end

Runtime.Connections[#Runtime.Connections+1] = Workspace.DescendantAdded:Connect(function(object)
    if VisualsState.world_minecraft_texture and object:IsA("BasePart") then
        task.defer(function()
            if object and object.Parent then addTexturesToPart(object) end
        end)
    end
end)

local ZOMBIE_ANIMATIONS = {
    idle = {"rbxassetid://616158929","rbxassetid://616160636"},
    walk = "rbxassetid://616168032",
    run = "rbxassetid://616163682",
    jump = "rbxassetid://616161997",
    fall = "rbxassetid://616157476",
    climb = "rbxassetid://616156119",
    swim = "rbxassetid://616165109",
    swimidle = "rbxassetid://616166655",
}

local function applyZombieAnimations(character)
    local animate = character and character:FindFirstChild("Animate")
    if not animate then return end

    for _, animation in ipairs(animate:GetDescendants()) do
        if animation:IsA("Animation") then
            if Runtime.OriginalAnimations[animation] == nil then
                Runtime.OriginalAnimations[animation] = animation.AnimationId
            end

            local parentName = animation.Parent and animation.Parent.Name:lower() or ""
            local id = ZOMBIE_ANIMATIONS[parentName]
            if type(id) == "table" then
                local index = animation.Name:lower():find("2") and 2 or 1
                id = id[index] or id[1]
            end
            if type(id) == "string" then
                animation.AnimationId = id
            end
        end
    end
end

local function removeGeneratedAccessories(character)
    if not character then return end
    for _, child in ipairs(character:GetChildren()) do
        if child.Name:find("^DevKageAvatar_") then
            pcall(function() child:Destroy() end)
        end
    end
end

local function createAttachedPart(character, name, size, color, relativeCFrame, shape)
    local head = character and character:FindFirstChild("Head")
    if not head then return nil end

    local part = Instance.new("Part")
    part.Name = "DevKageAvatar_" .. name
    part.Size = size
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.CastShadow = false
    part.Shape = shape or Enum.PartType.Block
    part.CFrame = head.CFrame * relativeCFrame
    part.Parent = character

    local weld = Instance.new("Weld")
    weld.Name = "DevKageWeld"
    weld.Part0 = head
    weld.Part1 = part
    weld.C0 = relativeCFrame
    weld.C1 = CFrame.new()
    weld.Parent = part

    return part
end

local function accessoryRotation()
    return CFrame.Angles(
        math.rad(tonumber(VisualsState.avatar_rotation_x) or 0),
        math.rad(tonumber(VisualsState.avatar_rotation_y) or 0),
        math.rad(tonumber(VisualsState.avatar_rotation_z) or 0)
    )
end

local function createLuxuryHornSet(character, prefix, baseColor, tipColor, glowColor, hornOffset, rotation, scale)
    local function makeSegment(side, index, count)
        local t = (index - 1) / math.max(count - 1, 1)
        local thickness = (0.34 - 0.20 * t) * scale
        local length = (0.48 - 0.12 * t) * scale

        local x = side * (0.42 + 0.115 * index) * scale
        local y = hornOffset + (0.05 + 0.105 * index + 0.012 * index * index) * scale
        local z = (-0.06 - 0.035 * index) * scale

        local pitch = math.rad(-18 - index * 3)
        local yaw = math.rad(side * (5 + index * 2))
        local roll = math.rad(side * (18 + index * 8))
        local relative = CFrame.new(x, y, z) * rotation * CFrame.Angles(pitch, yaw, roll)

        local segment = createAttachedPart(
            character,
            prefix .. "_Segment_" .. tostring(side) .. "_" .. tostring(index),
            Vector3.new(thickness, length, thickness * 0.92),
            baseColor:Lerp(tipColor, t),
            relative
        )
        if not segment then return end        local wedge = Instance.new("SpecialMesh")
        wedge.MeshType = Enum.MeshType.Wedge
        wedge.Scale = Vector3.new(1, 1, 1)
        wedge.Parent = segment
        segment.Material = Enum.Material.SmoothPlastic

        local core = createAttachedPart(
            character,
            prefix .. "_Core_" .. tostring(side) .. "_" .. tostring(index),
            Vector3.new(thickness * 0.34, length * 0.76, thickness * 0.30),
            glowColor,
            relative * CFrame.new(0, 0, -thickness * 0.30)
        )
        if core then
            local coreMesh = Instance.new("SpecialMesh")
            coreMesh.MeshType = Enum.MeshType.Wedge
            coreMesh.Parent = core
            core.Material = Enum.Material.Neon
            core.Transparency = 0.18 + 0.22 * t
        end
    end

    local count = 6
    for _, side in ipairs({-1, 1}) do
        local base = createAttachedPart(
            character,
            prefix .. "_Base_" .. tostring(side),
            Vector3.new(0.40, 0.32, 0.36) * scale,
            baseColor,
            CFrame.new(side * 0.44 * scale, hornOffset + 0.08 * scale, -0.05 * scale)
                * rotation * CFrame.Angles(math.rad(-12), 0, math.rad(side * 14)),
            Enum.PartType.Ball
        )
        if base then
            base.Material = Enum.Material.SmoothPlastic
            local shine = Instance.new("PointLight")
            shine.Color = glowColor
            shine.Brightness = 0.55
            shine.Range = 3.2 * scale
            shine.Shadows = false
            shine.Parent = base
        end

        for index = 1, count do
            makeSegment(side, index, count)
        end

        local tine = createAttachedPart(
            character,
            prefix .. "_Tine_" .. tostring(side),
            Vector3.new(0.12, 0.42, 0.11) * scale,
            tipColor,
            CFrame.new(side * 0.78 * scale, hornOffset + 0.48 * scale, -0.18 * scale)
                * rotation * CFrame.Angles(math.rad(-38), math.rad(side * 8), math.rad(side * 62))
        )
        if tine then
            local tineMesh = Instance.new("SpecialMesh")
            tineMesh.MeshType = Enum.MeshType.Wedge
            tineMesh.Parent = tine
            tine.Material = Enum.Material.Neon
            tine.Transparency = 0.08
        end
    end
end

local function applyAccessorySet(character)
    local scale = math.clamp(tonumber(VisualsState.avatar_accessory_scale) or 1, 0.2, 3)
    local rotation = accessoryRotation()
    local beardOffset = tonumber(VisualsState.avatar_beard_offset) or -1.56
    local hornOffset = tonumber(VisualsState.avatar_horn_offset) or 1.2

    if VisualsState.avatar_beard then
        local beard = createAttachedPart(
            character, "Beard",
            Vector3.new(0.82, 0.48, 0.12) * scale,
            Color3.fromRGB(55, 35, 22),
            CFrame.new(0, beardOffset, -0.48) * rotation
        )
        if beard then
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.Wedge
            mesh.Parent = beard
        end
    end

    if VisualsState.avatar_red_horn then
        createLuxuryHornSet(
            character,
            "InfernalHorn",
            Color3.fromRGB(95, 5, 8),
            Color3.fromRGB(255, 74, 18),
            Color3.fromRGB(255, 185, 45),
            hornOffset,
            rotation,
            scale
        )
    end

    if VisualsState.avatar_blue_horn then
        createLuxuryHornSet(
            character,
            "FrozenHorn",
            Color3.fromRGB(12, 34, 92),
            Color3.fromRGB(72, 190, 255),
            Color3.fromRGB(175, 245, 255),
            hornOffset,
            rotation,
            scale
        )
    end

    if VisualsState.avatar_fake_accessory then
        local fake = createAttachedPart(
            character, "FakeAccessory",
            Vector3.new(0.42, 0.42, 0.42) * scale,
            Color3.fromRGB(180, 70, 255),
            CFrame.new(0, 1.35, 0) * rotation,
            Enum.PartType.Ball
        )
        if fake then
            fake.Material = Enum.Material.Neon
            fake.Transparency = 0.15
        end
    end
end

local function applyHeadless(character)
    local head = character and character:FindFirstChild("Head")
    if not head then return end
    setRemembered(head, "Transparency", 1)
    for _, object in ipairs(head:GetDescendants()) do
        if object:IsA("Decal") or object:IsA("Texture") then
            setRemembered(object, "Transparency", 1)
        end
    end
end

local KORBLOX_TEXTURE = "rbxassetid://902843398"
local KORBLOX_UPPER_MESH = "rbxassetid://902942096"
local KORBLOX_LOWER_MESH = "rbxassetid://902942093"
local KORBLOX_FOOT_MESH  = "rbxassetid://902942089"

local function createKorbloxReplica(character, sourcePart, meshId, textureId, suffix)
    if not sourcePart or not sourcePart:IsA("BasePart") then return nil end
    local visual=Instance.new("Part")
    visual.Name="DevKageAvatar_Korblox"..tostring(suffix or "Part")
    visual.Size=sourcePart.Size
    visual.CFrame=sourcePart.CFrame
    visual.Color=Color3.new(1,1,1)
    visual.Material=Enum.Material.SmoothPlastic
    visual.Transparency=0
    visual.CanCollide=false
    visual.CanTouch=false
    visual.CanQuery=false
    visual.Massless=true
    visual.CastShadow=false
    visual.Parent=character

    local mesh=Instance.new("SpecialMesh")
    mesh.MeshType=Enum.MeshType.FileMesh
    mesh.MeshId=meshId
    mesh.TextureId=textureId
    mesh.Scale=Vector3.new(1,1,1)
    mesh.Parent=visual

    local weld=Instance.new("WeldConstraint")
    weld.Part0=sourcePart
    weld.Part1=visual
    weld.Parent=visual
    setLocalHidden(sourcePart,true)
    return visual
end

local function createKorbloxFallback(character, upperPart, lowerPart, footPart)
    local made=0
    if upperPart then if createKorbloxReplica(character,upperPart,KORBLOX_UPPER_MESH,KORBLOX_TEXTURE,"Upper") then made=made+1 end end
    if lowerPart then if createKorbloxReplica(character,lowerPart,KORBLOX_LOWER_MESH,KORBLOX_TEXTURE,"Lower") then made=made+1 end end
    if footPart then if createKorbloxReplica(character,footPart,KORBLOX_FOOT_MESH,KORBLOX_TEXTURE,"Foot") then made=made+1 end end
    return made>0
end

local function applyKorblox(character)
    if not character then return end

    local upper=character:FindFirstChild("RightUpperLeg")
    local lower=character:FindFirstChild("RightLowerLeg")
    local foot=character:FindFirstChild("RightFoot")

    if upper and lower and foot and upper:IsA("MeshPart") and lower:IsA("MeshPart") and foot:IsA("MeshPart") then
        local upperMeshOk=setRemembered(upper,"MeshId",KORBLOX_UPPER_MESH)
        local upperTextureOk=setRemembered(upper,"TextureID",KORBLOX_TEXTURE)
        local lowerMeshOk=setRemembered(lower,"MeshId",KORBLOX_LOWER_MESH)
        local lowerTextureOk=setRemembered(lower,"TextureID",KORBLOX_TEXTURE)
        local footMeshOk=setRemembered(foot,"MeshId",KORBLOX_FOOT_MESH)
        local footTextureOk=setRemembered(foot,"TextureID",KORBLOX_TEXTURE)

        setLocalHidden(upper,false)
        setLocalHidden(lower,false)
        setLocalHidden(foot,false)
        if upperMeshOk and upperTextureOk and lowerMeshOk and lowerTextureOk and footMeshOk and footTextureOk then
            return
        end

        createKorbloxFallback(character,upper,lower,foot)
        return
    end

    local r6Leg=character:FindFirstChild("Right Leg")
    if r6Leg and r6Leg:IsA("BasePart") then
        createKorbloxReplica(character,r6Leg,KORBLOX_LOWER_MESH,KORBLOX_TEXTURE,"R6")
    elseif lower and lower:IsA("BasePart") then
        createKorbloxFallback(character,upper,lower,foot)
    end
end

local function applyAvatarNow(character)
    character = character or LocalPlayer.Character
    if not character then return end

    restoreAvatarProperties()
    removeGeneratedAccessories(character)

    if VisualsState.avatar_zombie_animations then applyZombieAnimations(character) end
    if VisualsState.avatar_headless then applyHeadless(character) end
    if VisualsState.avatar_korblox then applyKorblox(character) end
    applyAccessorySet(character)
end

local function scheduleAvatarApply()
    Runtime.AvatarToken = Runtime.AvatarToken + 1
    local token = Runtime.AvatarToken
    local delayTime = math.max(0, tonumber(VisualsState.avatar_apply_delay) or 0.35)
    local retries = math.clamp(math.floor(tonumber(VisualsState.avatar_retry_count) or 3), 1, 10)
    local retryDelay = math.max(0.05, tonumber(VisualsState.avatar_retry_delay) or 0.8)

    task.spawn(function()
        task.wait(delayTime)
        for attempt = 1, retries do
            if token ~= Runtime.AvatarToken then return end
            local character = LocalPlayer.Character
            if character then pcall(applyAvatarNow, character) end
            if attempt < retries then task.wait(retryDelay) end
        end
    end)
end

