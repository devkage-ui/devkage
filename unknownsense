end

AntiAimState.core.Actions = {
    Toggle = function() aa_apply(not AntiAimState.enabled) end,
    CycleYaw = function()
        local options = AntiAimState.core.YawModes
        local index = table.find(options, AntiAimState.yaw_mode) or 0
        AntiAimState.SetValue("yaw_mode", options[index % #options + 1])
    end,
    CyclePitch = function()
        local options = AntiAimState.core.PitchModes
        local index = table.find(options, AntiAimState.pitch_mode) or 0
        AntiAimState.SetValue("pitch_mode", options[index % #options + 1])
    end,
    CyclePreset = function()
        local options = AntiAimState.core.PresetOptions
        local index = table.find(options, AntiAimState.preset) or 1
        AntiAimState.SelectPreset(options[index % #options + 1])
    end,
    FlipSide = function()
        AntiAimState.freestand_direction = AntiAimState.freestand_direction == "Right" and "Left" or "Right"
        AntiAimState.SyncControls()
    end,
    Reset = function()
        local enabled = AntiAimState.enabled
        for key, value in pairs(AntiAimState.core.Defaults) do
            if key ~= "enabled" and key ~= "noclip_enabled" and key ~= "flight_enabled" and key ~= "flight_speed" then
                AntiAimState[key] = value
            end
        end
        AntiAimState.Normalize()
        aa_apply(enabled)
    end,
}

if AntiAimState.core.InputConnection then AntiAimState.core.InputConnection:Disconnect() end
AntiAimState.core.InputConnection = uis.InputBegan:Connect(function(input, processed)
    local core = AntiAimState.core
    if core.Unloaded or core.Syncing or processed or not AntiAimState.keybinds_enabled or uis:GetFocusedTextBox() then return end
    local manager = library.KeybindManager
    if manager and (manager.CaptureControl or (manager.Menu and manager.Menu.Visible)) then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = input.KeyCode.Name
    if key == AntiAimState.toggle_key then core.Actions.Toggle()
    elseif key == AntiAimState.yaw_cycle_key then core.Actions.CycleYaw()
    elseif key == AntiAimState.pitch_cycle_key then core.Actions.CyclePitch()
    elseif key == AntiAimState.preset_cycle_key then core.Actions.CyclePreset()
    elseif key == AntiAimState.freestand_key then core.Actions.FlipSide() end
end)



