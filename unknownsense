                if cursor ~= "" then
                    proxyUrl = proxyUrl .. "&cursor=" .. ModDetectorHttpService:UrlEncode(cursor)
                end
                data = modDetectorReadJson(proxyUrl)
            end
            if type(data) ~= "table" or type(data.data) ~= "table" then break end

            for _, entry in ipairs(data.data) do
                local userId = tonumber(entry.userId)
                    or tonumber(entry.id)
                    or (type(entry.user) == "table" and tonumber(entry.user.userId))
                    or (type(entry.user) == "table" and tonumber(entry.user.id))
                if userId then collected[userId] = true end
            end

            cursor = tostring(data.nextPageCursor or "")
            task.wait(0.03)
        until cursor == "" or pageCount >= 25
    end

    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return false end
    ModDetectorRuntime.StaffIds = collected
    ModDetectorRuntime.StaffIdsReady = true
    return true
end

local function modDetectorPlayerHasStaffFriend(plr, token)
    if not plr or plr == LocalPlayer then return false end
    if not ModDetectorRuntime.StaffIdsReady or next(ModDetectorRuntime.StaffIds) == nil then return false end

    local ok, pages = pcall(function()
        return Players:GetFriendsAsync(plr.UserId)
    end)
    if not ok or not pages then return false end

    local pageCount = 0
    while token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled do
        pageCount = pageCount + 1
        local page = pages:GetCurrentPage()
        for _, friend in ipairs(page) do
            if ModDetectorRuntime.StaffIds[tonumber(friend.Id)] then
                return true
            end
        end

        if pages.IsFinished or pageCount >= 6 then break end
        local advanced = pcall(function()
            pages:AdvanceToNextPageAsync()
        end)
        if not advanced then break end
        task.wait(0.03)
    end
    return false
end

local function modDetectorScan(token)
    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return end

    if modDetectorOnlineStaffPresent() then
        modDetectorSetAlert(true)
        return
    end

    modDetectorSetAlert(false)

    if not ModDetectorRuntime.StaffIdsReady then
        modDetectorLoadStaffIds(token)
    end
    if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and modDetectorPlayerHasStaffFriend(plr, token) then
            modDetectorSetAlert(true)
            return
        end
        if token ~= ModDetectorRuntime.Token or not ModDetectorRuntime.Enabled then return end
    end

    modDetectorSetAlert(false)
end

local function modDetectorQueueScan(delaySeconds)
    if not ModDetectorRuntime.Enabled then return end
    local token = ModDetectorRuntime.Token
    task.delay(delaySeconds or 0, function()
        if token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled then
            modDetectorScan(token)
        end
    end)
end

local function setModDetectorEnabled(enabled)
    enabled = enabled == true
    VisualsState.mod_detector_enabled = enabled
    ModDetectorRuntime.Enabled = enabled
    ModDetectorRuntime.Token = ModDetectorRuntime.Token + 1
    if enabled and library and library.KeybindManager and library.KeybindManager.EnsureUI then
        library.KeybindManager:EnsureUI(library.Window)
    end
    modDetectorSetAlert(false, true)

    if not enabled then return end

    local token = ModDetectorRuntime.Token
    task.spawn(function()
        modDetectorScan(token)
        while token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled do
            task.wait(15)
            if token == ModDetectorRuntime.Token and ModDetectorRuntime.Enabled then
                modDetectorScan(token)
            end
        end
    end)
end

