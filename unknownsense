            shard.Activate = safeActivate
            changed = true
        end
        if shard.Deactivate ~= safeDeactivate then
            shard.Deactivate = safeDeactivate
            changed = true
        end
        if shard.AlwaysOn ~= true then
            shard.AlwaysOn = true
