local function firstAccessory(root)
    if not root then return nil end
    if root:IsA("Accessory") then return root end
    for _,object in ipairs(root:GetDescendants()) do
        if object:IsA("Accessory") then return object end
    end
    return nil
end

local function cloneAccessoryFromRoots(roots)
    if type(roots)~="table" then return nil end
    local result=nil
    for _,root in ipairs(roots) do
        if not result then
            local accessory=firstAccessory(root)
            if accessory then
                pcall(function() result=accessory:Clone() end)
            end
        end
    end
    for _,root in ipairs(roots) do
        pcall(function() root:Destroy() end)
    end
    return result
end

local function loadAccessoryByDescription(assetId,kind)
    local description=Instance.new("HumanoidDescription")
    local configured=pcall(function()
        if kind=="Face" then
            description.FaceAccessory=tostring(assetId)
        else
            description.HatAccessory=tostring(assetId)
        end
    end)
    if not configured then
        pcall(function() description:Destroy() end)
        return nil
    end

    local model=nil
    local ok=pcall(function()
        local success,result=SpooferState.AvatarAssets.TryMethods(Players,
            {"CreateHumanoidModelFromDescriptionAsync","CreateHumanoidModelFromDescription"},
            description,Enum.HumanoidRigType.R15)
        if not success then error(result) end
        model=result
    end)
    pcall(function() description:Destroy() end)
    if not ok or not model then return nil end
    local accessory=firstAccessory(model)
    local clone=nil
    if accessory then pcall(function() clone=accessory:Clone() end) end
    pcall(function() model:Destroy() end)
    return clone
end

local function loadAccessoryTemplate(assetId,kind)
    local key=tostring(assetId)..":"..tostring(kind)
    local cached=AvatarAssetCache[key]
    if cached then
        local clone=nil
        pcall(function() clone=cached:Clone() end)
        if clone then return clone end
    end

    local accessory=nil

    local roots=nil
    local objectsOk=pcall(function()
        roots=game:GetObjects("rbxassetid://"..tostring(assetId))
    end)
    if objectsOk then
        accessory=cloneAccessoryFromRoots(roots)
    end

    if not accessory then
        local model=nil
        local insertOk=pcall(function()
            model=AvatarInsertService:LoadAsset(tonumber(assetId))
        end)
        if insertOk and model then
            local found=firstAccessory(model)
            if found then pcall(function() accessory=found:Clone() end) end
            pcall(function() model:Destroy() end)
        end
    end

    if not accessory then
        accessory=loadAccessoryByDescription(assetId,kind)
    end

    if not accessory then return nil end
    accessory.Parent=nil
    AvatarAssetCache[key]=accessory
    local clone=nil
    pcall(function() clone=accessory:Clone() end)
    return clone
end

local function prepareAccessory(accessory,color,scale)
    scale=math.clamp(tonumber(scale) or 1,0.15,4)
    if typeof(color)~="Color3" then color=Color3.new(1,1,1) end

    for _,object in ipairs(accessory:GetDescendants()) do
        if object:IsA("BasePart") then
            object.CanCollide=false
            object.CanTouch=false
            object.CanQuery=false
            object.Massless=true
            object.CastShadow=false
            pcall(function() object.Color=color end)
            if object:IsA("MeshPart") then
                pcall(function()
                    object.Size=object.Size*scale
                    object.TextureID=""
                end)
            end
        elseif object:IsA("SpecialMesh") then
            pcall(function()
                object.Scale=object.Scale*scale
                object.TextureId=""
            end)
        elseif object:IsA("Attachment") then
            pcall(function() object.Position=object.Position*scale end)
        end
    end
end

local function attachAccessoryToHead(character,assetId,kind,name,color,scale,offset,rotation)
    if not character then return false end
    local head=character:FindFirstChild("Head")
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if not head or not humanoid then return false end

    local accessory=loadAccessoryTemplate(assetId,kind)
    if not accessory then return false end
    accessory.Name=avatarName(name)
    prepareAccessory(accessory,color,scale)

    local handle=accessory:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        pcall(function() accessory:Destroy() end)
        return false
    end

    local handleAttachment=nil
    for _,child in ipairs(handle:GetChildren()) do
        if child:IsA("Attachment") then
            handleAttachment=child
            break
        end
    end

    local headAttachment=handleAttachment and head:FindFirstChild(handleAttachment.Name)
    local baseRelative=CFrame.new()
    if handleAttachment and headAttachment and headAttachment:IsA("Attachment") then
        baseRelative=headAttachment.CFrame*handleAttachment.CFrame:Inverse()
    end

    accessory.Parent=character
    handle.CanCollide=false
    handle.CanTouch=false
    handle.CanQuery=false
    handle.Massless=true

    for _,joint in ipairs(handle:GetChildren()) do
        if joint:IsA("Weld") or joint:IsA("WeldConstraint") or joint:IsA("Motor6D") then
            pcall(function() joint:Destroy() end)
        end
    end

    local finalRelative=baseRelative*(offset or CFrame.new())*(rotation or CFrame.new())
    handle.CFrame=head.CFrame*finalRelative

    local weld=Instance.new("Weld")
    weld.Name="DevKageAvatarWeld"
    weld.Part0=head
    weld.Part1=handle
    weld.C0=finalRelative
    weld.C1=CFrame.new()
    weld.Parent=handle
    return true
end

