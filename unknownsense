library:ObserveThemeRoot(library.ThemeRoot)
task.spawn(function()
    task.wait(0.15)
    local root = library and library.ThemeRoot
    if not root or not root.Parent then return end
    library:ApplyThemeObject(root)
    local objects = root:GetDescendants()
    for index, object in ipairs(objects) do
        if object and object.Parent then library:ApplyThemeObject(object) end
        if index % 80 == 0 then task.wait() end
    end
    local manager = library and library.KeybindManager
    if manager and manager.Overlay and manager.Overlay.Parent then
        library:ApplyThemeObject(manager.Overlay)
        local overlayObjects = manager.Overlay:GetDescendants()
        for index, object in ipairs(overlayObjects) do
            if object and object.Parent then library:ApplyThemeObject(object) end
            if index % 80 == 0 then task.wait() end
        end
    end
end)

