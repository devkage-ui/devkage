function SpooferState.InstallDataBridge()
local controller=SpooferState.ResolveGameModule("PlayerDataController","Controller")
if type(controller)~="table" or type(controller.Get)~="function" then
SpooferState.dataStatus="PlayerDataController unavailable"
return false
end
local environment=(type(getgenv)=="function" and getgenv()) or _G
local bridge=environment.__DevKagePlayerDataBridge
if type(bridge)~="table" or bridge.Controller~=controller or type(bridge.Original)~="function" then
bridge={Controller=controller,Original=controller.Get,Active=true}
bridge.Wrapper=function(self,key,...)
local originalValue=bridge.Original(self,key,...)
if bridge.Active and type(bridge.Resolve)=="function" then
local ok,handled,value=pcall(bridge.Resolve,key,originalValue)
if ok and handled then return value end
end
return originalValue
end
controller.Get=bridge.Wrapper
environment.__DevKagePlayerDataBridge=bridge
elseif controller.Get~=bridge.Wrapper then
-- Another script currently owns the outer wrapper. Do not re-wrap it.
-- If that script chained the previous function, DevKage remains inside
-- the chain without creating a circular wrapper dependency.
bridge.ExternalWrapper=controller.Get
end
bridge.Owner=SpooferState
bridge.Active=true
bridge.Resolve=function(key,originalValue)
if not SpooferState.IsActive() then return false,originalValue end
local config=getgenv().__DevKageConfig
local normalized=SpooferState.Key(key)
if config.eloLiveSync~=false and config.spoofELO~=false and spoofELOName(normalized) then
return true,normalizeSpoofELO(config.elo)
end
if config.duelHistoryEnabled==true and (normalized=="duelhistory" or normalized=="matchhistory" or normalized=="recentmatches") then
local value,handled=SpooferState.BuildDuelHistory(originalValue,config)
return handled,value
end
if config.duelHistoryEnabled==true and normalized=="loggedeloevents" then
local value,handled=SpooferState.BuildLoggedELOEvents(originalValue,config)
return handled,value
end
local entry=SpooferState.dataKeyMap[normalized]
if not entry or config[entry.Toggle]~=true then return false,originalValue end
return true,math.max(0,math.floor((tonumber(config[entry.Value]) or 0)+0.5))
end
SpooferState.dataStatus="Client data bridge ready"
return true
end

