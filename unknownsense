function UA.save()
    if type(writefile) ~= "function" then return false end
    if not ua_isActiveInstance() then return false end

    local now = os.clock()
    local remaining = 0.18 - (now - (UA.lastSaveAt or 0))
    if UA.saveBusy or remaining > 0 then
        UA.saveQueued = true
        if not UA.saveScheduled then
            UA.saveScheduled = true
            task.delay(math.max(remaining, 0.05), function()
                UA.saveScheduled = false
                if UA.saveQueued and ua_isActiveInstance() then
                    UA.saveQueued = false
                    UA.save()
                end
            end)
        end
        return true
    end

    UA.saveBusy = true
    local ok = pcall(function()
        if type(makefolder) == "function" then
            local folderExists = false
            if type(isfolder) == "function" then
                local checked, result = pcall(isfolder, "devkage_inventory")
                folderExists = checked and result == true
            end
            if not folderExists then pcall(makefolder, "devkage_inventory") end
        end
        writefile(UA.saveFile, HttpService:JSONEncode({
            schemaVersion = 4,
            weaponLoadout = UA.ExportWeaponLoadout(),
            weaponFavorites = UA.ExportFavorites(),
            emoteLoadout = UA.ExportEmoteLoadout(),
        }))
    end)
    UA.lastSaveAt = os.clock()
    UA.saveBusy = false

    if UA.saveQueued and not UA.saveScheduled then
        UA.saveQueued = false
        UA.saveScheduled = true
        task.delay(0.18, function()
            UA.saveScheduled = false
            if ua_isActiveInstance() then UA.save() end
        end)
    end
    return ok
end

function UA.load()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
    local existsOk, exists = pcall(isfile, UA.saveFile)
    if not existsOk or not exists then return false end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(UA.saveFile))
    end)
    if not ok or type(decoded) ~= "table" then return false end
    UA.ImportWeaponLoadout(decoded.weaponLoadout or decoded.equipped)
    UA.ImportFavorites(decoded.weaponFavorites or decoded.favorites)
    UA.ImportEmoteLoadout(decoded.emoteLoadout)
    return true
end

