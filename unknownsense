            Text = "",
            TextTransparency = 1,
            AutoButtonColor = false,
            Active = true,
            ZIndex = 30
        })

        local popup = nil
        local popupList = nil
        local outsideConnection = nil
        local rowConnections = {}
        local rows = {}

        local function disconnectPopupConnections()
            for _, connection in ipairs(rowConnections) do
                pcall(function() connection:Disconnect() end)
            end
            rowConnections = {}
            if outsideConnection then
                pcall(function() outsideConnection:Disconnect() end)
                outsideConnection = nil
            end
        end

        local function setArrow(open)
            Arrow.Rotation = open and 180 or 0
            Holder_Outline_Frame.BackgroundColor3 = open and Color3.fromRGB(46,46,46) or Color3.fromRGB(36,36,36)
        end

        function Content.Content:Refresh()
            for _, row in ipairs(rows) do
                if row and row.Button then
                    row.Button.TextColor3 = row.Index == Content.State and Content.Window.Accent or Color3.fromRGB(205,205,205)
                end
            end
        end

        function Content.Content:Close()
            if not Content.Content.Open and not popup then return end
            Content.Content.Open = false
            setArrow(false)
            disconnectPopupConnections()
            rows = {}
            popupList = nil
            if popup then
                pcall(function() popup:Destroy() end)
                popup = nil
            end
        end

        function Content:Set(state, silent)
            local index = tonumber(state)
            if not index and state ~= nil then
                for optionIndex, option in ipairs(Content.Options) do
                    if tostring(option) == tostring(state) then
                        index = optionIndex
                        break
                    end
                end
            end
            index = math.clamp(math.floor(index or 1), 1, math.max(#Content.Options, 1))
            Content.State = index
            Outline_Frame_Title.Text = tostring(Content.Options[index] or "")
            if Content.Content.Open then Content.Content:Refresh() end
            if not silent then
                utility:SafeCallback(Content.Callback, Content.State, Content.Options[Content.State])
            end
        end

        function Content:Get()
            return Content.State
        end

        function Content:GetValue()
            return Content.Options[Content.State]
        end

        local function mouseInside(guiObject, position)
            if not guiObject or not guiObject.Parent then return false end
            local p = guiObject.AbsolutePosition
            local s = guiObject.AbsoluteSize
            return position.X >= p.X and position.X <= p.X + s.X
                and position.Y >= p.Y and position.Y <= p.Y + s.Y
        end

        local function positionPopup()
            if not popup or not popup.Parent then return end
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1920,1080)
            local anchorPos = Content_Holder_Outline.AbsolutePosition
            local anchorSize = Content_Holder_Outline.AbsoluteSize
            local width = math.max(math.floor(anchorSize.X), 100)
            local visibleRows = math.min(#Content.Options, 8)
            local height = visibleRows * 20 + 2
            local x = anchorPos.X
            local y = anchorPos.Y + anchorSize.Y + 2
            if y + height > viewport.Y - 4 then
                y = anchorPos.Y - height - 2
            end
            x = math.clamp(x, 4, math.max(4, viewport.X - width - 4))
            y = math.clamp(y, 4, math.max(4, viewport.Y - height - 4))
            popup.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
            popup.Size = UDim2.fromOffset(width, height)
        end

        function Content:Open()
            if Content.Content.Open then return end
            Content.Section:CloseContent()

            popup = Instance.new("Frame")
            popup.Name = "DevKage_DropdownPopup"
            popup.BackgroundColor3 = Color3.fromRGB(12,12,12)
            popup.BorderColor3 = Color3.fromRGB(0,0,0)
            popup.BorderSizePixel = 1
            popup.Active = true
            popup.ClipsDescendants = false
            popup.ZIndex = 1200
            popup.Parent = Content.Window.Root

            popupList = Instance.new("ScrollingFrame")
            popupList.Name = "Options"
            popupList.BackgroundColor3 = Color3.fromRGB(35,35,35)
            popupList.BorderSizePixel = 0
            popupList.Position = UDim2.new(0,1,0,1)
            popupList.Size = UDim2.new(1,-2,1,-2)
            popupList.CanvasSize = UDim2.fromOffset(0, #Content.Options * 20)
            popupList.ScrollBarThickness = #Content.Options > 8 and 3 or 0
            popupList.ScrollBarImageColor3 = Color3.fromRGB(75,75,75)
            popupList.ScrollingDirection = Enum.ScrollingDirection.Y
            popupList.ScrollingEnabled = #Content.Options > 8
            popupList.ClipsDescendants = true
            popupList.Active = true
            popupList.ZIndex = 1201
            popupList.Parent = popup

            rows = {}
            for index, option in ipairs(Content.Options) do
                local optionButton = Instance.new("TextButton")
                optionButton.Name = "Option_" .. tostring(index)
                optionButton.BackgroundColor3 = Color3.fromRGB(35,35,35)
                optionButton.BackgroundTransparency = 0
                optionButton.BorderSizePixel = 0
                optionButton.Position = UDim2.new(0,0,0,(index-1)*20)
                optionButton.Size = UDim2.new(1,0,0,20)
                optionButton.AutoButtonColor = false
                optionButton.Active = true
                optionButton.Text = tostring(option)
                optionButton.TextColor3 = index == Content.State and Content.Window.Accent or Color3.fromRGB(205,205,205)
                optionButton.TextSize = 9
                optionButton.Font = Enum.Font.Code
                optionButton.TextXAlignment = Enum.TextXAlignment.Left
                optionButton.TextYAlignment = Enum.TextYAlignment.Center
                optionButton.ZIndex = 1202
                optionButton.Parent = popupList

                local padding = Instance.new("UIPadding")
                padding.PaddingLeft = UDim.new(0,8)
                padding.Parent = optionButton

                rows[#rows+1] = {Index=index, Button=optionButton}

                rowConnections[#rowConnections+1] = optionButton.Activated:Connect(function()
                    if not Content.Content.Open then return end
                    Content:Set(index)
                    Content.Content:Close()
                    if Content.Section.Content == Content.Content then
                        Content.Section.Content = {}
                    end
                end)

                rowConnections[#rowConnections+1] = optionButton.MouseEnter:Connect(function()
                    optionButton.BackgroundColor3 = Color3.fromRGB(46,46,46)
                end)

                rowConnections[#rowConnections+1] = optionButton.MouseLeave:Connect(function()
                    optionButton.BackgroundColor3 = Color3.fromRGB(35,35,35)
                end)
            end

            Content.Content.Open = true
            Content.Section.Content = Content.Content
            setArrow(true)
            positionPopup()
            Content.Content:Refresh()

            task.defer(function()
                if not Content.Content.Open then return end
                outsideConnection = uis.InputBegan:Connect(function(input)
                    if not Content.Content.Open then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1
                        and input.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end
                    local pos = Vector2.new(input.Position.X, input.Position.Y)
                    if not mouseInside(popup, pos) and not mouseInside(Content_Holder, pos) then
                        Content.Content:Close()
                        if Content.Section.Content == Content.Content then
                            Content.Section.Content = {}
                        end
                    end
                end)
