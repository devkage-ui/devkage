        config.eloLiveSyncAutoLoad = true
        if SpooferState.savedELO ~= nil then
            config.elo = normalizeSpoofELO(SpooferState.savedELO)
        end
    end

    config.eloLiveSync = true
    config.spoofELO = true
    config.rankDisplay = "Use Spoofed ELO"
