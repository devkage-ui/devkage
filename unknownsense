        local request = self:Requests()
        if not (request.Flight or request.Speed or request.AirStop or request.NoClip or request.Spin) then
            if self.Character or next(self.Objects) or next(self.Properties) then self:ReleaseCharacter() end
            self:SetStatus("Movement: ready")
            return
        end
        local character = LocalPlayer.Character
        local humanoid, root = self:FindRig(character)
        if not humanoid or not root then
            self:ReleaseCharacter()
            self:SetStatus(character and "Movement: compatible character unavailable" or "Movement: waiting for character")
            return
        end
        self:AttachCharacter(character, humanoid, root)
        local assemblyRoot = root.AssemblyRootPart
        local state = humanoid:GetState()
        if humanoid.Health <= 0 or state == stateTypes.Dead then
            self:Suspend()
            self:SetStatus("Movement: waiting for respawn")
            return
        end
