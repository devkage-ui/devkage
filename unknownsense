                        local props = render[2]
                        local dur   = render[4] or 0.25
                        local ti    = TweenInfo.new(dur, Enum.EasingStyle.Linear,
                            state and Enum.EasingDirection.Out or Enum.EasingDirection.In)
                        local cls   = obj.ClassName

                        if cls == "Frame" then
                            local bt = props["BackgroundTransparency"] or 0
                            if bt ~= 1 then
                                tws:Create(obj, ti, {BackgroundTransparency = state and bt or 1}):Play()
                            end
                        elseif cls == "ImageLabel" then
                            local bt = props["BackgroundTransparency"] or 0
                            if bt ~= 1 then
                                tws:Create(obj, ti, {BackgroundTransparency = state and bt or 1}):Play()
                            end
                            local it = props["ImageTransparency"] or 0
                            if it ~= 1 then
                                tws:Create(obj, ti, {ImageTransparency = state and it or 1}):Play()
                            end
                        elseif cls == "TextLabel" or cls == "TextButton" or cls == "TextBox" then
                            local bt = props["BackgroundTransparency"] or 0
                            if bt ~= 1 then
                                tws:Create(obj, ti, {BackgroundTransparency = state and bt or 1}):Play()
                            end
                            local tt = props["TextTransparency"] or 0
                            if tt ~= 1 then
                                tws:Create(obj, ti, {TextTransparency = state and tt or 1}):Play()
                            end
                        elseif cls == "ScrollingFrame" then
                            local bt = props["BackgroundTransparency"] or 0
                            if bt ~= 1 then
                                tws:Create(obj, ti, {BackgroundTransparency = state and bt or 1}):Play()
                            end
                            local st = props["ScrollBarImageTransparency"] or 0
                            if st ~= 1 then
                                tws:Create(obj, ti, {ScrollBarImageTransparency = state and st or 1}):Play()
                            end
                        end
                    end
                end

                task.delay(0.26, function()
                    if fadeToken ~= Window.FadeToken then return end
                    if ScreenGui and ScreenGui.Parent then
                        if state then
                            ScreenGui.Enabled = true
                        else
                            ScreenGui.Enabled = false
                        end
                    end
                end)
            end

            function Window:Unload()
                local env = (type(getgenv) == "function" and getgenv()) or _G
                if env.__DevKageWindow == Window then env.__DevKageWindow = nil end
                for _, callback in ipairs(library.CleanupCallbacks) do
                    utility:SafeCallback(callback)
                end
                for index, connection in pairs(library.Connections) do
                    pcall(function() connection:Disconnect() end)
                end
                if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
                uis.MouseIconEnabled = PreviousMouseIconEnabled
                library = nil
                utility = nil
            end
        end

        Window["TabsHolder"]  = InnerBorder_InnerFrame_Tabs
        Window["PagesHolder"] = Pages_InnerBorder_InnerFrame
        Window["ScreenGui"]   = ScreenGui
        Window["MainFrame"]    = ScreenGui_MainFrame

        do
            local dragging  = false
            local dragInput = nil
            local dragStart  = nil
            local startPos   = nil

            local DragBar = utility:RenderObject("Frame", {
                BackgroundColor3 = Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Parent = ScreenGui_MainFrame,
                Position = UDim2.new(0, 0, 0, 0),
                Size = UDim2.new(1, 0, 0, 12),
                ZIndex = 30000,
                Active = true
            })

            utility:CreateConnection(DragBar.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    dragStart = input.Position
                    startPos = ScreenGui_MainFrame.Position
                    dragInput = input

                    utility:CreateConnection(input.Changed, function()
                        if input.UserInputState == Enum.UserInputState.End then
                            dragging = false
                            dragInput = nil
                        end
                    end)
                end
            end)

            utility:CreateConnection(DragBar.InputChanged, function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    dragInput = input
                end
            end)

            utility:CreateConnection(uis.InputChanged, function(input)
                if input == dragInput and dragging then
                    local delta = input.Position - dragStart
                    ScreenGui_MainFrame.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)
        end

        function Window:Toggle()
            Window.Enabled = not Window.Enabled
            uis.MouseIconEnabled = Window.Enabled and true or PreviousMouseIconEnabled
            if not Window.Enabled and library.KeybindManager and library.KeybindManager.HideMenu then
                library.KeybindManager:HideMenu()
            end
            Window:Fade(Window.Enabled)
            return Window.Enabled
        end

        utility:CreateConnection(uis.InputBegan, function(Input)
            if library.KeybindManager and library.KeybindManager.CaptureControl then return end
            if Input.KeyCode and Input.KeyCode == Window.Key then
                Window:Toggle()
            end
        end)
    end
    return setmetatable(Window, library)
end

-- ── Notifications ─────────────────────────────────────────
function library:Notify(Properties)
    Properties = Properties or {}
    local description = tostring(Properties.description or Properties.Description or Properties.message or Properties.Message or "Notification")
    local duration = math.max(tonumber(Properties.duration or Properties.Duration) or 5, 0.25)

    local screen = self.ScreenGui
    if not screen then return end

    local holder = screen:FindFirstChild("DevKage_Notifications")
    if not holder then
        holder = Instance.new("Frame")
        holder.Name = "DevKage_Notifications"
        holder.BackgroundTransparency = 1
        holder.AnchorPoint = Vector2.new(1,0)
        holder.Position = UDim2.new(1,-18,0,18)
        holder.Size = UDim2.new(0,260,0,0)
        holder.AutomaticSize = Enum.AutomaticSize.Y
        holder.ZIndex = 500
        holder.Parent = screen

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0,5)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = holder
    end

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(23,23,23)
    frame.BackgroundTransparency = 1
    frame.BorderColor3 = Color3.fromRGB(12,12,12)
    frame.BorderSizePixel = 1
    frame.Size = UDim2.new(1,0,0,38)
    frame.ZIndex = 501
    frame.Parent = holder

    local inner = Instance.new("Frame")
    inner.BackgroundColor3 = self.Accent
    inner.BackgroundTransparency = 1
    inner.BorderSizePixel = 0
    inner.Position = UDim2.new(0,0,0,0)
    inner.Size = UDim2.new(0,2,1,0)
    inner.ZIndex = 502
    inner.Parent = frame

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0,10,0,5)
    label.Size = UDim2.new(1,-18,1,-10)
    label.Font = Enum.Font.Code
    label.TextSize = 10
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextColor3 = Color3.fromRGB(220,220,220)
    label.TextTransparency = 1
    label.Text = description
    label.ZIndex = 503
    label.Parent = frame

    tws:Create(frame,TweenInfo.new(0.15),{
        BackgroundTransparency=0
    }):Play()
    tws:Create(inner,TweenInfo.new(0.15),{
        BackgroundTransparency=0
    }):Play()
    tws:Create(label,TweenInfo.new(0.15),{
        TextTransparency=0
    }):Play()

    task.delay(duration,function()
        if not frame.Parent then return end
        local info=TweenInfo.new(0.2)
        tws:Create(frame,info,{BackgroundTransparency=1}):Play()
        tws:Create(inner,info,{BackgroundTransparency=1}):Play()
        tws:Create(label,info,{TextTransparency=1}):Play()
        task.delay(0.22,function()
            if frame.Parent then frame:Destroy() end
        end)
    end)

    return frame
end

